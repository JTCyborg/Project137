 523  8312 3E 01                LD      A,1
 524  8314 C9                   RET
 525  8315
 526  8315              AccelGradientRegs:
 527  8315 02 00                DB $02,$00
 528  8317 08 00 09 00          DB $08,$00,$09,$00,$0A,$00,$0B,$00 ; destination base = 0
 528  831B 0A 00 0B 00
 529  831F 0E 40 0F 01          DB $0E,$40,$0F,$01                 ; destination pitch = 320
 530  8323 14 00 15 00          DB $14,$00,$15,$00                 ; x = 0
 531  8327 16 00 17 00          DB $16,$00,$17,$00                 ; y = 0
 532  832B 18 40 19 01          DB $18,$40,$19,$01                 ; width = 320
 533  832F 1A C8 1B 00          DB $1A,$C8,$1B,$00                 ; height = 200
 534  8333 1C 00 1D 00          DB $1C,$00,$1D,$00,$1E,$00,$1F,$00 ; start colour = 00000000h
 534  8337 1E 00 1F 00
 535  833B 20 FF 21 00          DB $20,$FF,$21,$00,$22,$00,$23,$00 ; end colour = 000000FFh
 535  833F 22 00 23 00
 536  8343              AccelGradientRegsEnd:
 537  8343
 538  8343              ; -------------------------------------------------------------------------
 539  8343              ; Project131-compatible 2D accelerator smoke test.
 540  8343              ; Uses 320x200x8bpp so the complete 64,000-byte framebuffer is in banks 0..3.
 541  8343              ; Tests solid fill, VRAM-to-VRAM BitBLT, Bresenham line and status/readback.
 542  8343              ; Returns A=0 on success, A=1 on failure.
 543  8343              ; -------------------------------------------------------------------------
 544  8343              Run2DAcceleratorTest:
 545  8343 21 15 8F             LD      HL,Msg2DStart
 546  8346 CD 8D 89             CALL    DebugPrint
 547  8349 CD 0E 87             CALL    SpectrumShow2DStart
 548  834C
 549  834C                      ; The adapter powers up with a zeroed DAC. Program visible colours
 550  834C                      ; before the first 8-bpp test, then restore VBE mode (DAC writes
 551  834C                      ; switch the adapter to legacy software mode).
 552  834C CD E3 81             CALL    Program2DTestPalette
 553  834F
 554  834F                      ; Select 320x200x8bpp.
 555  834F 3E 40                LD      A,320&255
 556  8351 32 A6 89             LD      (ModeXLo),A
 557  8354 3E 01                LD      A,320>>8
 558  8356 32 A7 89             LD      (ModeXHi),A
 559  8359 3E C8                LD      A,200&255
 560  835B 32 A8 89             LD      (ModeYLo),A
 561  835E AF                   XOR     A
 562  835F 32 A9 89             LD      (ModeYHi),A
 563  8362 CD 88 84             CALL    ConfigureCurrentMode
 564  8365
 565  8365                      ; SOLID FILL: destination (20,20), 100x60, colour E3h.
 566  8365 21 19 84             LD      HL,AccelFillRegs
 567  8368 3E 26                LD      A,AccelFillRegsEnd-AccelFillRegs
 568  836A CD E5 83             CALL    WriteAccelRegisterTable
 569  836D 3E 00                LD      A,0
 570  836F 1E 01                LD      E,1
 571  8371 CD FC 83             CALL    WriteAccelRegister
 572  8374 CD 06 84             CALL    CheckAccelDone
 573  8377 B7                   OR      A
 574  8378 C0                   RET     NZ
 575  8379
 576  8379                      ; BITBLT: copy the filled rectangle to (140,20).
 577  8379 21 3F 84             LD      HL,AccelBlitRegs
 578  837C 3E 22                LD      A,AccelBlitRegsEnd-AccelBlitRegs
 579  837E CD E5 83             CALL    WriteAccelRegisterTable
 580  8381 3E 00                LD      A,0
 581  8383 1E 02                LD      E,2
 582  8385 CD FC 83             CALL    WriteAccelRegister
 583  8388 CD 06 84             CALL    CheckAccelDone
 584  838B B7                   OR      A
 585  838C C0                   RET     NZ
 586  838D
 587  838D                      ; LINE: draw from (0,0) to (319,199), colour FFh.
 588  838D 21 61 84             LD      HL,AccelLineRegs
 589  8390 3E 1E                LD      A,AccelLineRegsEnd-AccelLineRegs
 590  8392 CD E5 83             CALL    WriteAccelRegisterTable
 591  8395 3E 00                LD      A,0
 592  8397 1E 03                LD      E,3
 593  8399 CD FC 83             CALL    WriteAccelRegister
 594  839C CD 06 84             CALL    CheckAccelDone
 595  839F B7                   OR      A
 596  83A0 C0                   RET     NZ
 597  83A1
 598  83A1                      ; Read back the source and copied destination pixels in bank 0.
 599  83A1 AF                   XOR     A
 600  83A2 01 DF 03             LD      BC,$03DF
 601  83A5 ED 79                OUT     (C),A
 602  83A7 21 14 D9             LD      HL,$D914             ; 20*320 + 20 + C000h
 603  83AA 7E                   LD      A,(HL)
 604  83AB FE E3                CP      $E3
 605  83AD 20 27                JR      NZ,AccelReadbackFail
 606  83AF 21 8C D9             LD      HL,$D98C             ; 20*320 + 140 + C000h
 607  83B2 7E                   LD      A,(HL)
 608  83B3 FE E3                CP      $E3
 609  83B5 20 1F                JR      NZ,AccelReadbackFail
 610  83B7
 611  83B7                      ; The final line pixel is linear offset 63999 = bank 3:3A00?
 612  83B7                      ; Bank 3 aperture address = C000h + (63999 - 49152) = F9FFh.
 613  83B7 3E 03                LD      A,3
 614  83B9 01 DF 03             LD      BC,$03DF
 615  83BC ED 79                OUT     (C),A
 616  83BE 21 FF F9             LD      HL,$F9FF
 617  83C1 7E                   LD      A,(HL)
 618  83C2 FE FF                CP      $FF
 619  83C4 20 10                JR      NZ,AccelReadbackFail
 620  83C6
 621  83C6 21 37 8F             LD      HL,Msg2DPass
 622  83C9 CD 8D 89             CALL    DebugPrint
 623  83CC CD 66 87             CALL    SpectrumShow2DPass
 624  83CF CD 63 89             CALL    WaitSpace
 625  83D2
 626  83D2                      ; Follow the primitive smoke test with a 256-colour gradient
 627  83D2                      ; generated by the dedicated 2D gradient-fill command.
 628  83D2 CD 31 82             CALL    Run2DGradientTest
 629  83D5 C9                   RET
 630  83D6
 631  83D6              AccelReadbackFail:
 632  83D6 21 7E 8F             LD      HL,Msg2DReadbackFail
 633  83D9 CD 8D 89             CALL    DebugPrint
 634  83DC CD 7C 87             CALL    SpectrumShow2DFail
 635  83DF CD 63 89             CALL    WaitSpace
 636  83E2 3E 01                LD      A,1
 637  83E4 C9                   RET
 638  83E5
 639  83E5              ; HL points to register/value pairs; A is the byte count.
 640  83E5              WriteAccelRegisterTable:
 641  83E5 32 96 89             LD      (AccelPairCount),A
 642  83E8              WriteAccelRegisterTableLoop:
 643  83E8 7E                   LD      A,(HL)
 644  83E9 23                   INC     HL
 645  83EA 5E                   LD      E,(HL)
 646  83EB 23                   INC     HL
 647  83EC E5                   PUSH    HL
 648  83ED CD FC 83             CALL    WriteAccelRegister
 649  83F0 E1                   POP     HL
 650  83F1 3A 96 89             LD      A,(AccelPairCount)
 651  83F4 D6 02                SUB     2
 652  83F6 32 96 89             LD      (AccelPairCount),A
 653  83F9 20 ED                JR      NZ,WriteAccelRegisterTableLoop
 654  83FB C9                   RET
 655  83FC
 656  83FC              ; A = accelerator register index, E = value.
 657  83FC              WriteAccelRegister:
 658  83FC 01 E2 03             LD      BC,$03E2
 659  83FF ED 79                OUT     (C),A
 660  8401 7B                   LD      A,E
 661  8402 0C                   INC     C
 662  8403 ED 79                OUT     (C),A
 663  8405 C9                   RET
 664  8406
 665  8406              ; Returns A=0 when status register reports DONE (1), otherwise A=1.
 666  8406              CheckAccelDone:
 667  8406 01 E2 03             LD      BC,$03E2
 668  8409 3E 01                LD      A,1
 669  840B ED 79                OUT     (C),A
 670  840D 0C                   INC     C
 671  840E ED 78                IN      A,(C)
 672  8410 FE 01                CP      1
 673  8412 20 02                JR      NZ,CheckAccelFailed
 674  8414 AF                   XOR     A
 675  8415 C9                   RET
 676  8416              CheckAccelFailed:
 677  8416 3E 01                LD      A,1
 678  8418 C9                   RET
 679  8419
 680  8419              ; Register tables: index,value pairs. All addresses are byte offsets in VRAM.
 681  8419              AccelFillRegs:
 682  8419 02 00                DB $02,$00                 ; ROP COPY
 683  841B 08 00 09 00          DB $08,$00,$09,$00,$0A,$00,$0B,$00 ; destination base = 0
 683  841F 0A 00 0B 00
 684  8423 0E 40 0F 01          DB $0E,$40,$0F,$01         ; destination pitch = 320
 685  8427 14 14 15 00          DB $14,20,$15,0,$16,20,$17,0
 685  842B 16 14 17 00
 686  842F 18 64 19 00          DB $18,100,$19,0,$1A,60,$1B,0
 686  8433 1A 3C 1B 00
 687  8437 1C E3 1D 00          DB $1C,$E3,$1D,0,$1E,0,$1F,0
 687  843B 1E 00 1F 00
 688  843F              AccelFillRegsEnd:
 689  843F
 690  843F              AccelBlitRegs:
 691  843F 02 00                DB $02,$00
 692  8441 0C 40 0D 01          DB $0C,$40,$0D,$01         ; source pitch = 320
 693  8445 0E 40 0F 01          DB $0E,$40,$0F,$01         ; destination pitch = 320
 694  8449 10 14 11 00          DB $10,20,$11,0,$12,20,$13,0
 694  844D 12 14 13 00
 695  8451 14 8C 15 00          DB $14,140,$15,0,$16,20,$17,0
 695  8455 16 14 17 00
 696  8459 18 64 19 00          DB $18,100,$19,0,$1A,60,$1B,0
 696  845D 1A 3C 1B 00
 697  8461              AccelBlitRegsEnd:
 698  8461
 699  8461              AccelLineRegs:
 700  8461 02 00                DB $02,$00
 701  8463 0E 40 0F 01          DB $0E,$40,$0F,$01         ; destination pitch = 320
 702  8467 14 00 15 00          DB $14,0,$15,0,$16,0,$17,0
 702  846B 16 00 17 00
 703  846F 1C FF 1D 00          DB $1C,$FF,$1D,0,$1E,0,$1F,0
 703  8473 1E 00 1F 00
 704  8477 20 3F 21 01          DB $20,63,$21,1,$22,199,$23,0 ; endpoint (319,199)
 704  847B 22 C7 23 00
 705  847F              AccelLineRegsEnd:
 706  847F
 707  847F              AccelTestFailed:
 708  847F 21 63 8F             LD      HL,Msg2DFail
 709  8482 CD 8D 89             CALL    DebugPrint
 710  8485              AccelTestFailedIdle:
 711  8485 76                   HALT
 712  8486 18 FD                JR      AccelTestFailedIdle
 713  8488
 714  8488              ; Re-apply the currently selected packed-pixel 8-bpp resolution.
 715  8488              ConfigureCurrentMode:
 716  8488 3A A6 89             LD      A,(ModeXLo)
 717  848B 5F                   LD      E,A
 718  848C 3E 00                LD      A,0
 719  848E CD A7 80             CALL    WriteVgaRegister
 720  8491 3A A7 89             LD      A,(ModeXHi)
 721  8494 5F                   LD      E,A
 722  8495 3E 01                LD      A,1
 723  8497 CD A7 80             CALL    WriteVgaRegister
 724  849A 3A A8 89             LD      A,(ModeYLo)
 725  849D 5F                   LD      E,A
 726  849E 3E 02                LD      A,2
 727  84A0 CD A7 80             CALL    WriteVgaRegister
 728  84A3 3A A9 89             LD      A,(ModeYHi)
 729  84A6 5F                   LD      E,A
 730  84A7 3E 03                LD      A,3
 731  84A9 CD A7 80             CALL    WriteVgaRegister
 732  84AC 3E 08                LD      A,8
 733  84AE 5F                   LD      E,A
 734  84AF 3E 04                LD      A,4
 735  84B1 CD A7 80             CALL    WriteVgaRegister
 736  84B4 3E 01                LD      A,1
 737  84B6 5F                   LD      E,A
 738  84B7 3E 05                LD      A,5
 739  84B9 CD A7 80             CALL    WriteVgaRegister
 740  84BC C9                   RET
 741  84BD
 742  84BD              ; Palette table entry: count (word), index mask (byte), DAC source stride
 743  84BD              ; beyond RGB (word). The RGB332 source table contains 256 evenly ordered
 744  84BD              ; entries, so each smaller palette samples the full colour range.
 745  84BD              SelectPaletteParameters:
 746  84BD 21 22 8A             LD      HL,PaletteConfigTable
 747  84C0 3A AE 89             LD      A,(PaletteLevel)
 748  84C3 B7                   OR      A
 749  84C4 28 07                JR      Z,PaletteConfigFound
 750  84C6 47                   LD      B,A
 751  84C7              PaletteConfigSkip:
 752  84C7 11 05 00             LD      DE,5
 753  84CA 19                   ADD     HL,DE
 754  84CB 10 FA                DJNZ    PaletteConfigSkip
 755  84CD              PaletteConfigFound:
 756  84CD 7E                   LD      A,(HL)
 757  84CE 23                   INC     HL
 758  84CF 32 B0 89             LD      (PaletteRemaining),A
 759  84D2 32 B2 89             LD      (PaletteCount),A
 760  84D5 7E                   LD      A,(HL)
 761  84D6 23                   INC     HL
 762  84D7 32 B1 89             LD      (PaletteRemaining+1),A
 763  84DA 32 B3 89             LD      (PaletteCount+1),A
 764  84DD 7E                   LD      A,(HL)
 765  84DE 23                   INC     HL
 766  84DF 32 AF 89             LD      (PaletteMask),A
 767  84E2 7E                   LD      A,(HL)
 768  84E3 23                   INC     HL
 769  84E4 32 B4 89             LD      (PaletteStride),A
 770  84E7 7E                   LD      A,(HL)
 771  84E8 32 B5 89             LD      (PaletteStride+1),A
 772  84EB C9                   RET
 773  84EC
 774  84EC              ; Program the selected number of DAC entries sampled from the 256-step HSV hue ramp.
 775  84EC              ProgramDacPalette:
 776  84EC 21 37 96             LD      HL,DacHuePalette
 777  84EF ED 5B B4 89          LD      DE,(PaletteStride)
 778  84F3 AF                   XOR     A
 779  84F4 32 9C 89             LD      (DacIndex),A
 780  84F7              ProgramDacPaletteLoop:
 781  84F7 3A 9C 89             LD      A,(DacIndex)
 782  84FA 01 C8 03             LD      BC,$03C8
 783  84FD ED 79                OUT     (C),A
 784  84FF 01 C9 03             LD      BC,$03C9
 785  8502 7E                   LD      A,(HL)
 786  8503 23                   INC     HL
 787  8504 ED 79                OUT     (C),A
 788  8506 7E                   LD      A,(HL)
 789  8507 23                   INC     HL
 790  8508 ED 79                OUT     (C),A
 791  850A 7E                   LD      A,(HL)
 792  850B 23                   INC     HL
 793  850C ED 79                OUT     (C),A
 794  850E 19                   ADD     HL,DE
 795  850F 3A 9C 89             LD      A,(DacIndex)
 796  8512 3C                   INC     A
 797  8513 32 9C 89             LD      (DacIndex),A
 798  8516 E5                   PUSH    HL
 799  8517 CD 1E 85             CALL    DecPaletteRemaining
 800  851A E1                   POP     HL
 801  851B 20 DA                JR      NZ,ProgramDacPaletteLoop
 802  851D C9                   RET
 803  851E
 804  851E              DecPaletteRemaining:
 805  851E 2A B0 89             LD      HL,(PaletteRemaining)
 806  8521 2B                   DEC     HL
 807  8522 22 B0 89             LD      (PaletteRemaining),HL
 808  8525 7C                   LD      A,H
 809  8526 B5                   OR      L
 810  8527 C9                   RET
 811  8528
 812  8528              ; Fill the framebuffer with a full-width horizontal hue gradient.
 813  8528              ; Palette entries are sampled evenly from the first to last hue.
 814  8528              ; A 16-bit accumulator spreads palette transitions uniformly across each row.
 815  8528              FillModeVRAM:
 816  8528 AF                   XOR     A
 817  8529 32 95 89             LD      (CurrentBank),A
 818  852C 32 9C 89             LD      (DacIndex),A
 819  852F 21 00 00             LD      HL,0
 820  8532 22 B6 89             LD      (GradientAccumulator),HL
 821  8535 22 B8 89             LD      (ModeXCounter),HL
 822  8538              ModeFillBank:
 823  8538 3A 95 89             LD      A,(CurrentBank)
 824  853B 01 DF 03             LD      BC,$03DF
 825  853E ED 79                OUT     (C),A
 826  8540 21 00 C0             LD      HL,$C000
 827  8543 3A 95 89             LD      A,(CurrentBank)
 828  8546 47                   LD      B,A
 829  8547 3A AB 89             LD      A,(ModeBankCount)
 830  854A 3D                   DEC     A
 831  854B B8                   CP      B
 832  854C 20 06                JR      NZ,ModeFillFullBank
 833  854E ED 4B AC 89          LD      BC,(ModeLastBankBytes)
 834  8552 18 03                JR      ModeFillCountReady
 835  8554              ModeFillFullBank:
 836  8554 01 00 40             LD      BC,$4000
 837  8557              ModeFillCountReady:
 838  8557              ModeFillByte:
 839  8557 3A 9C 89             LD      A,(DacIndex)
 840  855A 77                   LD      (HL),A
 841  855B 23                   INC     HL
 842  855C E5                   PUSH    HL
 843  855D
 844  855D                      ; Advance the X coordinate and detect the end of the scanline.
 845  855D 2A B8 89             LD      HL,(ModeXCounter)
 846  8560 23                   INC     HL
 847  8561 22 B8 89             LD      (ModeXCounter),HL
 848  8564 E5                   PUSH    HL
 849  8565 3A A6 89             LD      A,(ModeXLo)
 850  8568 5F                   LD      E,A
 851  8569 3A A7 89             LD      A,(ModeXHi)
 852  856C 57                   LD      D,A
 853  856D B7                   OR      A
 854  856E ED 52                SBC     HL,DE
 855  8570 E1                   POP     HL
 856  8571 20 0F                JR      NZ,ModeGradientAdvance
 857  8573
 858  8573                      ; Restart the gradient at the beginning of every scanline.
 859  8573 21 00 00             LD      HL,0
 860  8576 22 B8 89             LD      (ModeXCounter),HL
 861  8579 22 B6 89             LD      (GradientAccumulator),HL
 862  857C AF                   XOR     A
 863  857D 32 9C 89             LD      (DacIndex),A
 864  8580 18 21                JR      ModePatternAdvanceDone
 865  8582
 866  8582              ModeGradientAdvance:
 867  8582                      ; Bresenham-style distribution: add palette count per pixel and
 868  8582                      ; advance the DAC index whenever the accumulator reaches width.
 869  8582 2A B6 89             LD      HL,(GradientAccumulator)
 870  8585 ED 5B B2 89          LD      DE,(PaletteCount)
 871  8589 19                   ADD     HL,DE
 872  858A ED 5B A6 89          LD      DE,(ModeXLo)
 873  858E B7                   OR      A
 874  858F ED 52                SBC     HL,DE
 875  8591 38 0C                JR      C,ModeGradientHold
 876  8593 22 B6 89             LD      (GradientAccumulator),HL
 877  8596 3A 9C 89             LD      A,(DacIndex)
 878  8599 3C                   INC     A
 879  859A 32 9C 89             LD      (DacIndex),A
 880  859D 18 04                JR      ModePatternAdvanceDone
 881  859F              ModeGradientHold:
 882  859F 19                   ADD     HL,DE
 883  85A0 22 B6 89             LD      (GradientAccumulator),HL
 884  85A3
 885  85A3              ModePatternAdvanceDone:
 886  85A3 E1                   POP     HL
 887  85A4 0B                   DEC     BC
 888  85A5 78                   LD      A,B
 889  85A6 B1                   OR      C
 890  85A7 C2 57 85             JP      NZ,ModeFillByte
 891  85AA 3A 95 89             LD      A,(CurrentBank)
 892  85AD 3C                   INC     A
 893  85AE 32 95 89             LD      (CurrentBank),A
 894  85B1 47                   LD      B,A
 895  85B2 3A AB 89             LD      A,(ModeBankCount)
 896  85B5 B8                   CP      B
 897  85B6 C2 38 85             JP      NZ,ModeFillBank
 898  85B9 C9                   RET
 899  85BA
 900  85BA              ; Read back every programmed DAC entry, including all RGB components.
 901  85BA              ; Return A=0 on success, A=1 on mismatch.
 902  85BA              VerifyDacPalette:
 903  85BA 21 37 96             LD      HL,DacHuePalette
 904  85BD ED 5B B4 89          LD      DE,(PaletteStride)
 905  85C1 AF                   XOR     A
 906  85C2 32 9C 89             LD      (DacIndex),A
 907  85C5              VerifyDacPaletteLoop:
 908  85C5 3A 9C 89             LD      A,(DacIndex)
 909  85C8 01 C7 03             LD      BC,$03C7
 910  85CB ED 79                OUT     (C),A
 911  85CD 01 C9 03             LD      BC,$03C9
 912  85D0 ED 78                IN      A,(C)
 913  85D2 BE                   CP      (HL)
 914  85D3 20 1E                JR      NZ,VerifyDacPaletteFailed
 915  85D5 23                   INC     HL
 916  85D6 ED 78                IN      A,(C)
 917  85D8 BE                   CP      (HL)
 918  85D9 20 18                JR      NZ,VerifyDacPaletteFailed
 919  85DB 23                   INC     HL
 920  85DC ED 78                IN      A,(C)
 921  85DE BE                   CP      (HL)
 922  85DF 20 12                JR      NZ,VerifyDacPaletteFailed
 923  85E1 23                   INC     HL
 924  85E2 19                   ADD     HL,DE
 925  85E3 3A 9C 89             LD      A,(DacIndex)
 926  85E6 3C                   INC     A
 927  85E7 32 9C 89             LD      (DacIndex),A
 928  85EA E5                   PUSH    HL
 929  85EB CD 1E 85             CALL    DecPaletteRemaining
 930  85EE E1                   POP     HL
 931  85EF 20 D4                JR      NZ,VerifyDacPaletteLoop
 932  85F1 AF                   XOR     A
 933  85F2 C9                   RET
 934  85F3              VerifyDacPaletteFailed:
 935  85F3 3E 01                LD      A,1
 936  85F5 C9                   RET
 937  85F6
 938  85F6              RunDac256Test:
 939  85F6 21 C6 91             LD      HL,MsgDacStart
 940  85F9 CD 8D 89             CALL    DebugPrint
 941  85FC CD 92 87             CALL    SpectrumShowDacStart
 942  85FF 3E 00                LD      A,0
 943  8601 1E 40                LD      E,64
 944  8603 CD A7 80             CALL    WriteVgaRegister
 945  8606 3E 01                LD      A,1
 946  8608 1E 01                LD      E,1
 947  860A CD A7 80             CALL    WriteVgaRegister
 948  860D 3E 02                LD      A,2
 949  860F 1E C8                LD      E,200
 950  8611 CD A7 80             CALL    WriteVgaRegister
 951  8614 3E 03                LD      A,3
 952  8616 1E 00                LD      E,0
 953  8618 CD A7 80             CALL    WriteVgaRegister
 954  861B 3E 04                LD      A,4
 955  861D 1E 08                LD      E,8
 956  861F CD A7 80             CALL    WriteVgaRegister
 957  8622 3E 05                LD      A,5
 958  8624 1E 01                LD      E,1
 959  8626 CD A7 80             CALL    WriteVgaRegister
 960  8629 CD 79 86             CALL    ProgramDac332
 961  862C
 962  862C                      ; DAC writes use ports 3C8h/3C9h. In the Project131 adapter model,
 963  862C                      ; writes to legacy VGA ports clear vbe_enabled. Re-apply the packed
 964  862C                      ; 320x200x8 mode AFTER programming the DAC, before touching VRAM.
 965  862C 3E 00                LD      A,0
 966  862E 1E 40                LD      E,64
 967  8630 CD A7 80             CALL    WriteVgaRegister
 968  8633 3E 01                LD      A,1
 969  8635 1E 01                LD      E,1
 970  8637 CD A7 80             CALL    WriteVgaRegister
 971  863A 3E 02                LD      A,2
 972  863C 1E C8                LD      E,200
 973  863E CD A7 80             CALL    WriteVgaRegister
 974  8641 3E 03                LD      A,3
 975  8643 1E 00                LD      E,0
 976  8645 CD A7 80             CALL    WriteVgaRegister
 977  8648 3E 04                LD      A,4
 978  864A 1E 08                LD      E,8
 979  864C CD A7 80             CALL    WriteVgaRegister
 980  864F 3E 05                LD      A,5
 981  8651 1E 01                LD      E,1
 982  8653 CD A7 80             CALL    WriteVgaRegister
 983  8656
