 927  85D4              ; HL points to register/value pairs; A is the byte count.
 928  85D4              WriteAccelRegisterTable:
 929  85D4 32 C8 8B             LD      (AccelPairCount),A
 930  85D7              WriteAccelRegisterTableLoop:
 931  85D7 7E                   LD      A,(HL)
 932  85D8 23                   INC     HL
 933  85D9 5E                   LD      E,(HL)
 934  85DA 23                   INC     HL
 935  85DB E5                   PUSH    HL
