 93   807A              ; -------------------------------------------------------------------------
 94   807A              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
 95   807A              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
 96   807A              ; -------------------------------------------------------------------------
 97   807A              OpenATMShadowPorts:
 98   807A 01 8A 80             LD      BC,ShadowPortsOpened
 99   807D C5                   PUSH    BC
100   807E 01 53 2A             LD      BC,$2A53
101   8081 C5                   PUSH    BC
102   8082 01 77 01             LD      BC,$0177
103   8085 3E C3                LD      A,$C3
104   8087 C3 2F 3D             JP      $3D2F
105   808A              ShadowPortsOpened:
106   808A C9                   RET
107   808B
108   808B              ; A = indexed VGA register, E = value.
109   808B              WriteVgaRegister:
110   808B 01 E0 03             LD      BC,$03E0
111   808E ED 79                OUT     (C),A
112   8090 7B                   LD      A,E
113   8091 0C                   INC     C
114   8092 ED 79                OUT     (C),A
115   8094 C9                   RET
116   8095
117   8095              ; -------------------------------------------------------------------------
118   8095              ; Fill the 640x480x16 framebuffer.
119   8095              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
120   8095              ; The aperture C000h-FFFFh is switched with port 3DFh.
121   8095              ; -------------------------------------------------------------------------
122   8095              Fill640x480x16:
123   8095 AF                   XOR     A
124   8096 32 52 82             LD      (CurrentBank),A
125   8099
126   8099              FillBankLoop:
127   8099 3A 52 82             LD      A,(CurrentBank)
128   809C 01 DF 03             LD      BC,$03DF
129   809F ED 79                OUT     (C),A
130   80A1
131   80A1 21 00 C0             LD      HL,$C000
132   80A4 11 AC 82             LD      DE,ColorPattern
133   80A7 3A 52 82             LD      A,(CurrentBank)
134   80AA FE 25                CP      37
135   80AC 28 05                JR      Z,FillLastHalfBank
136   80AE 01 00 40             LD      BC,$4000
137   80B1 18 03                JR      FillBankBytes
138   80B3
139   80B3              FillLastHalfBank:
140   80B3 01 00 20             LD      BC,$2000
141   80B6
142   80B6              FillBankBytes:
143   80B6 1A                   LD      A,(DE)
144   80B7 13                   INC     DE
145   80B8 77                   LD      (HL),A
146   80B9 23                   INC     HL
147   80BA
148   80BA                      ; Repeat the 128-byte RGB565 colour-bar sequence.
149   80BA F5                   PUSH    AF
150   80BB 7A                   LD      A,D
151   80BC FE 83                CP      HIGH ColorPatternEnd
152   80BE 20 08                JR      NZ,PatternPointerReady
153   80C0 7B                   LD      A,E
154   80C1 FE 2C                CP      LOW ColorPatternEnd
155   80C3 20 03                JR      NZ,PatternPointerReady
156   80C5 11 AC 82             LD      DE,ColorPattern
157   80C8              PatternPointerReady:
158   80C8 F1                   POP     AF
159   80C9
160   80C9 0B                   DEC     BC
161   80CA 78                   LD      A,B
162   80CB B1                   OR      C
163   80CC 20 E8                JR      NZ,FillBankBytes
164   80CE
165   80CE 3A 52 82             LD      A,(CurrentBank)
166   80D1 3C                   INC     A
167   80D2 32 52 82             LD      (CurrentBank),A
168   80D5 FE 26                CP      38
169   80D7 20 C0                JR      NZ,FillBankLoop
170   80D9 C9                   RET
