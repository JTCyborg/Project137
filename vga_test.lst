# file opened: vga_test.asm
   1  0000              ; =========================================================================
   2  0000              ; PROJECT137 — ATM TURBO 2+ EXTERNAL VGA ADAPTER STANDARD MODE TEST
   3  0000              ; Based on the proven ATM startup/ROM trampoline from Project112.
   4  0000              ; Target adapter: Project131 ISA VGA/SVGA software interface.
   5  0000              ;
   6  0000              ; Test:
   7  0000              ;   - unlock ATM shadow ports through TR-DOS ROM
   8  0000              ;   - enable VGA software mode + 16 KiB aperture
   9  0000              ;   - program 640x480 RGB565 through 3E0h/3E1h
  10  0000              ;   - fill 614400 bytes of linear VRAM through 38 aperture banks
  11  0000              ;   - read back bytes from bank 0 and the last framebuffer bank
  12  0000              ;   - report results on port EF (spectrum_out.txt)
  13  0000              ;
  14  0000              ; Expected image: eight-colour RGB565 vertical bars.
  15  0000              ; =========================================================================
  16  0000
  17  0000                      DEVICE ZXSPECTRUM128
  18  0000                      EMPTYTRD "vga_test.TRD"
  19  0000
  20  0000                      ORG     $8000
  21  8000
  22  8000              VgaTestEntry:
  23  8000 F3                   DI
  24  8001 31 FF BF             LD      SP,$BFFF
  25  8004
  26  8004 21 50 8D             LD      HL,MsgBuild
  27  8007 CD 10 89             CALL    DebugPrint
  28  800A 21 67 8D             LD      HL,MsgStart
  29  800D CD 10 89             CALL    DebugPrint
  30  8010
  31  8010 CD 96 80             CALL    OpenATMShadowPorts
  32  8013
  33  8013                      ; Select standard Spectrum screen page 5 before drawing status text.
  34  8013 AF                   XOR     A
  35  8014 01 FD 7F             LD      BC,$7FFD
  36  8017 ED 79                OUT     (C),A
  37  8019 CD 33 88             CALL    SpectrumShowStartup
  38  801C 21 86 90             LD      HL,ScreenShadowReady
  39  801F CD 43 88             CALL    SpectrumShowStatus
  40  8022
  41  8022 21 8D 8D             LD      HL,MsgAdapterInit
  42  8025 CD 10 89             CALL    DebugPrint
  43  8028
  44  8028                      ; Enable the adapter before running any engine tests.
  45  8028                      ; 3DEh: software mode = 1, aperture enable = 1, bank 0.
  46  8028 01 DE 03             LD      BC,$03DE
  47  802B 3E 03                LD      A,$03
  48  802D ED 79                OUT     (C),A
  49  802F
  50  802F                      ; Run 2D engine tests first, before framebuffer and palette sweeps.
  51  802F CD C6 82             CALL    Run2DAcceleratorTest
  52  8032 B7                   OR      A
  53  8033 C2 02 84             JP      NZ,AccelTestFailed
  54  8036
  55  8036 CD 52 88             CALL    SpectrumShowInitialMode
  56  8039
  57  8039                      ; Configure packed-pixel 640x480 RGB565:
  58  8039                      ; XRES = 0280h, YRES = 01E0h, BPP = 16, ENABLE = 1.
  59  8039 3E 00                LD      A,0
  60  803B 1E 80                LD      E,$80
  61  803D CD A7 80             CALL    WriteVgaRegister
  62  8040 3E 01                LD      A,1
  63  8042 1E 02                LD      E,$02
  64  8044 CD A7 80             CALL    WriteVgaRegister
  65  8047 3E 02                LD      A,2
  66  8049 1E E0                LD      E,$E0
  67  804B CD A7 80             CALL    WriteVgaRegister
  68  804E 3E 03                LD      A,3
  69  8050 1E 01                LD      E,$01
  70  8052 CD A7 80             CALL    WriteVgaRegister
  71  8055 3E 04                LD      A,4
  72  8057 1E 10                LD      E,16
  73  8059 CD A7 80             CALL    WriteVgaRegister
  74  805C 3E 05                LD      A,5
  75  805E 1E 01                LD      E,1
  76  8060 CD A7 80             CALL    WriteVgaRegister
  77  8063
  78  8063 21 A4 8D             LD      HL,MsgModeSet
  79  8066 CD 10 89             CALL    DebugPrint
  80  8069
  81  8069 CD B1 80             CALL    Fill640x480x16
  82  806C
  83  806C 21 BE 8D             LD      HL,MsgFrameWritten
  84  806F CD 10 89             CALL    DebugPrint
  85  8072 CD 6E 88             CALL    SpectrumShowInitialWriteComplete
  86  8075
  87  8075 CD F6 80             CALL    VerifyFramebuffer
  88  8078 B7                   OR      A
  89  8079 20 12                JR      NZ,VgaTestFailed
  90  807B
  91  807B 21 DA 8D             LD      HL,MsgReadbackPass
  92  807E CD 10 89             CALL    DebugPrint
  93  8081
  94  8081                      ; Palette/resolution matrix is deliberately the final test group.
  95  8081 CD 29 81             CALL    RunPackedModeSweep
  96  8084
  97  8084 21 04 8E             LD      HL,MsgReady
  98  8087 CD 10 89             CALL    DebugPrint
  99  808A
 100  808A              VgaTestIdle:
 101  808A 76                   HALT
 102  808B 18 FD                JR      VgaTestIdle
 103  808D
 104  808D              VgaTestFailed:
 105  808D 21 EF 8D             LD      HL,MsgReadbackFail
 106  8090 CD 10 89             CALL    DebugPrint
 107  8093              VgaTestFailedIdle:
 108  8093 76                   HALT
 109  8094 18 FD                JR      VgaTestFailedIdle
 110  8096
 111  8096              ; -------------------------------------------------------------------------
 112  8096              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
 113  8096              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
 114  8096              ; -------------------------------------------------------------------------
 115  8096              OpenATMShadowPorts:
 116  8096 01 A6 80             LD      BC,ShadowPortsOpened
 117  8099 C5                   PUSH    BC
 118  809A 01 53 2A             LD      BC,$2A53
 119  809D C5                   PUSH    BC
 120  809E 01 77 01             LD      BC,$0177
 121  80A1 3E C3                LD      A,$C3
 122  80A3 C3 2F 3D             JP      $3D2F
 123  80A6              ShadowPortsOpened:
 124  80A6 C9                   RET
 125  80A7
 126  80A7              ; A = indexed VGA register, E = value.
 127  80A7              WriteVgaRegister:
 128  80A7 01 E0 03             LD      BC,$03E0
 129  80AA ED 79                OUT     (C),A
 130  80AC 7B                   LD      A,E
 131  80AD 0C                   INC     C
 132  80AE ED 79                OUT     (C),A
 133  80B0 C9                   RET
 134  80B1
 135  80B1              ; -------------------------------------------------------------------------
 136  80B1              ; Fill the 640x480x16 framebuffer.
 137  80B1              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
 138  80B1              ; The aperture C000h-FFFFh is switched with port 3DFh.
 139  80B1              ; -------------------------------------------------------------------------
 140  80B1              Fill640x480x16:
 141  80B1 AF                   XOR     A
 142  80B2 32 18 89             LD      (CurrentBank),A
 143  80B5
 144  80B5              FillBankLoop:
 145  80B5 3A 18 89             LD      A,(CurrentBank)
 146  80B8 01 DF 03             LD      BC,$03DF
 147  80BB ED 79                OUT     (C),A
 148  80BD
 149  80BD 21 00 C0             LD      HL,$C000
 150  80C0 11 D0 8C             LD      DE,ColorPattern
 151  80C3 3A 18 89             LD      A,(CurrentBank)
 152  80C6 FE 25                CP      37
 153  80C8 28 05                JR      Z,FillLastHalfBank
 154  80CA 01 00 40             LD      BC,$4000
 155  80CD 18 03                JR      FillBankBytes
 156  80CF
 157  80CF              FillLastHalfBank:
 158  80CF 01 00 20             LD      BC,$2000
 159  80D2
 160  80D2              FillBankBytes:
 161  80D2 1A                   LD      A,(DE)
 162  80D3 13                   INC     DE
 163  80D4 77                   LD      (HL),A
 164  80D5 23                   INC     HL
 165  80D6
 166  80D6                      ; Repeat the 128-byte RGB565 colour-bar sequence.
 167  80D6 F5                   PUSH    AF
 168  80D7 7A                   LD      A,D
 169  80D8 FE 8D                CP      HIGH ColorPatternEnd
 170  80DA 20 08                JR      NZ,PatternPointerReady
 171  80DC 7B                   LD      A,E
 172  80DD FE 50                CP      LOW ColorPatternEnd
 173  80DF 20 03                JR      NZ,PatternPointerReady
 174  80E1 11 D0 8C             LD      DE,ColorPattern
 175  80E4              PatternPointerReady:
 176  80E4 F1                   POP     AF
 177  80E5
 178  80E5 0B                   DEC     BC
 179  80E6 78                   LD      A,B
 180  80E7 B1                   OR      C
 181  80E8 20 E8                JR      NZ,FillBankBytes
 182  80EA
 183  80EA 3A 18 89             LD      A,(CurrentBank)
 184  80ED 3C                   INC     A
 185  80EE 32 18 89             LD      (CurrentBank),A
 186  80F1 FE 26                CP      38
 187  80F3 20 C0                JR      NZ,FillBankLoop
 188  80F5 C9                   RET
 189  80F6
 190  80F6              ; -------------------------------------------------------------------------
 191  80F6              ; Readback checks:
 192  80F6              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
 193  80F6              ; bank 37 starts at linear offset 37*4000h = 5E000h.
 194  80F6              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
 195  80F6              ; Return A=0 on success, A=1 on mismatch.
 196  80F6              ; -------------------------------------------------------------------------
 197  80F6              VerifyFramebuffer:
 198  80F6 AF                   XOR     A
 199  80F7 01 DF 03             LD      BC,$03DF
 200  80FA ED 79                OUT     (C),A
 201  80FC
 202  80FC 21 00 C0             LD      HL,$C000
 203  80FF                      ; First eight pixels are black: bytes 0..15 must be zero.
 204  80FF 7E                   LD      A,(HL)
 205  8100 B7                   OR      A
 206  8101 20 23                JR      NZ,VerifyFailed
 207  8103 23                   INC     HL
 208  8104 7E                   LD      A,(HL)
 209  8105 B7                   OR      A
 210  8106 20 1E                JR      NZ,VerifyFailed
 211  8108
 212  8108                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
 213  8108 21 10 C0             LD      HL,$C010
 214  810B 7E                   LD      A,(HL)
 215  810C FE 1F                CP      $1F
 216  810E 20 16                JR      NZ,VerifyFailed
 217  8110 23                   INC     HL
 218  8111 7E                   LD      A,(HL)
 219  8112 B7                   OR      A
 220  8113 20 11                JR      NZ,VerifyFailed
 221  8115
 222  8115 3E 25                LD      A,37
 223  8117 01 DF 03             LD      BC,$03DF
 224  811A ED 79                OUT     (C),A
 225  811C 21 FF DF             LD      HL,$DFFF
 226  811F 7E                   LD      A,(HL)
 227  8120 FE FF                CP      $FF
 228  8122 20 02                JR      NZ,VerifyFailed
 229  8124
 230  8124 AF                   XOR     A
 231  8125 C9                   RET
 232  8126
 233  8126              VerifyFailed:
 234  8126 3E 01                LD      A,1
 235  8128 C9                   RET
 236  8129
 237  8129
 238  8129              ; -------------------------------------------------------------------------
 239  8129              ; Sweep the nine requested standard PC display resolutions.
 240  8129              ; Each mode uses 8-bpp indexed pixels and writes exactly its visible
 241  8129              ; framebuffer size. Use only the adapter's initialized EGA palette
 242  8129              ; entries 0..7, matching the proven Project132 test pattern.
 243  8129              ; SPACE advances to the next resolution.
 244  8129              ; -------------------------------------------------------------------------
 245  8129              RunPackedModeSweep:
 246  8129 21 2B 8E             LD      HL,MsgSweepStart
 247  812C CD 10 89             CALL    DebugPrint
 248  812F 21 5D 89             LD      HL,PackedModeTable
 249  8132 22 26 89             LD      (ModeTablePtr),HL
 250  8135 21 B9 89             LD      HL,ModeLabelTable
 251  8138 22 1D 89             LD      (ModeLabelPtr),HL
 252  813B 3E 09                LD      A,9
 253  813D 32 28 89             LD      (ModeCount),A
 254  8140
 255  8140              ; Outer loop: increase resolution only after all four palette sizes pass.
 256  8140              PackedModeNext:
 257  8140 2A 26 89             LD      HL,(ModeTablePtr)
 258  8143 7E                   LD      A,(HL)
 259  8144 23                   INC     HL
 260  8145 32 29 89             LD      (ModeXLo),A
 261  8148 7E                   LD      A,(HL)
 262  8149 23                   INC     HL
 263  814A 32 2A 89             LD      (ModeXHi),A
 264  814D 7E                   LD      A,(HL)
 265  814E 23                   INC     HL
 266  814F 32 2B 89             LD      (ModeYLo),A
 267  8152 7E                   LD      A,(HL)
 268  8153 23                   INC     HL
 269  8154 32 2C 89             LD      (ModeYHi),A
 270  8157 7E                   LD      A,(HL)
 271  8158 23                   INC     HL
 272  8159 32 2D 89             LD      (ModeBpp),A
 273  815C 7E                   LD      A,(HL)
 274  815D 23                   INC     HL
 275  815E 32 2E 89             LD      (ModeBankCount),A
 276  8161 7E                   LD      A,(HL)
 277  8162 23                   INC     HL
 278  8163 32 2F 89             LD      (ModeLastBankBytes),A
 279  8166 7E                   LD      A,(HL)
 280  8167 23                   INC     HL
 281  8168 32 30 89             LD      (ModeLastBankBytes+1),A
 282  816B 22 26 89             LD      (ModeTablePtr),HL
 283  816E
 284  816E CD 0B 84             CALL    ConfigureCurrentMode
 285  8171 CD 8A 88             CALL    SpectrumShowMode
 286  8174
 287  8174 AF                   XOR     A
 288  8175 32 31 89             LD      (PaletteLevel),A
 289  8178
 290  8178              ; Inner loop: 2, 4, 16 and 256 DAC entries at this resolution.
 291  8178              PackedPaletteNext:
 292  8178 CD 40 84             CALL    SelectPaletteParameters
 293  817B CD 6F 84             CALL    ProgramDacPalette
 294  817E
 295  817E                      ; Legacy DAC writes disable VBE in the adapter model.
 296  817E                      ; Re-apply this resolution's indexed 8-bpp mode before VRAM access.
 297  817E CD 0B 84             CALL    ConfigureCurrentMode
 298  8181
 299  8181 21 9A 8F             LD      HL,MsgPaletteLevel
 300  8184 CD 10 89             CALL    DebugPrint
 301  8187 3A 31 89             LD      A,(PaletteLevel)
 302  818A CD F6 88             CALL    DebugHexByte
 303  818D 21 A9 8F             LD      HL,MsgPaletteSuffix
 304  8190 CD 10 89             CALL    DebugPrint
 305  8193
 306  8193                      ; Verify the DAC before touching the framebuffer. This keeps all
 307  8193                      ; DAC read-index/component activity out of the post-render phase.
 308  8193 CD 40 84             CALL    SelectPaletteParameters
 309  8196 CD 3D 85             CALL    VerifyDacPalette
 310  8199 B7                   OR      A
 311  819A 20 3A                JR      NZ,PackedPaletteFailed
 312  819C
 313  819C CD AB 84             CALL    FillModeVRAM
 314  819F
 315  819F 21 C8 8F             LD      HL,MsgPalettePass
 316  81A2 CD 10 89             CALL    DebugPrint
 317  81A5 CD B6 88             CALL    SpectrumShowWriteComplete
 318  81A8 CD E6 88             CALL    WaitSpace
 319  81AB
 320  81AB 3A 31 89             LD      A,(PaletteLevel)
 321  81AE 3C                   INC     A
 322  81AF 32 31 89             LD      (PaletteLevel),A
 323  81B2 FE 04                CP      4
 324  81B4 20 C2                JR      NZ,PackedPaletteNext
 325  81B6
 326  81B6 3A 28 89             LD      A,(ModeCount)
 327  81B9 3D                   DEC     A
 328  81BA 32 28 89             LD      (ModeCount),A
 329  81BD C2 40 81             JP      NZ,PackedModeNext
 330  81C0
 331  81C0 21 74 8E             LD      HL,MsgSweepDone
 332  81C3 CD 10 89             CALL    DebugPrint
 333  81C6 CD 11 88             CALL    SpectrumClear
 334  81C9 21 4F 90             LD      HL,ScreenTitle
 335  81CC CD 5D 87             CALL    SpectrumPrint
 336  81CF 21 8E 91             LD      HL,ScreenAllDone
 337  81D2 CD 5D 87             CALL    SpectrumPrint
 338  81D5 C9                   RET
 339  81D6
 340  81D6              PackedPaletteFailed:
 341  81D6 21 DC 8F             LD      HL,MsgPaletteFail
 342  81D9 CD 10 89             CALL    DebugPrint
 343  81DC CD 47 87             CALL    SpectrumShowDacFail
 344  81DF CD E6 88             CALL    WaitSpace
 345  81E2 C9                   RET
 346  81E3
 347  81E3              ; Initialize only the entries used by the 2D smoke test.
 348  81E3              ; DAC components are six-bit values. Index 01 = blue, E3 = orange, FF = white.
 349  81E3              Program2DTestPalette:
 350  81E3 01 C8 03             LD      BC,$03C8
 351  81E6 AF                   XOR     A
 352  81E7 ED 79                OUT     (C),A
 353  81E9 01 C9 03             LD      BC,$03C9
 354  81EC AF                   XOR     A
 355  81ED ED 79                OUT     (C),A
 356  81EF ED 79                OUT     (C),A
 357  81F1 ED 79                OUT     (C),A
 358  81F3
 359  81F3 01 C8 03             LD      BC,$03C8
 360  81F6 3E 01                LD      A,1
 361  81F8 ED 79                OUT     (C),A
 362  81FA 01 C9 03             LD      BC,$03C9
 363  81FD 3E 00                LD      A,$00
 364  81FF ED 79                OUT     (C),A
 365  8201 3E 00                LD      A,$00
 366  8203 ED 79                OUT     (C),A
 367  8205 3E 3F                LD      A,$3F
 368  8207 ED 79                OUT     (C),A
 369  8209
 370  8209 01 C8 03             LD      BC,$03C8
 371  820C 3E E3                LD      A,$E3
 372  820E ED 79                OUT     (C),A
 373  8210 01 C9 03             LD      BC,$03C9
 374  8213 3E 3F                LD      A,$3F
 375  8215 ED 79                OUT     (C),A
 376  8217 3E 20                LD      A,$20
 377  8219 ED 79                OUT     (C),A
 378  821B AF                   XOR     A
 379  821C ED 79                OUT     (C),A
 380  821E
 381  821E 01 C8 03             LD      BC,$03C8
 382  8221 3E FF                LD      A,$FF
 383  8223 ED 79                OUT     (C),A
 384  8225 01 C9 03             LD      BC,$03C9
 385  8228 3E 3F                LD      A,$3F
 386  822A ED 79                OUT     (C),A
 387  822C ED 79                OUT     (C),A
 388  822E ED 79                OUT     (C),A
 389  8230 C9                   RET
 390  8231
 391  8231              ; -------------------------------------------------------------------------
 392  8231              ; 2D gradient test. One dedicated accelerator command (CMD=4) interpolates
 393  8231              ; the 8-bpp palette index from 00h to FFh across a 320x200 rectangle.
 394  8231              ; No CPU framebuffer writes and no per-column command loop are used.
 395  8231              ; Returns A=0 on success, A=1 on accelerator/readback failure.
 396  8231              ; -------------------------------------------------------------------------
 397  8231              Run2DGradientTest:
 398  8231 21 20 8F             LD      HL,Msg2DGradientStart
 399  8234 CD 10 89             CALL    DebugPrint
 400  8237 CD A7 86             CALL    SpectrumShow2DGradientStart
 401  823A
 402  823A 3E 03                LD      A,3
 403  823C 32 31 89             LD      (PaletteLevel),A
 404  823F CD 40 84             CALL    SelectPaletteParameters
 405  8242 CD 6F 84             CALL    ProgramDacPalette
 406  8245 CD 0B 84             CALL    ConfigureCurrentMode
 407  8248
 408  8248 21 98 82             LD      HL,AccelGradientRegs
 409  824B 3E 2E                LD      A,AccelGradientRegsEnd-AccelGradientRegs
 410  824D CD 68 83             CALL    WriteAccelRegisterTable
 411  8250
 412  8250                      ; CMD 4: interpolate colour 00h -> FFh across 320 pixels.
 413  8250 3E 00                LD      A,0
 414  8252 1E 04                LD      E,4
 415  8254 CD 7F 83             CALL    WriteAccelRegister
 416  8257 CD 89 83             CALL    CheckAccelDone
 417  825A B7                   OR      A
 418  825B C2 89 82             JP      NZ,Run2DGradientFailed
 419  825E
 420  825E                      ; Read back first, midpoint (x=160 -> 80h), and last pixel.
 421  825E AF                   XOR     A
 422  825F 01 DF 03             LD      BC,$03DF
 423  8262 ED 79                OUT     (C),A
 424  8264 21 00 C0             LD      HL,$C000
 425  8267 7E                   LD      A,(HL)
 426  8268 B7                   OR      A
 427  8269 20 1E                JR      NZ,Run2DGradientReadbackFailed
 428  826B 21 A0 C0             LD      HL,$C0A0
 429  826E 7E                   LD      A,(HL)
 430  826F FE 80                CP      $80
 431  8271 20 16                JR      NZ,Run2DGradientReadbackFailed
 432  8273 21 3F C1             LD      HL,$C13F
 433  8276 7E                   LD      A,(HL)
 434  8277 FE FF                CP      $FF
 435  8279 20 0E                JR      NZ,Run2DGradientReadbackFailed
 436  827B
 437  827B 21 46 8F             LD      HL,Msg2DGradientPass
 438  827E CD 10 89             CALL    DebugPrint
 439  8281 CD BD 86             CALL    SpectrumShow2DGradientPass
 440  8284 CD E6 88             CALL    WaitSpace
 441  8287 AF                   XOR     A
 442  8288 C9                   RET
 443  8289
 444  8289              Run2DGradientReadbackFailed:
 445  8289              Run2DGradientFailed:
 446  8289 21 76 8F             LD      HL,Msg2DGradientFail
 447  828C CD 10 89             CALL    DebugPrint
 448  828F CD D3 86             CALL    SpectrumShow2DGradientFail
 449  8292 CD E6 88             CALL    WaitSpace
 450  8295 3E 01                LD      A,1
 451  8297 C9                   RET
 452  8298
 453  8298              AccelGradientRegs:
 454  8298 02 00                DB $02,$00
 455  829A 08 00 09 00          DB $08,$00,$09,$00,$0A,$00,$0B,$00 ; destination base = 0
 455  829E 0A 00 0B 00
 456  82A2 0E 40 0F 01          DB $0E,$40,$0F,$01                 ; destination pitch = 320
 457  82A6 14 00 15 00          DB $14,$00,$15,$00                 ; x = 0
 458  82AA 16 00 17 00          DB $16,$00,$17,$00                 ; y = 0
 459  82AE 18 40 19 01          DB $18,$40,$19,$01                 ; width = 320
 460  82B2 1A C8 1B 00          DB $1A,$C8,$1B,$00                 ; height = 200
 461  82B6 1C 00 1D 00          DB $1C,$00,$1D,$00,$1E,$00,$1F,$00 ; start colour = 00000000h
 461  82BA 1E 00 1F 00
 462  82BE 20 FF 21 00          DB $20,$FF,$21,$00,$22,$00,$23,$00 ; end colour = 000000FFh
 462  82C2 22 00 23 00
 463  82C6              AccelGradientRegsEnd:
 464  82C6
 465  82C6              ; -------------------------------------------------------------------------
 466  82C6              ; Project131-compatible 2D accelerator smoke test.
 467  82C6              ; Uses 320x200x8bpp so the complete 64,000-byte framebuffer is in banks 0..3.
 468  82C6              ; Tests solid fill, VRAM-to-VRAM BitBLT, Bresenham line and status/readback.
 469  82C6              ; Returns A=0 on success, A=1 on failure.
 470  82C6              ; -------------------------------------------------------------------------
 471  82C6              Run2DAcceleratorTest:
 472  82C6 21 98 8E             LD      HL,Msg2DStart
 473  82C9 CD 10 89             CALL    DebugPrint
 474  82CC CD 91 86             CALL    SpectrumShow2DStart
 475  82CF
 476  82CF                      ; The adapter powers up with a zeroed DAC. Program visible colours
 477  82CF                      ; before the first 8-bpp test, then restore VBE mode (DAC writes
 478  82CF                      ; switch the adapter to legacy software mode).
 479  82CF CD E3 81             CALL    Program2DTestPalette
 480  82D2
 481  82D2                      ; Select 320x200x8bpp.
 482  82D2 3E 40                LD      A,320&255
 483  82D4 32 29 89             LD      (ModeXLo),A
 484  82D7 3E 01                LD      A,320>>8
 485  82D9 32 2A 89             LD      (ModeXHi),A
 486  82DC 3E C8                LD      A,200&255
 487  82DE 32 2B 89             LD      (ModeYLo),A
 488  82E1 AF                   XOR     A
 489  82E2 32 2C 89             LD      (ModeYHi),A
 490  82E5 CD 0B 84             CALL    ConfigureCurrentMode
 491  82E8
 492  82E8                      ; SOLID FILL: destination (20,20), 100x60, colour E3h.
 493  82E8 21 9C 83             LD      HL,AccelFillRegs
 494  82EB 3E 26                LD      A,AccelFillRegsEnd-AccelFillRegs
 495  82ED CD 68 83             CALL    WriteAccelRegisterTable
 496  82F0 3E 00                LD      A,0
 497  82F2 1E 01                LD      E,1
 498  82F4 CD 7F 83             CALL    WriteAccelRegister
 499  82F7 CD 89 83             CALL    CheckAccelDone
 500  82FA B7                   OR      A
 501  82FB C0                   RET     NZ
 502  82FC
 503  82FC                      ; BITBLT: copy the filled rectangle to (140,20).
 504  82FC 21 C2 83             LD      HL,AccelBlitRegs
 505  82FF 3E 22                LD      A,AccelBlitRegsEnd-AccelBlitRegs
 506  8301 CD 68 83             CALL    WriteAccelRegisterTable
 507  8304 3E 00                LD      A,0
 508  8306 1E 02                LD      E,2
 509  8308 CD 7F 83             CALL    WriteAccelRegister
 510  830B CD 89 83             CALL    CheckAccelDone
 511  830E B7                   OR      A
 512  830F C0                   RET     NZ
 513  8310
 514  8310                      ; LINE: draw from (0,0) to (319,199), colour FFh.
 515  8310 21 E4 83             LD      HL,AccelLineRegs
 516  8313 3E 1E                LD      A,AccelLineRegsEnd-AccelLineRegs
 517  8315 CD 68 83             CALL    WriteAccelRegisterTable
 518  8318 3E 00                LD      A,0
