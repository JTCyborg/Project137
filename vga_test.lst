 104  808F              ; -------------------------------------------------------------------------
 105  808F              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
 106  808F              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
 107  808F              ; -------------------------------------------------------------------------
 108  808F              OpenATMShadowPorts:
 109  808F 01 9F 80             LD      BC,ShadowPortsOpened
 110  8092 C5                   PUSH    BC
 111  8093 01 53 2A             LD      BC,$2A53
 112  8096 C5                   PUSH    BC
 113  8097 01 77 01             LD      BC,$0177
 114  809A 3E C3                LD      A,$C3
 115  809C C3 2F 3D             JP      $3D2F
 116  809F              ShadowPortsOpened:
 117  809F C9                   RET
 118  80A0
 119  80A0              ; A = indexed VGA register, E = value.
 120  80A0              WriteVgaRegister:
 121  80A0 01 E0 03             LD      BC,$03E0
 122  80A3 ED 79                OUT     (C),A
 123  80A5 7B                   LD      A,E
 124  80A6 0C                   INC     C
 125  80A7 ED 79                OUT     (C),A
 126  80A9 C9                   RET
 127  80AA
 128  80AA              ; -------------------------------------------------------------------------
 129  80AA              ; Fill the 640x480x16 framebuffer.
 130  80AA              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
 131  80AA              ; The aperture C000h-FFFFh is switched with port 3DFh.
 132  80AA              ; -------------------------------------------------------------------------
 133  80AA              Fill640x480x16:
 134  80AA AF                   XOR     A
 135  80AB 32 18 86             LD      (CurrentBank),A
 136  80AE
 137  80AE              FillBankLoop:
 138  80AE 3A 18 86             LD      A,(CurrentBank)
 139  80B1 01 DF 03             LD      BC,$03DF
 140  80B4 ED 79                OUT     (C),A
 141  80B6
 142  80B6 21 00 C0             LD      HL,$C000
 143  80B9 11 C6 89             LD      DE,ColorPattern
 144  80BC 3A 18 86             LD      A,(CurrentBank)
 145  80BF FE 25                CP      37
 146  80C1 28 05                JR      Z,FillLastHalfBank
 147  80C3 01 00 40             LD      BC,$4000
 148  80C6 18 03                JR      FillBankBytes
 149  80C8
 150  80C8              FillLastHalfBank:
 151  80C8 01 00 20             LD      BC,$2000
 152  80CB
 153  80CB              FillBankBytes:
 154  80CB 1A                   LD      A,(DE)
 155  80CC 13                   INC     DE
 156  80CD 77                   LD      (HL),A
 157  80CE 23                   INC     HL
 158  80CF
 159  80CF                      ; Repeat the 128-byte RGB565 colour-bar sequence.
 160  80CF F5                   PUSH    AF
 161  80D0 7A                   LD      A,D
 162  80D1 FE 8A                CP      HIGH ColorPatternEnd
 163  80D3 20 08                JR      NZ,PatternPointerReady
 164  80D5 7B                   LD      A,E
 165  80D6 FE 46                CP      LOW ColorPatternEnd
 166  80D8 20 03                JR      NZ,PatternPointerReady
 167  80DA 11 C6 89             LD      DE,ColorPattern
 168  80DD              PatternPointerReady:
 169  80DD F1                   POP     AF
 170  80DE
 171  80DE 0B                   DEC     BC
 172  80DF 78                   LD      A,B
 173  80E0 B1                   OR      C
 174  80E1 20 E8                JR      NZ,FillBankBytes
 175  80E3
 176  80E3 3A 18 86             LD      A,(CurrentBank)
 177  80E6 3C                   INC     A
 178  80E7 32 18 86             LD      (CurrentBank),A
 179  80EA FE 26                CP      38
 180  80EC 20 C0                JR      NZ,FillBankLoop
 181  80EE C9                   RET
 182  80EF
 183  80EF              ; -------------------------------------------------------------------------
 184  80EF              ; Readback checks:
 185  80EF              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
 186  80EF              ; bank 37 starts at linear offset 37*4000h = 5E000h.
 187  80EF              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
 188  80EF              ; Return A=0 on success, A=1 on mismatch.
 189  80EF              ; -------------------------------------------------------------------------
 190  80EF              VerifyFramebuffer:
 191  80EF AF                   XOR     A
 192  80F0 01 DF 03             LD      BC,$03DF
 193  80F3 ED 79                OUT     (C),A
 194  80F5
 195  80F5 21 00 C0             LD      HL,$C000
 196  80F8                      ; First eight pixels are black: bytes 0..15 must be zero.
 197  80F8 7E                   LD      A,(HL)
 198  80F9 B7                   OR      A
 199  80FA 20 23                JR      NZ,VerifyFailed
 200  80FC 23                   INC     HL
 201  80FD 7E                   LD      A,(HL)
 202  80FE B7                   OR      A
 203  80FF 20 1E                JR      NZ,VerifyFailed
 204  8101
 205  8101                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
 206  8101 21 10 C0             LD      HL,$C010
 207  8104 7E                   LD      A,(HL)
 208  8105 FE 1F                CP      $1F
 209  8107 20 16                JR      NZ,VerifyFailed
 210  8109 23                   INC     HL
 211  810A 7E                   LD      A,(HL)
 212  810B B7                   OR      A
 213  810C 20 11                JR      NZ,VerifyFailed
 214  810E
 215  810E 3E 25                LD      A,37
 216  8110 01 DF 03             LD      BC,$03DF
 217  8113 ED 79                OUT     (C),A
 218  8115 21 FF DF             LD      HL,$DFFF
 219  8118 7E                   LD      A,(HL)
 220  8119 FE FF                CP      $FF
 221  811B 20 02                JR      NZ,VerifyFailed
 222  811D
 223  811D AF                   XOR     A
 224  811E C9                   RET
 225  811F
 226  811F              VerifyFailed:
 227  811F 3E 01                LD      A,1
 228  8121 C9                   RET
 229  8122
 230  8122
 231  8122              ; -------------------------------------------------------------------------
 232  8122              ; Sweep the nine requested standard PC display resolutions.
 233  8122              ; Each mode uses 8-bpp indexed pixels and writes exactly its visible
 234  8122              ; framebuffer size. Use only the adapter's initialized EGA palette
 235  8122              ; entries 0..7, matching the proven Project132 test pattern.
 236  8122              ; SPACE advances to the next resolution.
 237  8122              ; -------------------------------------------------------------------------
 238  8122              RunPackedModeSweep:
 239  8122 21 21 8B             LD      HL,MsgSweepStart
 240  8125 CD 10 86             CALL    DebugPrint
 241  8128 21 53 86             LD      HL,PackedModeTable
 242  812B 22 22 86             LD      (ModeTablePtr),HL
 243  812E 21 AF 86             LD      HL,ModeLabelTable
 244  8131 22 19 86             LD      (ModeLabelPtr),HL
 245  8134 3E 09                LD      A,9
 246  8136 32 24 86             LD      (ModeCount),A
 247  8139
 248  8139              ; Outer loop: increase resolution only after all four palette sizes pass.
 249  8139              PackedModeNext:
 250  8139 2A 22 86             LD      HL,(ModeTablePtr)
 251  813C 7E                   LD      A,(HL)
 252  813D 23                   INC     HL
 253  813E 32 25 86             LD      (ModeXLo),A
 254  8141 7E                   LD      A,(HL)
 255  8142 23                   INC     HL
 256  8143 32 26 86             LD      (ModeXHi),A
 257  8146 7E                   LD      A,(HL)
 258  8147 23                   INC     HL
 259  8148 32 27 86             LD      (ModeYLo),A
 260  814B 7E                   LD      A,(HL)
 261  814C 23                   INC     HL
 262  814D 32 28 86             LD      (ModeYHi),A
 263  8150 7E                   LD      A,(HL)
 264  8151 23                   INC     HL
 265  8152 32 29 86             LD      (ModeBpp),A
 266  8155 7E                   LD      A,(HL)
 267  8156 23                   INC     HL
 268  8157 32 2A 86             LD      (ModeBankCount),A
 269  815A 7E                   LD      A,(HL)
 270  815B 23                   INC     HL
 271  815C 32 2B 86             LD      (ModeLastBankBytes),A
 272  815F 7E                   LD      A,(HL)
 273  8160 23                   INC     HL
 274  8161 32 2C 86             LD      (ModeLastBankBytes+1),A
 275  8164 22 22 86             LD      (ModeTablePtr),HL
 276  8167
 277  8167 CD DC 81             CALL    ConfigureCurrentMode
 278  816A CD 8A 85             CALL    SpectrumShowMode
 279  816D
 280  816D AF                   XOR     A
 281  816E 32 2D 86             LD      (PaletteLevel),A
 282  8171
 283  8171              ; Inner loop: 2, 4, 16 and 256 DAC entries at this resolution.
 284  8171              PackedPaletteNext:
 285  8171 CD 11 82             CALL    SelectPaletteParameters
 286  8174 CD 3A 82             CALL    ProgramDacPalette
 287  8177
 288  8177                      ; Legacy DAC writes disable VBE in the adapter model.
 289  8177                      ; Re-apply this resolution's indexed 8-bpp mode before VRAM access.
 290  8177 CD DC 81             CALL    ConfigureCurrentMode
 291  817A
 292  817A 21 8E 8B             LD      HL,MsgPaletteLevel
 293  817D CD 10 86             CALL    DebugPrint
 294  8180 3A 2D 86             LD      A,(PaletteLevel)
 295  8183 CD F6 85             CALL    DebugHexByte
 296  8186 21 9D 8B             LD      HL,MsgPaletteSuffix
 297  8189 CD 10 86             CALL    DebugPrint
 298  818C
 299  818C CD 76 82             CALL    FillModeVRAM
 300  818F CD 11 82             CALL    SelectPaletteParameters
 301  8192 CD C1 82             CALL    VerifyDacPalette
 302  8195 B7                   OR      A
 303  8196 20 37                JR      NZ,PackedPaletteFailed
 304  8198
 305  8198 21 B4 8B             LD      HL,MsgPalettePass
 306  819B CD 10 86             CALL    DebugPrint
 307  819E CD B6 85             CALL    SpectrumShowWriteComplete
 308  81A1 CD E6 85             CALL    WaitSpace
 309  81A4
 310  81A4 3A 2D 86             LD      A,(PaletteLevel)
 311  81A7 3C                   INC     A
 312  81A8 32 2D 86             LD      (PaletteLevel),A
 313  81AB FE 04                CP      4
 314  81AD 20 C2                JR      NZ,PackedPaletteNext
 315  81AF
 316  81AF 3A 24 86             LD      A,(ModeCount)
 317  81B2 3D                   DEC     A
 318  81B3 32 24 86             LD      (ModeCount),A
 319  81B6 C2 39 81             JP      NZ,PackedModeNext
 320  81B9
 321  81B9 21 6A 8B             LD      HL,MsgSweepDone
 322  81BC CD 10 86             CALL    DebugPrint
 323  81BF CD 11 85             CALL    SpectrumClear
 324  81C2 21 3B 8C             LD      HL,ScreenTitle
 325  81C5 CD 5D 84             CALL    SpectrumPrint
 326  81C8 21 7A 8D             LD      HL,ScreenAllDone
 327  81CB CD 5D 84             CALL    SpectrumPrint
 328  81CE C9                   RET
 329  81CF
 330  81CF              PackedPaletteFailed:
 331  81CF 21 C8 8B             LD      HL,MsgPaletteFail
 332  81D2 CD 10 86             CALL    DebugPrint
 333  81D5 CD 47 84             CALL    SpectrumShowDacFail
 334  81D8 CD E6 85             CALL    WaitSpace
 335  81DB C9                   RET
 336  81DC
 337  81DC              ; Re-apply the currently selected packed-pixel 8-bpp resolution.
 338  81DC              ConfigureCurrentMode:
 339  81DC 3A 25 86             LD      A,(ModeXLo)
 340  81DF 5F                   LD      E,A
 341  81E0 3E 00                LD      A,0
 342  81E2 CD A0 80             CALL    WriteVgaRegister
 343  81E5 3A 26 86             LD      A,(ModeXHi)
 344  81E8 5F                   LD      E,A
 345  81E9 3E 01                LD      A,1
 346  81EB CD A0 80             CALL    WriteVgaRegister
 347  81EE 3A 27 86             LD      A,(ModeYLo)
 348  81F1 5F                   LD      E,A
 349  81F2 3E 02                LD      A,2
 350  81F4 CD A0 80             CALL    WriteVgaRegister
 351  81F7 3A 28 86             LD      A,(ModeYHi)
 352  81FA 5F                   LD      E,A
 353  81FB 3E 03                LD      A,3
 354  81FD CD A0 80             CALL    WriteVgaRegister
 355  8200 3E 08                LD      A,8
 356  8202 5F                   LD      E,A
 357  8203 3E 04                LD      A,4
 358  8205 CD A0 80             CALL    WriteVgaRegister
 359  8208 3E 01                LD      A,1
 360  820A 5F                   LD      E,A
 361  820B 3E 05                LD      A,5
 362  820D CD A0 80             CALL    WriteVgaRegister
 363  8210 C9                   RET
 364  8211
 365  8211              ; Palette table entry: count (word), index mask (byte), DAC source stride
 366  8211              ; beyond RGB (word). The RGB332 source table contains 256 evenly ordered
 367  8211              ; entries, so each smaller palette samples the full colour range.
 368  8211              SelectPaletteParameters:
 369  8211 21 9B 86             LD      HL,PaletteConfigTable
 370  8214 3A 2D 86             LD      A,(PaletteLevel)
 371  8217 B7                   OR      A
 372  8218 28 07                JR      Z,PaletteConfigFound
 373  821A 47                   LD      B,A
 374  821B              PaletteConfigSkip:
 375  821B 11 05 00             LD      DE,5
 376  821E 19                   ADD     HL,DE
 377  821F 10 FA                DJNZ    PaletteConfigSkip
 378  8221              PaletteConfigFound:
 379  8221 7E                   LD      A,(HL)
 380  8222 23                   INC     HL
 381  8223 32 2F 86             LD      (PaletteRemaining),A
 382  8226 7E                   LD      A,(HL)
 383  8227 23                   INC     HL
 384  8228 32 30 86             LD      (PaletteRemaining+1),A
 385  822B 7E                   LD      A,(HL)
 386  822C 23                   INC     HL
 387  822D 32 2E 86             LD      (PaletteMask),A
 388  8230 7E                   LD      A,(HL)
 389  8231 23                   INC     HL
 390  8232 32 31 86             LD      (PaletteStride),A
 391  8235 7E                   LD      A,(HL)
 392  8236 32 32 86             LD      (PaletteStride+1),A
 393  8239 C9                   RET
 394  823A
 395  823A              ; Program the selected number of DAC entries from the full RGB332 ramp.
 396  823A              ProgramDacPalette:
 397  823A 21 83 8E             LD      HL,Dac332Palette
 398  823D ED 5B 31 86          LD      DE,(PaletteStride)
 399  8241 AF                   XOR     A
 400  8242 32 1B 86             LD      (DacIndex),A
 401  8245              ProgramDacPaletteLoop:
 402  8245 3A 1B 86             LD      A,(DacIndex)
 403  8248 01 C8 03             LD      BC,$03C8
 404  824B ED 79                OUT     (C),A
 405  824D 01 C9 03             LD      BC,$03C9
 406  8250 7E                   LD      A,(HL)
 407  8251 23                   INC     HL
 408  8252 ED 79                OUT     (C),A
 409  8254 7E                   LD      A,(HL)
 410  8255 23                   INC     HL
 411  8256 ED 79                OUT     (C),A
 412  8258 7E                   LD      A,(HL)
 413  8259 23                   INC     HL
 414  825A ED 79                OUT     (C),A
 415  825C 19                   ADD     HL,DE
 416  825D 3A 1B 86             LD      A,(DacIndex)
 417  8260 3C                   INC     A
 418  8261 32 1B 86             LD      (DacIndex),A
 419  8264 E5                   PUSH    HL
 420  8265 CD 6C 82             CALL    DecPaletteRemaining
 421  8268 E1                   POP     HL
 422  8269 20 DA                JR      NZ,ProgramDacPaletteLoop
 423  826B C9                   RET
 424  826C
 425  826C              DecPaletteRemaining:
 426  826C 2A 2F 86             LD      HL,(PaletteRemaining)
 427  826F 2B                   DEC     HL
 428  8270 22 2F 86             LD      (PaletteRemaining),HL
 429  8273 7C                   LD      A,H
 430  8274 B5                   OR      L
 431  8275 C9                   RET
 432  8276
 433  8276              ; Fill exactly the active 8-bpp framebuffer. Each byte is one palette
 434  8276              ; index; use only initialized EGA palette entries 0..7.
 435  8276              ; Only banks containing visible pixels are touched.
 436  8276              FillModeVRAM:
 437  8276 AF                   XOR     A
 438  8277 32 18 86             LD      (CurrentBank),A
 439  827A 32 1B 86             LD      (DacIndex),A
 440  827D              ModeFillBank:
 441  827D 3A 18 86             LD      A,(CurrentBank)
 442  8280 01 DF 03             LD      BC,$03DF
 443  8283 ED 79                OUT     (C),A
 444  8285 21 00 C0             LD      HL,$C000
 445  8288 11 33 86             LD      DE,ModePattern8
 446  828B 3A 18 86             LD      A,(CurrentBank)
 447  828E 47                   LD      B,A
 448  828F 3A 2A 86             LD      A,(ModeBankCount)
 449  8292 3D                   DEC     A
 450  8293 B8                   CP      B
 451  8294 20 06                JR      NZ,ModeFillFullBank
 452  8296 ED 4B 2B 86          LD      BC,(ModeLastBankBytes)
 453  829A 18 03                JR      ModeFillCountReady
 454  829C              ModeFillFullBank:
 455  829C 01 00 40             LD      BC,$4000
 456  829F              ModeFillCountReady:
 457  829F              ModeFillByte:
 458  829F 3A 1B 86             LD      A,(DacIndex)
 459  82A2 77                   LD      (HL),A
 460  82A3 23                   INC     HL
 461  82A4 3C                   INC     A
 462  82A5 5F                   LD      E,A
 463  82A6 3A 2E 86             LD      A,(PaletteMask)
 464  82A9 A3                   AND     E
 465  82AA 32 1B 86             LD      (DacIndex),A
 466  82AD 0B                   DEC     BC
 467  82AE 78                   LD      A,B
 468  82AF B1                   OR      C
 469  82B0 20 ED                JR      NZ,ModeFillByte
 470  82B2 3A 18 86             LD      A,(CurrentBank)
 471  82B5 3C                   INC     A
 472  82B6 32 18 86             LD      (CurrentBank),A
 473  82B9 47                   LD      B,A
 474  82BA 3A 2A 86             LD      A,(ModeBankCount)
 475  82BD B8                   CP      B
 476  82BE 20 BD                JR      NZ,ModeFillBank
 477  82C0 C9                   RET
 478  82C1
 479  82C1              ; Read back every programmed DAC entry, including all RGB components.
 480  82C1              ; Return A=0 on success, A=1 on mismatch.
 481  82C1              VerifyDacPalette:
 482  82C1 21 83 8E             LD      HL,Dac332Palette
 483  82C4 ED 5B 31 86          LD      DE,(PaletteStride)
 484  82C8 AF                   XOR     A
 485  82C9 32 1B 86             LD      (DacIndex),A
 486  82CC              VerifyDacPaletteLoop:
 487  82CC 3A 1B 86             LD      A,(DacIndex)
 488  82CF 01 C7 03             LD      BC,$03C7
 489  82D2 ED 79                OUT     (C),A
 490  82D4 01 C9 03             LD      BC,$03C9
 491  82D7 ED 78                IN      A,(C)
 492  82D9 BE                   CP      (HL)
 493  82DA 20 1E                JR      NZ,VerifyDacPaletteFailed
 494  82DC 23                   INC     HL
 495  82DD ED 78                IN      A,(C)
 496  82DF BE                   CP      (HL)
 497  82E0 20 18                JR      NZ,VerifyDacPaletteFailed
 498  82E2 23                   INC     HL
 499  82E3 ED 78                IN      A,(C)
 500  82E5 BE                   CP      (HL)
 501  82E6 20 12                JR      NZ,VerifyDacPaletteFailed
 502  82E8 23                   INC     HL
 503  82E9 19                   ADD     HL,DE
 504  82EA 3A 1B 86             LD      A,(DacIndex)
 505  82ED 3C                   INC     A
 506  82EE 32 1B 86             LD      (DacIndex),A
 507  82F1 E5                   PUSH    HL
 508  82F2 CD 6C 82             CALL    DecPaletteRemaining
 509  82F5 E1                   POP     HL
 510  82F6 20 D4                JR      NZ,VerifyDacPaletteLoop
 511  82F8 AF                   XOR     A
 512  82F9 C9                   RET
 513  82FA              VerifyDacPaletteFailed:
 514  82FA 3E 01                LD      A,1
 515  82FC C9                   RET
