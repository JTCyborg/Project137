 822  8549              ; Draw one zero-terminated ASCII string from SceneTextPtr.
 823  8549              ; Font88_132 stores 8 bytes per glyph for character codes 20h..7Fh.
 824  8549              SceneDrawText:
 825  8549              SceneDrawNextChar:
 826  8549 2A AD 91             LD      HL,(SceneTextPtr)
 827  854C 7E                   LD      A,(HL)
