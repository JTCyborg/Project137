 105  8092              ; -------------------------------------------------------------------------
 106  8092              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
 107  8092              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
 108  8092              ; -------------------------------------------------------------------------
 109  8092              OpenATMShadowPorts:
 110  8092 01 A2 80             LD      BC,ShadowPortsOpened
 111  8095 C5                   PUSH    BC
 112  8096 01 53 2A             LD      BC,$2A53
 113  8099 C5                   PUSH    BC
 114  809A 01 77 01             LD      BC,$0177
 115  809D 3E C3                LD      A,$C3
 116  809F C3 2F 3D             JP      $3D2F
 117  80A2              ShadowPortsOpened:
 118  80A2 C9                   RET
 119  80A3
 120  80A3              ; A = indexed VGA register, E = value.
 121  80A3              WriteVgaRegister:
 122  80A3 01 E0 03             LD      BC,$03E0
 123  80A6 ED 79                OUT     (C),A
 124  80A8 7B                   LD      A,E
 125  80A9 0C                   INC     C
 126  80AA ED 79                OUT     (C),A
 127  80AC C9                   RET
 128  80AD
 129  80AD              ; -------------------------------------------------------------------------
 130  80AD              ; Fill the 640x480x16 framebuffer.
 131  80AD              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
 132  80AD              ; The aperture C000h-FFFFh is switched with port 3DFh.
 133  80AD              ; -------------------------------------------------------------------------
 134  80AD              Fill640x480x16:
 135  80AD AF                   XOR     A
 136  80AE 32 38 85             LD      (CurrentBank),A
 137  80B1
 138  80B1              FillBankLoop:
 139  80B1 3A 38 85             LD      A,(CurrentBank)
 140  80B4 01 DF 03             LD      BC,$03DF
 141  80B7 ED 79                OUT     (C),A
 142  80B9
 143  80B9 21 00 C0             LD      HL,$C000
 144  80BC 11 B2 88             LD      DE,ColorPattern
 145  80BF 3A 38 85             LD      A,(CurrentBank)
 146  80C2 FE 25                CP      37
 147  80C4 28 05                JR      Z,FillLastHalfBank
 148  80C6 01 00 40             LD      BC,$4000
 149  80C9 18 03                JR      FillBankBytes
 150  80CB
 151  80CB              FillLastHalfBank:
 152  80CB 01 00 20             LD      BC,$2000
 153  80CE
 154  80CE              FillBankBytes:
 155  80CE 1A                   LD      A,(DE)
 156  80CF 13                   INC     DE
 157  80D0 77                   LD      (HL),A
 158  80D1 23                   INC     HL
 159  80D2
 160  80D2                      ; Repeat the 128-byte RGB565 colour-bar sequence.
 161  80D2 F5                   PUSH    AF
 162  80D3 7A                   LD      A,D
 163  80D4 FE 89                CP      HIGH ColorPatternEnd
 164  80D6 20 08                JR      NZ,PatternPointerReady
 165  80D8 7B                   LD      A,E
 166  80D9 FE 32                CP      LOW ColorPatternEnd
 167  80DB 20 03                JR      NZ,PatternPointerReady
 168  80DD 11 B2 88             LD      DE,ColorPattern
 169  80E0              PatternPointerReady:
 170  80E0 F1                   POP     AF
 171  80E1
 172  80E1 0B                   DEC     BC
 173  80E2 78                   LD      A,B
 174  80E3 B1                   OR      C
 175  80E4 20 E8                JR      NZ,FillBankBytes
 176  80E6
 177  80E6 3A 38 85             LD      A,(CurrentBank)
 178  80E9 3C                   INC     A
 179  80EA 32 38 85             LD      (CurrentBank),A
 180  80ED FE 26                CP      38
 181  80EF 20 C0                JR      NZ,FillBankLoop
 182  80F1 C9                   RET
 183  80F2
 184  80F2              ; -------------------------------------------------------------------------
 185  80F2              ; Readback checks:
 186  80F2              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
 187  80F2              ; bank 37 starts at linear offset 37*4000h = 5E000h.
 188  80F2              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
 189  80F2              ; Return A=0 on success, A=1 on mismatch.
 190  80F2              ; -------------------------------------------------------------------------
 191  80F2              VerifyFramebuffer:
 192  80F2 AF                   XOR     A
 193  80F3 01 DF 03             LD      BC,$03DF
 194  80F6 ED 79                OUT     (C),A
 195  80F8
 196  80F8 21 00 C0             LD      HL,$C000
 197  80FB                      ; First eight pixels are black: bytes 0..15 must be zero.
 198  80FB 7E                   LD      A,(HL)
 199  80FC B7                   OR      A
 200  80FD 20 23                JR      NZ,VerifyFailed
 201  80FF 23                   INC     HL
 202  8100 7E                   LD      A,(HL)
 203  8101 B7                   OR      A
 204  8102 20 1E                JR      NZ,VerifyFailed
 205  8104
 206  8104                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
 207  8104 21 10 C0             LD      HL,$C010
 208  8107 7E                   LD      A,(HL)
 209  8108 FE 1F                CP      $1F
 210  810A 20 16                JR      NZ,VerifyFailed
 211  810C 23                   INC     HL
 212  810D 7E                   LD      A,(HL)
 213  810E B7                   OR      A
 214  810F 20 11                JR      NZ,VerifyFailed
 215  8111
 216  8111 3E 25                LD      A,37
 217  8113 01 DF 03             LD      BC,$03DF
 218  8116 ED 79                OUT     (C),A
 219  8118 21 FF DF             LD      HL,$DFFF
 220  811B 7E                   LD      A,(HL)
 221  811C FE FF                CP      $FF
 222  811E 20 02                JR      NZ,VerifyFailed
 223  8120
 224  8120 AF                   XOR     A
 225  8121 C9                   RET
 226  8122
 227  8122              VerifyFailed:
 228  8122 3E 01                LD      A,1
 229  8124 C9                   RET
