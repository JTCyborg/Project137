 965  8648              ; Restore the standard 16-colour VGA/EGA DAC palette (6-bit RGB).
 966  8648              ; This keeps the text-mode colour test independent of the preceding
 967  8648              ; programmable 256-entry gradient test.
 968  8648              ProgramStandardEgaPalette:
 969  8648 01 C8 03             LD      BC,$03C8
 970  864B AF                   XOR     A
 971  864C ED 79                OUT     (C),A
 972  864E 01 C9 03             LD      BC,$03C9
 973  8651 21 5E 86             LD      HL,StandardEgaPalette
 974  8654 16 30                LD      D,48
 975  8656              StandardEgaPaletteWrite:
 976  8656 7E                   LD      A,(HL)
 977  8657 ED 79                OUT     (C),A
 978  8659 23                   INC     HL
 979  865A 15                   DEC     D
 980  865B 20 F9                JR      NZ,StandardEgaPaletteWrite
 981  865D C9                   RET
 982  865E
 983  865E              StandardEgaPalette:
 984  865E                      ; RGB triples, DAC range 00h..3Fh.
 985  865E 00 00 00 00          DB $00,$00,$00, $00,$00,$2A, $00,$2A,$00, $00,$2A,$2A
 985  8662 00 2A 00 2A
 985  8666 00 00 2A 2A
 986  866A 2A 00 00 2A          DB $2A,$00,$00, $2A,$00,$2A, $2A,$15,$00, $2A,$2A,$2A
