180   80DA AF                   XOR     A
181   80DB 01 DF 03             LD      BC,$03DF
182   80DE ED 79                OUT     (C),A
183   80E0
184   80E0 21 00 C0             LD      HL,$C000
185   80E3                      ; First eight pixels are black: bytes 0..15 must be zero.
186   80E3 7E                   LD      A,(HL)
187   80E4 B7                   OR      A
188   80E5 20 23                JR      NZ,VerifyFailed
189   80E7 23                   INC     HL
190   80E8 7E                   LD      A,(HL)
191   80E9 B7                   OR      A
192   80EA 20 1E                JR      NZ,VerifyFailed
193   80EC
194   80EC                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
195   80EC 21 10 C0             LD      HL,$C010
196   80EF 7E                   LD      A,(HL)
197   80F0 FE 1F                CP      $1F
198   80F2 20 16                JR      NZ,VerifyFailed
199   80F4 23                   INC     HL
200   80F5 7E                   LD      A,(HL)
201   80F6 B7                   OR      A
202   80F7 20 11                JR      NZ,VerifyFailed
203   80F9
