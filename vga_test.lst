 973  862F C9                   RET
 974  8630
 975  8630              ; A = accelerator register index, E = value.
 976  8630              WriteAccelRegister:
 977  8630 01 E2 03             LD      BC,$03E2
 978  8633 ED 79                OUT     (C),A
 979  8635 7B                   LD      A,E
