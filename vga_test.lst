 956  8632              ; Restore the standard 16-colour VGA/EGA DAC palette (6-bit RGB).
 957  8632              ; This keeps the text-mode colour test independent of the preceding
 958  8632              ; programmable 256-entry gradient test.
 959  8632              ProgramStandardEgaPalette:
 960  8632 01 C8 03             LD      BC,$03C8
 961  8635 AF                   XOR     A
 962  8636 ED 79                OUT     (C),A
 963  8638 01 C9 03             LD      BC,$03C9
