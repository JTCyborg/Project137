 829  854E C8                   RET     Z
 830  854F 23                   INC     HL
 831  8550 22 AD 91             LD      (SceneTextPtr),HL
 832  8553 D6 20                SUB     32
 833  8555 6F                   LD      L,A
 834  8556 26 00                LD      H,0
 835  8558 29                   ADD     HL,HL
 836  8559 29                   ADD     HL,HL
 837  855A 29                   ADD     HL,HL
 838  855B 11 E5 A4             LD      DE,Font88_132
 839  855E 19                   ADD     HL,DE
 840  855F 22 AF 91             LD      (SceneGlyphPtr),HL
 841  8562 AF                   XOR     A
 842  8563 32 B5 91             LD      (SceneGlyphRow),A
 843  8566 3A B2 91             LD      A,(SceneTextY)
 844  8569 32 B7 91             LD      (SceneRowY),A
