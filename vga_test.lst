 999  864D              ; Register tables: index,value pairs. All addresses are byte offsets in VRAM.
1000  864D              AccelFillRegs:
1001  864D 02 00                DB $02,$00                 ; ROP COPY
1002  864F 08 00 09 00          DB $08,$00,$09,$00,$0A,$00,$0B,$00 ; destination base = 0
1002  8653 0A 00 0B 00
1003  8657 0E 40 0F 01          DB $0E,$40,$0F,$01         ; destination pitch = 320
