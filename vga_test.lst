# file opened: vga_test.asm
   1  0000              ; =========================================================================
   2  0000              ; PROJECT137 — ATM TURBO 2+ EXTERNAL VGA ADAPTER STANDARD MODE TEST
   3  0000              ; Based on the proven ATM startup/ROM trampoline from Project112.
   4  0000              ; Target adapter: Project131 ISA VGA/SVGA software interface.
   5  0000              ;
   6  0000              ; Test:
   7  0000              ;   - unlock ATM shadow ports through TR-DOS ROM
   8  0000              ;   - enable VGA software mode + 16 KiB aperture
   9  0000              ;   - program 640x480 RGB565 through 3E0h/3E1h
  10  0000              ;   - fill 614400 bytes of linear VRAM through 38 aperture banks
  11  0000              ;   - read back bytes from bank 0 and the last framebuffer bank
  12  0000              ;   - report results on port EF (spectrum_out.txt)
  13  0000              ;
  14  0000              ; Expected image: eight-colour RGB565 vertical bars.
  15  0000              ; =========================================================================
  16  0000
  17  0000                      DEVICE ZXSPECTRUM128
  18  0000                      EMPTYTRD "vga_test.TRD"
  19  0000
  20  0000                      ORG     $8000
  21  8000
  22  8000              VgaTestEntry:
  23  8000 F3                   DI
  24  8001 31 FF BF             LD      SP,$BFFF
  25  8004
  26  8004 21 9E 8A             LD      HL,MsgBuild
  27  8007 CD 65 86             CALL    DebugPrint
  28  800A 21 B5 8A             LD      HL,MsgStart
  29  800D CD 65 86             CALL    DebugPrint
  30  8010
  31  8010 CD 8F 80             CALL    OpenATMShadowPorts
  32  8013
  33  8013                      ; Select standard Spectrum screen page 5 before drawing status text.
  34  8013 AF                   XOR     A
  35  8014 01 FD 7F             LD      BC,$7FFD
  36  8017 ED 79                OUT     (C),A
  37  8019 CD 88 85             CALL    SpectrumShowStartup
  38  801C 21 D5 8C             LD      HL,ScreenShadowReady
  39  801F CD 98 85             CALL    SpectrumShowStatus
  40  8022
  41  8022 21 DB 8A             LD      HL,MsgAdapterInit
  42  8025 CD 65 86             CALL    DebugPrint
  43  8028
  44  8028 CD A7 85             CALL    SpectrumShowInitialMode
  45  802B
  46  802B                      ; 3DEh: software mode = 1, aperture enable = 1, bank 0.
  47  802B 01 DE 03             LD      BC,$03DE
  48  802E 3E 03                LD      A,$03
  49  8030 ED 79                OUT     (C),A
  50  8032
  51  8032                      ; Configure packed-pixel 640x480 RGB565:
  52  8032                      ; XRES = 0280h, YRES = 01E0h, BPP = 16, ENABLE = 1.
  53  8032 3E 00                LD      A,0
  54  8034 1E 80                LD      E,$80
  55  8036 CD A0 80             CALL    WriteVgaRegister
  56  8039 3E 01                LD      A,1
  57  803B 1E 02                LD      E,$02
  58  803D CD A0 80             CALL    WriteVgaRegister
  59  8040 3E 02                LD      A,2
  60  8042 1E E0                LD      E,$E0
  61  8044 CD A0 80             CALL    WriteVgaRegister
  62  8047 3E 03                LD      A,3
  63  8049 1E 01                LD      E,$01
  64  804B CD A0 80             CALL    WriteVgaRegister
  65  804E 3E 04                LD      A,4
  66  8050 1E 10                LD      E,16
  67  8052 CD A0 80             CALL    WriteVgaRegister
  68  8055 3E 05                LD      A,5
  69  8057 1E 01                LD      E,1
  70  8059 CD A0 80             CALL    WriteVgaRegister
  71  805C
  72  805C 21 F2 8A             LD      HL,MsgModeSet
  73  805F CD 65 86             CALL    DebugPrint
  74  8062
  75  8062 CD AA 80             CALL    Fill640x480x16
  76  8065
  77  8065 21 0C 8B             LD      HL,MsgFrameWritten
  78  8068 CD 65 86             CALL    DebugPrint
  79  806B CD C3 85             CALL    SpectrumShowInitialWriteComplete
  80  806E
  81  806E CD EF 80             CALL    VerifyFramebuffer
  82  8071 B7                   OR      A
  83  8072 20 12                JR      NZ,VgaTestFailed
  84  8074
  85  8074 21 28 8B             LD      HL,MsgReadbackPass
  86  8077 CD 65 86             CALL    DebugPrint
  87  807A
  88  807A CD 22 81             CALL    RunPackedModeSweep
  89  807D
  90  807D 21 52 8B             LD      HL,MsgReady
  91  8080 CD 65 86             CALL    DebugPrint
  92  8083
  93  8083              VgaTestIdle:
  94  8083 76                   HALT
  95  8084 18 FD                JR      VgaTestIdle
  96  8086
  97  8086              VgaTestFailed:
  98  8086 21 3D 8B             LD      HL,MsgReadbackFail
  99  8089 CD 65 86             CALL    DebugPrint
 100  808C              VgaTestFailedIdle:
 101  808C 76                   HALT
 102  808D 18 FD                JR      VgaTestFailedIdle
 103  808F
 104  808F              ; -------------------------------------------------------------------------
 105  808F              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
 106  808F              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
 107  808F              ; -------------------------------------------------------------------------
 108  808F              OpenATMShadowPorts:
 109  808F 01 9F 80             LD      BC,ShadowPortsOpened
 110  8092 C5                   PUSH    BC
 111  8093 01 53 2A             LD      BC,$2A53
 112  8096 C5                   PUSH    BC
 113  8097 01 77 01             LD      BC,$0177
 114  809A 3E C3                LD      A,$C3
 115  809C C3 2F 3D             JP      $3D2F
 116  809F              ShadowPortsOpened:
 117  809F C9                   RET
 118  80A0
 119  80A0              ; A = indexed VGA register, E = value.
 120  80A0              WriteVgaRegister:
 121  80A0 01 E0 03             LD      BC,$03E0
 122  80A3 ED 79                OUT     (C),A
 123  80A5 7B                   LD      A,E
 124  80A6 0C                   INC     C
 125  80A7 ED 79                OUT     (C),A
 126  80A9 C9                   RET
 127  80AA
 128  80AA              ; -------------------------------------------------------------------------
 129  80AA              ; Fill the 640x480x16 framebuffer.
 130  80AA              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
 131  80AA              ; The aperture C000h-FFFFh is switched with port 3DFh.
 132  80AA              ; -------------------------------------------------------------------------
 133  80AA              Fill640x480x16:
 134  80AA AF                   XOR     A
 135  80AB 32 6D 86             LD      (CurrentBank),A
 136  80AE
 137  80AE              FillBankLoop:
 138  80AE 3A 6D 86             LD      A,(CurrentBank)
 139  80B1 01 DF 03             LD      BC,$03DF
 140  80B4 ED 79                OUT     (C),A
 141  80B6
 142  80B6 21 00 C0             LD      HL,$C000
 143  80B9 11 1E 8A             LD      DE,ColorPattern
 144  80BC 3A 6D 86             LD      A,(CurrentBank)
 145  80BF FE 25                CP      37
 146  80C1 28 05                JR      Z,FillLastHalfBank
 147  80C3 01 00 40             LD      BC,$4000
 148  80C6 18 03                JR      FillBankBytes
 149  80C8
 150  80C8              FillLastHalfBank:
 151  80C8 01 00 20             LD      BC,$2000
 152  80CB
 153  80CB              FillBankBytes:
 154  80CB 1A                   LD      A,(DE)
 155  80CC 13                   INC     DE
 156  80CD 77                   LD      (HL),A
 157  80CE 23                   INC     HL
 158  80CF
 159  80CF                      ; Repeat the 128-byte RGB565 colour-bar sequence.
 160  80CF F5                   PUSH    AF
 161  80D0 7A                   LD      A,D
 162  80D1 FE 8A                CP      HIGH ColorPatternEnd
 163  80D3 20 08                JR      NZ,PatternPointerReady
 164  80D5 7B                   LD      A,E
 165  80D6 FE 9E                CP      LOW ColorPatternEnd
 166  80D8 20 03                JR      NZ,PatternPointerReady
 167  80DA 11 1E 8A             LD      DE,ColorPattern
 168  80DD              PatternPointerReady:
 169  80DD F1                   POP     AF
 170  80DE
 171  80DE 0B                   DEC     BC
 172  80DF 78                   LD      A,B
 173  80E0 B1                   OR      C
 174  80E1 20 E8                JR      NZ,FillBankBytes
 175  80E3
 176  80E3 3A 6D 86             LD      A,(CurrentBank)
 177  80E6 3C                   INC     A
 178  80E7 32 6D 86             LD      (CurrentBank),A
 179  80EA FE 26                CP      38
 180  80EC 20 C0                JR      NZ,FillBankLoop
 181  80EE C9                   RET
 182  80EF
 183  80EF              ; -------------------------------------------------------------------------
 184  80EF              ; Readback checks:
 185  80EF              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
 186  80EF              ; bank 37 starts at linear offset 37*4000h = 5E000h.
 187  80EF              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
 188  80EF              ; Return A=0 on success, A=1 on mismatch.
 189  80EF              ; -------------------------------------------------------------------------
 190  80EF              VerifyFramebuffer:
 191  80EF AF                   XOR     A
 192  80F0 01 DF 03             LD      BC,$03DF
 193  80F3 ED 79                OUT     (C),A
 194  80F5
 195  80F5 21 00 C0             LD      HL,$C000
 196  80F8                      ; First eight pixels are black: bytes 0..15 must be zero.
 197  80F8 7E                   LD      A,(HL)
 198  80F9 B7                   OR      A
 199  80FA 20 23                JR      NZ,VerifyFailed
 200  80FC 23                   INC     HL
 201  80FD 7E                   LD      A,(HL)
 202  80FE B7                   OR      A
 203  80FF 20 1E                JR      NZ,VerifyFailed
 204  8101
 205  8101                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
 206  8101 21 10 C0             LD      HL,$C010
 207  8104 7E                   LD      A,(HL)
 208  8105 FE 1F                CP      $1F
 209  8107 20 16                JR      NZ,VerifyFailed
 210  8109 23                   INC     HL
 211  810A 7E                   LD      A,(HL)
 212  810B B7                   OR      A
 213  810C 20 11                JR      NZ,VerifyFailed
 214  810E
 215  810E 3E 25                LD      A,37
 216  8110 01 DF 03             LD      BC,$03DF
 217  8113 ED 79                OUT     (C),A
 218  8115 21 FF DF             LD      HL,$DFFF
 219  8118 7E                   LD      A,(HL)
 220  8119 FE FF                CP      $FF
 221  811B 20 02                JR      NZ,VerifyFailed
 222  811D
 223  811D AF                   XOR     A
 224  811E C9                   RET
 225  811F
 226  811F              VerifyFailed:
 227  811F 3E 01                LD      A,1
 228  8121 C9                   RET
 229  8122
 230  8122
 231  8122              ; -------------------------------------------------------------------------
 232  8122              ; Sweep the nine requested standard PC display resolutions.
 233  8122              ; Each mode uses 8-bpp indexed pixels and writes exactly its visible
 234  8122              ; framebuffer size. Use only the adapter's initialized EGA palette
 235  8122              ; entries 0..7, matching the proven Project132 test pattern.
 236  8122              ; SPACE advances to the next resolution.
 237  8122              ; -------------------------------------------------------------------------
 238  8122              RunPackedModeSweep:
 239  8122 21 79 8B             LD      HL,MsgSweepStart
 240  8125 CD 65 86             CALL    DebugPrint
 241  8128 21 AB 86             LD      HL,PackedModeTable
 242  812B 22 77 86             LD      (ModeTablePtr),HL
 243  812E 21 07 87             LD      HL,ModeLabelTable
 244  8131 22 6E 86             LD      (ModeLabelPtr),HL
 245  8134 3E 09                LD      A,9
 246  8136 32 79 86             LD      (ModeCount),A
 247  8139
 248  8139              ; Outer loop: increase resolution only after all four palette sizes pass.
 249  8139              PackedModeNext:
 250  8139 2A 77 86             LD      HL,(ModeTablePtr)
 251  813C 7E                   LD      A,(HL)
 252  813D 23                   INC     HL
 253  813E 32 7A 86             LD      (ModeXLo),A
 254  8141 7E                   LD      A,(HL)
 255  8142 23                   INC     HL
 256  8143 32 7B 86             LD      (ModeXHi),A
 257  8146 7E                   LD      A,(HL)
 258  8147 23                   INC     HL
 259  8148 32 7C 86             LD      (ModeYLo),A
 260  814B 7E                   LD      A,(HL)
 261  814C 23                   INC     HL
 262  814D 32 7D 86             LD      (ModeYHi),A
 263  8150 7E                   LD      A,(HL)
 264  8151 23                   INC     HL
 265  8152 32 7E 86             LD      (ModeBpp),A
 266  8155 7E                   LD      A,(HL)
 267  8156 23                   INC     HL
 268  8157 32 7F 86             LD      (ModeBankCount),A
 269  815A 7E                   LD      A,(HL)
 270  815B 23                   INC     HL
 271  815C 32 80 86             LD      (ModeLastBankBytes),A
 272  815F 7E                   LD      A,(HL)
 273  8160 23                   INC     HL
 274  8161 32 81 86             LD      (ModeLastBankBytes+1),A
 275  8164 22 77 86             LD      (ModeTablePtr),HL
 276  8167
 277  8167 CD DC 81             CALL    ConfigureCurrentMode
 278  816A CD DF 85             CALL    SpectrumShowMode
 279  816D
 280  816D AF                   XOR     A
 281  816E 32 82 86             LD      (PaletteLevel),A
 282  8171
 283  8171              ; Inner loop: 2, 4, 16 and 256 DAC entries at this resolution.
 284  8171              PackedPaletteNext:
 285  8171 CD 11 82             CALL    SelectPaletteParameters
 286  8174 CD 3A 82             CALL    ProgramDacPalette
 287  8177
 288  8177                      ; Legacy DAC writes disable VBE in the adapter model.
 289  8177                      ; Re-apply this resolution's indexed 8-bpp mode before VRAM access.
 290  8177 CD DC 81             CALL    ConfigureCurrentMode
 291  817A
 292  817A 21 E6 8B             LD      HL,MsgPaletteLevel
 293  817D CD 65 86             CALL    DebugPrint
 294  8180 3A 82 86             LD      A,(PaletteLevel)
 295  8183 CD 4B 86             CALL    DebugHexByte
 296  8186 21 F5 8B             LD      HL,MsgPaletteSuffix
 297  8189 CD 65 86             CALL    DebugPrint
 298  818C
 299  818C                      ; Verify the DAC before touching the framebuffer. This keeps all
 300  818C                      ; DAC read-index/component activity out of the post-render phase.
 301  818C CD 11 82             CALL    SelectPaletteParameters
 302  818F CD 16 83             CALL    VerifyDacPalette
 303  8192 B7                   OR      A
 304  8193 20 3A                JR      NZ,PackedPaletteFailed
 305  8195
 306  8195 CD 76 82             CALL    FillModeVRAM
 307  8198
 308  8198 21 17 8C             LD      HL,MsgPalettePass
 309  819B CD 65 86             CALL    DebugPrint
 310  819E CD 0B 86             CALL    SpectrumShowWriteComplete
 311  81A1 CD 3B 86             CALL    WaitSpace
 312  81A4
 313  81A4 3A 82 86             LD      A,(PaletteLevel)
 314  81A7 3C                   INC     A
 315  81A8 32 82 86             LD      (PaletteLevel),A
 316  81AB FE 04                CP      4
 317  81AD 20 C2                JR      NZ,PackedPaletteNext
 318  81AF
 319  81AF 3A 79 86             LD      A,(ModeCount)
 320  81B2 3D                   DEC     A
 321  81B3 32 79 86             LD      (ModeCount),A
 322  81B6 C2 39 81             JP      NZ,PackedModeNext
 323  81B9
 324  81B9 21 C2 8B             LD      HL,MsgSweepDone
 325  81BC CD 65 86             CALL    DebugPrint
 326  81BF CD 66 85             CALL    SpectrumClear
 327  81C2 21 9E 8C             LD      HL,ScreenTitle
 328  81C5 CD B2 84             CALL    SpectrumPrint
 329  81C8 21 DD 8D             LD      HL,ScreenAllDone
 330  81CB CD B2 84             CALL    SpectrumPrint
 331  81CE C9                   RET
 332  81CF
 333  81CF              PackedPaletteFailed:
 334  81CF 21 2B 8C             LD      HL,MsgPaletteFail
 335  81D2 CD 65 86             CALL    DebugPrint
 336  81D5 CD 9C 84             CALL    SpectrumShowDacFail
 337  81D8 CD 3B 86             CALL    WaitSpace
 338  81DB C9                   RET
 339  81DC
 340  81DC              ; Re-apply the currently selected packed-pixel 8-bpp resolution.
 341  81DC              ConfigureCurrentMode:
 342  81DC 3A 7A 86             LD      A,(ModeXLo)
 343  81DF 5F                   LD      E,A
 344  81E0 3E 00                LD      A,0
 345  81E2 CD A0 80             CALL    WriteVgaRegister
 346  81E5 3A 7B 86             LD      A,(ModeXHi)
 347  81E8 5F                   LD      E,A
 348  81E9 3E 01                LD      A,1
 349  81EB CD A0 80             CALL    WriteVgaRegister
 350  81EE 3A 7C 86             LD      A,(ModeYLo)
 351  81F1 5F                   LD      E,A
 352  81F2 3E 02                LD      A,2
 353  81F4 CD A0 80             CALL    WriteVgaRegister
 354  81F7 3A 7D 86             LD      A,(ModeYHi)
 355  81FA 5F                   LD      E,A
 356  81FB 3E 03                LD      A,3
 357  81FD CD A0 80             CALL    WriteVgaRegister
 358  8200 3E 08                LD      A,8
 359  8202 5F                   LD      E,A
 360  8203 3E 04                LD      A,4
 361  8205 CD A0 80             CALL    WriteVgaRegister
 362  8208 3E 01                LD      A,1
 363  820A 5F                   LD      E,A
 364  820B 3E 05                LD      A,5
 365  820D CD A0 80             CALL    WriteVgaRegister
 366  8210 C9                   RET
 367  8211
 368  8211              ; Palette table entry: count (word), index mask (byte), DAC source stride
 369  8211              ; beyond RGB (word). The RGB332 source table contains 256 evenly ordered
 370  8211              ; entries, so each smaller palette samples the full colour range.
 371  8211              SelectPaletteParameters:
 372  8211 21 F3 86             LD      HL,PaletteConfigTable
 373  8214 3A 82 86             LD      A,(PaletteLevel)
 374  8217 B7                   OR      A
 375  8218 28 07                JR      Z,PaletteConfigFound
 376  821A 47                   LD      B,A
 377  821B              PaletteConfigSkip:
 378  821B 11 05 00             LD      DE,5
 379  821E 19                   ADD     HL,DE
 380  821F 10 FA                DJNZ    PaletteConfigSkip
 381  8221              PaletteConfigFound:
 382  8221 7E                   LD      A,(HL)
 383  8222 23                   INC     HL
 384  8223 32 84 86             LD      (PaletteRemaining),A
 385  8226 7E                   LD      A,(HL)
 386  8227 23                   INC     HL
 387  8228 32 85 86             LD      (PaletteRemaining+1),A
 388  822B 7E                   LD      A,(HL)
 389  822C 23                   INC     HL
 390  822D 32 83 86             LD      (PaletteMask),A
 391  8230 7E                   LD      A,(HL)
 392  8231 23                   INC     HL
 393  8232 32 86 86             LD      (PaletteStride),A
 394  8235 7E                   LD      A,(HL)
 395  8236 32 87 86             LD      (PaletteStride+1),A
 396  8239 C9                   RET
 397  823A
 398  823A              ; Program the selected number of DAC entries from the full RGB332 ramp.
 399  823A              ProgramDacPalette:
 400  823A 21 E5 8E             LD      HL,Dac332Palette
 401  823D ED 5B 86 86          LD      DE,(PaletteStride)
 402  8241 AF                   XOR     A
 403  8242 32 70 86             LD      (DacIndex),A
 404  8245              ProgramDacPaletteLoop:
 405  8245 3A 70 86             LD      A,(DacIndex)
 406  8248 01 C8 03             LD      BC,$03C8
 407  824B ED 79                OUT     (C),A
 408  824D 01 C9 03             LD      BC,$03C9
 409  8250 7E                   LD      A,(HL)
 410  8251 23                   INC     HL
 411  8252 ED 79                OUT     (C),A
 412  8254 7E                   LD      A,(HL)
 413  8255 23                   INC     HL
 414  8256 ED 79                OUT     (C),A
 415  8258 7E                   LD      A,(HL)
 416  8259 23                   INC     HL
 417  825A ED 79                OUT     (C),A
 418  825C 19                   ADD     HL,DE
 419  825D 3A 70 86             LD      A,(DacIndex)
 420  8260 3C                   INC     A
 421  8261 32 70 86             LD      (DacIndex),A
 422  8264 E5                   PUSH    HL
 423  8265 CD 6C 82             CALL    DecPaletteRemaining
 424  8268 E1                   POP     HL
 425  8269 20 DA                JR      NZ,ProgramDacPaletteLoop
 426  826B C9                   RET
 427  826C
 428  826C              DecPaletteRemaining:
 429  826C 2A 84 86             LD      HL,(PaletteRemaining)
 430  826F 2B                   DEC     HL
 431  8270 22 84 86             LD      (PaletteRemaining),HL
 432  8273 7C                   LD      A,H
 433  8274 B5                   OR      L
 434  8275 C9                   RET
 435  8276
 436  8276              ; Fill exactly the active 8-bpp framebuffer. Display each palette entry
 437  8276              ; as an eight-pixel-wide vertical colour bar, cycling through the selected
 438  8276              ; palette size (2, 4, 16, or 256 entries).
 439  8276              ; Only banks containing visible pixels are touched.
 440  8276              FillModeVRAM:
 441  8276 AF                   XOR     A
 442  8277 32 6D 86             LD      (CurrentBank),A
 443  827A 32 70 86             LD      (DacIndex),A
 444  827D 3E 00                LD      A,0
 445  827F 32 88 86             LD      (PatternCounter),A
 446  8282 32 89 86             LD      (ModeXCounter),A
 447  8285 32 8A 86             LD      (ModeXCounter+1),A
 448  8288              ModeFillBank:
 449  8288 3A 6D 86             LD      A,(CurrentBank)
 450  828B 01 DF 03             LD      BC,$03DF
 451  828E ED 79                OUT     (C),A
 452  8290 21 00 C0             LD      HL,$C000
 453  8293 11 8B 86             LD      DE,ModePattern8
 454  8296 3A 6D 86             LD      A,(CurrentBank)
 455  8299 47                   LD      B,A
 456  829A 3A 7F 86             LD      A,(ModeBankCount)
 457  829D 3D                   DEC     A
 458  829E B8                   CP      B
 459  829F 20 06                JR      NZ,ModeFillFullBank
 460  82A1 ED 4B 80 86          LD      BC,(ModeLastBankBytes)
 461  82A5 18 03                JR      ModeFillCountReady
 462  82A7              ModeFillFullBank:
 463  82A7 01 00 40             LD      BC,$4000
 464  82AA              ModeFillCountReady:
 465  82AA              ModeFillByte:
 466  82AA 3A 70 86             LD      A,(DacIndex)
 467  82AD 77                   LD      (HL),A
 468  82AE 23                   INC     HL
 469  82AF E5                   PUSH    HL                    ; preserve framebuffer write pointer
 470  82B0
 471  82B0                      ; Advance the horizontal pixel counter independently of HL, which
 472  82B0                      ; must continue to point into the VGA aperture for the next write.
 473  82B0 2A 89 86             LD      HL,(ModeXCounter)
 474  82B3 23                   INC     HL
 475  82B4 22 89 86             LD      (ModeXCounter),HL
 476  82B7 E5                   PUSH    HL
 477  82B8 3A 7A 86             LD      A,(ModeXLo)
 478  82BB 5F                   LD      E,A
 479  82BC 3A 7B 86             LD      A,(ModeXHi)
 480  82BF 57                   LD      D,A
 481  82C0 B7                   OR      A
 482  82C1 ED 52                SBC     HL,DE
 483  82C3 E1                   POP     HL
 484  82C4 20 0F                JR      NZ,ModePatternContinue
 485  82C6
 486  82C6                      ; Start every scanline with palette index zero.
 487  82C6 21 00 00             LD      HL,0
 488  82C9 22 89 86             LD      (ModeXCounter),HL
 489  82CC AF                   XOR     A
 490  82CD 32 88 86             LD      (PatternCounter),A
 491  82D0 32 70 86             LD      (DacIndex),A
 492  82D3 18 2A                JR      ModePatternAdvanceDone
 493  82D5
 494  82D5              ModePatternContinue:
 495  82D5                      ; A 256-entry palette cannot fit as eight-pixel bars. Use one
 496  82D5                      ; pixel per colour so all 256 DAC entries appear across the row.
 497  82D5 3A 83 86             LD      A,(PaletteMask)
 498  82D8 FE FF                CP      $FF
 499  82DA 28 0E                JR      Z,ModePatternWidthOne
 500  82DC
 501  82DC                      ; Smaller palettes retain the wider eight-pixel bars.
 502  82DC 3A 88 86             LD      A,(PatternCounter)
 503  82DF 3C                   INC     A
 504  82E0 FE 08                CP      8
 505  82E2 20 18                JR      NZ,ModePatternHold
 506  82E4 AF                   XOR     A
 507  82E5 32 88 86             LD      (PatternCounter),A
 508  82E8 18 04                JR      ModePatternAdvanceColour
 509  82EA
 510  82EA              ModePatternWidthOne:
 511  82EA AF                   XOR     A
 512  82EB 32 88 86             LD      (PatternCounter),A
 513  82EE
 514  82EE              ModePatternAdvanceColour:
 515  82EE 3A 70 86             LD      A,(DacIndex)
 516  82F1 3C                   INC     A
 517  82F2 5F                   LD      E,A
 518  82F3 3A 83 86             LD      A,(PaletteMask)
 519  82F6 A3                   AND     E
 520  82F7 32 70 86             LD      (DacIndex),A
 521  82FA 18 03                JR      ModePatternAdvanceDone
 522  82FC
 523  82FC              ModePatternHold:
 524  82FC 32 88 86             LD      (PatternCounter),A
 525  82FF              ModePatternAdvanceDone:
 526  82FF E1                   POP     HL                    ; restore framebuffer write pointer
 527  8300 0B                   DEC     BC
 528  8301 78                   LD      A,B
 529  8302 B1                   OR      C
 530  8303 C2 AA 82             JP      NZ,ModeFillByte
 531  8306 3A 6D 86             LD      A,(CurrentBank)
 532  8309 3C                   INC     A
 533  830A 32 6D 86             LD      (CurrentBank),A
 534  830D 47                   LD      B,A
 535  830E 3A 7F 86             LD      A,(ModeBankCount)
 536  8311 B8                   CP      B
 537  8312 C2 88 82             JP      NZ,ModeFillBank
