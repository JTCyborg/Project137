# file opened: vga_test.asm
   1  0000              ; =========================================================================
   2  0000              ; PROJECT137 — ATM TURBO 2+ EXTERNAL VGA ADAPTER STANDARD MODE TEST
   3  0000              ; Based on the proven ATM startup/ROM trampoline from Project112.
   4  0000              ; Target adapter: Project131 ISA VGA/SVGA software interface.
   5  0000              ;
   6  0000              ; Test:
   7  0000              ;   - unlock ATM shadow ports through TR-DOS ROM
   8  0000              ;   - enable VGA software mode + 16 KiB aperture
   9  0000              ;   - program 640x480 RGB565 through 3E0h/3E1h
  10  0000              ;   - fill 614400 bytes of linear VRAM through 38 aperture banks
  11  0000              ;   - read back bytes from bank 0 and the last framebuffer bank
  12  0000              ;   - report results on port EF (spectrum_out.txt)
  13  0000              ;
  14  0000              ; Expected image: eight-colour RGB565 vertical bars.
  15  0000              ; =========================================================================
  16  0000
  17  0000                      DEVICE ZXSPECTRUM128
  18  0000                      EMPTYTRD "vga_test.TRD"
  19  0000
  20  0000                      ORG     $8000
  21  8000
  22  8000              VgaTestEntry:
  23  8000 F3                   DI
  24  8001 31 FF BF             LD      SP,$BFFF
  25  8004
  26  8004 21 5C 89             LD      HL,MsgBuild
  27  8007 CD 5A 85             CALL    DebugPrint
  28  800A 21 73 89             LD      HL,MsgStart
  29  800D CD 5A 85             CALL    DebugPrint
  30  8010
  31  8010 CD 92 80             CALL    OpenATMShadowPorts
  32  8013
  33  8013                      ; Select standard Spectrum screen page 5 before drawing status text.
  34  8013 AF                   XOR     A
  35  8014 01 FD 7F             LD      BC,$7FFD
  36  8017 ED 79                OUT     (C),A
  37  8019 CD 7D 84             CALL    SpectrumShowStartup
  38  801C 21 2F 8B             LD      HL,ScreenShadowReady
  39  801F CD 8D 84             CALL    SpectrumShowStatus
  40  8022
  41  8022 21 99 89             LD      HL,MsgAdapterInit
  42  8025 CD 5A 85             CALL    DebugPrint
  43  8028
  44  8028 CD 9C 84             CALL    SpectrumShowInitialMode
  45  802B
  46  802B                      ; 3DEh: software mode = 1, aperture enable = 1, bank 0.
  47  802B 01 DE 03             LD      BC,$03DE
  48  802E 3E 03                LD      A,$03
  49  8030 ED 79                OUT     (C),A
  50  8032
  51  8032                      ; Configure packed-pixel 640x480 RGB565:
  52  8032                      ; XRES = 0280h, YRES = 01E0h, BPP = 16, ENABLE = 1.
  53  8032 3E 00                LD      A,0
  54  8034 1E 80                LD      E,$80
  55  8036 CD A3 80             CALL    WriteVgaRegister
  56  8039 3E 01                LD      A,1
  57  803B 1E 02                LD      E,$02
  58  803D CD A3 80             CALL    WriteVgaRegister
