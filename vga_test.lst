# file opened: vga_test.asm
   1  0000              ; =========================================================================
   2  0000              ; PROJECT137 — ATM TURBO 2+ EXTERNAL VGA ADAPTER STANDARD MODE TEST
   3  0000              ; Based on the proven ATM startup/ROM trampoline from Project112.
   4  0000              ; Target adapter: Project131 ISA VGA/SVGA software interface.
   5  0000              ;
   6  0000              ; Test:
   7  0000              ;   - unlock ATM shadow ports through TR-DOS ROM
   8  0000              ;   - enable VGA software mode + 16 KiB aperture
   9  0000              ;   - program 640x480 RGB565 through 3E0h/3E1h
  10  0000              ;   - fill 614400 bytes of linear VRAM through 38 aperture banks
  11  0000              ;   - read back bytes from bank 0 and the last framebuffer bank
  12  0000              ;   - report results on port EF (spectrum_out.txt)
  13  0000              ;
  14  0000              ; Expected image: eight-colour RGB565 vertical bars.
  15  0000              ; =========================================================================
  16  0000
  17  0000                      DEVICE ZXSPECTRUM128
  18  0000                      EMPTYTRD "vga_test.TRD"
  19  0000
  20  0000                      ORG     $8000
  21  8000
  22  8000              VgaTestEntry:
  23  8000 F3                   DI
  24  8001 31 FF BF             LD      SP,$BFFF
  25  8004
  26  8004 21 23 8C             LD      HL,MsgBuild
  27  8007 CD E6 87             CALL    DebugPrint
  28  800A 21 3A 8C             LD      HL,MsgStart
  29  800D CD E6 87             CALL    DebugPrint
  30  8010
  31  8010 CD 96 80             CALL    OpenATMShadowPorts
  32  8013
  33  8013                      ; Select standard Spectrum screen page 5 before drawing status text.
  34  8013 AF                   XOR     A
  35  8014 01 FD 7F             LD      BC,$7FFD
  36  8017 ED 79                OUT     (C),A
  37  8019 CD 09 87             CALL    SpectrumShowStartup
  38  801C 21 DF 8E             LD      HL,ScreenShadowReady
  39  801F CD 19 87             CALL    SpectrumShowStatus
  40  8022
  41  8022 21 60 8C             LD      HL,MsgAdapterInit
  42  8025 CD E6 87             CALL    DebugPrint
  43  8028
  44  8028                      ; Enable the adapter before running any engine tests.
  45  8028                      ; 3DEh: software mode = 1, aperture enable = 1, bank 0.
  46  8028 01 DE 03             LD      BC,$03DE
  47  802B 3E 03                LD      A,$03
  48  802D ED 79                OUT     (C),A
  49  802F
  50  802F                      ; Run 2D engine tests first, before framebuffer and palette sweeps.
  51  802F CD E3 81             CALL    Run2DAcceleratorTest
  52  8032 B7                   OR      A
  53  8033 C2 1A 83             JP      NZ,AccelTestFailed
  54  8036
  55  8036 CD 28 87             CALL    SpectrumShowInitialMode
  56  8039
  57  8039                      ; Configure packed-pixel 640x480 RGB565:
  58  8039                      ; XRES = 0280h, YRES = 01E0h, BPP = 16, ENABLE = 1.
  59  8039 3E 00                LD      A,0
  60  803B 1E 80                LD      E,$80
  61  803D CD A7 80             CALL    WriteVgaRegister
  62  8040 3E 01                LD      A,1
  63  8042 1E 02                LD      E,$02
  64  8044 CD A7 80             CALL    WriteVgaRegister
  65  8047 3E 02                LD      A,2
  66  8049 1E E0                LD      E,$E0
  67  804B CD A7 80             CALL    WriteVgaRegister
  68  804E 3E 03                LD      A,3
  69  8050 1E 01                LD      E,$01
  70  8052 CD A7 80             CALL    WriteVgaRegister
  71  8055 3E 04                LD      A,4
  72  8057 1E 10                LD      E,16
  73  8059 CD A7 80             CALL    WriteVgaRegister
  74  805C 3E 05                LD      A,5
  75  805E 1E 01                LD      E,1
  76  8060 CD A7 80             CALL    WriteVgaRegister
  77  8063
  78  8063 21 77 8C             LD      HL,MsgModeSet
  79  8066 CD E6 87             CALL    DebugPrint
  80  8069
  81  8069 CD B1 80             CALL    Fill640x480x16
  82  806C
  83  806C 21 91 8C             LD      HL,MsgFrameWritten
  84  806F CD E6 87             CALL    DebugPrint
  85  8072 CD 44 87             CALL    SpectrumShowInitialWriteComplete
  86  8075
  87  8075 CD F6 80             CALL    VerifyFramebuffer
  88  8078 B7                   OR      A
  89  8079 20 12                JR      NZ,VgaTestFailed
  90  807B
  91  807B 21 AD 8C             LD      HL,MsgReadbackPass
  92  807E CD E6 87             CALL    DebugPrint
  93  8081
  94  8081                      ; Palette/resolution matrix is deliberately the final test group.
  95  8081 CD 29 81             CALL    RunPackedModeSweep
  96  8084
  97  8084 21 D7 8C             LD      HL,MsgReady
  98  8087 CD E6 87             CALL    DebugPrint
  99  808A
 100  808A              VgaTestIdle:
 101  808A 76                   HALT
 102  808B 18 FD                JR      VgaTestIdle
 103  808D
 104  808D              VgaTestFailed:
 105  808D 21 C2 8C             LD      HL,MsgReadbackFail
 106  8090 CD E6 87             CALL    DebugPrint
 107  8093              VgaTestFailedIdle:
 108  8093 76                   HALT
 109  8094 18 FD                JR      VgaTestFailedIdle
 110  8096
 111  8096              ; -------------------------------------------------------------------------
 112  8096              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
 113  8096              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
 114  8096              ; -------------------------------------------------------------------------
 115  8096              OpenATMShadowPorts:
 116  8096 01 A6 80             LD      BC,ShadowPortsOpened
 117  8099 C5                   PUSH    BC
 118  809A 01 53 2A             LD      BC,$2A53
 119  809D C5                   PUSH    BC
 120  809E 01 77 01             LD      BC,$0177
 121  80A1 3E C3                LD      A,$C3
 122  80A3 C3 2F 3D             JP      $3D2F
 123  80A6              ShadowPortsOpened:
 124  80A6 C9                   RET
 125  80A7
 126  80A7              ; A = indexed VGA register, E = value.
 127  80A7              WriteVgaRegister:
 128  80A7 01 E0 03             LD      BC,$03E0
 129  80AA ED 79                OUT     (C),A
 130  80AC 7B                   LD      A,E
 131  80AD 0C                   INC     C
 132  80AE ED 79                OUT     (C),A
 133  80B0 C9                   RET
 134  80B1
 135  80B1              ; -------------------------------------------------------------------------
 136  80B1              ; Fill the 640x480x16 framebuffer.
 137  80B1              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
 138  80B1              ; The aperture C000h-FFFFh is switched with port 3DFh.
 139  80B1              ; -------------------------------------------------------------------------
 140  80B1              Fill640x480x16:
 141  80B1 AF                   XOR     A
 142  80B2 32 EE 87             LD      (CurrentBank),A
 143  80B5
 144  80B5              FillBankLoop:
 145  80B5 3A EE 87             LD      A,(CurrentBank)
 146  80B8 01 DF 03             LD      BC,$03DF
 147  80BB ED 79                OUT     (C),A
 148  80BD
 149  80BD 21 00 C0             LD      HL,$C000
 150  80C0 11 A3 8B             LD      DE,ColorPattern
 151  80C3 3A EE 87             LD      A,(CurrentBank)
 152  80C6 FE 25                CP      37
 153  80C8 28 05                JR      Z,FillLastHalfBank
 154  80CA 01 00 40             LD      BC,$4000
 155  80CD 18 03                JR      FillBankBytes
 156  80CF
 157  80CF              FillLastHalfBank:
 158  80CF 01 00 20             LD      BC,$2000
 159  80D2
 160  80D2              FillBankBytes:
 161  80D2 1A                   LD      A,(DE)
 162  80D3 13                   INC     DE
 163  80D4 77                   LD      (HL),A
 164  80D5 23                   INC     HL
 165  80D6
 166  80D6                      ; Repeat the 128-byte RGB565 colour-bar sequence.
 167  80D6 F5                   PUSH    AF
 168  80D7 7A                   LD      A,D
 169  80D8 FE 8C                CP      HIGH ColorPatternEnd
 170  80DA 20 08                JR      NZ,PatternPointerReady
 171  80DC 7B                   LD      A,E
 172  80DD FE 23                CP      LOW ColorPatternEnd
 173  80DF 20 03                JR      NZ,PatternPointerReady
 174  80E1 11 A3 8B             LD      DE,ColorPattern
 175  80E4              PatternPointerReady:
 176  80E4 F1                   POP     AF
 177  80E5
 178  80E5 0B                   DEC     BC
 179  80E6 78                   LD      A,B
 180  80E7 B1                   OR      C
 181  80E8 20 E8                JR      NZ,FillBankBytes
 182  80EA
 183  80EA 3A EE 87             LD      A,(CurrentBank)
 184  80ED 3C                   INC     A
 185  80EE 32 EE 87             LD      (CurrentBank),A
 186  80F1 FE 26                CP      38
 187  80F3 20 C0                JR      NZ,FillBankLoop
 188  80F5 C9                   RET
 189  80F6
 190  80F6              ; -------------------------------------------------------------------------
 191  80F6              ; Readback checks:
 192  80F6              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
 193  80F6              ; bank 37 starts at linear offset 37*4000h = 5E000h.
 194  80F6              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
 195  80F6              ; Return A=0 on success, A=1 on mismatch.
 196  80F6              ; -------------------------------------------------------------------------
 197  80F6              VerifyFramebuffer:
 198  80F6 AF                   XOR     A
 199  80F7 01 DF 03             LD      BC,$03DF
 200  80FA ED 79                OUT     (C),A
 201  80FC
 202  80FC 21 00 C0             LD      HL,$C000
 203  80FF                      ; First eight pixels are black: bytes 0..15 must be zero.
 204  80FF 7E                   LD      A,(HL)
 205  8100 B7                   OR      A
 206  8101 20 23                JR      NZ,VerifyFailed
 207  8103 23                   INC     HL
 208  8104 7E                   LD      A,(HL)
 209  8105 B7                   OR      A
 210  8106 20 1E                JR      NZ,VerifyFailed
 211  8108
 212  8108                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
 213  8108 21 10 C0             LD      HL,$C010
 214  810B 7E                   LD      A,(HL)
 215  810C FE 1F                CP      $1F
 216  810E 20 16                JR      NZ,VerifyFailed
 217  8110 23                   INC     HL
 218  8111 7E                   LD      A,(HL)
 219  8112 B7                   OR      A
 220  8113 20 11                JR      NZ,VerifyFailed
 221  8115
 222  8115 3E 25                LD      A,37
 223  8117 01 DF 03             LD      BC,$03DF
 224  811A ED 79                OUT     (C),A
 225  811C 21 FF DF             LD      HL,$DFFF
 226  811F 7E                   LD      A,(HL)
 227  8120 FE FF                CP      $FF
 228  8122 20 02                JR      NZ,VerifyFailed
 229  8124
 230  8124 AF                   XOR     A
 231  8125 C9                   RET
 232  8126
 233  8126              VerifyFailed:
 234  8126 3E 01                LD      A,1
 235  8128 C9                   RET
 236  8129
 237  8129
 238  8129              ; -------------------------------------------------------------------------
 239  8129              ; Sweep the nine requested standard PC display resolutions.
 240  8129              ; Each mode uses 8-bpp indexed pixels and writes exactly its visible
 241  8129              ; framebuffer size. Use only the adapter's initialized EGA palette
 242  8129              ; entries 0..7, matching the proven Project132 test pattern.
 243  8129              ; SPACE advances to the next resolution.
 244  8129              ; -------------------------------------------------------------------------
 245  8129              RunPackedModeSweep:
 246  8129 21 FE 8C             LD      HL,MsgSweepStart
 247  812C CD E6 87             CALL    DebugPrint
 248  812F 21 30 88             LD      HL,PackedModeTable
 249  8132 22 F9 87             LD      (ModeTablePtr),HL
 250  8135 21 8C 88             LD      HL,ModeLabelTable
 251  8138 22 F0 87             LD      (ModeLabelPtr),HL
 252  813B 3E 09                LD      A,9
 253  813D 32 FB 87             LD      (ModeCount),A
 254  8140
 255  8140              ; Outer loop: increase resolution only after all four palette sizes pass.
 256  8140              PackedModeNext:
 257  8140 2A F9 87             LD      HL,(ModeTablePtr)
 258  8143 7E                   LD      A,(HL)
 259  8144 23                   INC     HL
 260  8145 32 FC 87             LD      (ModeXLo),A
 261  8148 7E                   LD      A,(HL)
 262  8149 23                   INC     HL
 263  814A 32 FD 87             LD      (ModeXHi),A
 264  814D 7E                   LD      A,(HL)
 265  814E 23                   INC     HL
 266  814F 32 FE 87             LD      (ModeYLo),A
 267  8152 7E                   LD      A,(HL)
 268  8153 23                   INC     HL
 269  8154 32 FF 87             LD      (ModeYHi),A
 270  8157 7E                   LD      A,(HL)
 271  8158 23                   INC     HL
 272  8159 32 00 88             LD      (ModeBpp),A
 273  815C 7E                   LD      A,(HL)
 274  815D 23                   INC     HL
 275  815E 32 01 88             LD      (ModeBankCount),A
 276  8161 7E                   LD      A,(HL)
 277  8162 23                   INC     HL
 278  8163 32 02 88             LD      (ModeLastBankBytes),A
 279  8166 7E                   LD      A,(HL)
 280  8167 23                   INC     HL
 281  8168 32 03 88             LD      (ModeLastBankBytes+1),A
 282  816B 22 F9 87             LD      (ModeTablePtr),HL
 283  816E
 284  816E CD 23 83             CALL    ConfigureCurrentMode
 285  8171 CD 60 87             CALL    SpectrumShowMode
 286  8174
 287  8174 AF                   XOR     A
 288  8175 32 04 88             LD      (PaletteLevel),A
 289  8178
 290  8178              ; Inner loop: 2, 4, 16 and 256 DAC entries at this resolution.
 291  8178              PackedPaletteNext:
 292  8178 CD 58 83             CALL    SelectPaletteParameters
 293  817B CD 87 83             CALL    ProgramDacPalette
 294  817E
 295  817E                      ; Legacy DAC writes disable VBE in the adapter model.
 296  817E                      ; Re-apply this resolution's indexed 8-bpp mode before VRAM access.
 297  817E CD 23 83             CALL    ConfigureCurrentMode
 298  8181
 299  8181 21 F3 8D             LD      HL,MsgPaletteLevel
 300  8184 CD E6 87             CALL    DebugPrint
 301  8187 3A 04 88             LD      A,(PaletteLevel)
 302  818A CD CC 87             CALL    DebugHexByte
 303  818D 21 02 8E             LD      HL,MsgPaletteSuffix
 304  8190 CD E6 87             CALL    DebugPrint
 305  8193
 306  8193                      ; Verify the DAC before touching the framebuffer. This keeps all
 307  8193                      ; DAC read-index/component activity out of the post-render phase.
 308  8193 CD 58 83             CALL    SelectPaletteParameters
 309  8196 CD 55 84             CALL    VerifyDacPalette
 310  8199 B7                   OR      A
 311  819A 20 3A                JR      NZ,PackedPaletteFailed
 312  819C
 313  819C CD C3 83             CALL    FillModeVRAM
 314  819F
 315  819F 21 21 8E             LD      HL,MsgPalettePass
 316  81A2 CD E6 87             CALL    DebugPrint
 317  81A5 CD 8C 87             CALL    SpectrumShowWriteComplete
 318  81A8 CD BC 87             CALL    WaitSpace
 319  81AB
 320  81AB 3A 04 88             LD      A,(PaletteLevel)
 321  81AE 3C                   INC     A
 322  81AF 32 04 88             LD      (PaletteLevel),A
 323  81B2 FE 04                CP      4
 324  81B4 20 C2                JR      NZ,PackedPaletteNext
 325  81B6
 326  81B6 3A FB 87             LD      A,(ModeCount)
 327  81B9 3D                   DEC     A
 328  81BA 32 FB 87             LD      (ModeCount),A
 329  81BD C2 40 81             JP      NZ,PackedModeNext
 330  81C0
 331  81C0 21 47 8D             LD      HL,MsgSweepDone
 332  81C3 CD E6 87             CALL    DebugPrint
 333  81C6 CD E7 86             CALL    SpectrumClear
 334  81C9 21 A8 8E             LD      HL,ScreenTitle
 335  81CC CD 33 86             CALL    SpectrumPrint
 336  81CF 21 E7 8F             LD      HL,ScreenAllDone
 337  81D2 CD 33 86             CALL    SpectrumPrint
 338  81D5 C9                   RET
 339  81D6
 340  81D6              PackedPaletteFailed:
 341  81D6 21 35 8E             LD      HL,MsgPaletteFail
 342  81D9 CD E6 87             CALL    DebugPrint
 343  81DC CD 1D 86             CALL    SpectrumShowDacFail
 344  81DF CD BC 87             CALL    WaitSpace
 345  81E2 C9                   RET
 346  81E3
 347  81E3              ; -------------------------------------------------------------------------
 348  81E3              ; Project131-compatible 2D accelerator smoke test.
 349  81E3              ; Uses 320x200x8bpp so the complete 64,000-byte framebuffer is in banks 0..3.
 350  81E3              ; Tests solid fill, VRAM-to-VRAM BitBLT, Bresenham line and status/readback.
 351  81E3              ; Returns A=0 on success, A=1 on failure.
 352  81E3              ; -------------------------------------------------------------------------
 353  81E3              Run2DAcceleratorTest:
 354  81E3 21 6B 8D             LD      HL,Msg2DStart
 355  81E6 CD E6 87             CALL    DebugPrint
 356  81E9 CD A9 85             CALL    SpectrumShow2DStart
 357  81EC
 358  81EC                      ; Select 320x200x8bpp.
 359  81EC 3E 40                LD      A,320&255
 360  81EE 32 FC 87             LD      (ModeXLo),A
 361  81F1 3E 01                LD      A,320>>8
 362  81F3 32 FD 87             LD      (ModeXHi),A
 363  81F6 3E C8                LD      A,200&255
 364  81F8 32 FE 87             LD      (ModeYLo),A
 365  81FB AF                   XOR     A
 366  81FC 32 FF 87             LD      (ModeYHi),A
 367  81FF CD 23 83             CALL    ConfigureCurrentMode
 368  8202
 369  8202                      ; SOLID FILL: destination (20,20), 100x60, colour E3h.
 370  8202 21 B4 82             LD      HL,AccelFillRegs
 371  8205 3E 26                LD      A,AccelFillRegsEnd-AccelFillRegs
 372  8207 CD 80 82             CALL    WriteAccelRegisterTable
 373  820A 3E 00                LD      A,0
 374  820C 1E 01                LD      E,1
 375  820E CD 97 82             CALL    WriteAccelRegister
 376  8211 CD A1 82             CALL    CheckAccelDone
 377  8214 B7                   OR      A
 378  8215 C0                   RET     NZ
 379  8216
 380  8216                      ; BITBLT: copy the filled rectangle to (140,20).
 381  8216 21 DA 82             LD      HL,AccelBlitRegs
 382  8219 3E 22                LD      A,AccelBlitRegsEnd-AccelBlitRegs
 383  821B CD 80 82             CALL    WriteAccelRegisterTable
 384  821E 3E 00                LD      A,0
 385  8220 1E 02                LD      E,2
 386  8222 CD 97 82             CALL    WriteAccelRegister
 387  8225 CD A1 82             CALL    CheckAccelDone
 388  8228 B7                   OR      A
 389  8229 C0                   RET     NZ
 390  822A
 391  822A                      ; LINE: draw from (0,0) to (319,199), colour FFh.
 392  822A 21 FC 82             LD      HL,AccelLineRegs
 393  822D 3E 1E                LD      A,AccelLineRegsEnd-AccelLineRegs
 394  822F CD 80 82             CALL    WriteAccelRegisterTable
 395  8232 3E 00                LD      A,0
 396  8234 1E 03                LD      E,3
 397  8236 CD 97 82             CALL    WriteAccelRegister
 398  8239 CD A1 82             CALL    CheckAccelDone
 399  823C B7                   OR      A
 400  823D C0                   RET     NZ
 401  823E
 402  823E                      ; Read back the source and copied destination pixels in bank 0.
 403  823E AF                   XOR     A
 404  823F 01 DF 03             LD      BC,$03DF
 405  8242 ED 79                OUT     (C),A
 406  8244 21 14 D9             LD      HL,$D914             ; 20*320 + 20 + C000h
 407  8247 7E                   LD      A,(HL)
 408  8248 FE E3                CP      $E3
 409  824A 20 25                JR      NZ,AccelReadbackFail
 410  824C 21 8C D9             LD      HL,$D98C             ; 20*320 + 140 + C000h
 411  824F 7E                   LD      A,(HL)
 412  8250 FE E3                CP      $E3
 413  8252 20 1D                JR      NZ,AccelReadbackFail
 414  8254
 415  8254                      ; The final line pixel is linear offset 63999 = bank 3:3A00?
 416  8254                      ; Bank 3 aperture address = C000h + (63999 - 49152) = F9FFh.
 417  8254 3E 03                LD      A,3
 418  8256 01 DF 03             LD      BC,$03DF
 419  8259 ED 79                OUT     (C),A
 420  825B 21 FF F9             LD      HL,$F9FF
 421  825E 7E                   LD      A,(HL)
 422  825F FE FF                CP      $FF
 423  8261 20 0E                JR      NZ,AccelReadbackFail
 424  8263
 425  8263 21 8D 8D             LD      HL,Msg2DPass
 426  8266 CD E6 87             CALL    DebugPrint
 427  8269 CD BF 85             CALL    SpectrumShow2DPass
 428  826C CD BC 87             CALL    WaitSpace
 429  826F AF                   XOR     A
 430  8270 C9                   RET
 431  8271
 432  8271              AccelReadbackFail:
 433  8271 21 D4 8D             LD      HL,Msg2DReadbackFail
 434  8274 CD E6 87             CALL    DebugPrint
 435  8277 CD D5 85             CALL    SpectrumShow2DFail
 436  827A CD BC 87             CALL    WaitSpace
 437  827D 3E 01                LD      A,1
 438  827F C9                   RET
 439  8280
 440  8280              ; HL points to register/value pairs; A is the byte count.
 441  8280              WriteAccelRegisterTable:
 442  8280 32 EF 87             LD      (AccelPairCount),A
 443  8283              WriteAccelRegisterTableLoop:
 444  8283 7E                   LD      A,(HL)
 445  8284 23                   INC     HL
 446  8285 5E                   LD      E,(HL)
 447  8286 23                   INC     HL
 448  8287 E5                   PUSH    HL
 449  8288 CD 97 82             CALL    WriteAccelRegister
 450  828B E1                   POP     HL
 451  828C 3A EF 87             LD      A,(AccelPairCount)
 452  828F D6 02                SUB     2
 453  8291 32 EF 87             LD      (AccelPairCount),A
 454  8294 20 ED                JR      NZ,WriteAccelRegisterTableLoop
 455  8296 C9                   RET
 456  8297
 457  8297              ; A = accelerator register index, E = value.
 458  8297              WriteAccelRegister:
 459  8297 01 E2 03             LD      BC,$03E2
 460  829A ED 79                OUT     (C),A
 461  829C 7B                   LD      A,E
 462  829D 0C                   INC     C
 463  829E ED 79                OUT     (C),A
 464  82A0 C9                   RET
 465  82A1
 466  82A1              ; Returns A=0 when status register reports DONE (1), otherwise A=1.
 467  82A1              CheckAccelDone:
 468  82A1 01 E2 03             LD      BC,$03E2
 469  82A4 3E 01                LD      A,1
 470  82A6 ED 79                OUT     (C),A
 471  82A8 0C                   INC     C
 472  82A9 ED 78                IN      A,(C)
 473  82AB FE 01                CP      1
 474  82AD 20 02                JR      NZ,CheckAccelFailed
 475  82AF AF                   XOR     A
 476  82B0 C9                   RET
 477  82B1              CheckAccelFailed:
 478  82B1 3E 01                LD      A,1
 479  82B3 C9                   RET
 480  82B4
 481  82B4              ; Register tables: index,value pairs. All addresses are byte offsets in VRAM.
 482  82B4              AccelFillRegs:
 483  82B4 02 00                DB $02,$00                 ; ROP COPY
 484  82B6 08 00 09 00          DB $08,$00,$09,$00,$0A,$00,$0B,$00 ; destination base = 0
 484  82BA 0A 00 0B 00
 485  82BE 0E 40 0F 01          DB $0E,$40,$0F,$01         ; destination pitch = 320
 486  82C2 14 14 15 00          DB $14,20,$15,0,$16,20,$17,0
 486  82C6 16 14 17 00
 487  82CA 18 64 19 00          DB $18,100,$19,0,$1A,60,$1B,0
 487  82CE 1A 3C 1B 00
 488  82D2 1C E3 1D 00          DB $1C,$E3,$1D,0,$1E,0,$1F,0
 488  82D6 1E 00 1F 00
 489  82DA              AccelFillRegsEnd:
 490  82DA
 491  82DA              AccelBlitRegs:
 492  82DA 02 00                DB $02,$00
 493  82DC 0C 40 0D 01          DB $0C,$40,$0D,$01         ; source pitch = 320
 494  82E0 0E 40 0F 01          DB $0E,$40,$0F,$01         ; destination pitch = 320
 495  82E4 10 14 11 00          DB $10,20,$11,0,$12,20,$13,0
 495  82E8 12 14 13 00
 496  82EC 14 8C 15 00          DB $14,140,$15,0,$16,20,$17,0
 496  82F0 16 14 17 00
 497  82F4 18 64 19 00          DB $18,100,$19,0,$1A,60,$1B,0
 497  82F8 1A 3C 1B 00
 498  82FC              AccelBlitRegsEnd:
 499  82FC
 500  82FC              AccelLineRegs:
 501  82FC 02 00                DB $02,$00
 502  82FE 0E 40 0F 01          DB $0E,$40,$0F,$01         ; destination pitch = 320
 503  8302 14 00 15 00          DB $14,0,$15,0,$16,0,$17,0
 503  8306 16 00 17 00
 504  830A 1C FF 1D 00          DB $1C,$FF,$1D,0,$1E,0,$1F,0
 504  830E 1E 00 1F 00
 505  8312 20 3F 21 01          DB $20,63,$21,1,$22,199,$23,0 ; endpoint (319,199)
 505  8316 22 C7 23 00
 506  831A              AccelLineRegsEnd:
 507  831A
 508  831A              AccelTestFailed:
 509  831A 21 B9 8D             LD      HL,Msg2DFail
