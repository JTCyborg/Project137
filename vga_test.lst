# file opened: vga_test.asm
   1  0000              ; =========================================================================
   2  0000              ; PROJECT137 — ATM TURBO 2+ EXTERNAL VGA ADAPTER STANDARD MODE TEST
   3  0000              ; Based on the proven ATM startup/ROM trampoline from Project112.
   4  0000              ; Target adapter: Project131 ISA VGA/SVGA software interface.
   5  0000              ;
   6  0000              ; Test:
   7  0000              ;   - unlock ATM shadow ports through TR-DOS ROM
   8  0000              ;   - enable VGA software mode + 16 KiB aperture
   9  0000              ;   - program 640x480 RGB565 through 3E0h/3E1h
  10  0000              ;   - fill 614400 bytes of linear VRAM through 38 aperture banks
  11  0000              ;   - read back bytes from bank 0 and the last framebuffer bank
  12  0000              ;   - report results on port EF (spectrum_out.txt)
  13  0000              ;
  14  0000              ; Expected image: eight-colour RGB565 vertical bars.
  15  0000              ; =========================================================================
  16  0000
  17  0000                      DEVICE ZXSPECTRUM128
  18  0000                      EMPTYTRD "vga_test.TRD"
  19  0000
  20  0000                      ORG     $8000
  21  8000
  22  8000              VgaTestEntry:
  23  8000 F3                   DI
  24  8001 31 FF BF             LD      SP,$BFFF
  25  8004
  26  8004 21 8D 8A             LD      HL,MsgBuild
  27  8007 CD 54 86             CALL    DebugPrint
  28  800A 21 A4 8A             LD      HL,MsgStart
  29  800D CD 54 86             CALL    DebugPrint
  30  8010
  31  8010 CD 8F 80             CALL    OpenATMShadowPorts
  32  8013
  33  8013                      ; Select standard Spectrum screen page 5 before drawing status text.
  34  8013 AF                   XOR     A
  35  8014 01 FD 7F             LD      BC,$7FFD
  36  8017 ED 79                OUT     (C),A
  37  8019 CD 77 85             CALL    SpectrumShowStartup
  38  801C 21 C4 8C             LD      HL,ScreenShadowReady
  39  801F CD 87 85             CALL    SpectrumShowStatus
  40  8022
  41  8022 21 CA 8A             LD      HL,MsgAdapterInit
  42  8025 CD 54 86             CALL    DebugPrint
  43  8028
  44  8028 CD 96 85             CALL    SpectrumShowInitialMode
  45  802B
  46  802B                      ; 3DEh: software mode = 1, aperture enable = 1, bank 0.
  47  802B 01 DE 03             LD      BC,$03DE
  48  802E 3E 03                LD      A,$03
  49  8030 ED 79                OUT     (C),A
  50  8032
  51  8032                      ; Configure packed-pixel 640x480 RGB565:
  52  8032                      ; XRES = 0280h, YRES = 01E0h, BPP = 16, ENABLE = 1.
  53  8032 3E 00                LD      A,0
  54  8034 1E 80                LD      E,$80
  55  8036 CD A0 80             CALL    WriteVgaRegister
  56  8039 3E 01                LD      A,1
  57  803B 1E 02                LD      E,$02
  58  803D CD A0 80             CALL    WriteVgaRegister
  59  8040 3E 02                LD      A,2
  60  8042 1E E0                LD      E,$E0
  61  8044 CD A0 80             CALL    WriteVgaRegister
  62  8047 3E 03                LD      A,3
  63  8049 1E 01                LD      E,$01
  64  804B CD A0 80             CALL    WriteVgaRegister
  65  804E 3E 04                LD      A,4
  66  8050 1E 10                LD      E,16
  67  8052 CD A0 80             CALL    WriteVgaRegister
  68  8055 3E 05                LD      A,5
  69  8057 1E 01                LD      E,1
  70  8059 CD A0 80             CALL    WriteVgaRegister
  71  805C
  72  805C 21 E1 8A             LD      HL,MsgModeSet
  73  805F CD 54 86             CALL    DebugPrint
  74  8062
  75  8062 CD AA 80             CALL    Fill640x480x16
  76  8065
  77  8065 21 FB 8A             LD      HL,MsgFrameWritten
  78  8068 CD 54 86             CALL    DebugPrint
  79  806B CD B2 85             CALL    SpectrumShowInitialWriteComplete
  80  806E
  81  806E CD EF 80             CALL    VerifyFramebuffer
  82  8071 B7                   OR      A
  83  8072 20 12                JR      NZ,VgaTestFailed
  84  8074
  85  8074 21 17 8B             LD      HL,MsgReadbackPass
  86  8077 CD 54 86             CALL    DebugPrint
  87  807A
  88  807A CD 22 81             CALL    RunPackedModeSweep
  89  807D
  90  807D 21 41 8B             LD      HL,MsgReady
  91  8080 CD 54 86             CALL    DebugPrint
  92  8083
  93  8083              VgaTestIdle:
  94  8083 76                   HALT
  95  8084 18 FD                JR      VgaTestIdle
  96  8086
  97  8086              VgaTestFailed:
  98  8086 21 2C 8B             LD      HL,MsgReadbackFail
  99  8089 CD 54 86             CALL    DebugPrint
 100  808C              VgaTestFailedIdle:
 101  808C 76                   HALT
 102  808D 18 FD                JR      VgaTestFailedIdle
 103  808F
 104  808F              ; -------------------------------------------------------------------------
 105  808F              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
 106  808F              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
 107  808F              ; -------------------------------------------------------------------------
 108  808F              OpenATMShadowPorts:
 109  808F 01 9F 80             LD      BC,ShadowPortsOpened
 110  8092 C5                   PUSH    BC
 111  8093 01 53 2A             LD      BC,$2A53
 112  8096 C5                   PUSH    BC
 113  8097 01 77 01             LD      BC,$0177
 114  809A 3E C3                LD      A,$C3
 115  809C C3 2F 3D             JP      $3D2F
 116  809F              ShadowPortsOpened:
 117  809F C9                   RET
 118  80A0
 119  80A0              ; A = indexed VGA register, E = value.
 120  80A0              WriteVgaRegister:
 121  80A0 01 E0 03             LD      BC,$03E0
 122  80A3 ED 79                OUT     (C),A
 123  80A5 7B                   LD      A,E
 124  80A6 0C                   INC     C
 125  80A7 ED 79                OUT     (C),A
 126  80A9 C9                   RET
 127  80AA
 128  80AA              ; -------------------------------------------------------------------------
 129  80AA              ; Fill the 640x480x16 framebuffer.
 130  80AA              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
 131  80AA              ; The aperture C000h-FFFFh is switched with port 3DFh.
 132  80AA              ; -------------------------------------------------------------------------
 133  80AA              Fill640x480x16:
 134  80AA AF                   XOR     A
 135  80AB 32 5C 86             LD      (CurrentBank),A
 136  80AE
 137  80AE              FillBankLoop:
 138  80AE 3A 5C 86             LD      A,(CurrentBank)
 139  80B1 01 DF 03             LD      BC,$03DF
 140  80B4 ED 79                OUT     (C),A
 141  80B6
 142  80B6 21 00 C0             LD      HL,$C000
 143  80B9 11 0D 8A             LD      DE,ColorPattern
 144  80BC 3A 5C 86             LD      A,(CurrentBank)
 145  80BF FE 25                CP      37
 146  80C1 28 05                JR      Z,FillLastHalfBank
 147  80C3 01 00 40             LD      BC,$4000
 148  80C6 18 03                JR      FillBankBytes
 149  80C8
 150  80C8              FillLastHalfBank:
 151  80C8 01 00 20             LD      BC,$2000
 152  80CB
 153  80CB              FillBankBytes:
 154  80CB 1A                   LD      A,(DE)
 155  80CC 13                   INC     DE
 156  80CD 77                   LD      (HL),A
 157  80CE 23                   INC     HL
 158  80CF
 159  80CF                      ; Repeat the 128-byte RGB565 colour-bar sequence.
 160  80CF F5                   PUSH    AF
 161  80D0 7A                   LD      A,D
 162  80D1 FE 8A                CP      HIGH ColorPatternEnd
 163  80D3 20 08                JR      NZ,PatternPointerReady
 164  80D5 7B                   LD      A,E
 165  80D6 FE 8D                CP      LOW ColorPatternEnd
 166  80D8 20 03                JR      NZ,PatternPointerReady
 167  80DA 11 0D 8A             LD      DE,ColorPattern
 168  80DD              PatternPointerReady:
 169  80DD F1                   POP     AF
 170  80DE
 171  80DE 0B                   DEC     BC
 172  80DF 78                   LD      A,B
 173  80E0 B1                   OR      C
 174  80E1 20 E8                JR      NZ,FillBankBytes
 175  80E3
 176  80E3 3A 5C 86             LD      A,(CurrentBank)
 177  80E6 3C                   INC     A
 178  80E7 32 5C 86             LD      (CurrentBank),A
 179  80EA FE 26                CP      38
 180  80EC 20 C0                JR      NZ,FillBankLoop
 181  80EE C9                   RET
 182  80EF
 183  80EF              ; -------------------------------------------------------------------------
 184  80EF              ; Readback checks:
 185  80EF              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
 186  80EF              ; bank 37 starts at linear offset 37*4000h = 5E000h.
 187  80EF              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
 188  80EF              ; Return A=0 on success, A=1 on mismatch.
 189  80EF              ; -------------------------------------------------------------------------
 190  80EF              VerifyFramebuffer:
 191  80EF AF                   XOR     A
 192  80F0 01 DF 03             LD      BC,$03DF
 193  80F3 ED 79                OUT     (C),A
 194  80F5
 195  80F5 21 00 C0             LD      HL,$C000
 196  80F8                      ; First eight pixels are black: bytes 0..15 must be zero.
 197  80F8 7E                   LD      A,(HL)
 198  80F9 B7                   OR      A
 199  80FA 20 23                JR      NZ,VerifyFailed
 200  80FC 23                   INC     HL
 201  80FD 7E                   LD      A,(HL)
 202  80FE B7                   OR      A
 203  80FF 20 1E                JR      NZ,VerifyFailed
 204  8101
 205  8101                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
 206  8101 21 10 C0             LD      HL,$C010
 207  8104 7E                   LD      A,(HL)
 208  8105 FE 1F                CP      $1F
 209  8107 20 16                JR      NZ,VerifyFailed
 210  8109 23                   INC     HL
 211  810A 7E                   LD      A,(HL)
 212  810B B7                   OR      A
 213  810C 20 11                JR      NZ,VerifyFailed
 214  810E
 215  810E 3E 25                LD      A,37
 216  8110 01 DF 03             LD      BC,$03DF
 217  8113 ED 79                OUT     (C),A
 218  8115 21 FF DF             LD      HL,$DFFF
 219  8118 7E                   LD      A,(HL)
 220  8119 FE FF                CP      $FF
 221  811B 20 02                JR      NZ,VerifyFailed
 222  811D
 223  811D AF                   XOR     A
 224  811E C9                   RET
 225  811F
 226  811F              VerifyFailed:
 227  811F 3E 01                LD      A,1
 228  8121 C9                   RET
 229  8122
 230  8122
 231  8122              ; -------------------------------------------------------------------------
 232  8122              ; Sweep the nine requested standard PC display resolutions.
 233  8122              ; Each mode uses 8-bpp indexed pixels and writes exactly its visible
 234  8122              ; framebuffer size. Use only the adapter's initialized EGA palette
 235  8122              ; entries 0..7, matching the proven Project132 test pattern.
 236  8122              ; SPACE advances to the next resolution.
 237  8122              ; -------------------------------------------------------------------------
 238  8122              RunPackedModeSweep:
 239  8122 21 68 8B             LD      HL,MsgSweepStart
 240  8125 CD 54 86             CALL    DebugPrint
 241  8128 21 9A 86             LD      HL,PackedModeTable
 242  812B 22 66 86             LD      (ModeTablePtr),HL
 243  812E 21 F6 86             LD      HL,ModeLabelTable
 244  8131 22 5D 86             LD      (ModeLabelPtr),HL
 245  8134 3E 09                LD      A,9
 246  8136 32 68 86             LD      (ModeCount),A
 247  8139
 248  8139              ; Outer loop: increase resolution only after all four palette sizes pass.
 249  8139              PackedModeNext:
 250  8139 2A 66 86             LD      HL,(ModeTablePtr)
 251  813C 7E                   LD      A,(HL)
 252  813D 23                   INC     HL
 253  813E 32 69 86             LD      (ModeXLo),A
 254  8141 7E                   LD      A,(HL)
 255  8142 23                   INC     HL
 256  8143 32 6A 86             LD      (ModeXHi),A
 257  8146 7E                   LD      A,(HL)
 258  8147 23                   INC     HL
 259  8148 32 6B 86             LD      (ModeYLo),A
 260  814B 7E                   LD      A,(HL)
 261  814C 23                   INC     HL
 262  814D 32 6C 86             LD      (ModeYHi),A
 263  8150 7E                   LD      A,(HL)
 264  8151 23                   INC     HL
 265  8152 32 6D 86             LD      (ModeBpp),A
 266  8155 7E                   LD      A,(HL)
 267  8156 23                   INC     HL
 268  8157 32 6E 86             LD      (ModeBankCount),A
 269  815A 7E                   LD      A,(HL)
 270  815B 23                   INC     HL
 271  815C 32 6F 86             LD      (ModeLastBankBytes),A
 272  815F 7E                   LD      A,(HL)
 273  8160 23                   INC     HL
 274  8161 32 70 86             LD      (ModeLastBankBytes+1),A
 275  8164 22 66 86             LD      (ModeTablePtr),HL
 276  8167
 277  8167 CD DC 81             CALL    ConfigureCurrentMode
 278  816A CD CE 85             CALL    SpectrumShowMode
 279  816D
 280  816D AF                   XOR     A
 281  816E 32 71 86             LD      (PaletteLevel),A
 282  8171
 283  8171              ; Inner loop: 2, 4, 16 and 256 DAC entries at this resolution.
 284  8171              PackedPaletteNext:
 285  8171 CD 11 82             CALL    SelectPaletteParameters
 286  8174 CD 3A 82             CALL    ProgramDacPalette
 287  8177
 288  8177                      ; Legacy DAC writes disable VBE in the adapter model.
 289  8177                      ; Re-apply this resolution's indexed 8-bpp mode before VRAM access.
 290  8177 CD DC 81             CALL    ConfigureCurrentMode
 291  817A
 292  817A 21 D5 8B             LD      HL,MsgPaletteLevel
 293  817D CD 54 86             CALL    DebugPrint
 294  8180 3A 71 86             LD      A,(PaletteLevel)
 295  8183 CD 3A 86             CALL    DebugHexByte
 296  8186 21 E4 8B             LD      HL,MsgPaletteSuffix
 297  8189 CD 54 86             CALL    DebugPrint
 298  818C
 299  818C CD 76 82             CALL    FillModeVRAM
 300  818F CD 11 82             CALL    SelectPaletteParameters
 301  8192 CD 05 83             CALL    VerifyDacPalette
 302  8195 B7                   OR      A
 303  8196 20 37                JR      NZ,PackedPaletteFailed
 304  8198
 305  8198 21 06 8C             LD      HL,MsgPalettePass
 306  819B CD 54 86             CALL    DebugPrint
 307  819E CD FA 85             CALL    SpectrumShowWriteComplete
 308  81A1 CD 2A 86             CALL    WaitSpace
 309  81A4
 310  81A4 3A 71 86             LD      A,(PaletteLevel)
 311  81A7 3C                   INC     A
 312  81A8 32 71 86             LD      (PaletteLevel),A
 313  81AB FE 04                CP      4
 314  81AD 20 C2                JR      NZ,PackedPaletteNext
 315  81AF
 316  81AF 3A 68 86             LD      A,(ModeCount)
 317  81B2 3D                   DEC     A
 318  81B3 32 68 86             LD      (ModeCount),A
 319  81B6 C2 39 81             JP      NZ,PackedModeNext
 320  81B9
 321  81B9 21 B1 8B             LD      HL,MsgSweepDone
 322  81BC CD 54 86             CALL    DebugPrint
 323  81BF CD 55 85             CALL    SpectrumClear
 324  81C2 21 8D 8C             LD      HL,ScreenTitle
 325  81C5 CD A1 84             CALL    SpectrumPrint
 326  81C8 21 CC 8D             LD      HL,ScreenAllDone
 327  81CB CD A1 84             CALL    SpectrumPrint
 328  81CE C9                   RET
 329  81CF
 330  81CF              PackedPaletteFailed:
 331  81CF 21 1A 8C             LD      HL,MsgPaletteFail
 332  81D2 CD 54 86             CALL    DebugPrint
 333  81D5 CD 8B 84             CALL    SpectrumShowDacFail
 334  81D8 CD 2A 86             CALL    WaitSpace
 335  81DB C9                   RET
 336  81DC
 337  81DC              ; Re-apply the currently selected packed-pixel 8-bpp resolution.
 338  81DC              ConfigureCurrentMode:
 339  81DC 3A 69 86             LD      A,(ModeXLo)
 340  81DF 5F                   LD      E,A
 341  81E0 3E 00                LD      A,0
 342  81E2 CD A0 80             CALL    WriteVgaRegister
 343  81E5 3A 6A 86             LD      A,(ModeXHi)
 344  81E8 5F                   LD      E,A
 345  81E9 3E 01                LD      A,1
 346  81EB CD A0 80             CALL    WriteVgaRegister
 347  81EE 3A 6B 86             LD      A,(ModeYLo)
 348  81F1 5F                   LD      E,A
 349  81F2 3E 02                LD      A,2
 350  81F4 CD A0 80             CALL    WriteVgaRegister
 351  81F7 3A 6C 86             LD      A,(ModeYHi)
 352  81FA 5F                   LD      E,A
 353  81FB 3E 03                LD      A,3
 354  81FD CD A0 80             CALL    WriteVgaRegister
 355  8200 3E 08                LD      A,8
 356  8202 5F                   LD      E,A
 357  8203 3E 04                LD      A,4
 358  8205 CD A0 80             CALL    WriteVgaRegister
 359  8208 3E 01                LD      A,1
 360  820A 5F                   LD      E,A
 361  820B 3E 05                LD      A,5
 362  820D CD A0 80             CALL    WriteVgaRegister
 363  8210 C9                   RET
 364  8211
 365  8211              ; Palette table entry: count (word), index mask (byte), DAC source stride
 366  8211              ; beyond RGB (word). The RGB332 source table contains 256 evenly ordered
 367  8211              ; entries, so each smaller palette samples the full colour range.
 368  8211              SelectPaletteParameters:
 369  8211 21 E2 86             LD      HL,PaletteConfigTable
 370  8214 3A 71 86             LD      A,(PaletteLevel)
 371  8217 B7                   OR      A
 372  8218 28 07                JR      Z,PaletteConfigFound
 373  821A 47                   LD      B,A
 374  821B              PaletteConfigSkip:
 375  821B 11 05 00             LD      DE,5
 376  821E 19                   ADD     HL,DE
 377  821F 10 FA                DJNZ    PaletteConfigSkip
 378  8221              PaletteConfigFound:
 379  8221 7E                   LD      A,(HL)
 380  8222 23                   INC     HL
 381  8223 32 73 86             LD      (PaletteRemaining),A
 382  8226 7E                   LD      A,(HL)
 383  8227 23                   INC     HL
 384  8228 32 74 86             LD      (PaletteRemaining+1),A
 385  822B 7E                   LD      A,(HL)
 386  822C 23                   INC     HL
 387  822D 32 72 86             LD      (PaletteMask),A
 388  8230 7E                   LD      A,(HL)
 389  8231 23                   INC     HL
 390  8232 32 75 86             LD      (PaletteStride),A
 391  8235 7E                   LD      A,(HL)
 392  8236 32 76 86             LD      (PaletteStride+1),A
 393  8239 C9                   RET
 394  823A
 395  823A              ; Program the selected number of DAC entries from the full RGB332 ramp.
 396  823A              ProgramDacPalette:
 397  823A 21 D4 8E             LD      HL,Dac332Palette
 398  823D ED 5B 75 86          LD      DE,(PaletteStride)
 399  8241 AF                   XOR     A
 400  8242 32 5F 86             LD      (DacIndex),A
 401  8245              ProgramDacPaletteLoop:
 402  8245 3A 5F 86             LD      A,(DacIndex)
 403  8248 01 C8 03             LD      BC,$03C8
 404  824B ED 79                OUT     (C),A
 405  824D 01 C9 03             LD      BC,$03C9
 406  8250 7E                   LD      A,(HL)
 407  8251 23                   INC     HL
 408  8252 ED 79                OUT     (C),A
 409  8254 7E                   LD      A,(HL)
 410  8255 23                   INC     HL
 411  8256 ED 79                OUT     (C),A
 412  8258 7E                   LD      A,(HL)
 413  8259 23                   INC     HL
 414  825A ED 79                OUT     (C),A
 415  825C 19                   ADD     HL,DE
 416  825D 3A 5F 86             LD      A,(DacIndex)
 417  8260 3C                   INC     A
 418  8261 32 5F 86             LD      (DacIndex),A
 419  8264 E5                   PUSH    HL
 420  8265 CD 6C 82             CALL    DecPaletteRemaining
 421  8268 E1                   POP     HL
 422  8269 20 DA                JR      NZ,ProgramDacPaletteLoop
 423  826B C9                   RET
 424  826C
 425  826C              DecPaletteRemaining:
 426  826C 2A 73 86             LD      HL,(PaletteRemaining)
 427  826F 2B                   DEC     HL
 428  8270 22 73 86             LD      (PaletteRemaining),HL
 429  8273 7C                   LD      A,H
 430  8274 B5                   OR      L
 431  8275 C9                   RET
 432  8276
 433  8276              ; Fill exactly the active 8-bpp framebuffer. Display each palette entry
 434  8276              ; as an eight-pixel-wide vertical colour bar, cycling through the selected
 435  8276              ; palette size (2, 4, 16, or 256 entries).
 436  8276              ; Only banks containing visible pixels are touched.
 437  8276              FillModeVRAM:
 438  8276 AF                   XOR     A
 439  8277 32 5C 86             LD      (CurrentBank),A
 440  827A 32 5F 86             LD      (DacIndex),A
 441  827D 3E 00                LD      A,0
 442  827F 32 77 86             LD      (PatternCounter),A
 443  8282 32 78 86             LD      (ModeXCounter),A
 444  8285 32 79 86             LD      (ModeXCounter+1),A
 445  8288              ModeFillBank:
 446  8288 3A 5C 86             LD      A,(CurrentBank)
 447  828B 01 DF 03             LD      BC,$03DF
 448  828E ED 79                OUT     (C),A
 449  8290 21 00 C0             LD      HL,$C000
 450  8293 11 7A 86             LD      DE,ModePattern8
 451  8296 3A 5C 86             LD      A,(CurrentBank)
 452  8299 47                   LD      B,A
 453  829A 3A 6E 86             LD      A,(ModeBankCount)
 454  829D 3D                   DEC     A
 455  829E B8                   CP      B
 456  829F 20 06                JR      NZ,ModeFillFullBank
 457  82A1 ED 4B 6F 86          LD      BC,(ModeLastBankBytes)
 458  82A5 18 03                JR      ModeFillCountReady
 459  82A7              ModeFillFullBank:
 460  82A7 01 00 40             LD      BC,$4000
 461  82AA              ModeFillCountReady:
 462  82AA              ModeFillByte:
 463  82AA 3A 5F 86             LD      A,(DacIndex)
 464  82AD 77                   LD      (HL),A
 465  82AE 23                   INC     HL
 466  82AF
 467  82AF                      ; Keep the palette pattern aligned to each scanline. The previous
 468  82AF                      ; linear pattern advanced across row boundaries, producing diagonal
 469  82AF                      ; colour bands (especially obvious with 16 and 256 entries).
 470  82AF 2A 78 86             LD      HL,(ModeXCounter)
 471  82B2 23                   INC     HL
 472  82B3 22 78 86             LD      (ModeXCounter),HL
 473  82B6 E5                   PUSH    HL
 474  82B7 3A 69 86             LD      A,(ModeXLo)
 475  82BA 5F                   LD      E,A
 476  82BB 3A 6A 86             LD      A,(ModeXHi)
 477  82BE 57                   LD      D,A
 478  82BF B7                   OR      A
 479  82C0 ED 52                SBC     HL,DE
 480  82C2 E1                   POP     HL
 481  82C3 20 0F                JR      NZ,ModePatternContinue
 482  82C5 21 00 00             LD      HL,0
 483  82C8 22 78 86             LD      (ModeXCounter),HL
 484  82CB AF                   XOR     A
 485  82CC 32 77 86             LD      (PatternCounter),A
 486  82CF 32 5F 86             LD      (DacIndex),A
 487  82D2 18 1D                JR      ModePatternAdvanceDone
 488  82D4
 489  82D4              ModePatternContinue:
 490  82D4 3A 77 86             LD      A,(PatternCounter)
 491  82D7 3C                   INC     A
 492  82D8 FE 08                CP      8
 493  82DA 20 12                JR      NZ,ModePatternHold
 494  82DC AF                   XOR     A
 495  82DD 32 77 86             LD      (PatternCounter),A
 496  82E0 3A 5F 86             LD      A,(DacIndex)
 497  82E3 3C                   INC     A
 498  82E4 5F                   LD      E,A
 499  82E5 3A 72 86             LD      A,(PaletteMask)
 500  82E8 A3                   AND     E
 501  82E9 32 5F 86             LD      (DacIndex),A
 502  82EC 18 03                JR      ModePatternAdvanceDone
 503  82EE              ModePatternHold:
 504  82EE 32 77 86             LD      (PatternCounter),A
 505  82F1              ModePatternAdvanceDone:
 506  82F1 0B                   DEC     BC
 507  82F2 78                   LD      A,B
 508  82F3 B1                   OR      C
 509  82F4 20 B4                JR      NZ,ModeFillByte
 510  82F6 3A 5C 86             LD      A,(CurrentBank)
 511  82F9 3C                   INC     A
 512  82FA 32 5C 86             LD      (CurrentBank),A
 513  82FD 47                   LD      B,A
 514  82FE 3A 6E 86             LD      A,(ModeBankCount)
 515  8301 B8                   CP      B
 516  8302 20 84                JR      NZ,ModeFillBank
 517  8304 C9                   RET
 518  8305
 519  8305              ; Read back every programmed DAC entry, including all RGB components.
 520  8305              ; Return A=0 on success, A=1 on mismatch.
 521  8305              VerifyDacPalette:
 522  8305 21 D4 8E             LD      HL,Dac332Palette
 523  8308 ED 5B 75 86          LD      DE,(PaletteStride)
 524  830C AF                   XOR     A
 525  830D 32 5F 86             LD      (DacIndex),A
 526  8310              VerifyDacPaletteLoop:
 527  8310 3A 5F 86             LD      A,(DacIndex)
 528  8313 01 C7 03             LD      BC,$03C7
 529  8316 ED 79                OUT     (C),A
 530  8318 01 C9 03             LD      BC,$03C9
 531  831B ED 78                IN      A,(C)
 532  831D BE                   CP      (HL)
 533  831E 20 1E                JR      NZ,VerifyDacPaletteFailed
 534  8320 23                   INC     HL
