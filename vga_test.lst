 104  808F              ; -------------------------------------------------------------------------
 105  808F              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
 106  808F              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
 107  808F              ; -------------------------------------------------------------------------
 108  808F              OpenATMShadowPorts:
 109  808F 01 9F 80             LD      BC,ShadowPortsOpened
 110  8092 C5                   PUSH    BC
 111  8093 01 53 2A             LD      BC,$2A53
 112  8096 C5                   PUSH    BC
 113  8097 01 77 01             LD      BC,$0177
 114  809A 3E C3                LD      A,$C3
 115  809C C3 2F 3D             JP      $3D2F
 116  809F              ShadowPortsOpened:
 117  809F C9                   RET
 118  80A0
 119  80A0              ; A = indexed VGA register, E = value.
 120  80A0              WriteVgaRegister:
 121  80A0 01 E0 03             LD      BC,$03E0
 122  80A3 ED 79                OUT     (C),A
 123  80A5 7B                   LD      A,E
 124  80A6 0C                   INC     C
 125  80A7 ED 79                OUT     (C),A
 126  80A9 C9                   RET
 127  80AA
 128  80AA              ; -------------------------------------------------------------------------
 129  80AA              ; Fill the 640x480x16 framebuffer.
 130  80AA              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
 131  80AA              ; The aperture C000h-FFFFh is switched with port 3DFh.
 132  80AA              ; -------------------------------------------------------------------------
 133  80AA              Fill640x480x16:
 134  80AA AF                   XOR     A
 135  80AB 32 65 86             LD      (CurrentBank),A
 136  80AE
 137  80AE              FillBankLoop:
 138  80AE 3A 65 86             LD      A,(CurrentBank)
 139  80B1 01 DF 03             LD      BC,$03DF
 140  80B4 ED 79                OUT     (C),A
 141  80B6
 142  80B6 21 00 C0             LD      HL,$C000
 143  80B9 11 19 8A             LD      DE,ColorPattern
 144  80BC 3A 65 86             LD      A,(CurrentBank)
 145  80BF FE 25                CP      37
 146  80C1 28 05                JR      Z,FillLastHalfBank
 147  80C3 01 00 40             LD      BC,$4000
 148  80C6 18 03                JR      FillBankBytes
 149  80C8
 150  80C8              FillLastHalfBank:
 151  80C8 01 00 20             LD      BC,$2000
 152  80CB
 153  80CB              FillBankBytes:
 154  80CB 1A                   LD      A,(DE)
 155  80CC 13                   INC     DE
 156  80CD 77                   LD      (HL),A
 157  80CE 23                   INC     HL
 158  80CF
 159  80CF                      ; Repeat the 128-byte RGB565 colour-bar sequence.
 160  80CF F5                   PUSH    AF
 161  80D0 7A                   LD      A,D
 162  80D1 FE 8A                CP      HIGH ColorPatternEnd
 163  80D3 20 08                JR      NZ,PatternPointerReady
 164  80D5 7B                   LD      A,E
 165  80D6 FE 99                CP      LOW ColorPatternEnd
 166  80D8 20 03                JR      NZ,PatternPointerReady
 167  80DA 11 19 8A             LD      DE,ColorPattern
 168  80DD              PatternPointerReady:
 169  80DD F1                   POP     AF
 170  80DE
 171  80DE 0B                   DEC     BC
 172  80DF 78                   LD      A,B
 173  80E0 B1                   OR      C
 174  80E1 20 E8                JR      NZ,FillBankBytes
 175  80E3
 176  80E3 3A 65 86             LD      A,(CurrentBank)
 177  80E6 3C                   INC     A
 178  80E7 32 65 86             LD      (CurrentBank),A
 179  80EA FE 26                CP      38
 180  80EC 20 C0                JR      NZ,FillBankLoop
 181  80EE C9                   RET
 182  80EF
 183  80EF              ; -------------------------------------------------------------------------
 184  80EF              ; Readback checks:
 185  80EF              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
 186  80EF              ; bank 37 starts at linear offset 37*4000h = 5E000h.
 187  80EF              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
 188  80EF              ; Return A=0 on success, A=1 on mismatch.
 189  80EF              ; -------------------------------------------------------------------------
 190  80EF              VerifyFramebuffer:
 191  80EF AF                   XOR     A
 192  80F0 01 DF 03             LD      BC,$03DF
 193  80F3 ED 79                OUT     (C),A
 194  80F5
 195  80F5 21 00 C0             LD      HL,$C000
 196  80F8                      ; First eight pixels are black: bytes 0..15 must be zero.
 197  80F8 7E                   LD      A,(HL)
 198  80F9 B7                   OR      A
 199  80FA 20 23                JR      NZ,VerifyFailed
 200  80FC 23                   INC     HL
 201  80FD 7E                   LD      A,(HL)
 202  80FE B7                   OR      A
 203  80FF 20 1E                JR      NZ,VerifyFailed
 204  8101
 205  8101                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
 206  8101 21 10 C0             LD      HL,$C010
 207  8104 7E                   LD      A,(HL)
 208  8105 FE 1F                CP      $1F
 209  8107 20 16                JR      NZ,VerifyFailed
 210  8109 23                   INC     HL
 211  810A 7E                   LD      A,(HL)
 212  810B B7                   OR      A
 213  810C 20 11                JR      NZ,VerifyFailed
 214  810E
 215  810E 3E 25                LD      A,37
 216  8110 01 DF 03             LD      BC,$03DF
 217  8113 ED 79                OUT     (C),A
 218  8115 21 FF DF             LD      HL,$DFFF
 219  8118 7E                   LD      A,(HL)
 220  8119 FE FF                CP      $FF
 221  811B 20 02                JR      NZ,VerifyFailed
 222  811D
 223  811D AF                   XOR     A
 224  811E C9                   RET
 225  811F
 226  811F              VerifyFailed:
 227  811F 3E 01                LD      A,1
 228  8121 C9                   RET
 229  8122
 230  8122
 231  8122              ; -------------------------------------------------------------------------
 232  8122              ; Sweep the nine requested standard PC display resolutions.
 233  8122              ; Each mode uses 8-bpp indexed pixels and writes exactly its visible
 234  8122              ; framebuffer size. Use only the adapter's initialized EGA palette
 235  8122              ; entries 0..7, matching the proven Project132 test pattern.
 236  8122              ; SPACE advances to the next resolution.
 237  8122              ; -------------------------------------------------------------------------
 238  8122              RunPackedModeSweep:
 239  8122 21 74 8B             LD      HL,MsgSweepStart
 240  8125 CD 5D 86             CALL    DebugPrint
 241  8128 21 A6 86             LD      HL,PackedModeTable
 242  812B 22 6F 86             LD      (ModeTablePtr),HL
 243  812E 21 02 87             LD      HL,ModeLabelTable
 244  8131 22 66 86             LD      (ModeLabelPtr),HL
 245  8134 3E 09                LD      A,9
 246  8136 32 71 86             LD      (ModeCount),A
 247  8139
 248  8139              ; Outer loop: increase resolution only after all four palette sizes pass.
 249  8139              PackedModeNext:
 250  8139 2A 6F 86             LD      HL,(ModeTablePtr)
 251  813C 7E                   LD      A,(HL)
 252  813D 23                   INC     HL
 253  813E 32 72 86             LD      (ModeXLo),A
 254  8141 7E                   LD      A,(HL)
 255  8142 23                   INC     HL
 256  8143 32 73 86             LD      (ModeXHi),A
 257  8146 7E                   LD      A,(HL)
 258  8147 23                   INC     HL
 259  8148 32 74 86             LD      (ModeYLo),A
 260  814B 7E                   LD      A,(HL)
 261  814C 23                   INC     HL
 262  814D 32 75 86             LD      (ModeYHi),A
 263  8150 7E                   LD      A,(HL)
 264  8151 23                   INC     HL
 265  8152 32 76 86             LD      (ModeBpp),A
 266  8155 7E                   LD      A,(HL)
 267  8156 23                   INC     HL
 268  8157 32 77 86             LD      (ModeBankCount),A
 269  815A 7E                   LD      A,(HL)
 270  815B 23                   INC     HL
 271  815C 32 78 86             LD      (ModeLastBankBytes),A
 272  815F 7E                   LD      A,(HL)
 273  8160 23                   INC     HL
 274  8161 32 79 86             LD      (ModeLastBankBytes+1),A
 275  8164 22 6F 86             LD      (ModeTablePtr),HL
 276  8167
 277  8167 CD DC 81             CALL    ConfigureCurrentMode
 278  816A CD D7 85             CALL    SpectrumShowMode
 279  816D
 280  816D AF                   XOR     A
 281  816E 32 7A 86             LD      (PaletteLevel),A
 282  8171
 283  8171              ; Inner loop: 2, 4, 16 and 256 DAC entries at this resolution.
 284  8171              PackedPaletteNext:
 285  8171 CD 11 82             CALL    SelectPaletteParameters
 286  8174 CD 40 82             CALL    ProgramDacPalette
 287  8177
 288  8177                      ; Legacy DAC writes disable VBE in the adapter model.
 289  8177                      ; Re-apply this resolution's indexed 8-bpp mode before VRAM access.
 290  8177 CD DC 81             CALL    ConfigureCurrentMode
 291  817A
 292  817A 21 E1 8B             LD      HL,MsgPaletteLevel
 293  817D CD 5D 86             CALL    DebugPrint
 294  8180 3A 7A 86             LD      A,(PaletteLevel)
 295  8183 CD 43 86             CALL    DebugHexByte
 296  8186 21 F0 8B             LD      HL,MsgPaletteSuffix
 297  8189 CD 5D 86             CALL    DebugPrint
 298  818C
 299  818C                      ; Verify the DAC before touching the framebuffer. This keeps all
 300  818C                      ; DAC read-index/component activity out of the post-render phase.
 301  818C CD 11 82             CALL    SelectPaletteParameters
 302  818F CD 0E 83             CALL    VerifyDacPalette
 303  8192 B7                   OR      A
 304  8193 20 3A                JR      NZ,PackedPaletteFailed
 305  8195
 306  8195 CD 7C 82             CALL    FillModeVRAM
 307  8198
 308  8198 21 0F 8C             LD      HL,MsgPalettePass
 309  819B CD 5D 86             CALL    DebugPrint
 310  819E CD 03 86             CALL    SpectrumShowWriteComplete
 311  81A1 CD 33 86             CALL    WaitSpace
 312  81A4
 313  81A4 3A 7A 86             LD      A,(PaletteLevel)
 314  81A7 3C                   INC     A
 315  81A8 32 7A 86             LD      (PaletteLevel),A
 316  81AB FE 04                CP      4
 317  81AD 20 C2                JR      NZ,PackedPaletteNext
 318  81AF
 319  81AF 3A 71 86             LD      A,(ModeCount)
 320  81B2 3D                   DEC     A
 321  81B3 32 71 86             LD      (ModeCount),A
 322  81B6 C2 39 81             JP      NZ,PackedModeNext
 323  81B9
 324  81B9 21 BD 8B             LD      HL,MsgSweepDone
 325  81BC CD 5D 86             CALL    DebugPrint
 326  81BF CD 5E 85             CALL    SpectrumClear
 327  81C2 21 96 8C             LD      HL,ScreenTitle
 328  81C5 CD AA 84             CALL    SpectrumPrint
 329  81C8 21 D5 8D             LD      HL,ScreenAllDone
 330  81CB CD AA 84             CALL    SpectrumPrint
 331  81CE C9                   RET
 332  81CF
 333  81CF              PackedPaletteFailed:
 334  81CF 21 23 8C             LD      HL,MsgPaletteFail
 335  81D2 CD 5D 86             CALL    DebugPrint
 336  81D5 CD 94 84             CALL    SpectrumShowDacFail
 337  81D8 CD 33 86             CALL    WaitSpace
 338  81DB C9                   RET
 339  81DC
 340  81DC              ; Re-apply the currently selected packed-pixel 8-bpp resolution.
 341  81DC              ConfigureCurrentMode:
 342  81DC 3A 72 86             LD      A,(ModeXLo)
 343  81DF 5F                   LD      E,A
 344  81E0 3E 00                LD      A,0
 345  81E2 CD A0 80             CALL    WriteVgaRegister
 346  81E5 3A 73 86             LD      A,(ModeXHi)
 347  81E8 5F                   LD      E,A
 348  81E9 3E 01                LD      A,1
 349  81EB CD A0 80             CALL    WriteVgaRegister
 350  81EE 3A 74 86             LD      A,(ModeYLo)
 351  81F1 5F                   LD      E,A
 352  81F2 3E 02                LD      A,2
 353  81F4 CD A0 80             CALL    WriteVgaRegister
 354  81F7 3A 75 86             LD      A,(ModeYHi)
 355  81FA 5F                   LD      E,A
 356  81FB 3E 03                LD      A,3
 357  81FD CD A0 80             CALL    WriteVgaRegister
 358  8200 3E 08                LD      A,8
 359  8202 5F                   LD      E,A
 360  8203 3E 04                LD      A,4
 361  8205 CD A0 80             CALL    WriteVgaRegister
 362  8208 3E 01                LD      A,1
 363  820A 5F                   LD      E,A
 364  820B 3E 05                LD      A,5
 365  820D CD A0 80             CALL    WriteVgaRegister
 366  8210 C9                   RET
 367  8211
 368  8211              ; Palette table entry: count (word), index mask (byte), DAC source stride
 369  8211              ; beyond RGB (word). The RGB332 source table contains 256 evenly ordered
 370  8211              ; entries, so each smaller palette samples the full colour range.
 371  8211              SelectPaletteParameters:
 372  8211 21 EE 86             LD      HL,PaletteConfigTable
 373  8214 3A 7A 86             LD      A,(PaletteLevel)
 374  8217 B7                   OR      A
 375  8218 28 07                JR      Z,PaletteConfigFound
 376  821A 47                   LD      B,A
 377  821B              PaletteConfigSkip:
 378  821B 11 05 00             LD      DE,5
 379  821E 19                   ADD     HL,DE
 380  821F 10 FA                DJNZ    PaletteConfigSkip
 381  8221              PaletteConfigFound:
 382  8221 7E                   LD      A,(HL)
 383  8222 23                   INC     HL
 384  8223 32 7C 86             LD      (PaletteRemaining),A
 385  8226 32 7E 86             LD      (PaletteCount),A
 386  8229 7E                   LD      A,(HL)
 387  822A 23                   INC     HL
 388  822B 32 7D 86             LD      (PaletteRemaining+1),A
 389  822E 32 7F 86             LD      (PaletteCount+1),A
 390  8231 7E                   LD      A,(HL)
 391  8232 23                   INC     HL
 392  8233 32 7B 86             LD      (PaletteMask),A
 393  8236 7E                   LD      A,(HL)
 394  8237 23                   INC     HL
 395  8238 32 80 86             LD      (PaletteStride),A
 396  823B 7E                   LD      A,(HL)
 397  823C 32 81 86             LD      (PaletteStride+1),A
 398  823F C9                   RET
 399  8240
 400  8240              ; Program the selected number of DAC entries sampled from the 256-step HSV hue ramp.
 401  8240              ProgramDacPalette:
 402  8240 21 DF 8E             LD      HL,DacHuePalette
 403  8243 ED 5B 80 86          LD      DE,(PaletteStride)
 404  8247 AF                   XOR     A
 405  8248 32 68 86             LD      (DacIndex),A
 406  824B              ProgramDacPaletteLoop:
 407  824B 3A 68 86             LD      A,(DacIndex)
 408  824E 01 C8 03             LD      BC,$03C8
 409  8251 ED 79                OUT     (C),A
 410  8253 01 C9 03             LD      BC,$03C9
 411  8256 7E                   LD      A,(HL)
 412  8257 23                   INC     HL
 413  8258 ED 79                OUT     (C),A
 414  825A 7E                   LD      A,(HL)
 415  825B 23                   INC     HL
 416  825C ED 79                OUT     (C),A
 417  825E 7E                   LD      A,(HL)
 418  825F 23                   INC     HL
 419  8260 ED 79                OUT     (C),A
 420  8262 19                   ADD     HL,DE
 421  8263 3A 68 86             LD      A,(DacIndex)
 422  8266 3C                   INC     A
 423  8267 32 68 86             LD      (DacIndex),A
 424  826A E5                   PUSH    HL
 425  826B CD 72 82             CALL    DecPaletteRemaining
 426  826E E1                   POP     HL
 427  826F 20 DA                JR      NZ,ProgramDacPaletteLoop
 428  8271 C9                   RET
 429  8272
 430  8272              DecPaletteRemaining:
 431  8272 2A 7C 86             LD      HL,(PaletteRemaining)
 432  8275 2B                   DEC     HL
 433  8276 22 7C 86             LD      (PaletteRemaining),HL
 434  8279 7C                   LD      A,H
 435  827A B5                   OR      L
 436  827B C9                   RET
 437  827C
 438  827C              ; Fill the framebuffer with a full-width horizontal hue gradient.
 439  827C              ; Palette entries are sampled evenly from the first to last hue.
 440  827C              ; A 16-bit accumulator spreads palette transitions uniformly across each row.
 441  827C              FillModeVRAM:
 442  827C AF                   XOR     A
 443  827D 32 65 86             LD      (CurrentBank),A
 444  8280 32 68 86             LD      (DacIndex),A
 445  8283 21 00 00             LD      HL,0
 446  8286 22 82 86             LD      (GradientAccumulator),HL
 447  8289 22 84 86             LD      (ModeXCounter),HL
 448  828C              ModeFillBank:
 449  828C 3A 65 86             LD      A,(CurrentBank)
 450  828F 01 DF 03             LD      BC,$03DF
 451  8292 ED 79                OUT     (C),A
 452  8294 21 00 C0             LD      HL,$C000
 453  8297 3A 65 86             LD      A,(CurrentBank)
 454  829A 47                   LD      B,A
 455  829B 3A 77 86             LD      A,(ModeBankCount)
 456  829E 3D                   DEC     A
 457  829F B8                   CP      B
 458  82A0 20 06                JR      NZ,ModeFillFullBank
 459  82A2 ED 4B 78 86          LD      BC,(ModeLastBankBytes)
 460  82A6 18 03                JR      ModeFillCountReady
 461  82A8              ModeFillFullBank:
 462  82A8 01 00 40             LD      BC,$4000
 463  82AB              ModeFillCountReady:
 464  82AB              ModeFillByte:
 465  82AB 3A 68 86             LD      A,(DacIndex)
 466  82AE 77                   LD      (HL),A
 467  82AF 23                   INC     HL
 468  82B0 E5                   PUSH    HL
 469  82B1
 470  82B1                      ; Advance the X coordinate and detect the end of the scanline.
 471  82B1 2A 84 86             LD      HL,(ModeXCounter)
 472  82B4 23                   INC     HL
 473  82B5 22 84 86             LD      (ModeXCounter),HL
 474  82B8 E5                   PUSH    HL
 475  82B9 3A 72 86             LD      A,(ModeXLo)
 476  82BC 5F                   LD      E,A
 477  82BD 3A 73 86             LD      A,(ModeXHi)
 478  82C0 57                   LD      D,A
 479  82C1 B7                   OR      A
 480  82C2 ED 52                SBC     HL,DE
 481  82C4 E1                   POP     HL
 482  82C5 20 0F                JR      NZ,ModeGradientAdvance
 483  82C7
 484  82C7                      ; Restart the gradient at the beginning of every scanline.
 485  82C7 21 00 00             LD      HL,0
 486  82CA 22 84 86             LD      (ModeXCounter),HL
 487  82CD 22 82 86             LD      (GradientAccumulator),HL
 488  82D0 AF                   XOR     A
 489  82D1 32 68 86             LD      (DacIndex),A
 490  82D4 18 21                JR      ModePatternAdvanceDone
 491  82D6
 492  82D6              ModeGradientAdvance:
 493  82D6                      ; Bresenham-style distribution: add palette count per pixel and
 494  82D6                      ; advance the DAC index whenever the accumulator reaches width.
 495  82D6 2A 82 86             LD      HL,(GradientAccumulator)
 496  82D9 ED 5B 7E 86          LD      DE,(PaletteCount)
 497  82DD 19                   ADD     HL,DE
 498  82DE ED 5B 72 86          LD      DE,(ModeXLo)
 499  82E2 B7                   OR      A
 500  82E3 ED 52                SBC     HL,DE
 501  82E5 38 0C                JR      C,ModeGradientHold
 502  82E7 22 82 86             LD      (GradientAccumulator),HL
 503  82EA 3A 68 86             LD      A,(DacIndex)
 504  82ED 3C                   INC     A
 505  82EE 32 68 86             LD      (DacIndex),A
 506  82F1 18 04                JR      ModePatternAdvanceDone
 507  82F3              ModeGradientHold:
 508  82F3 19                   ADD     HL,DE
 509  82F4 22 82 86             LD      (GradientAccumulator),HL
 510  82F7
 511  82F7              ModePatternAdvanceDone:
 512  82F7 E1                   POP     HL
 513  82F8 0B                   DEC     BC
 514  82F9 78                   LD      A,B
 515  82FA B1                   OR      C
 516  82FB C2 AB 82             JP      NZ,ModeFillByte
 517  82FE 3A 65 86             LD      A,(CurrentBank)
 518  8301 3C                   INC     A
 519  8302 32 65 86             LD      (CurrentBank),A
 520  8305 47                   LD      B,A
 521  8306 3A 77 86             LD      A,(ModeBankCount)
 522  8309 B8                   CP      B
 523  830A C2 8C 82             JP      NZ,ModeFillBank
 524  830D C9                   RET
 525  830E
 526  830E              ; Read back every programmed DAC entry, including all RGB components.
 527  830E              ; Return A=0 on success, A=1 on mismatch.
 528  830E              VerifyDacPalette:
 529  830E 21 DF 8E             LD      HL,DacHuePalette
 530  8311 ED 5B 80 86          LD      DE,(PaletteStride)
 531  8315 AF                   XOR     A
 532  8316 32 68 86             LD      (DacIndex),A
 533  8319              VerifyDacPaletteLoop:
