 538  8348              ; -------------------------------------------------------------------------
 539  8348              ; Project131-compatible 2D accelerator smoke test.
 540  8348              ; Uses 320x200x8bpp so the complete 64,000-byte framebuffer is in banks 0..3.
 541  8348              ; Tests solid fill, VRAM-to-VRAM BitBLT, Bresenham line and status/readback.
 542  8348              ; Returns A=0 on success, A=1 on failure.
 543  8348              ; -------------------------------------------------------------------------
 544  8348              Run2DAcceleratorTest:
 545  8348 21 70 92             LD      HL,Msg2DStart
 546  834B CD E7 8C             CALL    DebugPrint
 547  834E CD 26 8A             CALL    SpectrumShow2DStart
 548  8351
 549  8351                      ; The adapter powers up with a zeroed DAC. Program visible colours
 550  8351                      ; before the first 8-bpp test, then restore VBE mode (DAC writes
 551  8351                      ; switch the adapter to legacy software mode).
 552  8351 CD E3 81             CALL    Program2DTestPalette
 553  8354
 554  8354                      ; Select 320x200x8bpp.
 555  8354 3E 40                LD      A,320&255
 556  8356 32 01 8D             LD      (ModeXLo),A
 557  8359 3E 01                LD      A,320>>8
 558  835B 32 02 8D             LD      (ModeXHi),A
 559  835E 3E C8                LD      A,200&255
 560  8360 32 03 8D             LD      (ModeYLo),A
 561  8363 AF                   XOR     A
 562  8364 32 04 8D             LD      (ModeYHi),A
 563  8367 CD A0 87             CALL    ConfigureCurrentMode
 564  836A
 565  836A                      ; SOLID FILL: destination (20,20), 100x60, colour E3h.
 566  836A 21 31 87             LD      HL,AccelFillRegs
 567  836D 3E 26                LD      A,AccelFillRegsEnd-AccelFillRegs
 568  836F CD FD 86             CALL    WriteAccelRegisterTable
 569  8372 3E 00                LD      A,0
 570  8374 1E 01                LD      E,1
 571  8376 CD 14 87             CALL    WriteAccelRegister
 572  8379 CD 1E 87             CALL    CheckAccelDone
 573  837C B7                   OR      A
 574  837D C0                   RET     NZ
 575  837E
 576  837E                      ; BITBLT: copy the filled rectangle to (140,20).
 577  837E 21 57 87             LD      HL,AccelBlitRegs
 578  8381 3E 22                LD      A,AccelBlitRegsEnd-AccelBlitRegs
 579  8383 CD FD 86             CALL    WriteAccelRegisterTable
 580  8386 3E 00                LD      A,0
 581  8388 1E 02                LD      E,2
 582  838A CD 14 87             CALL    WriteAccelRegister
 583  838D CD 1E 87             CALL    CheckAccelDone
 584  8390 B7                   OR      A
 585  8391 C0                   RET     NZ
 586  8392
 587  8392                      ; LINE: draw from (0,0) to (319,199), colour FFh.
 588  8392 21 79 87             LD      HL,AccelLineRegs
 589  8395 3E 1E                LD      A,AccelLineRegsEnd-AccelLineRegs
 590  8397 CD FD 86             CALL    WriteAccelRegisterTable
 591  839A 3E 00                LD      A,0
 592  839C 1E 03                LD      E,3
 593  839E CD 14 87             CALL    WriteAccelRegister
 594  83A1 CD 1E 87             CALL    CheckAccelDone
 595  83A4 B7                   OR      A
 596  83A5 C0                   RET     NZ
 597  83A6
 598  83A6                      ; Read back the source and copied destination pixels in bank 0.
 599  83A6 AF                   XOR     A
 600  83A7 01 DF 03             LD      BC,$03DF
 601  83AA ED 79                OUT     (C),A
 602  83AC 21 14 D9             LD      HL,$D914             ; 20*320 + 20 + C000h
 603  83AF 7E                   LD      A,(HL)
 604  83B0 FE E3                CP      $E3
 605  83B2 C2 EE 86             JP      NZ,AccelReadbackFail
 606  83B5 21 8C D9             LD      HL,$D98C             ; 20*320 + 140 + C000h
 607  83B8 7E                   LD      A,(HL)
 608  83B9 FE E3                CP      $E3
 609  83BB C2 EE 86             JP      NZ,AccelReadbackFail
 610  83BE
 611  83BE                      ; The final line pixel is linear offset 63999 = bank 3:3A00?
 612  83BE                      ; Bank 3 aperture address = C000h + (63999 - 49152) = F9FFh.
 613  83BE 3E 03                LD      A,3
 614  83C0 01 DF 03             LD      BC,$03DF
 615  83C3 ED 79                OUT     (C),A
 616  83C5 21 FF F9             LD      HL,$F9FF
 617  83C8 7E                   LD      A,(HL)
 618  83C9 FE FF                CP      $FF
 619  83CB C2 EE 86             JP      NZ,AccelReadbackFail
 620  83CE
 621  83CE 21 92 92             LD      HL,Msg2DPass
 622  83D1 CD E7 8C             CALL    DebugPrint
 623  83D4 CD C0 8A             CALL    SpectrumShow2DPass
 624  83D7 CD BD 8C             CALL    WaitSpace
 625  83DA
 626  83DA                      ; Follow the primitive smoke test with a 256-colour gradient
 627  83DA                      ; generated by the dedicated 2D gradient-fill command.
 628  83DA CD 31 82             CALL    Run2DGradientTest
 629  83DD B7                   OR      A
 630  83DE C0                   RET     NZ
 631  83DF CD 59 84             CALL    RunTextModeTest
 632  83E2 C9                   RET
 633  83E3
 634  83E3              ; Restore the standard 16-colour VGA/EGA DAC palette (6-bit RGB).
 635  83E3              ; This keeps the text-mode colour test independent of the preceding
 636  83E3              ; programmable 256-entry gradient test.
 637  83E3              ProgramStandardEgaPalette:
 638  83E3 01 C8 03             LD      BC,$03C8
 639  83E6 AF                   XOR     A
 640  83E7 ED 79                OUT     (C),A
 641  83E9 01 C9 03             LD      BC,$03C9
 642  83EC 21 F9 83             LD      HL,StandardEgaPalette
 643  83EF 16 30                LD      D,48
 644  83F1              StandardEgaPaletteWrite:
 645  83F1 7E                   LD      A,(HL)
 646  83F2 ED 79                OUT     (C),A
 647  83F4 23                   INC     HL
 648  83F5 15                   DEC     D
 649  83F6 20 F9                JR      NZ,StandardEgaPaletteWrite
 650  83F8 C9                   RET
 651  83F9
 652  83F9              StandardEgaPalette:
 653  83F9                      ; RGB triples, DAC range 00h..3Fh.
 654  83F9 00 00 00 00          DB $00,$00,$00, $00,$00,$2A, $00,$2A,$00, $00,$2A,$2A
 654  83FD 00 2A 00 2A
 654  8401 00 00 2A 2A
 655  8405 2A 00 00 2A          DB $2A,$00,$00, $2A,$00,$2A, $2A,$15,$00, $2A,$2A,$2A
 655  8409 00 2A 2A 15
 655  840D 00 2A 2A 2A
 656  8411 15 15 15 15          DB $15,$15,$15, $15,$15,$3F, $15,$3F,$15, $15,$3F,$3F
 656  8415 15 3F 15 3F
 656  8419 15 15 3F 3F
 657  841D 3F 15 15 3F          DB $3F,$15,$15, $3F,$15,$3F, $3F,$3F,$15, $3F,$3F,$3F
 657  8421 15 3F 3F 3F
 657  8425 15 3F 3F 3F
 658  8429
 659  8429              ; IBM VGA mode 3 CRTC timing. Indexed register/value pairs.
 660  8429              ; CR11 is written with bit 7 clear to unlock vertical timing registers.
 661  8429              TextCrtcMode3:
 662  8429                      ; Unlock protected CRTC registers before changing horizontal timing.
 663  8429 11 0E                DB $11,$0E
 664  842B 00 5F 01 4F          DB $00,$5F, $01,$4F, $02,$50, $03,$82
 664  842F 02 50 03 82
 665  8433 04 54 05 80          DB $04,$54, $05,$80, $06,$BF, $07,$1F
 665  8437 06 BF 07 1F
 666  843B 09 0F 0A 0D          DB $09,$0F, $0A,$0D, $0B,$0E, $0C,$80
 666  843F 0B 0E 0C 80
 667  8443 0D 00 0E 00          DB $0D,$00, $0E,$00, $0F,$00, $10,$9C
 667  8447 0F 00 10 9C
 668  844B 12 8F 13 28          DB $12,$8F, $13,$28, $14,$00, $15,$96
 668  844F 14 00 15 96
 669  8453 16 B9 17 83          DB $16,$B9, $17,$83, $18,$FF
 669  8457 18 FF
 670  8459
 671  8459              ; -------------------------------------------------------------------------
 672  8459              ; VGA text-mode test: 80x25, character plane 0, attribute plane 1.
 673  8459              ; Uses the adapter's bank-6 text aperture (C000h-C7CFh).
 674  8459              ; Scrolls rows 1..24 to rows 0..23, clears row 24, then verifies
 675  8459              ; character and attribute readback through the VGA plane read map.
 676  8459              ; -------------------------------------------------------------------------
 677  8459              RunTextModeTest:
 678  8459 21 1E 93             LD      HL,MsgTextStart
 679  845C CD E7 8C             CALL    DebugPrint
 680  845F CD 52 8A             CALL    SpectrumShowTextStart
 681  8462
 682  8462                      ; The preceding 256-colour gradient test leaves a custom DAC ramp.
 683  8462                      ; Restore the standard 16-colour VGA palette before testing text
 684  8462                      ; attributes, which are expected to use the conventional EGA colours.
 685  8462 CD E3 83             CALL    ProgramStandardEgaPalette
 686  8465
 687  8465                      ; Program the VGA CRTC for a real 80-column, 25-row mode 3
 688  8465                      ; timing (720x400, 9-dot characters, 16 scanlines per row).
 689  8465                      ; The adapter must derive text geometry from these registers;
 690  8465                      ; the renderer must not invent a default column count.
 691  8465 21 29 84             LD      HL,TextCrtcMode3
 692  8468 16 18                LD      D,24
 693  846A 01 D4 03             LD      BC,$03D4
 694  846D              TextCrtcWrite:
 695  846D 7E                   LD      A,(HL)
 696  846E ED 79                OUT     (C),A
 697  8470 23                   INC     HL
 698  8471 0C                   INC     C
 699  8472 7E                   LD      A,(HL)
 700  8473 ED 79                OUT     (C),A
 701  8475 23                   INC     HL
 702  8476 0D                   DEC     C
 703  8477 15                   DEC     D
 704  8478 20 F3                JR      NZ,TextCrtcWrite
 705  847A
 706  847A                      ; Text lives in Spectrum bridge bank 6 (plane offset 18000h).
 707  847A                      ; CRTC[1E].A0 adds MA16, so start 8000h resolves to 18000h
 708  847A                      ; before PCem's four-byte interleaved display-address conversion.
 709  847A 01 D4 03             LD      BC,$03D4
 710  847D 3E 1E                LD      A,$1E
 711  847F ED 79                OUT     (C),A
 712  8481 0C                   INC     C
 713  8482 3E A0                LD      A,$A0
 714  8484 ED 79                OUT     (C),A
 715  8486
