 109  8094 18 FD                JR      VgaTestFailedIdle
 110  8096
 111  8096              ; -------------------------------------------------------------------------
 112  8096              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
 113  8096              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
 114  8096              ; -------------------------------------------------------------------------
 115  8096              OpenATMShadowPorts:
 116  8096 01 A6 80             LD      BC,ShadowPortsOpened
 117  8099 C5                   PUSH    BC
 118  809A 01 53 2A             LD      BC,$2A53
 119  809D C5                   PUSH    BC
 120  809E 01 77 01             LD      BC,$0177
 121  80A1 3E C3                LD      A,$C3
 122  80A3 C3 2F 3D             JP      $3D2F
 123  80A6              ShadowPortsOpened:
 124  80A6 C9                   RET
 125  80A7
 126  80A7              ; A = indexed VGA register, E = value.
 127  80A7              WriteVgaRegister:
 128  80A7 01 E0 03             LD      BC,$03E0
 129  80AA ED 79                OUT     (C),A
 130  80AC 7B                   LD      A,E
 131  80AD 0C                   INC     C
 132  80AE ED 79                OUT     (C),A
 133  80B0 C9                   RET
 134  80B1
 135  80B1              ; -------------------------------------------------------------------------
 136  80B1              ; Fill the 640x480x16 framebuffer.
 137  80B1              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
 138  80B1              ; The aperture C000h-FFFFh is switched with port 3DFh.
 139  80B1              ; -------------------------------------------------------------------------
 140  80B1              Fill640x480x16:
 141  80B1 AF                   XOR     A
 142  80B2 32 65 89             LD      (CurrentBank),A
 143  80B5
 144  80B5              FillBankLoop:
 145  80B5 3A 65 89             LD      A,(CurrentBank)
 146  80B8 01 DF 03             LD      BC,$03DF
 147  80BB ED 79                OUT     (C),A
 148  80BD
 149  80BD 21 00 C0             LD      HL,$C000
 150  80C0 11 1D 8D             LD      DE,ColorPattern
 151  80C3 3A 65 89             LD      A,(CurrentBank)
 152  80C6 FE 25                CP      37
 153  80C8 28 05                JR      Z,FillLastHalfBank
 154  80CA 01 00 40             LD      BC,$4000
 155  80CD 18 03                JR      FillBankBytes
 156  80CF
 157  80CF              FillLastHalfBank:
 158  80CF 01 00 20             LD      BC,$2000
 159  80D2
 160  80D2              FillBankBytes:
 161  80D2 1A                   LD      A,(DE)
 162  80D3 13                   INC     DE
 163  80D4 77                   LD      (HL),A
 164  80D5 23                   INC     HL
 165  80D6
 166  80D6                      ; Repeat the 128-byte RGB565 colour-bar sequence.
 167  80D6 F5                   PUSH    AF
 168  80D7 7A                   LD      A,D
 169  80D8 FE 8D                CP      HIGH ColorPatternEnd
 170  80DA 20 08                JR      NZ,PatternPointerReady
 171  80DC 7B                   LD      A,E
 172  80DD FE 9D                CP      LOW ColorPatternEnd
 173  80DF 20 03                JR      NZ,PatternPointerReady
 174  80E1 11 1D 8D             LD      DE,ColorPattern
 175  80E4              PatternPointerReady:
 176  80E4 F1                   POP     AF
 177  80E5
 178  80E5 0B                   DEC     BC
 179  80E6 78                   LD      A,B
 180  80E7 B1                   OR      C
 181  80E8 20 E8                JR      NZ,FillBankBytes
 182  80EA
 183  80EA 3A 65 89             LD      A,(CurrentBank)
 184  80ED 3C                   INC     A
 185  80EE 32 65 89             LD      (CurrentBank),A
 186  80F1 FE 26                CP      38
 187  80F3 20 C0                JR      NZ,FillBankLoop
 188  80F5 C9                   RET
 189  80F6
 190  80F6              ; -------------------------------------------------------------------------
 191  80F6              ; Readback checks:
 192  80F6              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
 193  80F6              ; bank 37 starts at linear offset 37*4000h = 5E000h.
 194  80F6              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
 195  80F6              ; Return A=0 on success, A=1 on mismatch.
 196  80F6              ; -------------------------------------------------------------------------
 197  80F6              VerifyFramebuffer:
 198  80F6 AF                   XOR     A
 199  80F7 01 DF 03             LD      BC,$03DF
 200  80FA ED 79                OUT     (C),A
 201  80FC
 202  80FC 21 00 C0             LD      HL,$C000
 203  80FF                      ; First eight pixels are black: bytes 0..15 must be zero.
 204  80FF 7E                   LD      A,(HL)
 205  8100 B7                   OR      A
 206  8101 20 23                JR      NZ,VerifyFailed
 207  8103 23                   INC     HL
 208  8104 7E                   LD      A,(HL)
 209  8105 B7                   OR      A
 210  8106 20 1E                JR      NZ,VerifyFailed
 211  8108
 212  8108                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
 213  8108 21 10 C0             LD      HL,$C010
 214  810B 7E                   LD      A,(HL)
 215  810C FE 1F                CP      $1F
 216  810E 20 16                JR      NZ,VerifyFailed
 217  8110 23                   INC     HL
 218  8111 7E                   LD      A,(HL)
 219  8112 B7                   OR      A
 220  8113 20 11                JR      NZ,VerifyFailed
 221  8115
 222  8115 3E 25                LD      A,37
 223  8117 01 DF 03             LD      BC,$03DF
 224  811A ED 79                OUT     (C),A
 225  811C 21 FF DF             LD      HL,$DFFF
 226  811F 7E                   LD      A,(HL)
 227  8120 FE FF                CP      $FF
 228  8122 20 02                JR      NZ,VerifyFailed
 229  8124
 230  8124 AF                   XOR     A
 231  8125 C9                   RET
 232  8126
 233  8126              VerifyFailed:
 234  8126 3E 01                LD      A,1
 235  8128 C9                   RET
 236  8129
 237  8129
 238  8129              ; -------------------------------------------------------------------------
 239  8129              ; Sweep the nine requested standard PC display resolutions.
 240  8129              ; Each mode uses 8-bpp indexed pixels and writes exactly its visible
 241  8129              ; framebuffer size. Use only the adapter's initialized EGA palette
 242  8129              ; entries 0..7, matching the proven Project132 test pattern.
 243  8129              ; SPACE advances to the next resolution.
 244  8129              ; -------------------------------------------------------------------------
 245  8129              RunPackedModeSweep:
 246  8129 21 78 8E             LD      HL,MsgSweepStart
 247  812C CD 5D 89             CALL    DebugPrint
 248  812F 21 AA 89             LD      HL,PackedModeTable
 249  8132 22 73 89             LD      (ModeTablePtr),HL
 250  8135 21 06 8A             LD      HL,ModeLabelTable
 251  8138 22 6A 89             LD      (ModeLabelPtr),HL
 252  813B 3E 09                LD      A,9
 253  813D 32 75 89             LD      (ModeCount),A
 254  8140
 255  8140              ; Outer loop: increase resolution only after all four palette sizes pass.
 256  8140              PackedModeNext:
 257  8140 2A 73 89             LD      HL,(ModeTablePtr)
 258  8143 7E                   LD      A,(HL)
 259  8144 23                   INC     HL
 260  8145 32 76 89             LD      (ModeXLo),A
 261  8148 7E                   LD      A,(HL)
 262  8149 23                   INC     HL
 263  814A 32 77 89             LD      (ModeXHi),A
 264  814D 7E                   LD      A,(HL)
 265  814E 23                   INC     HL
 266  814F 32 78 89             LD      (ModeYLo),A
 267  8152 7E                   LD      A,(HL)
 268  8153 23                   INC     HL
 269  8154 32 79 89             LD      (ModeYHi),A
 270  8157 7E                   LD      A,(HL)
 271  8158 23                   INC     HL
 272  8159 32 7A 89             LD      (ModeBpp),A
 273  815C 7E                   LD      A,(HL)
 274  815D 23                   INC     HL
 275  815E 32 7B 89             LD      (ModeBankCount),A
 276  8161 7E                   LD      A,(HL)
 277  8162 23                   INC     HL
 278  8163 32 7C 89             LD      (ModeLastBankBytes),A
 279  8166 7E                   LD      A,(HL)
 280  8167 23                   INC     HL
 281  8168 32 7D 89             LD      (ModeLastBankBytes+1),A
 282  816B 22 73 89             LD      (ModeTablePtr),HL
 283  816E
 284  816E CD 58 84             CALL    ConfigureCurrentMode
 285  8171 CD D7 88             CALL    SpectrumShowMode
 286  8174
 287  8174 AF                   XOR     A
 288  8175 32 7E 89             LD      (PaletteLevel),A
 289  8178
 290  8178              ; Inner loop: 2, 4, 16 and 256 DAC entries at this resolution.
 291  8178              PackedPaletteNext:
 292  8178 CD 8D 84             CALL    SelectPaletteParameters
 293  817B CD BC 84             CALL    ProgramDacPalette
 294  817E
 295  817E                      ; Legacy DAC writes disable VBE in the adapter model.
 296  817E                      ; Re-apply this resolution's indexed 8-bpp mode before VRAM access.
 297  817E CD 58 84             CALL    ConfigureCurrentMode
 298  8181
 299  8181 21 BB 90             LD      HL,MsgPaletteLevel
 300  8184 CD 5D 89             CALL    DebugPrint
 301  8187 3A 7E 89             LD      A,(PaletteLevel)
 302  818A CD 43 89             CALL    DebugHexByte
 303  818D 21 CA 90             LD      HL,MsgPaletteSuffix
 304  8190 CD 5D 89             CALL    DebugPrint
 305  8193
 306  8193                      ; Verify the DAC before touching the framebuffer. This keeps all
 307  8193                      ; DAC read-index/component activity out of the post-render phase.
 308  8193 CD 8D 84             CALL    SelectPaletteParameters
 309  8196 CD 8A 85             CALL    VerifyDacPalette
 310  8199 B7                   OR      A
 311  819A 20 3A                JR      NZ,PackedPaletteFailed
 312  819C
 313  819C CD F8 84             CALL    FillModeVRAM
 314  819F
 315  819F 21 E9 90             LD      HL,MsgPalettePass
 316  81A2 CD 5D 89             CALL    DebugPrint
 317  81A5 CD 03 89             CALL    SpectrumShowWriteComplete
 318  81A8 CD 33 89             CALL    WaitSpace
 319  81AB
 320  81AB 3A 7E 89             LD      A,(PaletteLevel)
 321  81AE 3C                   INC     A
 322  81AF 32 7E 89             LD      (PaletteLevel),A
 323  81B2 FE 04                CP      4
 324  81B4 20 C2                JR      NZ,PackedPaletteNext
 325  81B6
 326  81B6 3A 75 89             LD      A,(ModeCount)
 327  81B9 3D                   DEC     A
 328  81BA 32 75 89             LD      (ModeCount),A
 329  81BD C2 40 81             JP      NZ,PackedModeNext
 330  81C0
 331  81C0 21 C1 8E             LD      HL,MsgSweepDone
 332  81C3 CD 5D 89             CALL    DebugPrint
 333  81C6 CD 5E 88             CALL    SpectrumClear
 334  81C9 21 70 91             LD      HL,ScreenTitle
 335  81CC CD AA 87             CALL    SpectrumPrint
 336  81CF 21 AF 92             LD      HL,ScreenAllDone
 337  81D2 CD AA 87             CALL    SpectrumPrint
 338  81D5 C9                   RET
 339  81D6
 340  81D6              PackedPaletteFailed:
 341  81D6 21 FD 90             LD      HL,MsgPaletteFail
 342  81D9 CD 5D 89             CALL    DebugPrint
 343  81DC CD 94 87             CALL    SpectrumShowDacFail
 344  81DF CD 33 89             CALL    WaitSpace
 345  81E2 C9                   RET
 346  81E3
 347  81E3              ; Initialize only the entries used by the 2D smoke test.
 348  81E3              ; DAC components are six-bit values. Index 01 = blue, E3 = orange, FF = white.
 349  81E3              Program2DTestPalette:
 350  81E3 01 C8 03             LD      BC,$03C8
 351  81E6 AF                   XOR     A
 352  81E7 ED 79                OUT     (C),A
 353  81E9 01 C9 03             LD      BC,$03C9
 354  81EC AF                   XOR     A
 355  81ED ED 79                OUT     (C),A
 356  81EF ED 79                OUT     (C),A
 357  81F1 ED 79                OUT     (C),A
 358  81F3
 359  81F3 01 C8 03             LD      BC,$03C8
 360  81F6 3E 01                LD      A,1
 361  81F8 ED 79                OUT     (C),A
 362  81FA 01 C9 03             LD      BC,$03C9
 363  81FD 3E 00                LD      A,$00
 364  81FF ED 79                OUT     (C),A
 365  8201 3E 00                LD      A,$00
 366  8203 ED 79                OUT     (C),A
 367  8205 3E 3F                LD      A,$3F
 368  8207 ED 79                OUT     (C),A
 369  8209
 370  8209 01 C8 03             LD      BC,$03C8
 371  820C 3E E3                LD      A,$E3
 372  820E ED 79                OUT     (C),A
 373  8210 01 C9 03             LD      BC,$03C9
 374  8213 3E 3F                LD      A,$3F
 375  8215 ED 79                OUT     (C),A
 376  8217 3E 20                LD      A,$20
 377  8219 ED 79                OUT     (C),A
 378  821B AF                   XOR     A
 379  821C ED 79                OUT     (C),A
 380  821E
 381  821E 01 C8 03             LD      BC,$03C8
 382  8221 3E FF                LD      A,$FF
 383  8223 ED 79                OUT     (C),A
 384  8225 01 C9 03             LD      BC,$03C9
 385  8228 3E 3F                LD      A,$3F
 386  822A ED 79                OUT     (C),A
 387  822C ED 79                OUT     (C),A
 388  822E ED 79                OUT     (C),A
 389  8230 C9                   RET
 390  8231
 391  8231              ; -------------------------------------------------------------------------
 392  8231              ; 2D gradient test. One dedicated accelerator command (CMD=4) interpolates
 393  8231              ; the 8-bpp palette index from 00h to FFh across a 320x200 rectangle.
 394  8231              ; No CPU framebuffer writes and no per-column command loop are used.
 395  8231              ; Returns A=0 on success, A=1 on accelerator/readback failure.
 396  8231              ; -------------------------------------------------------------------------
 397  8231              Run2DGradientTest:
 398  8231 21 6D 8F             LD      HL,Msg2DGradientStart
 399  8234 CD 5D 89             CALL    DebugPrint
 400  8237 CD F4 86             CALL    SpectrumShow2DGradientStart
 401  823A
 402  823A 3E 03                LD      A,3
 403  823C 32 7E 89             LD      (PaletteLevel),A
 404  823F CD 8D 84             CALL    SelectPaletteParameters
 405  8242 CD BC 84             CALL    ProgramDacPalette
 406  8245 CD 58 84             CALL    ConfigureCurrentMode
 407  8248
 408  8248 21 E5 82             LD      HL,AccelGradientRegs
 409  824B 3E 2E                LD      A,AccelGradientRegsEnd-AccelGradientRegs
 410  824D CD B5 83             CALL    WriteAccelRegisterTable
 411  8250
 412  8250                      ; CMD 4: interpolate colour 00h -> FFh across 320 pixels.
 413  8250 3E 00                LD      A,0
 414  8252 1E 04                LD      E,4
 415  8254 CD CC 83             CALL    WriteAccelRegister
 416  8257 CD D6 83             CALL    CheckAccelDone
 417  825A B7                   OR      A
 418  825B C2 9F 82             JP      NZ,Run2DGradientStatusFailed
 419  825E
 420  825E                      ; Read back first, midpoint (x=160 -> 80h), and last pixel.
 421  825E AF                   XOR     A
 422  825F 01 DF 03             LD      BC,$03DF
 423  8262 ED 79                OUT     (C),A
 424  8264 21 00 C0             LD      HL,$C000
 425  8267 7E                   LD      A,(HL)
 426  8268 B7                   OR      A
 427  8269 20 6B                JR      NZ,Run2DGradientReadbackFailed
 428  826B 21 A0 C0             LD      HL,$C0A0
 429  826E 7E                   LD      A,(HL)
 430  826F FE 80                CP      $80
 431  8271 20 63                JR      NZ,Run2DGradientReadbackFailed
 432  8273 21 3F C1             LD      HL,$C13F
 433  8276 7E                   LD      A,(HL)
 434  8277 FE FF                CP      $FF
 435  8279 20 5B                JR      NZ,Run2DGradientReadbackFailed
 436  827B
 437  827B                      ; Verify the first and last pixels of the final scanline.
 438  827B                      ; Linear offsets 63680 and 63999 are in bank 3.
 439  827B 3E 03                LD      A,3
 440  827D 01 DF 03             LD      BC,$03DF
 441  8280 ED 79                OUT     (C),A
 442  8282 21 C0 F8             LD      HL,$F8C0             ; bank 3 + offset 63680
 443  8285 7E                   LD      A,(HL)
 444  8286 B7                   OR      A
 445  8287 20 4D                JR      NZ,Run2DGradientReadbackFailed
 446  8289 21 FF F9             LD      HL,$F9FF             ; bank 3 + offset 63999
 447  828C 7E                   LD      A,(HL)
 448  828D FE FF                CP      $FF
 449  828F 20 45                JR      NZ,Run2DGradientReadbackFailed
 450  8291
 451  8291 21 93 8F             LD      HL,Msg2DGradientPass
 452  8294 CD 5D 89             CALL    DebugPrint
 453  8297 CD 0A 87             CALL    SpectrumShow2DGradientPass
 454  829A CD 33 89             CALL    WaitSpace
 455  829D AF                   XOR     A
 456  829E C9                   RET
 457  829F
 458  829F              Run2DGradientStatusFailed:
 459  829F                      ; Preserve the adapter's diagnostic status before printing.
 460  829F 01 E2 03             LD      BC,$03E2
 461  82A2 3E 01                LD      A,1
 462  82A4 ED 79                OUT     (C),A
 463  82A6 0C                   INC     C
 464  82A7 ED 78                IN      A,(C)
 465  82A9 FE 81                CP      $81
 466  82AB 28 11                JR      Z,Run2DGradientVbeDisabled
 467  82AD FE 82                CP      $82
 468  82AF 28 12                JR      Z,Run2DGradientBadRect
 469  82B1 FE 83                CP      $83
 470  82B3 28 13                JR      Z,Run2DGradientBadAddress
 471  82B5 FE 84                CP      $84
 472  82B7 28 14                JR      Z,Run2DGradientBadCommand
 473  82B9 21 97 90             LD      HL,Msg2DGradientUnknownStatus
 474  82BC 18 12                JR      Run2DGradientReportStatus
 475  82BE              Run2DGradientVbeDisabled:
 476  82BE 21 E7 8F             LD      HL,Msg2DGradientVbeDisabled
 477  82C1 18 0D                JR      Run2DGradientReportStatus
 478  82C3              Run2DGradientBadRect:
 479  82C3 21 0E 90             LD      HL,Msg2DGradientBadRect
 480  82C6 18 08                JR      Run2DGradientReportStatus
 481  82C8              Run2DGradientBadAddress:
 482  82C8 21 3A 90             LD      HL,Msg2DGradientBadAddress
 483  82CB 18 03                JR      Run2DGradientReportStatus
 484  82CD              Run2DGradientBadCommand:
 485  82CD 21 69 90             LD      HL,Msg2DGradientBadCommand
 486  82D0              Run2DGradientReportStatus:
 487  82D0 CD 5D 89             CALL    DebugPrint
 488  82D3 C3 DC 82             JP      Run2DGradientFailCommon
 489  82D6
 490  82D6              Run2DGradientReadbackFailed:
 491  82D6              Run2DGradientFailed:
 492  82D6 21 C3 8F             LD      HL,Msg2DGradientFail
 493  82D9 CD 5D 89             CALL    DebugPrint
 494  82DC              Run2DGradientFailCommon:
 495  82DC CD 20 87             CALL    SpectrumShow2DGradientFail
 496  82DF CD 33 89             CALL    WaitSpace
 497  82E2 3E 01                LD      A,1
 498  82E4 C9                   RET
 499  82E5
 500  82E5              AccelGradientRegs:
 501  82E5 02 00                DB $02,$00
 502  82E7 08 00 09 00          DB $08,$00,$09,$00,$0A,$00,$0B,$00 ; destination base = 0
 502  82EB 0A 00 0B 00
 503  82EF 0E 40 0F 01          DB $0E,$40,$0F,$01                 ; destination pitch = 320
 504  82F3 14 00 15 00          DB $14,$00,$15,$00                 ; x = 0
 505  82F7 16 00 17 00          DB $16,$00,$17,$00                 ; y = 0
 506  82FB 18 40 19 01          DB $18,$40,$19,$01                 ; width = 320
 507  82FF 1A C8 1B 00          DB $1A,$C8,$1B,$00                 ; height = 200
 508  8303 1C 00 1D 00          DB $1C,$00,$1D,$00,$1E,$00,$1F,$00 ; start colour = 00000000h
 508  8307 1E 00 1F 00
 509  830B 20 FF 21 00          DB $20,$FF,$21,$00,$22,$00,$23,$00 ; end colour = 000000FFh
 509  830F 22 00 23 00
 510  8313              AccelGradientRegsEnd:
 511  8313
 512  8313              ; -------------------------------------------------------------------------
 513  8313              ; Project131-compatible 2D accelerator smoke test.
 514  8313              ; Uses 320x200x8bpp so the complete 64,000-byte framebuffer is in banks 0..3.
 515  8313              ; Tests solid fill, VRAM-to-VRAM BitBLT, Bresenham line and status/readback.
 516  8313              ; Returns A=0 on success, A=1 on failure.
 517  8313              ; -------------------------------------------------------------------------
 518  8313              Run2DAcceleratorTest:
 519  8313 21 E5 8E             LD      HL,Msg2DStart
 520  8316 CD 5D 89             CALL    DebugPrint
 521  8319 CD DE 86             CALL    SpectrumShow2DStart
 522  831C
 523  831C                      ; The adapter powers up with a zeroed DAC. Program visible colours
 524  831C                      ; before the first 8-bpp test, then restore VBE mode (DAC writes
 525  831C                      ; switch the adapter to legacy software mode).
 526  831C CD E3 81             CALL    Program2DTestPalette
 527  831F
 528  831F                      ; Select 320x200x8bpp.
 529  831F 3E 40                LD      A,320&255
 530  8321 32 76 89             LD      (ModeXLo),A
 531  8324 3E 01                LD      A,320>>8
 532  8326 32 77 89             LD      (ModeXHi),A
 533  8329 3E C8                LD      A,200&255
 534  832B 32 78 89             LD      (ModeYLo),A
 535  832E AF                   XOR     A
 536  832F 32 79 89             LD      (ModeYHi),A
 537  8332 CD 58 84             CALL    ConfigureCurrentMode
 538  8335
 539  8335                      ; SOLID FILL: destination (20,20), 100x60, colour E3h.
 540  8335 21 E9 83             LD      HL,AccelFillRegs
 541  8338 3E 26                LD      A,AccelFillRegsEnd-AccelFillRegs
 542  833A CD B5 83             CALL    WriteAccelRegisterTable
 543  833D 3E 00                LD      A,0
 544  833F 1E 01                LD      E,1
 545  8341 CD CC 83             CALL    WriteAccelRegister
 546  8344 CD D6 83             CALL    CheckAccelDone
 547  8347 B7                   OR      A
 548  8348 C0                   RET     NZ
 549  8349
 550  8349                      ; BITBLT: copy the filled rectangle to (140,20).
 551  8349 21 0F 84             LD      HL,AccelBlitRegs
 552  834C 3E 22                LD      A,AccelBlitRegsEnd-AccelBlitRegs
 553  834E CD B5 83             CALL    WriteAccelRegisterTable
 554  8351 3E 00                LD      A,0
 555  8353 1E 02                LD      E,2
 556  8355 CD CC 83             CALL    WriteAccelRegister
 557  8358 CD D6 83             CALL    CheckAccelDone
 558  835B B7                   OR      A
 559  835C C0                   RET     NZ
 560  835D
 561  835D                      ; LINE: draw from (0,0) to (319,199), colour FFh.
 562  835D 21 31 84             LD      HL,AccelLineRegs
 563  8360 3E 1E                LD      A,AccelLineRegsEnd-AccelLineRegs
 564  8362 CD B5 83             CALL    WriteAccelRegisterTable
 565  8365 3E 00                LD      A,0
 566  8367 1E 03                LD      E,3
 567  8369 CD CC 83             CALL    WriteAccelRegister
 568  836C CD D6 83             CALL    CheckAccelDone
 569  836F B7                   OR      A
 570  8370 C0                   RET     NZ
 571  8371
 572  8371                      ; Read back the source and copied destination pixels in bank 0.
 573  8371 AF                   XOR     A
 574  8372 01 DF 03             LD      BC,$03DF
 575  8375 ED 79                OUT     (C),A
 576  8377 21 14 D9             LD      HL,$D914             ; 20*320 + 20 + C000h
 577  837A 7E                   LD      A,(HL)
 578  837B FE E3                CP      $E3
 579  837D 20 27                JR      NZ,AccelReadbackFail
 580  837F 21 8C D9             LD      HL,$D98C             ; 20*320 + 140 + C000h
 581  8382 7E                   LD      A,(HL)
 582  8383 FE E3                CP      $E3
 583  8385 20 1F                JR      NZ,AccelReadbackFail
 584  8387
 585  8387                      ; The final line pixel is linear offset 63999 = bank 3:3A00?
 586  8387                      ; Bank 3 aperture address = C000h + (63999 - 49152) = F9FFh.
 587  8387 3E 03                LD      A,3
 588  8389 01 DF 03             LD      BC,$03DF
 589  838C ED 79                OUT     (C),A
 590  838E 21 FF F9             LD      HL,$F9FF
 591  8391 7E                   LD      A,(HL)
 592  8392 FE FF                CP      $FF
 593  8394 20 10                JR      NZ,AccelReadbackFail
 594  8396
 595  8396 21 07 8F             LD      HL,Msg2DPass
 596  8399 CD 5D 89             CALL    DebugPrint
 597  839C CD 36 87             CALL    SpectrumShow2DPass
 598  839F CD 33 89             CALL    WaitSpace
 599  83A2
 600  83A2                      ; Follow the primitive smoke test with a 256-colour gradient
 601  83A2                      ; generated by the dedicated 2D gradient-fill command.
 602  83A2 CD 31 82             CALL    Run2DGradientTest
 603  83A5 C9                   RET
 604  83A6
 605  83A6              AccelReadbackFail:
 606  83A6 21 4E 8F             LD      HL,Msg2DReadbackFail
 607  83A9 CD 5D 89             CALL    DebugPrint
 608  83AC CD 4C 87             CALL    SpectrumShow2DFail
 609  83AF CD 33 89             CALL    WaitSpace
 610  83B2 3E 01                LD      A,1
 611  83B4 C9                   RET
