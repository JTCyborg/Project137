164   80CE
165   80CE 3A 46 82             LD      A,(CurrentBank)
166   80D1 3C                   INC     A
167   80D2 32 46 82             LD      (CurrentBank),A
168   80D5 FE 26                CP      38
169   80D7 20 C0                JR      NZ,FillBankLoop
170   80D9 C9                   RET
