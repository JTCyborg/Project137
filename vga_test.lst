 538  8348              ; -------------------------------------------------------------------------
 539  8348              ; Project131-compatible 2D accelerator smoke test.
 540  8348              ; Uses 320x200x8bpp so the complete 64,000-byte framebuffer is in banks 0..3.
 541  8348              ; Tests solid fill, VRAM-to-VRAM BitBLT, Bresenham line and status/readback.
 542  8348              ; Returns A=0 on success, A=1 on failure.
 543  8348              ; -------------------------------------------------------------------------
 544  8348              Run2DAcceleratorTest:
 545  8348 21 6D 92             LD      HL,Msg2DStart
 546  834B CD E4 8C             CALL    DebugPrint
 547  834E CD 23 8A             CALL    SpectrumShow2DStart
 548  8351
 549  8351                      ; The adapter powers up with a zeroed DAC. Program visible colours
 550  8351                      ; before the first 8-bpp test, then restore VBE mode (DAC writes
 551  8351                      ; switch the adapter to legacy software mode).
 552  8351 CD E3 81             CALL    Program2DTestPalette
 553  8354
 554  8354                      ; Select 320x200x8bpp.
 555  8354 3E 40                LD      A,320&255
 556  8356 32 FE 8C             LD      (ModeXLo),A
 557  8359 3E 01                LD      A,320>>8
 558  835B 32 FF 8C             LD      (ModeXHi),A
 559  835E 3E C8                LD      A,200&255
 560  8360 32 00 8D             LD      (ModeYLo),A
 561  8363 AF                   XOR     A
 562  8364 32 01 8D             LD      (ModeYHi),A
 563  8367 CD 9D 87             CALL    ConfigureCurrentMode
 564  836A
 565  836A                      ; SOLID FILL: destination (20,20), 100x60, colour E3h.
 566  836A 21 2E 87             LD      HL,AccelFillRegs
 567  836D 3E 26                LD      A,AccelFillRegsEnd-AccelFillRegs
 568  836F CD FA 86             CALL    WriteAccelRegisterTable
 569  8372 3E 00                LD      A,0
 570  8374 1E 01                LD      E,1
 571  8376 CD 11 87             CALL    WriteAccelRegister
 572  8379 CD 1B 87             CALL    CheckAccelDone
 573  837C B7                   OR      A
 574  837D C0                   RET     NZ
 575  837E
 576  837E                      ; BITBLT: copy the filled rectangle to (140,20).
 577  837E 21 54 87             LD      HL,AccelBlitRegs
 578  8381 3E 22                LD      A,AccelBlitRegsEnd-AccelBlitRegs
 579  8383 CD FA 86             CALL    WriteAccelRegisterTable
 580  8386 3E 00                LD      A,0
 581  8388 1E 02                LD      E,2
 582  838A CD 11 87             CALL    WriteAccelRegister
 583  838D CD 1B 87             CALL    CheckAccelDone
 584  8390 B7                   OR      A
 585  8391 C0                   RET     NZ
 586  8392
 587  8392                      ; LINE: draw from (0,0) to (319,199), colour FFh.
 588  8392 21 76 87             LD      HL,AccelLineRegs
 589  8395 3E 1E                LD      A,AccelLineRegsEnd-AccelLineRegs
 590  8397 CD FA 86             CALL    WriteAccelRegisterTable
 591  839A 3E 00                LD      A,0
 592  839C 1E 03                LD      E,3
 593  839E CD 11 87             CALL    WriteAccelRegister
 594  83A1 CD 1B 87             CALL    CheckAccelDone
 595  83A4 B7                   OR      A
 596  83A5 C0                   RET     NZ
 597  83A6
 598  83A6                      ; Read back the source and copied destination pixels in bank 0.
 599  83A6 AF                   XOR     A
 600  83A7 01 DF 03             LD      BC,$03DF
 601  83AA ED 79                OUT     (C),A
 602  83AC 21 14 D9             LD      HL,$D914             ; 20*320 + 20 + C000h
 603  83AF 7E                   LD      A,(HL)
 604  83B0 FE E3                CP      $E3
 605  83B2 C2 EB 86             JP      NZ,AccelReadbackFail
 606  83B5 21 8C D9             LD      HL,$D98C             ; 20*320 + 140 + C000h
 607  83B8 7E                   LD      A,(HL)
 608  83B9 FE E3                CP      $E3
 609  83BB C2 EB 86             JP      NZ,AccelReadbackFail
 610  83BE
 611  83BE                      ; The final line pixel is linear offset 63999 = bank 3:3A00?
 612  83BE                      ; Bank 3 aperture address = C000h + (63999 - 49152) = F9FFh.
 613  83BE 3E 03                LD      A,3
 614  83C0 01 DF 03             LD      BC,$03DF
 615  83C3 ED 79                OUT     (C),A
 616  83C5 21 FF F9             LD      HL,$F9FF
 617  83C8 7E                   LD      A,(HL)
 618  83C9 FE FF                CP      $FF
 619  83CB C2 EB 86             JP      NZ,AccelReadbackFail
 620  83CE
 621  83CE 21 8F 92             LD      HL,Msg2DPass
 622  83D1 CD E4 8C             CALL    DebugPrint
 623  83D4 CD BD 8A             CALL    SpectrumShow2DPass
 624  83D7 CD BA 8C             CALL    WaitSpace
 625  83DA
 626  83DA                      ; Follow the primitive smoke test with a 256-colour gradient
 627  83DA                      ; generated by the dedicated 2D gradient-fill command.
 628  83DA CD 31 82             CALL    Run2DGradientTest
 629  83DD B7                   OR      A
 630  83DE C0                   RET     NZ
 631  83DF CD 59 84             CALL    RunTextModeTest
 632  83E2 C9                   RET
 633  83E3
 634  83E3              ; Restore the standard 16-colour VGA/EGA DAC palette (6-bit RGB).
 635  83E3              ; This keeps the text-mode colour test independent of the preceding
 636  83E3              ; programmable 256-entry gradient test.
 637  83E3              ProgramStandardEgaPalette:
 638  83E3 01 C8 03             LD      BC,$03C8
 639  83E6 AF                   XOR     A
 640  83E7 ED 79                OUT     (C),A
 641  83E9 01 C9 03             LD      BC,$03C9
 642  83EC 21 F9 83             LD      HL,StandardEgaPalette
 643  83EF 16 30                LD      D,48
 644  83F1              StandardEgaPaletteWrite:
 645  83F1 7E                   LD      A,(HL)
 646  83F2 ED 79                OUT     (C),A
 647  83F4 23                   INC     HL
 648  83F5 15                   DEC     D
 649  83F6 20 F9                JR      NZ,StandardEgaPaletteWrite
 650  83F8 C9                   RET
 651  83F9
 652  83F9              StandardEgaPalette:
 653  83F9                      ; RGB triples, DAC range 00h..3Fh.
 654  83F9 00 00 00 00          DB $00,$00,$00, $00,$00,$2A, $00,$2A,$00, $00,$2A,$2A
 654  83FD 00 2A 00 2A
 654  8401 00 00 2A 2A
 655  8405 2A 00 00 2A          DB $2A,$00,$00, $2A,$00,$2A, $2A,$15,$00, $2A,$2A,$2A
 655  8409 00 2A 2A 15
 655  840D 00 2A 2A 2A
 656  8411 15 15 15 15          DB $15,$15,$15, $15,$15,$3F, $15,$3F,$15, $15,$3F,$3F
 656  8415 15 3F 15 3F
 656  8419 15 15 3F 3F
 657  841D 3F 15 15 3F          DB $3F,$15,$15, $3F,$15,$3F, $3F,$3F,$15, $3F,$3F,$3F
 657  8421 15 3F 3F 3F
 657  8425 15 3F 3F 3F
