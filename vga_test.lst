 626  83DA                      ; Follow the primitive smoke test with a 256-colour gradient
 627  83DA                      ; generated by the dedicated 2D gradient-fill command.
 628  83DA CD 31 82             CALL    Run2DGradientTest
 629  83DD B7                   OR      A
 630  83DE C0                   RET     NZ
 631  83DF CD 59 87             CALL    RunTextModeTest
 632  83E2 B7                   OR      A
 633  83E3 C0                   RET     NZ
 634  83E4 CD ED 83             CALL    RunGeometryTextScene
 635  83E7 B7                   OR      A
 636  83E8 C0                   RET     NZ
 637  83E9 CD 1D 85             CALL    Run640GeometryTest
 638  83EC C9                   RET
 639  83ED
