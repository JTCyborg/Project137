# file opened: vga_test.asm
   1  0000              ; =========================================================================
   2  0000              ; PROJECT137 — ATM TURBO 2+ EXTERNAL VGA ADAPTER STANDARD MODE TEST
   3  0000              ; Based on the proven ATM startup/ROM trampoline from Project112.
   4  0000              ; Target adapter: Project131 ISA VGA/SVGA software interface.
   5  0000              ;
   6  0000              ; Test:
   7  0000              ;   - unlock ATM shadow ports through TR-DOS ROM
   8  0000              ;   - enable VGA software mode + 16 KiB aperture
   9  0000              ;   - program 640x480 RGB565 through 3E0h/3E1h
  10  0000              ;   - fill 614400 bytes of linear VRAM through 38 aperture banks
  11  0000              ;   - read back bytes from bank 0 and the last framebuffer bank
  12  0000              ;   - report results on port EF (spectrum_out.txt)
  13  0000              ;
  14  0000              ; Expected image: eight-colour RGB565 vertical bars.
  15  0000              ; =========================================================================
  16  0000
  17  0000                      DEVICE ZXSPECTRUM128
  18  0000                      EMPTYTRD "vga_test.TRD"
  19  0000
  20  0000                      ORG     $8000
  21  8000
  22  8000              VgaTestEntry:
  23  8000 F3                   DI
  24  8001 31 FF BF             LD      SP,$BFFF
  25  8004
  26  8004 21 74 8C             LD      HL,MsgBuild
  27  8007 CD 37 88             CALL    DebugPrint
  28  800A 21 8B 8C             LD      HL,MsgStart
  29  800D CD 37 88             CALL    DebugPrint
  30  8010
  31  8010 CD 96 80             CALL    OpenATMShadowPorts
  32  8013
  33  8013                      ; Select standard Spectrum screen page 5 before drawing status text.
  34  8013 AF                   XOR     A
  35  8014 01 FD 7F             LD      BC,$7FFD
  36  8017 ED 79                OUT     (C),A
  37  8019 CD 5A 87             CALL    SpectrumShowStartup
  38  801C 21 30 8F             LD      HL,ScreenShadowReady
  39  801F CD 6A 87             CALL    SpectrumShowStatus
  40  8022
  41  8022 21 B1 8C             LD      HL,MsgAdapterInit
  42  8025 CD 37 88             CALL    DebugPrint
  43  8028
  44  8028                      ; Enable the adapter before running any engine tests.
  45  8028                      ; 3DEh: software mode = 1, aperture enable = 1, bank 0.
  46  8028 01 DE 03             LD      BC,$03DE
  47  802B 3E 03                LD      A,$03
  48  802D ED 79                OUT     (C),A
  49  802F
  50  802F                      ; Run 2D engine tests first, before framebuffer and palette sweeps.
  51  802F CD 31 82             CALL    Run2DAcceleratorTest
  52  8032 B7                   OR      A
  53  8033 C2 6B 83             JP      NZ,AccelTestFailed
  54  8036
  55  8036 CD 79 87             CALL    SpectrumShowInitialMode
  56  8039
  57  8039                      ; Configure packed-pixel 640x480 RGB565:
  58  8039                      ; XRES = 0280h, YRES = 01E0h, BPP = 16, ENABLE = 1.
  59  8039 3E 00                LD      A,0
  60  803B 1E 80                LD      E,$80
  61  803D CD A7 80             CALL    WriteVgaRegister
  62  8040 3E 01                LD      A,1
  63  8042 1E 02                LD      E,$02
  64  8044 CD A7 80             CALL    WriteVgaRegister
  65  8047 3E 02                LD      A,2
  66  8049 1E E0                LD      E,$E0
  67  804B CD A7 80             CALL    WriteVgaRegister
  68  804E 3E 03                LD      A,3
  69  8050 1E 01                LD      E,$01
  70  8052 CD A7 80             CALL    WriteVgaRegister
  71  8055 3E 04                LD      A,4
  72  8057 1E 10                LD      E,16
  73  8059 CD A7 80             CALL    WriteVgaRegister
  74  805C 3E 05                LD      A,5
  75  805E 1E 01                LD      E,1
  76  8060 CD A7 80             CALL    WriteVgaRegister
  77  8063
  78  8063 21 C8 8C             LD      HL,MsgModeSet
  79  8066 CD 37 88             CALL    DebugPrint
  80  8069
  81  8069 CD B1 80             CALL    Fill640x480x16
  82  806C
  83  806C 21 E2 8C             LD      HL,MsgFrameWritten
  84  806F CD 37 88             CALL    DebugPrint
  85  8072 CD 95 87             CALL    SpectrumShowInitialWriteComplete
  86  8075
  87  8075 CD F6 80             CALL    VerifyFramebuffer
  88  8078 B7                   OR      A
  89  8079 20 12                JR      NZ,VgaTestFailed
  90  807B
  91  807B 21 FE 8C             LD      HL,MsgReadbackPass
  92  807E CD 37 88             CALL    DebugPrint
  93  8081
  94  8081                      ; Palette/resolution matrix is deliberately the final test group.
  95  8081 CD 29 81             CALL    RunPackedModeSweep
  96  8084
  97  8084 21 28 8D             LD      HL,MsgReady
  98  8087 CD 37 88             CALL    DebugPrint
  99  808A
 100  808A              VgaTestIdle:
 101  808A 76                   HALT
 102  808B 18 FD                JR      VgaTestIdle
 103  808D
 104  808D              VgaTestFailed:
 105  808D 21 13 8D             LD      HL,MsgReadbackFail
 106  8090 CD 37 88             CALL    DebugPrint
 107  8093              VgaTestFailedIdle:
 108  8093 76                   HALT
 109  8094 18 FD                JR      VgaTestFailedIdle
 110  8096
 111  8096              ; -------------------------------------------------------------------------
 112  8096              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
 113  8096              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
 114  8096              ; -------------------------------------------------------------------------
 115  8096              OpenATMShadowPorts:
 116  8096 01 A6 80             LD      BC,ShadowPortsOpened
 117  8099 C5                   PUSH    BC
 118  809A 01 53 2A             LD      BC,$2A53
 119  809D C5                   PUSH    BC
 120  809E 01 77 01             LD      BC,$0177
 121  80A1 3E C3                LD      A,$C3
 122  80A3 C3 2F 3D             JP      $3D2F
 123  80A6              ShadowPortsOpened:
 124  80A6 C9                   RET
 125  80A7
 126  80A7              ; A = indexed VGA register, E = value.
 127  80A7              WriteVgaRegister:
 128  80A7 01 E0 03             LD      BC,$03E0
 129  80AA ED 79                OUT     (C),A
 130  80AC 7B                   LD      A,E
 131  80AD 0C                   INC     C
 132  80AE ED 79                OUT     (C),A
 133  80B0 C9                   RET
 134  80B1
 135  80B1              ; -------------------------------------------------------------------------
 136  80B1              ; Fill the 640x480x16 framebuffer.
 137  80B1              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
 138  80B1              ; The aperture C000h-FFFFh is switched with port 3DFh.
 139  80B1              ; -------------------------------------------------------------------------
 140  80B1              Fill640x480x16:
 141  80B1 AF                   XOR     A
 142  80B2 32 3F 88             LD      (CurrentBank),A
 143  80B5
 144  80B5              FillBankLoop:
 145  80B5 3A 3F 88             LD      A,(CurrentBank)
 146  80B8 01 DF 03             LD      BC,$03DF
 147  80BB ED 79                OUT     (C),A
 148  80BD
 149  80BD 21 00 C0             LD      HL,$C000
 150  80C0 11 F4 8B             LD      DE,ColorPattern
 151  80C3 3A 3F 88             LD      A,(CurrentBank)
 152  80C6 FE 25                CP      37
 153  80C8 28 05                JR      Z,FillLastHalfBank
 154  80CA 01 00 40             LD      BC,$4000
 155  80CD 18 03                JR      FillBankBytes
 156  80CF
 157  80CF              FillLastHalfBank:
 158  80CF 01 00 20             LD      BC,$2000
 159  80D2
 160  80D2              FillBankBytes:
 161  80D2 1A                   LD      A,(DE)
 162  80D3 13                   INC     DE
 163  80D4 77                   LD      (HL),A
 164  80D5 23                   INC     HL
 165  80D6
 166  80D6                      ; Repeat the 128-byte RGB565 colour-bar sequence.
 167  80D6 F5                   PUSH    AF
 168  80D7 7A                   LD      A,D
 169  80D8 FE 8C                CP      HIGH ColorPatternEnd
 170  80DA 20 08                JR      NZ,PatternPointerReady
 171  80DC 7B                   LD      A,E
 172  80DD FE 74                CP      LOW ColorPatternEnd
 173  80DF 20 03                JR      NZ,PatternPointerReady
 174  80E1 11 F4 8B             LD      DE,ColorPattern
 175  80E4              PatternPointerReady:
 176  80E4 F1                   POP     AF
 177  80E5
 178  80E5 0B                   DEC     BC
 179  80E6 78                   LD      A,B
 180  80E7 B1                   OR      C
 181  80E8 20 E8                JR      NZ,FillBankBytes
 182  80EA
 183  80EA 3A 3F 88             LD      A,(CurrentBank)
 184  80ED 3C                   INC     A
 185  80EE 32 3F 88             LD      (CurrentBank),A
 186  80F1 FE 26                CP      38
 187  80F3 20 C0                JR      NZ,FillBankLoop
 188  80F5 C9                   RET
 189  80F6
 190  80F6              ; -------------------------------------------------------------------------
 191  80F6              ; Readback checks:
 192  80F6              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
 193  80F6              ; bank 37 starts at linear offset 37*4000h = 5E000h.
 194  80F6              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
 195  80F6              ; Return A=0 on success, A=1 on mismatch.
 196  80F6              ; -------------------------------------------------------------------------
 197  80F6              VerifyFramebuffer:
 198  80F6 AF                   XOR     A
 199  80F7 01 DF 03             LD      BC,$03DF
 200  80FA ED 79                OUT     (C),A
 201  80FC
 202  80FC 21 00 C0             LD      HL,$C000
 203  80FF                      ; First eight pixels are black: bytes 0..15 must be zero.
 204  80FF 7E                   LD      A,(HL)
 205  8100 B7                   OR      A
 206  8101 20 23                JR      NZ,VerifyFailed
 207  8103 23                   INC     HL
 208  8104 7E                   LD      A,(HL)
 209  8105 B7                   OR      A
 210  8106 20 1E                JR      NZ,VerifyFailed
 211  8108
 212  8108                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
 213  8108 21 10 C0             LD      HL,$C010
 214  810B 7E                   LD      A,(HL)
 215  810C FE 1F                CP      $1F
 216  810E 20 16                JR      NZ,VerifyFailed
 217  8110 23                   INC     HL
 218  8111 7E                   LD      A,(HL)
 219  8112 B7                   OR      A
 220  8113 20 11                JR      NZ,VerifyFailed
 221  8115
 222  8115 3E 25                LD      A,37
 223  8117 01 DF 03             LD      BC,$03DF
 224  811A ED 79                OUT     (C),A
 225  811C 21 FF DF             LD      HL,$DFFF
 226  811F 7E                   LD      A,(HL)
 227  8120 FE FF                CP      $FF
 228  8122 20 02                JR      NZ,VerifyFailed
 229  8124
 230  8124 AF                   XOR     A
 231  8125 C9                   RET
 232  8126
 233  8126              VerifyFailed:
 234  8126 3E 01                LD      A,1
 235  8128 C9                   RET
 236  8129
 237  8129
 238  8129              ; -------------------------------------------------------------------------
 239  8129              ; Sweep the nine requested standard PC display resolutions.
 240  8129              ; Each mode uses 8-bpp indexed pixels and writes exactly its visible
 241  8129              ; framebuffer size. Use only the adapter's initialized EGA palette
 242  8129              ; entries 0..7, matching the proven Project132 test pattern.
 243  8129              ; SPACE advances to the next resolution.
 244  8129              ; -------------------------------------------------------------------------
 245  8129              RunPackedModeSweep:
 246  8129 21 4F 8D             LD      HL,MsgSweepStart
 247  812C CD 37 88             CALL    DebugPrint
 248  812F 21 81 88             LD      HL,PackedModeTable
 249  8132 22 4A 88             LD      (ModeTablePtr),HL
 250  8135 21 DD 88             LD      HL,ModeLabelTable
 251  8138 22 41 88             LD      (ModeLabelPtr),HL
 252  813B 3E 09                LD      A,9
 253  813D 32 4C 88             LD      (ModeCount),A
 254  8140
 255  8140              ; Outer loop: increase resolution only after all four palette sizes pass.
 256  8140              PackedModeNext:
 257  8140 2A 4A 88             LD      HL,(ModeTablePtr)
 258  8143 7E                   LD      A,(HL)
 259  8144 23                   INC     HL
 260  8145 32 4D 88             LD      (ModeXLo),A
 261  8148 7E                   LD      A,(HL)
 262  8149 23                   INC     HL
 263  814A 32 4E 88             LD      (ModeXHi),A
 264  814D 7E                   LD      A,(HL)
 265  814E 23                   INC     HL
 266  814F 32 4F 88             LD      (ModeYLo),A
 267  8152 7E                   LD      A,(HL)
 268  8153 23                   INC     HL
 269  8154 32 50 88             LD      (ModeYHi),A
 270  8157 7E                   LD      A,(HL)
 271  8158 23                   INC     HL
 272  8159 32 51 88             LD      (ModeBpp),A
 273  815C 7E                   LD      A,(HL)
 274  815D 23                   INC     HL
 275  815E 32 52 88             LD      (ModeBankCount),A
 276  8161 7E                   LD      A,(HL)
 277  8162 23                   INC     HL
 278  8163 32 53 88             LD      (ModeLastBankBytes),A
 279  8166 7E                   LD      A,(HL)
 280  8167 23                   INC     HL
 281  8168 32 54 88             LD      (ModeLastBankBytes+1),A
 282  816B 22 4A 88             LD      (ModeTablePtr),HL
 283  816E
 284  816E CD 74 83             CALL    ConfigureCurrentMode
 285  8171 CD B1 87             CALL    SpectrumShowMode
 286  8174
 287  8174 AF                   XOR     A
 288  8175 32 55 88             LD      (PaletteLevel),A
 289  8178
 290  8178              ; Inner loop: 2, 4, 16 and 256 DAC entries at this resolution.
 291  8178              PackedPaletteNext:
 292  8178 CD A9 83             CALL    SelectPaletteParameters
 293  817B CD D8 83             CALL    ProgramDacPalette
 294  817E
 295  817E                      ; Legacy DAC writes disable VBE in the adapter model.
 296  817E                      ; Re-apply this resolution's indexed 8-bpp mode before VRAM access.
 297  817E CD 74 83             CALL    ConfigureCurrentMode
 298  8181
 299  8181 21 44 8E             LD      HL,MsgPaletteLevel
 300  8184 CD 37 88             CALL    DebugPrint
 301  8187 3A 55 88             LD      A,(PaletteLevel)
 302  818A CD 1D 88             CALL    DebugHexByte
 303  818D 21 53 8E             LD      HL,MsgPaletteSuffix
 304  8190 CD 37 88             CALL    DebugPrint
 305  8193
 306  8193                      ; Verify the DAC before touching the framebuffer. This keeps all
 307  8193                      ; DAC read-index/component activity out of the post-render phase.
 308  8193 CD A9 83             CALL    SelectPaletteParameters
 309  8196 CD A6 84             CALL    VerifyDacPalette
 310  8199 B7                   OR      A
 311  819A 20 3A                JR      NZ,PackedPaletteFailed
 312  819C
 313  819C CD 14 84             CALL    FillModeVRAM
 314  819F
 315  819F 21 72 8E             LD      HL,MsgPalettePass
 316  81A2 CD 37 88             CALL    DebugPrint
 317  81A5 CD DD 87             CALL    SpectrumShowWriteComplete
 318  81A8 CD 0D 88             CALL    WaitSpace
 319  81AB
 320  81AB 3A 55 88             LD      A,(PaletteLevel)
 321  81AE 3C                   INC     A
 322  81AF 32 55 88             LD      (PaletteLevel),A
 323  81B2 FE 04                CP      4
 324  81B4 20 C2                JR      NZ,PackedPaletteNext
 325  81B6
 326  81B6 3A 4C 88             LD      A,(ModeCount)
 327  81B9 3D                   DEC     A
 328  81BA 32 4C 88             LD      (ModeCount),A
 329  81BD C2 40 81             JP      NZ,PackedModeNext
 330  81C0
 331  81C0 21 98 8D             LD      HL,MsgSweepDone
 332  81C3 CD 37 88             CALL    DebugPrint
 333  81C6 CD 38 87             CALL    SpectrumClear
 334  81C9 21 F9 8E             LD      HL,ScreenTitle
 335  81CC CD 84 86             CALL    SpectrumPrint
 336  81CF 21 38 90             LD      HL,ScreenAllDone
 337  81D2 CD 84 86             CALL    SpectrumPrint
 338  81D5 C9                   RET
 339  81D6
 340  81D6              PackedPaletteFailed:
 341  81D6 21 86 8E             LD      HL,MsgPaletteFail
 342  81D9 CD 37 88             CALL    DebugPrint
 343  81DC CD 6E 86             CALL    SpectrumShowDacFail
 344  81DF CD 0D 88             CALL    WaitSpace
 345  81E2 C9                   RET
 346  81E3
 347  81E3              ; Initialize only the entries used by the 2D smoke test.
 348  81E3              ; DAC components are six-bit values. Index 01 = blue, E3 = orange, FF = white.
 349  81E3              Program2DTestPalette:
 350  81E3 01 C8 03             LD      BC,$03C8
 351  81E6 AF                   XOR     A
 352  81E7 ED 79                OUT     (C),A
 353  81E9 01 C9 03             LD      BC,$03C9
 354  81EC AF                   XOR     A
 355  81ED ED 79                OUT     (C),A
 356  81EF ED 79                OUT     (C),A
 357  81F1 ED 79                OUT     (C),A
 358  81F3
 359  81F3 01 C8 03             LD      BC,$03C8
 360  81F6 3E 01                LD      A,1
 361  81F8 ED 79                OUT     (C),A
 362  81FA 01 C9 03             LD      BC,$03C9
 363  81FD 3E 00                LD      A,$00
 364  81FF ED 79                OUT     (C),A
 365  8201 3E 00                LD      A,$00
 366  8203 ED 79                OUT     (C),A
 367  8205 3E 3F                LD      A,$3F
 368  8207 ED 79                OUT     (C),A
 369  8209
 370  8209 01 C8 03             LD      BC,$03C8
 371  820C 3E E3                LD      A,$E3
 372  820E ED 79                OUT     (C),A
 373  8210 01 C9 03             LD      BC,$03C9
 374  8213 3E 3F                LD      A,$3F
 375  8215 ED 79                OUT     (C),A
 376  8217 3E 20                LD      A,$20
 377  8219 ED 79                OUT     (C),A
 378  821B AF                   XOR     A
 379  821C ED 79                OUT     (C),A
 380  821E
 381  821E 01 C8 03             LD      BC,$03C8
 382  8221 3E FF                LD      A,$FF
 383  8223 ED 79                OUT     (C),A
 384  8225 01 C9 03             LD      BC,$03C9
 385  8228 3E 3F                LD      A,$3F
 386  822A ED 79                OUT     (C),A
 387  822C ED 79                OUT     (C),A
 388  822E ED 79                OUT     (C),A
 389  8230 C9                   RET
 390  8231
 391  8231              ; -------------------------------------------------------------------------
 392  8231              ; Project131-compatible 2D accelerator smoke test.
 393  8231              ; Uses 320x200x8bpp so the complete 64,000-byte framebuffer is in banks 0..3.
 394  8231              ; Tests solid fill, VRAM-to-VRAM BitBLT, Bresenham line and status/readback.
 395  8231              ; Returns A=0 on success, A=1 on failure.
 396  8231              ; -------------------------------------------------------------------------
 397  8231              Run2DAcceleratorTest:
 398  8231 21 BC 8D             LD      HL,Msg2DStart
 399  8234 CD 37 88             CALL    DebugPrint
 400  8237 CD FA 85             CALL    SpectrumShow2DStart
 401  823A
 402  823A                      ; The adapter powers up with a zeroed DAC. Program visible colours
 403  823A                      ; before the first 8-bpp test, then restore VBE mode (DAC writes
 404  823A                      ; switch the adapter to legacy software mode).
 405  823A CD E3 81             CALL    Program2DTestPalette
 406  823D
 407  823D                      ; Select 320x200x8bpp.
 408  823D 3E 40                LD      A,320&255
 409  823F 32 4D 88             LD      (ModeXLo),A
 410  8242 3E 01                LD      A,320>>8
 411  8244 32 4E 88             LD      (ModeXHi),A
 412  8247 3E C8                LD      A,200&255
 413  8249 32 4F 88             LD      (ModeYLo),A
 414  824C AF                   XOR     A
 415  824D 32 50 88             LD      (ModeYHi),A
 416  8250 CD 74 83             CALL    ConfigureCurrentMode
 417  8253
 418  8253                      ; SOLID FILL: destination (20,20), 100x60, colour E3h.
 419  8253 21 05 83             LD      HL,AccelFillRegs
 420  8256 3E 26                LD      A,AccelFillRegsEnd-AccelFillRegs
 421  8258 CD D1 82             CALL    WriteAccelRegisterTable
 422  825B 3E 00                LD      A,0
 423  825D 1E 01                LD      E,1
 424  825F CD E8 82             CALL    WriteAccelRegister
 425  8262 CD F2 82             CALL    CheckAccelDone
 426  8265 B7                   OR      A
 427  8266 C0                   RET     NZ
 428  8267
 429  8267                      ; BITBLT: copy the filled rectangle to (140,20).
 430  8267 21 2B 83             LD      HL,AccelBlitRegs
 431  826A 3E 22                LD      A,AccelBlitRegsEnd-AccelBlitRegs
 432  826C CD D1 82             CALL    WriteAccelRegisterTable
 433  826F 3E 00                LD      A,0
 434  8271 1E 02                LD      E,2
 435  8273 CD E8 82             CALL    WriteAccelRegister
 436  8276 CD F2 82             CALL    CheckAccelDone
 437  8279 B7                   OR      A
 438  827A C0                   RET     NZ
 439  827B
 440  827B                      ; LINE: draw from (0,0) to (319,199), colour FFh.
 441  827B 21 4D 83             LD      HL,AccelLineRegs
 442  827E 3E 1E                LD      A,AccelLineRegsEnd-AccelLineRegs
 443  8280 CD D1 82             CALL    WriteAccelRegisterTable
 444  8283 3E 00                LD      A,0
 445  8285 1E 03                LD      E,3
 446  8287 CD E8 82             CALL    WriteAccelRegister
 447  828A CD F2 82             CALL    CheckAccelDone
 448  828D B7                   OR      A
 449  828E C0                   RET     NZ
 450  828F
 451  828F                      ; Read back the source and copied destination pixels in bank 0.
 452  828F AF                   XOR     A
 453  8290 01 DF 03             LD      BC,$03DF
 454  8293 ED 79                OUT     (C),A
 455  8295 21 14 D9             LD      HL,$D914             ; 20*320 + 20 + C000h
 456  8298 7E                   LD      A,(HL)
 457  8299 FE E3                CP      $E3
 458  829B 20 25                JR      NZ,AccelReadbackFail
 459  829D 21 8C D9             LD      HL,$D98C             ; 20*320 + 140 + C000h
 460  82A0 7E                   LD      A,(HL)
 461  82A1 FE E3                CP      $E3
 462  82A3 20 1D                JR      NZ,AccelReadbackFail
 463  82A5
 464  82A5                      ; The final line pixel is linear offset 63999 = bank 3:3A00?
 465  82A5                      ; Bank 3 aperture address = C000h + (63999 - 49152) = F9FFh.
 466  82A5 3E 03                LD      A,3
 467  82A7 01 DF 03             LD      BC,$03DF
 468  82AA ED 79                OUT     (C),A
 469  82AC 21 FF F9             LD      HL,$F9FF
 470  82AF 7E                   LD      A,(HL)
 471  82B0 FE FF                CP      $FF
 472  82B2 20 0E                JR      NZ,AccelReadbackFail
 473  82B4
 474  82B4 21 DE 8D             LD      HL,Msg2DPass
 475  82B7 CD 37 88             CALL    DebugPrint
 476  82BA CD 10 86             CALL    SpectrumShow2DPass
 477  82BD CD 0D 88             CALL    WaitSpace
 478  82C0 AF                   XOR     A
 479  82C1 C9                   RET
 480  82C2
 481  82C2              AccelReadbackFail:
 482  82C2 21 25 8E             LD      HL,Msg2DReadbackFail
 483  82C5 CD 37 88             CALL    DebugPrint
 484  82C8 CD 26 86             CALL    SpectrumShow2DFail
 485  82CB CD 0D 88             CALL    WaitSpace
 486  82CE 3E 01                LD      A,1
 487  82D0 C9                   RET
 488  82D1
 489  82D1              ; HL points to register/value pairs; A is the byte count.
 490  82D1              WriteAccelRegisterTable:
 491  82D1 32 40 88             LD      (AccelPairCount),A
 492  82D4              WriteAccelRegisterTableLoop:
 493  82D4 7E                   LD      A,(HL)
 494  82D5 23                   INC     HL
 495  82D6 5E                   LD      E,(HL)
 496  82D7 23                   INC     HL
 497  82D8 E5                   PUSH    HL
 498  82D9 CD E8 82             CALL    WriteAccelRegister
 499  82DC E1                   POP     HL
 500  82DD 3A 40 88             LD      A,(AccelPairCount)
 501  82E0 D6 02                SUB     2
 502  82E2 32 40 88             LD      (AccelPairCount),A
 503  82E5 20 ED                JR      NZ,WriteAccelRegisterTableLoop
 504  82E7 C9                   RET
 505  82E8
 506  82E8              ; A = accelerator register index, E = value.
 507  82E8              WriteAccelRegister:
 508  82E8 01 E2 03             LD      BC,$03E2
 509  82EB ED 79                OUT     (C),A
 510  82ED 7B                   LD      A,E
 511  82EE 0C                   INC     C
 512  82EF ED 79                OUT     (C),A
 513  82F1 C9                   RET
 514  82F2
 515  82F2              ; Returns A=0 when status register reports DONE (1), otherwise A=1.
 516  82F2              CheckAccelDone:
 517  82F2 01 E2 03             LD      BC,$03E2
 518  82F5 3E 01                LD      A,1
 519  82F7 ED 79                OUT     (C),A
 520  82F9 0C                   INC     C
 521  82FA ED 78                IN      A,(C)
 522  82FC FE 01                CP      1
 523  82FE 20 02                JR      NZ,CheckAccelFailed
 524  8300 AF                   XOR     A
 525  8301 C9                   RET
 526  8302              CheckAccelFailed:
 527  8302 3E 01                LD      A,1
 528  8304 C9                   RET
