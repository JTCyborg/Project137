 93   807A              ; -------------------------------------------------------------------------
 94   807A              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
 95   807A              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
 96   807A              ; -------------------------------------------------------------------------
 97   807A              OpenATMShadowPorts:
 98   807A 01 8A 80             LD      BC,ShadowPortsOpened
 99   807D C5                   PUSH    BC
100   807E 01 53 2A             LD      BC,$2A53
101   8081 C5                   PUSH    BC
102   8082 01 77 01             LD      BC,$0177
103   8085 3E C3                LD      A,$C3
104   8087 C3 2F 3D             JP      $3D2F
105   808A              ShadowPortsOpened:
106   808A C9                   RET
107   808B
108   808B              ; A = indexed VGA register, E = value.
109   808B              WriteVgaRegister:
110   808B 01 E0 03             LD      BC,$03E0
111   808E ED 79                OUT     (C),A
112   8090 7B                   LD      A,E
113   8091 0C                   INC     C
114   8092 ED 79                OUT     (C),A
115   8094 C9                   RET
116   8095
117   8095              ; -------------------------------------------------------------------------
118   8095              ; Fill the 640x480x16 framebuffer.
119   8095              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
120   8095              ; The aperture C000h-FFFFh is switched with port 3DFh.
121   8095              ; -------------------------------------------------------------------------
122   8095              Fill640x480x16:
123   8095 AF                   XOR     A
124   8096 32 46 82             LD      (CurrentBank),A
125   8099
126   8099              FillBankLoop:
127   8099 3A 46 82             LD      A,(CurrentBank)
128   809C 01 DF 03             LD      BC,$03DF
129   809F ED 79                OUT     (C),A
130   80A1
131   80A1 21 00 C0             LD      HL,$C000
132   80A4 11 9A 83             LD      DE,ColorPattern
133   80A7 3A 46 82             LD      A,(CurrentBank)
134   80AA FE 25                CP      37
135   80AC 28 05                JR      Z,FillLastHalfBank
136   80AE 01 00 40             LD      BC,$4000
137   80B1 18 03                JR      FillBankBytes
138   80B3
139   80B3              FillLastHalfBank:
140   80B3 01 00 20             LD      BC,$2000
141   80B6
142   80B6              FillBankBytes:
