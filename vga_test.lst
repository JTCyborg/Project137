 889  85A5 23                   INC     HL
 890  85A6 ED 78                IN      A,(C)
 891  85A8 BE                   CP      (HL)
 892  85A9 20 18                JR      NZ,VerifyDacPaletteFailed
 893  85AB 23                   INC     HL
 894  85AC ED 78                IN      A,(C)
 895  85AE BE                   CP      (HL)
 896  85AF 20 12                JR      NZ,VerifyDacPaletteFailed
 897  85B1 23                   INC     HL
 898  85B2 19                   ADD     HL,DE
 899  85B3 3A 6C 89             LD      A,(DacIndex)
 900  85B6 3C                   INC     A
 901  85B7 32 6C 89             LD      (DacIndex),A
 902  85BA E5                   PUSH    HL
 903  85BB CD EE 84             CALL    DecPaletteRemaining
 904  85BE E1                   POP     HL
 905  85BF 20 D4                JR      NZ,VerifyDacPaletteLoop
 906  85C1 AF                   XOR     A
 907  85C2 C9                   RET
 908  85C3              VerifyDacPaletteFailed:
 909  85C3 3E 01                LD      A,1
 910  85C5 C9                   RET
