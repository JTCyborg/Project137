 983  863A
 984  863A              ; Returns A=0 when status register reports DONE (1), otherwise A=1.
 985  863A              CheckAccelDone:
 986  863A 01 E2 03             LD      BC,$03E2
 987  863D 3E 01                LD      A,1
 988  863F ED 79                OUT     (C),A
 989  8641 0C                   INC     C
 990  8642 ED 78                IN      A,(C)
 991  8644 FE 01                CP      1
