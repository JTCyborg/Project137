 974  8648              StandardEgaPalette:
 975  8648                      ; RGB triples, DAC range 00h..3Fh.
 976  8648 00 00 00 00          DB $00,$00,$00, $00,$00,$2A, $00,$2A,$00, $00,$2A,$2A
 976  864C 00 2A 00 2A
 976  8650 00 00 2A 2A
 977  8654 2A 00 00 2A          DB $2A,$00,$00, $2A,$00,$2A, $2A,$15,$00, $2A,$2A,$2A
 977  8658 00 2A 2A 15
 977  865C 00 2A 2A 2A
 978  8660 15 15 15 15          DB $15,$15,$15, $15,$15,$3F, $15,$3F,$15, $15,$3F,$3F
 978  8664 15 3F 15 3F
 978  8668 15 15 3F 3F
 979  866C 3F 15 15 3F          DB $3F,$15,$15, $3F,$15,$3F, $3F,$3F,$15, $3F,$3F,$3F
 979  8670 15 3F 3F 3F
 979  8674 15 3F 3F 3F
