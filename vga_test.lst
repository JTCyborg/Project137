 648  83F5 15                   DEC     D
 649  83F6 20 F9                JR      NZ,StandardEgaPaletteWrite
 650  83F8 C9                   RET
 651  83F9
 652  83F9              StandardEgaPalette:
 653  83F9                      ; RGB triples, DAC range 00h..3Fh.
 654  83F9 00 00 00 00          DB $00,$00,$00, $00,$00,$2A, $00,$2A,$00, $00,$2A,$2A
 654  83FD 00 2A 00 2A
