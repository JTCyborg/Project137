 538  8348              ; -------------------------------------------------------------------------
 539  8348              ; Project131-compatible 2D accelerator smoke test.
 540  8348              ; Uses 320x200x8bpp so the complete 64,000-byte framebuffer is in banks 0..3.
 541  8348              ; Tests solid fill, VRAM-to-VRAM BitBLT, Bresenham line and status/readback.
 542  8348              ; Returns A=0 on success, A=1 on failure.
 543  8348              ; -------------------------------------------------------------------------
 544  8348              Run2DAcceleratorTest:
 545  8348 21 8C 91             LD      HL,Msg2DStart
 546  834B CD 03 8C             CALL    DebugPrint
 547  834E CD 42 89             CALL    SpectrumShow2DStart
 548  8351
 549  8351                      ; The adapter powers up with a zeroed DAC. Program visible colours
 550  8351                      ; before the first 8-bpp test, then restore VBE mode (DAC writes
 551  8351                      ; switch the adapter to legacy software mode).
 552  8351 CD E3 81             CALL    Program2DTestPalette
 553  8354
 554  8354                      ; Select 320x200x8bpp.
 555  8354 3E 40                LD      A,320&255
 556  8356 32 1D 8C             LD      (ModeXLo),A
 557  8359 3E 01                LD      A,320>>8
 558  835B 32 1E 8C             LD      (ModeXHi),A
 559  835E 3E C8                LD      A,200&255
 560  8360 32 1F 8C             LD      (ModeYLo),A
 561  8363 AF                   XOR     A
 562  8364 32 20 8C             LD      (ModeYHi),A
 563  8367 CD BC 86             CALL    ConfigureCurrentMode
 564  836A
 565  836A                      ; SOLID FILL: destination (20,20), 100x60, colour E3h.
 566  836A 21 4D 86             LD      HL,AccelFillRegs
 567  836D 3E 26                LD      A,AccelFillRegsEnd-AccelFillRegs
 568  836F CD 19 86             CALL    WriteAccelRegisterTable
 569  8372 3E 00                LD      A,0
 570  8374 1E 01                LD      E,1
 571  8376 CD 30 86             CALL    WriteAccelRegister
 572  8379 CD 3A 86             CALL    CheckAccelDone
 573  837C B7                   OR      A
 574  837D C0                   RET     NZ
 575  837E
 576  837E                      ; BITBLT: copy the filled rectangle to (140,20).
 577  837E 21 73 86             LD      HL,AccelBlitRegs
 578  8381 3E 22                LD      A,AccelBlitRegsEnd-AccelBlitRegs
 579  8383 CD 19 86             CALL    WriteAccelRegisterTable
 580  8386 3E 00                LD      A,0
 581  8388 1E 02                LD      E,2
 582  838A CD 30 86             CALL    WriteAccelRegister
 583  838D CD 3A 86             CALL    CheckAccelDone
 584  8390 B7                   OR      A
 585  8391 C0                   RET     NZ
 586  8392
 587  8392                      ; LINE: draw from (0,0) to (319,199), colour FFh.
 588  8392 21 95 86             LD      HL,AccelLineRegs
 589  8395 3E 1E                LD      A,AccelLineRegsEnd-AccelLineRegs
 590  8397 CD 19 86             CALL    WriteAccelRegisterTable
 591  839A 3E 00                LD      A,0
 592  839C 1E 03                LD      E,3
 593  839E CD 30 86             CALL    WriteAccelRegister
 594  83A1 CD 3A 86             CALL    CheckAccelDone
 595  83A4 B7                   OR      A
 596  83A5 C0                   RET     NZ
 597  83A6
 598  83A6                      ; Read back the source and copied destination pixels in bank 0.
 599  83A6 AF                   XOR     A
 600  83A7 01 DF 03             LD      BC,$03DF
 601  83AA ED 79                OUT     (C),A
 602  83AC 21 14 D9             LD      HL,$D914             ; 20*320 + 20 + C000h
 603  83AF 7E                   LD      A,(HL)
 604  83B0 FE E3                CP      $E3
 605  83B2 C2 0A 86             JP      NZ,AccelReadbackFail
 606  83B5 21 8C D9             LD      HL,$D98C             ; 20*320 + 140 + C000h
 607  83B8 7E                   LD      A,(HL)
 608  83B9 FE E3                CP      $E3
 609  83BB C2 0A 86             JP      NZ,AccelReadbackFail
 610  83BE
 611  83BE                      ; The final line pixel is linear offset 63999 = bank 3:3A00?
 612  83BE                      ; Bank 3 aperture address = C000h + (63999 - 49152) = F9FFh.
 613  83BE 3E 03                LD      A,3
 614  83C0 01 DF 03             LD      BC,$03DF
 615  83C3 ED 79                OUT     (C),A
 616  83C5 21 FF F9             LD      HL,$F9FF
 617  83C8 7E                   LD      A,(HL)
 618  83C9 FE FF                CP      $FF
 619  83CB C2 0A 86             JP      NZ,AccelReadbackFail
 620  83CE
 621  83CE 21 AE 91             LD      HL,Msg2DPass
 622  83D1 CD 03 8C             CALL    DebugPrint
 623  83D4 CD DC 89             CALL    SpectrumShow2DPass
 624  83D7 CD D9 8B             CALL    WaitSpace
 625  83DA
 626  83DA                      ; Follow the primitive smoke test with a 256-colour gradient
 627  83DA                      ; generated by the dedicated 2D gradient-fill command.
 628  83DA CD 31 82             CALL    Run2DGradientTest
 629  83DD B7                   OR      A
 630  83DE C0                   RET     NZ
 631  83DF CD 13 84             CALL    RunTextModeTest
 632  83E2 C9                   RET
 633  83E3
 634  83E3              ; IBM VGA mode 3 CRTC timing. Indexed register/value pairs.
 635  83E3              ; CR11 is written with bit 7 clear to unlock vertical timing registers.
 636  83E3              TextCrtcMode3:
 637  83E3                      ; Unlock protected CRTC registers before changing horizontal timing.
 638  83E3 11 0E                DB $11,$0E
 639  83E5 00 5F 01 4F          DB $00,$5F, $01,$4F, $02,$50, $03,$82
 639  83E9 02 50 03 82
 640  83ED 04 54 05 80          DB $04,$54, $05,$80, $06,$BF, $07,$1F
 640  83F1 06 BF 07 1F
 641  83F5 09 0F 0A 0D          DB $09,$0F, $0A,$0D, $0B,$0E, $0C,$80
 641  83F9 0B 0E 0C 80
 642  83FD 0D 00 0E 00          DB $0D,$00, $0E,$00, $0F,$00, $10,$9C
 642  8401 0F 00 10 9C
 643  8405 12 8F 13 28          DB $12,$8F, $13,$28, $14,$00, $15,$96
 643  8409 14 00 15 96
 644  840D 16 B9 17 A3          DB $16,$B9, $17,$A3, $18,$FF
 644  8411 18 FF
 645  8413
 646  8413              ; -------------------------------------------------------------------------
 647  8413              ; VGA text-mode test: 80x25, character plane 0, attribute plane 1.
 648  8413              ; Uses the adapter's bank-6 text aperture (C000h-C7CFh).
 649  8413              ; Scrolls rows 1..24 to rows 0..23, clears row 24, then verifies
 650  8413              ; character and attribute readback through the VGA plane read map.
 651  8413              ; -------------------------------------------------------------------------
 652  8413              RunTextModeTest:
 653  8413 21 3A 92             LD      HL,MsgTextStart
 654  8416 CD 03 8C             CALL    DebugPrint
 655  8419 CD 6E 89             CALL    SpectrumShowTextStart
 656  841C
 657  841C                      ; Program the VGA CRTC for a real 80-column, 25-row mode 3
 658  841C                      ; timing (720x400, 9-dot characters, 16 scanlines per row).
 659  841C                      ; The adapter must derive text geometry from these registers;
 660  841C                      ; the renderer must not invent a default column count.
 661  841C 21 E3 83             LD      HL,TextCrtcMode3
 662  841F 16 13                LD      D,19
 663  8421 01 D4 03             LD      BC,$03D4
 664  8424              TextCrtcWrite:
 665  8424 7E                   LD      A,(HL)
 666  8425 ED 79                OUT     (C),A
 667  8427 23                   INC     HL
 668  8428 0C                   INC     C
 669  8429 7E                   LD      A,(HL)
 670  842A ED 79                OUT     (C),A
 671  842C 23                   INC     HL
 672  842D 0D                   DEC     C
 673  842E 15                   DEC     D
 674  842F 20 F3                JR      NZ,TextCrtcWrite
 675  8431
 676  8431                      ; Select legacy VGA text mode: sequencer memory mode 06h,
 677  8431                      ; graphics-controller misc register 0Eh (B8000 text mapping).
 678  8431 01 C4 03             LD      BC,$03C4
 679  8434 3E 04                LD      A,4
 680  8436 ED 79                OUT     (C),A
 681  8438 0C                   INC     C
 682  8439 3E 06                LD      A,$06
 683  843B ED 79                OUT     (C),A
 684  843D
 685  843D 01 CE 03             LD      BC,$03CE
 686  8440 3E 06                LD      A,6
 687  8442 ED 79                OUT     (C),A
 688  8444 0C                   INC     C
 689  8445 3E 0E                LD      A,$0E
 690  8447 ED 79                OUT     (C),A
 691  8449
 692  8449                      ; Configure planar write mode 0 and full byte mask.
 693  8449 3E 05                LD      A,5
 694  844B 0D                   DEC     C
 695  844C ED 79                OUT     (C),A
 696  844E 0C                   INC     C
 697  844F AF                   XOR     A
 698  8450 ED 79                OUT     (C),A
