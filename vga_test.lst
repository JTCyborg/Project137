 659  8429              ; IBM VGA mode 3 CRTC timing. Indexed register/value pairs.
 660  8429              ; CR11 is written with bit 7 clear to unlock vertical timing registers.
 661  8429              TextCrtcMode3:
 662  8429                      ; Unlock protected CRTC registers before changing horizontal timing.
 663  8429 11 0E                DB $11,$0E
 664  842B 00 5F 01 4F          DB $00,$5F, $01,$4F, $02,$50, $03,$82
 664  842F 02 50 03 82
 665  8433 04 54 05 80          DB $04,$54, $05,$80, $06,$BF, $07,$1F
 665  8437 06 BF 07 1F
 666  843B 09 0F 0A 0D          DB $09,$0F, $0A,$0D, $0B,$0E, $0C,$80
 666  843F 0B 0E 0C 80
 667  8443 0D 00 0E 00          DB $0D,$00, $0E,$00, $0F,$00, $10,$9C
 667  8447 0F 00 10 9C
 668  844B 12 8F 13 28          DB $12,$8F, $13,$28, $14,$00, $15,$96
 668  844F 14 00 15 96
 669  8453 16 B9 17 83          DB $16,$B9, $17,$83, $18,$FF
 669  8457 18 FF
 670  8459
 671  8459              ; -------------------------------------------------------------------------
 672  8459              ; VGA text-mode test: 80x25, character plane 0, attribute plane 1.
 673  8459              ; Uses the adapter's bank-6 text aperture (C000h-C7CFh).
 674  8459              ; Scrolls rows 1..24 to rows 0..23, clears row 24, then verifies
 675  8459              ; character and attribute readback through the VGA plane read map.
 676  8459              ; -------------------------------------------------------------------------
 677  8459              RunTextModeTest:
 678  8459 21 1B 93             LD      HL,MsgTextStart
 679  845C CD E4 8C             CALL    DebugPrint
 680  845F CD 4F 8A             CALL    SpectrumShowTextStart
 681  8462
 682  8462                      ; The preceding 256-colour gradient test leaves a custom DAC ramp.
 683  8462                      ; Restore the standard 16-colour VGA palette before testing text
 684  8462                      ; attributes, which are expected to use the conventional EGA colours.
 685  8462 CD E3 83             CALL    ProgramStandardEgaPalette
 686  8465
 687  8465                      ; Program the VGA CRTC for a real 80-column, 25-row mode 3
 688  8465                      ; timing (720x400, 9-dot characters, 16 scanlines per row).
 689  8465                      ; The adapter must derive text geometry from these registers;
 690  8465                      ; the renderer must not invent a default column count.
 691  8465 21 29 84             LD      HL,TextCrtcMode3
 692  8468 16 18                LD      D,24
 693  846A 01 D4 03             LD      BC,$03D4
 694  846D              TextCrtcWrite:
 695  846D 7E                   LD      A,(HL)
 696  846E ED 79                OUT     (C),A
 697  8470 23                   INC     HL
 698  8471 0C                   INC     C
 699  8472 7E                   LD      A,(HL)
 700  8473 ED 79                OUT     (C),A
 701  8475 23                   INC     HL
 702  8476 0D                   DEC     C
 703  8477 15                   DEC     D
 704  8478 20 F3                JR      NZ,TextCrtcWrite
 705  847A
 706  847A                      ; Text lives in Spectrum bridge bank 6 (plane offset 18000h).
 707  847A                      ; CRTC[1E].A0 adds MA16, so start 8000h resolves to 18000h
 708  847A                      ; before PCem's four-byte interleaved display-address conversion.
 709  847A 01 D4 03             LD      BC,$03D4
 710  847D 3E 1E                LD      A,$1E
 711  847F ED 79                OUT     (C),A
 712  8481 0C                   INC     C
 713  8482 3E A0                LD      A,$A0
 714  8484 ED 79                OUT     (C),A
 715  8486
