  63  8049 1E 01                LD      E,$01
  64  804B CD A3 80             CALL    WriteVgaRegister
  65  804E 3E 04                LD      A,4
  66  8050 1E 10                LD      E,16
  67  8052 CD A3 80             CALL    WriteVgaRegister
  68  8055 3E 05                LD      A,5
  69  8057 1E 01                LD      E,1
  70  8059 CD A3 80             CALL    WriteVgaRegister
  71  805C
  72  805C 21 86 89             LD      HL,MsgModeSet
  73  805F CD 30 85             CALL    DebugPrint
  74  8062
  75  8062 CD AD 80             CALL    Fill640x480x16
  76  8065
