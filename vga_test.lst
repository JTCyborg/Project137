# file opened: vga_test.asm
   1  0000              ; =========================================================================
   2  0000              ; PROJECT137 — ATM TURBO 2+ EXTERNAL VGA ADAPTER STANDARD MODE TEST
   3  0000              ; Based on the proven ATM startup/ROM trampoline from Project112.
   4  0000              ; Target adapter: Project131 ISA VGA/SVGA software interface.
   5  0000              ;
   6  0000              ; Test:
   7  0000              ;   - unlock ATM shadow ports through TR-DOS ROM
   8  0000              ;   - enable VGA software mode + 16 KiB aperture
   9  0000              ;   - program 640x480 RGB565 through 3E0h/3E1h
  10  0000              ;   - fill 614400 bytes of linear VRAM through 38 aperture banks
  11  0000              ;   - read back bytes from bank 0 and the last framebuffer bank
  12  0000              ;   - report results on port EF (spectrum_out.txt)
  13  0000              ;
  14  0000              ; Expected image: eight-colour RGB565 vertical bars.
  15  0000              ; =========================================================================
  16  0000
  17  0000                      DEVICE ZXSPECTRUM128
  18  0000                      EMPTYTRD "vga_test.TRD"
  19  0000
  20  0000                      ORG     $8000
  21  8000
  22  8000              VgaTestEntry:
  23  8000 F3                   DI
  24  8001 31 FF BF             LD      SP,$BFFF
  25  8004
  26  8004 21 D2 8D             LD      HL,MsgBuild
  27  8007 CD 92 89             CALL    DebugPrint
  28  800A 21 E9 8D             LD      HL,MsgStart
  29  800D CD 92 89             CALL    DebugPrint
  30  8010
  31  8010 CD 96 80             CALL    OpenATMShadowPorts
  32  8013
  33  8013                      ; Select standard Spectrum screen page 5 before drawing status text.
  34  8013 AF                   XOR     A
  35  8014 01 FD 7F             LD      BC,$7FFD
  36  8017 ED 79                OUT     (C),A
  37  8019 CD B5 88             CALL    SpectrumShowStartup
  38  801C 21 61 92             LD      HL,ScreenShadowReady
  39  801F CD C5 88             CALL    SpectrumShowStatus
  40  8022
  41  8022 21 0F 8E             LD      HL,MsgAdapterInit
  42  8025 CD 92 89             CALL    DebugPrint
  43  8028
  44  8028                      ; Enable the adapter before running any engine tests.
  45  8028                      ; 3DEh: software mode = 1, aperture enable = 1, bank 0.
  46  8028 01 DE 03             LD      BC,$03DE
  47  802B 3E 03                LD      A,$03
  48  802D ED 79                OUT     (C),A
  49  802F
  50  802F                      ; Run 2D engine tests first, before framebuffer and palette sweeps.
  51  802F CD 48 83             CALL    Run2DAcceleratorTest
  52  8032 B7                   OR      A
  53  8033 C2 84 84             JP      NZ,AccelTestFailed
  54  8036
  55  8036 CD D4 88             CALL    SpectrumShowInitialMode
  56  8039
  57  8039                      ; Configure packed-pixel 640x480 RGB565:
  58  8039                      ; XRES = 0280h, YRES = 01E0h, BPP = 16, ENABLE = 1.
  59  8039 3E 00                LD      A,0
  60  803B 1E 80                LD      E,$80
  61  803D CD A7 80             CALL    WriteVgaRegister
  62  8040 3E 01                LD      A,1
  63  8042 1E 02                LD      E,$02
  64  8044 CD A7 80             CALL    WriteVgaRegister
  65  8047 3E 02                LD      A,2
  66  8049 1E E0                LD      E,$E0
  67  804B CD A7 80             CALL    WriteVgaRegister
  68  804E 3E 03                LD      A,3
  69  8050 1E 01                LD      E,$01
  70  8052 CD A7 80             CALL    WriteVgaRegister
  71  8055 3E 04                LD      A,4
  72  8057 1E 10                LD      E,16
  73  8059 CD A7 80             CALL    WriteVgaRegister
  74  805C 3E 05                LD      A,5
  75  805E 1E 01                LD      E,1
  76  8060 CD A7 80             CALL    WriteVgaRegister
  77  8063
  78  8063 21 26 8E             LD      HL,MsgModeSet
  79  8066 CD 92 89             CALL    DebugPrint
  80  8069
  81  8069 CD B1 80             CALL    Fill640x480x16
  82  806C
  83  806C 21 40 8E             LD      HL,MsgFrameWritten
  84  806F CD 92 89             CALL    DebugPrint
  85  8072 CD F0 88             CALL    SpectrumShowInitialWriteComplete
  86  8075
  87  8075 CD F6 80             CALL    VerifyFramebuffer
  88  8078 B7                   OR      A
  89  8079 20 12                JR      NZ,VgaTestFailed
  90  807B
  91  807B 21 5C 8E             LD      HL,MsgReadbackPass
  92  807E CD 92 89             CALL    DebugPrint
  93  8081
  94  8081                      ; Palette/resolution matrix is deliberately the final test group.
  95  8081 CD 29 81             CALL    RunPackedModeSweep
  96  8084
  97  8084 21 86 8E             LD      HL,MsgReady
  98  8087 CD 92 89             CALL    DebugPrint
  99  808A
 100  808A              VgaTestIdle:
 101  808A 76                   HALT
 102  808B 18 FD                JR      VgaTestIdle
 103  808D
 104  808D              VgaTestFailed:
 105  808D 21 71 8E             LD      HL,MsgReadbackFail
 106  8090 CD 92 89             CALL    DebugPrint
 107  8093              VgaTestFailedIdle:
 108  8093 76                   HALT
 109  8094 18 FD                JR      VgaTestFailedIdle
 110  8096
 111  8096              ; -------------------------------------------------------------------------
 112  8096              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
 113  8096              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
 114  8096              ; -------------------------------------------------------------------------
 115  8096              OpenATMShadowPorts:
 116  8096 01 A6 80             LD      BC,ShadowPortsOpened
 117  8099 C5                   PUSH    BC
 118  809A 01 53 2A             LD      BC,$2A53
 119  809D C5                   PUSH    BC
 120  809E 01 77 01             LD      BC,$0177
 121  80A1 3E C3                LD      A,$C3
 122  80A3 C3 2F 3D             JP      $3D2F
 123  80A6              ShadowPortsOpened:
 124  80A6 C9                   RET
 125  80A7
 126  80A7              ; A = indexed VGA register, E = value.
 127  80A7              WriteVgaRegister:
 128  80A7 01 E0 03             LD      BC,$03E0
 129  80AA ED 79                OUT     (C),A
 130  80AC 7B                   LD      A,E
 131  80AD 0C                   INC     C
 132  80AE ED 79                OUT     (C),A
 133  80B0 C9                   RET
 134  80B1
 135  80B1              ; -------------------------------------------------------------------------
 136  80B1              ; Fill the 640x480x16 framebuffer.
 137  80B1              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
 138  80B1              ; The aperture C000h-FFFFh is switched with port 3DFh.
 139  80B1              ; -------------------------------------------------------------------------
 140  80B1              Fill640x480x16:
 141  80B1 AF                   XOR     A
 142  80B2 32 9A 89             LD      (CurrentBank),A
 143  80B5
 144  80B5              FillBankLoop:
 145  80B5 3A 9A 89             LD      A,(CurrentBank)
 146  80B8 01 DF 03             LD      BC,$03DF
 147  80BB ED 79                OUT     (C),A
 148  80BD
 149  80BD 21 00 C0             LD      HL,$C000
 150  80C0 11 52 8D             LD      DE,ColorPattern
 151  80C3 3A 9A 89             LD      A,(CurrentBank)
 152  80C6 FE 25                CP      37
 153  80C8 28 05                JR      Z,FillLastHalfBank
 154  80CA 01 00 40             LD      BC,$4000
 155  80CD 18 03                JR      FillBankBytes
 156  80CF
 157  80CF              FillLastHalfBank:
 158  80CF 01 00 20             LD      BC,$2000
 159  80D2
 160  80D2              FillBankBytes:
 161  80D2 1A                   LD      A,(DE)
 162  80D3 13                   INC     DE
 163  80D4 77                   LD      (HL),A
 164  80D5 23                   INC     HL
 165  80D6
 166  80D6                      ; Repeat the 128-byte RGB565 colour-bar sequence.
 167  80D6 F5                   PUSH    AF
 168  80D7 7A                   LD      A,D
 169  80D8 FE 8D                CP      HIGH ColorPatternEnd
 170  80DA 20 08                JR      NZ,PatternPointerReady
 171  80DC 7B                   LD      A,E
 172  80DD FE D2                CP      LOW ColorPatternEnd
 173  80DF 20 03                JR      NZ,PatternPointerReady
 174  80E1 11 52 8D             LD      DE,ColorPattern
 175  80E4              PatternPointerReady:
 176  80E4 F1                   POP     AF
 177  80E5
 178  80E5 0B                   DEC     BC
 179  80E6 78                   LD      A,B
 180  80E7 B1                   OR      C
 181  80E8 20 E8                JR      NZ,FillBankBytes
 182  80EA
 183  80EA 3A 9A 89             LD      A,(CurrentBank)
 184  80ED 3C                   INC     A
 185  80EE 32 9A 89             LD      (CurrentBank),A
 186  80F1 FE 26                CP      38
 187  80F3 20 C0                JR      NZ,FillBankLoop
 188  80F5 C9                   RET
 189  80F6
 190  80F6              ; -------------------------------------------------------------------------
 191  80F6              ; Readback checks:
 192  80F6              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
 193  80F6              ; bank 37 starts at linear offset 37*4000h = 5E000h.
 194  80F6              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
 195  80F6              ; Return A=0 on success, A=1 on mismatch.
 196  80F6              ; -------------------------------------------------------------------------
 197  80F6              VerifyFramebuffer:
 198  80F6 AF                   XOR     A
 199  80F7 01 DF 03             LD      BC,$03DF
 200  80FA ED 79                OUT     (C),A
 201  80FC
 202  80FC 21 00 C0             LD      HL,$C000
 203  80FF                      ; First eight pixels are black: bytes 0..15 must be zero.
 204  80FF 7E                   LD      A,(HL)
 205  8100 B7                   OR      A
 206  8101 20 23                JR      NZ,VerifyFailed
 207  8103 23                   INC     HL
 208  8104 7E                   LD      A,(HL)
 209  8105 B7                   OR      A
 210  8106 20 1E                JR      NZ,VerifyFailed
 211  8108
 212  8108                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
 213  8108 21 10 C0             LD      HL,$C010
 214  810B 7E                   LD      A,(HL)
 215  810C FE 1F                CP      $1F
 216  810E 20 16                JR      NZ,VerifyFailed
 217  8110 23                   INC     HL
 218  8111 7E                   LD      A,(HL)
 219  8112 B7                   OR      A
 220  8113 20 11                JR      NZ,VerifyFailed
 221  8115
 222  8115 3E 25                LD      A,37
 223  8117 01 DF 03             LD      BC,$03DF
 224  811A ED 79                OUT     (C),A
 225  811C 21 FF DF             LD      HL,$DFFF
 226  811F 7E                   LD      A,(HL)
 227  8120 FE FF                CP      $FF
 228  8122 20 02                JR      NZ,VerifyFailed
 229  8124
 230  8124 AF                   XOR     A
 231  8125 C9                   RET
 232  8126
 233  8126              VerifyFailed:
 234  8126 3E 01                LD      A,1
 235  8128 C9                   RET
 236  8129
 237  8129
 238  8129              ; -------------------------------------------------------------------------
 239  8129              ; Sweep the nine requested standard PC display resolutions.
 240  8129              ; Each mode uses 8-bpp indexed pixels and writes exactly its visible
 241  8129              ; framebuffer size. Use only the adapter's initialized EGA palette
 242  8129              ; entries 0..7, matching the proven Project132 test pattern.
 243  8129              ; SPACE advances to the next resolution.
 244  8129              ; -------------------------------------------------------------------------
 245  8129              RunPackedModeSweep:
 246  8129 21 AD 8E             LD      HL,MsgSweepStart
 247  812C CD 92 89             CALL    DebugPrint
 248  812F 21 DF 89             LD      HL,PackedModeTable
 249  8132 22 A8 89             LD      (ModeTablePtr),HL
 250  8135 21 3B 8A             LD      HL,ModeLabelTable
 251  8138 22 9F 89             LD      (ModeLabelPtr),HL
 252  813B 3E 09                LD      A,9
 253  813D 32 AA 89             LD      (ModeCount),A
 254  8140
 255  8140              ; Outer loop: increase resolution only after all four palette sizes pass.
 256  8140              PackedModeNext:
 257  8140 2A A8 89             LD      HL,(ModeTablePtr)
 258  8143 7E                   LD      A,(HL)
 259  8144 23                   INC     HL
 260  8145 32 AB 89             LD      (ModeXLo),A
 261  8148 7E                   LD      A,(HL)
 262  8149 23                   INC     HL
 263  814A 32 AC 89             LD      (ModeXHi),A
 264  814D 7E                   LD      A,(HL)
 265  814E 23                   INC     HL
 266  814F 32 AD 89             LD      (ModeYLo),A
 267  8152 7E                   LD      A,(HL)
 268  8153 23                   INC     HL
 269  8154 32 AE 89             LD      (ModeYHi),A
 270  8157 7E                   LD      A,(HL)
 271  8158 23                   INC     HL
 272  8159 32 AF 89             LD      (ModeBpp),A
 273  815C 7E                   LD      A,(HL)
 274  815D 23                   INC     HL
 275  815E 32 B0 89             LD      (ModeBankCount),A
 276  8161 7E                   LD      A,(HL)
 277  8162 23                   INC     HL
 278  8163 32 B1 89             LD      (ModeLastBankBytes),A
 279  8166 7E                   LD      A,(HL)
 280  8167 23                   INC     HL
 281  8168 32 B2 89             LD      (ModeLastBankBytes+1),A
 282  816B 22 A8 89             LD      (ModeTablePtr),HL
 283  816E
 284  816E CD 8D 84             CALL    ConfigureCurrentMode
 285  8171 CD 0C 89             CALL    SpectrumShowMode
 286  8174
 287  8174 AF                   XOR     A
 288  8175 32 B3 89             LD      (PaletteLevel),A
 289  8178
 290  8178              ; Inner loop: 2, 4, 16 and 256 DAC entries at this resolution.
 291  8178              PackedPaletteNext:
 292  8178 CD C2 84             CALL    SelectPaletteParameters
 293  817B CD F1 84             CALL    ProgramDacPalette
 294  817E
 295  817E                      ; Legacy DAC writes disable VBE in the adapter model.
 296  817E                      ; Re-apply this resolution's indexed 8-bpp mode before VRAM access.
 297  817E CD 8D 84             CALL    ConfigureCurrentMode
 298  8181
 299  8181 21 75 91             LD      HL,MsgPaletteLevel
 300  8184 CD 92 89             CALL    DebugPrint
 301  8187 3A B3 89             LD      A,(PaletteLevel)
 302  818A CD 78 89             CALL    DebugHexByte
 303  818D 21 84 91             LD      HL,MsgPaletteSuffix
 304  8190 CD 92 89             CALL    DebugPrint
 305  8193
 306  8193                      ; Verify the DAC before touching the framebuffer. This keeps all
 307  8193                      ; DAC read-index/component activity out of the post-render phase.
 308  8193 CD C2 84             CALL    SelectPaletteParameters
 309  8196 CD BF 85             CALL    VerifyDacPalette
 310  8199 B7                   OR      A
 311  819A 20 3A                JR      NZ,PackedPaletteFailed
 312  819C
 313  819C CD 2D 85             CALL    FillModeVRAM
 314  819F
 315  819F 21 A3 91             LD      HL,MsgPalettePass
 316  81A2 CD 92 89             CALL    DebugPrint
 317  81A5 CD 38 89             CALL    SpectrumShowWriteComplete
 318  81A8 CD 68 89             CALL    WaitSpace
 319  81AB
 320  81AB 3A B3 89             LD      A,(PaletteLevel)
 321  81AE 3C                   INC     A
 322  81AF 32 B3 89             LD      (PaletteLevel),A
 323  81B2 FE 04                CP      4
 324  81B4 20 C2                JR      NZ,PackedPaletteNext
 325  81B6
 326  81B6 3A AA 89             LD      A,(ModeCount)
 327  81B9 3D                   DEC     A
 328  81BA 32 AA 89             LD      (ModeCount),A
 329  81BD C2 40 81             JP      NZ,PackedModeNext
 330  81C0
 331  81C0 21 F6 8E             LD      HL,MsgSweepDone
 332  81C3 CD 92 89             CALL    DebugPrint
 333  81C6 CD 93 88             CALL    SpectrumClear
 334  81C9 21 2A 92             LD      HL,ScreenTitle
 335  81CC CD DF 87             CALL    SpectrumPrint
 336  81CF 21 69 93             LD      HL,ScreenAllDone
 337  81D2 CD DF 87             CALL    SpectrumPrint
 338  81D5 C9                   RET
 339  81D6
 340  81D6              PackedPaletteFailed:
 341  81D6 21 B7 91             LD      HL,MsgPaletteFail
 342  81D9 CD 92 89             CALL    DebugPrint
 343  81DC CD C9 87             CALL    SpectrumShowDacFail
 344  81DF CD 68 89             CALL    WaitSpace
 345  81E2 C9                   RET
 346  81E3
 347  81E3              ; Initialize only the entries used by the 2D smoke test.
 348  81E3              ; DAC components are six-bit values. Index 01 = blue, E3 = orange, FF = white.
 349  81E3              Program2DTestPalette:
 350  81E3 01 C8 03             LD      BC,$03C8
 351  81E6 AF                   XOR     A
 352  81E7 ED 79                OUT     (C),A
 353  81E9 01 C9 03             LD      BC,$03C9
 354  81EC AF                   XOR     A
 355  81ED ED 79                OUT     (C),A
 356  81EF ED 79                OUT     (C),A
 357  81F1 ED 79                OUT     (C),A
 358  81F3
 359  81F3 01 C8 03             LD      BC,$03C8
 360  81F6 3E 01                LD      A,1
 361  81F8 ED 79                OUT     (C),A
 362  81FA 01 C9 03             LD      BC,$03C9
 363  81FD 3E 00                LD      A,$00
 364  81FF ED 79                OUT     (C),A
 365  8201 3E 00                LD      A,$00
 366  8203 ED 79                OUT     (C),A
 367  8205 3E 3F                LD      A,$3F
 368  8207 ED 79                OUT     (C),A
 369  8209
 370  8209 01 C8 03             LD      BC,$03C8
 371  820C 3E E3                LD      A,$E3
 372  820E ED 79                OUT     (C),A
 373  8210 01 C9 03             LD      BC,$03C9
 374  8213 3E 3F                LD      A,$3F
 375  8215 ED 79                OUT     (C),A
 376  8217 3E 20                LD      A,$20
 377  8219 ED 79                OUT     (C),A
 378  821B AF                   XOR     A
 379  821C ED 79                OUT     (C),A
 380  821E
 381  821E 01 C8 03             LD      BC,$03C8
 382  8221 3E FF                LD      A,$FF
 383  8223 ED 79                OUT     (C),A
 384  8225 01 C9 03             LD      BC,$03C9
 385  8228 3E 3F                LD      A,$3F
 386  822A ED 79                OUT     (C),A
 387  822C ED 79                OUT     (C),A
 388  822E ED 79                OUT     (C),A
 389  8230 C9                   RET
 390  8231
 391  8231              ; -------------------------------------------------------------------------
 392  8231              ; 2D gradient test. One dedicated accelerator command (CMD=4) interpolates
 393  8231              ; the 8-bpp palette index from 00h to FFh across a 320x200 rectangle.
 394  8231              ; No CPU framebuffer writes and no per-column command loop are used.
 395  8231              ; Returns A=0 on success, A=1 on accelerator/readback failure.
 396  8231              ; -------------------------------------------------------------------------
 397  8231              Run2DGradientTest:
 398  8231 21 A2 8F             LD      HL,Msg2DGradientStart
 399  8234 CD 92 89             CALL    DebugPrint
 400  8237 CD 29 87             CALL    SpectrumShow2DGradientStart
 401  823A
 402  823A 3E 03                LD      A,3
 403  823C 32 B3 89             LD      (PaletteLevel),A
 404  823F CD C2 84             CALL    SelectPaletteParameters
 405  8242 CD F1 84             CALL    ProgramDacPalette
 406  8245 CD 8D 84             CALL    ConfigureCurrentMode
 407  8248
 408  8248 21 1A 83             LD      HL,AccelGradientRegs
 409  824B 3E 2E                LD      A,AccelGradientRegsEnd-AccelGradientRegs
 410  824D CD EA 83             CALL    WriteAccelRegisterTable
 411  8250
 412  8250                      ; CMD 4: interpolate colour 00h -> FFh across 320 pixels.
 413  8250 3E 00                LD      A,0
 414  8252 1E 04                LD      E,4
 415  8254 CD 01 84             CALL    WriteAccelRegister
 416  8257 CD 0B 84             CALL    CheckAccelDone
 417  825A B7                   OR      A
 418  825B C2 A4 82             JP      NZ,Run2DGradientStatusFailed
 419  825E
 420  825E                      ; Read back first, midpoint (x=160 -> 80h), and last pixel.
 421  825E AF                   XOR     A
 422  825F 01 DF 03             LD      BC,$03DF
 423  8262 ED 79                OUT     (C),A
 424  8264 21 00 C0             LD      HL,$C000
 425  8267 7E                   LD      A,(HL)
 426  8268 B7                   OR      A
 427  8269 C2 0B 83             JP      NZ,Run2DGradientReadbackFailed
 428  826C 21 A0 C0             LD      HL,$C0A0
 429  826F 7E                   LD      A,(HL)
 430  8270 FE 80                CP      $80
 431  8272 C2 0B 83             JP      NZ,Run2DGradientReadbackFailed
 432  8275 21 3F C1             LD      HL,$C13F
 433  8278 7E                   LD      A,(HL)
 434  8279 FE FF                CP      $FF
 435  827B C2 0B 83             JP      NZ,Run2DGradientReadbackFailed
 436  827E
 437  827E                      ; Verify the first and last pixels of the final scanline.
 438  827E                      ; Linear offsets 63680 and 63999 are in bank 3.
 439  827E 3E 03                LD      A,3
 440  8280 01 DF 03             LD      BC,$03DF
 441  8283 ED 79                OUT     (C),A
 442  8285 21 C0 F8             LD      HL,$F8C0             ; bank 3 + offset 63680
 443  8288 7E                   LD      A,(HL)
 444  8289 B7                   OR      A
 445  828A C2 0B 83             JP      NZ,Run2DGradientReadbackFailed
 446  828D 21 FF F9             LD      HL,$F9FF             ; bank 3 + offset 63999
 447  8290 7E                   LD      A,(HL)
 448  8291 FE FF                CP      $FF
 449  8293 C2 0B 83             JP      NZ,Run2DGradientReadbackFailed
 450  8296
 451  8296 21 C8 8F             LD      HL,Msg2DGradientPass
 452  8299 CD 92 89             CALL    DebugPrint
 453  829C CD 3F 87             CALL    SpectrumShow2DGradientPass
 454  829F CD 68 89             CALL    WaitSpace
 455  82A2 AF                   XOR     A
 456  82A3 C9                   RET
 457  82A4
 458  82A4              Run2DGradientStatusFailed:
 459  82A4                      ; Preserve the adapter's diagnostic status before printing.
 460  82A4 01 E2 03             LD      BC,$03E2
 461  82A7 3E 01                LD      A,1
 462  82A9 ED 79                OUT     (C),A
 463  82AB 0C                   INC     C
 464  82AC ED 78                IN      A,(C)
 465  82AE FE 81                CP      $81
 466  82B0 28 2C                JR      Z,Run2DGradientVbeDisabled
 467  82B2 FE 82                CP      $82
 468  82B4 28 2D                JR      Z,Run2DGradientBadRect
 469  82B6 FE 83                CP      $83
 470  82B8 28 2E                JR      Z,Run2DGradientBadAddress
 471  82BA FE 84                CP      $84
 472  82BC 28 2F                JR      Z,Run2DGradientBadCommand
 473  82BE FE 80                CP      $80
 474  82C0 28 0D                JR      Z,Run2DGradientGenericError
 475  82C2 FE 00                CP      0
 476  82C4 28 0E                JR      Z,Run2DGradientZeroStatus
 477  82C6 FE 01                CP      1
 478  82C8 28 0F                JR      Z,Run2DGradientUnexpectedDone
 479  82CA 21 CC 90             LD      HL,Msg2DGradientUnknownStatus
 480  82CD 18 21                JR      Run2DGradientReportStatus
 481  82CF              Run2DGradientGenericError:
 482  82CF 21 F0 90             LD      HL,Msg2DGradientGenericError
 483  82D2 18 1C                JR      Run2DGradientReportStatus
 484  82D4              Run2DGradientZeroStatus:
 485  82D4 21 18 91             LD      HL,Msg2DGradientZeroStatus
 486  82D7 18 17                JR      Run2DGradientReportStatus
 487  82D9              Run2DGradientUnexpectedDone:
 488  82D9 21 3E 91             LD      HL,Msg2DGradientUnexpectedDone
 489  82DC 18 12                JR      Run2DGradientReportStatus
 490  82DE              Run2DGradientVbeDisabled:
 491  82DE 21 1C 90             LD      HL,Msg2DGradientVbeDisabled
 492  82E1 18 0D                JR      Run2DGradientReportStatus
 493  82E3              Run2DGradientBadRect:
 494  82E3 21 43 90             LD      HL,Msg2DGradientBadRect
 495  82E6 18 08                JR      Run2DGradientReportStatus
 496  82E8              Run2DGradientBadAddress:
 497  82E8 21 6F 90             LD      HL,Msg2DGradientBadAddress
 498  82EB 18 03                JR      Run2DGradientReportStatus
 499  82ED              Run2DGradientBadCommand:
 500  82ED 21 9E 90             LD      HL,Msg2DGradientBadCommand
 501  82F0              Run2DGradientReportStatus:
 502  82F0 CD 92 89             CALL    DebugPrint
 503  82F3                      ; Print the exact status byte read from accelerator register 01h.
 504  82F3 01 E2 03             LD      BC,$03E2
 505  82F6 3E 01                LD      A,1
 506  82F8 ED 79                OUT     (C),A
 507  82FA 0C                   INC     C
 508  82FB ED 78                IN      A,(C)
 509  82FD CD 78 89             CALL    DebugHexByte
 510  8300 3E 0D                LD      A,13
 511  8302 D3 EF                OUT     ($EF),A
 512  8304 3E 0A                LD      A,10
 513  8306 D3 EF                OUT     ($EF),A
 514  8308 C3 11 83             JP      Run2DGradientFailCommon
 515  830B
 516  830B              Run2DGradientReadbackFailed:
 517  830B              Run2DGradientFailed:
 518  830B 21 F8 8F             LD      HL,Msg2DGradientFail
 519  830E CD 92 89             CALL    DebugPrint
 520  8311              Run2DGradientFailCommon:
 521  8311 CD 55 87             CALL    SpectrumShow2DGradientFail
 522  8314 CD 68 89             CALL    WaitSpace
 523  8317 3E 01                LD      A,1
 524  8319 C9                   RET
 525  831A
 526  831A              AccelGradientRegs:
 527  831A 02 00                DB $02,$00
 528  831C 08 00 09 00          DB $08,$00,$09,$00,$0A,$00,$0B,$00 ; destination base = 0
 528  8320 0A 00 0B 00
 529  8324 0E 40 0F 01          DB $0E,$40,$0F,$01                 ; destination pitch = 320
 530  8328 14 00 15 00          DB $14,$00,$15,$00                 ; x = 0
 531  832C 16 00 17 00          DB $16,$00,$17,$00                 ; y = 0
 532  8330 18 40 19 01          DB $18,$40,$19,$01                 ; width = 320
 533  8334 1A C8 1B 00          DB $1A,$C8,$1B,$00                 ; height = 200
 534  8338 1C 00 1D 00          DB $1C,$00,$1D,$00,$1E,$00,$1F,$00 ; start colour = 00000000h
 534  833C 1E 00 1F 00
 535  8340 20 FF 21 00          DB $20,$FF,$21,$00,$22,$00,$23,$00 ; end colour = 000000FFh
 535  8344 22 00 23 00
 536  8348              AccelGradientRegsEnd:
 537  8348
 538  8348              ; -------------------------------------------------------------------------
 539  8348              ; Project131-compatible 2D accelerator smoke test.
 540  8348              ; Uses 320x200x8bpp so the complete 64,000-byte framebuffer is in banks 0..3.
 541  8348              ; Tests solid fill, VRAM-to-VRAM BitBLT, Bresenham line and status/readback.
 542  8348              ; Returns A=0 on success, A=1 on failure.
 543  8348              ; -------------------------------------------------------------------------
 544  8348              Run2DAcceleratorTest:
 545  8348 21 1A 8F             LD      HL,Msg2DStart
 546  834B CD 92 89             CALL    DebugPrint
 547  834E CD 13 87             CALL    SpectrumShow2DStart
 548  8351
 549  8351                      ; The adapter powers up with a zeroed DAC. Program visible colours
 550  8351                      ; before the first 8-bpp test, then restore VBE mode (DAC writes
 551  8351                      ; switch the adapter to legacy software mode).
 552  8351 CD E3 81             CALL    Program2DTestPalette
 553  8354
 554  8354                      ; Select 320x200x8bpp.
 555  8354 3E 40                LD      A,320&255
 556  8356 32 AB 89             LD      (ModeXLo),A
 557  8359 3E 01                LD      A,320>>8
 558  835B 32 AC 89             LD      (ModeXHi),A
 559  835E 3E C8                LD      A,200&255
 560  8360 32 AD 89             LD      (ModeYLo),A
 561  8363 AF                   XOR     A
 562  8364 32 AE 89             LD      (ModeYHi),A
 563  8367 CD 8D 84             CALL    ConfigureCurrentMode
 564  836A
 565  836A                      ; SOLID FILL: destination (20,20), 100x60, colour E3h.
 566  836A 21 1E 84             LD      HL,AccelFillRegs
 567  836D 3E 26                LD      A,AccelFillRegsEnd-AccelFillRegs
 568  836F CD EA 83             CALL    WriteAccelRegisterTable
 569  8372 3E 00                LD      A,0
 570  8374 1E 01                LD      E,1
 571  8376 CD 01 84             CALL    WriteAccelRegister
 572  8379 CD 0B 84             CALL    CheckAccelDone
 573  837C B7                   OR      A
 574  837D C0                   RET     NZ
 575  837E
 576  837E                      ; BITBLT: copy the filled rectangle to (140,20).
 577  837E 21 44 84             LD      HL,AccelBlitRegs
 578  8381 3E 22                LD      A,AccelBlitRegsEnd-AccelBlitRegs
 579  8383 CD EA 83             CALL    WriteAccelRegisterTable
 580  8386 3E 00                LD      A,0
 581  8388 1E 02                LD      E,2
 582  838A CD 01 84             CALL    WriteAccelRegister
 583  838D CD 0B 84             CALL    CheckAccelDone
 584  8390 B7                   OR      A
 585  8391 C0                   RET     NZ
 586  8392
 587  8392                      ; LINE: draw from (0,0) to (319,199), colour FFh.
 588  8392 21 66 84             LD      HL,AccelLineRegs
 589  8395 3E 1E                LD      A,AccelLineRegsEnd-AccelLineRegs
 590  8397 CD EA 83             CALL    WriteAccelRegisterTable
 591  839A 3E 00                LD      A,0
 592  839C 1E 03                LD      E,3
 593  839E CD 01 84             CALL    WriteAccelRegister
 594  83A1 CD 0B 84             CALL    CheckAccelDone
 595  83A4 B7                   OR      A
 596  83A5 C0                   RET     NZ
 597  83A6
 598  83A6                      ; Read back the source and copied destination pixels in bank 0.
 599  83A6 AF                   XOR     A
 600  83A7 01 DF 03             LD      BC,$03DF
 601  83AA ED 79                OUT     (C),A
 602  83AC 21 14 D9             LD      HL,$D914             ; 20*320 + 20 + C000h
 603  83AF 7E                   LD      A,(HL)
 604  83B0 FE E3                CP      $E3
 605  83B2 20 27                JR      NZ,AccelReadbackFail
 606  83B4 21 8C D9             LD      HL,$D98C             ; 20*320 + 140 + C000h
 607  83B7 7E                   LD      A,(HL)
 608  83B8 FE E3                CP      $E3
 609  83BA 20 1F                JR      NZ,AccelReadbackFail
 610  83BC
 611  83BC                      ; The final line pixel is linear offset 63999 = bank 3:3A00?
 612  83BC                      ; Bank 3 aperture address = C000h + (63999 - 49152) = F9FFh.
 613  83BC 3E 03                LD      A,3
 614  83BE 01 DF 03             LD      BC,$03DF
 615  83C1 ED 79                OUT     (C),A
 616  83C3 21 FF F9             LD      HL,$F9FF
 617  83C6 7E                   LD      A,(HL)
 618  83C7 FE FF                CP      $FF
 619  83C9 20 10                JR      NZ,AccelReadbackFail
 620  83CB
 621  83CB 21 3C 8F             LD      HL,Msg2DPass
 622  83CE CD 92 89             CALL    DebugPrint
 623  83D1 CD 6B 87             CALL    SpectrumShow2DPass
 624  83D4 CD 68 89             CALL    WaitSpace
 625  83D7
 626  83D7                      ; Follow the primitive smoke test with a 256-colour gradient
 627  83D7                      ; generated by the dedicated 2D gradient-fill command.
 628  83D7 CD 31 82             CALL    Run2DGradientTest
 629  83DA C9                   RET
 630  83DB
 631  83DB              AccelReadbackFail:
 632  83DB 21 83 8F             LD      HL,Msg2DReadbackFail
 633  83DE CD 92 89             CALL    DebugPrint
 634  83E1 CD 81 87             CALL    SpectrumShow2DFail
 635  83E4 CD 68 89             CALL    WaitSpace
 636  83E7 3E 01                LD      A,1
 637  83E9 C9                   RET
 638  83EA
 639  83EA              ; HL points to register/value pairs; A is the byte count.
 640  83EA              WriteAccelRegisterTable:
 641  83EA 32 9B 89             LD      (AccelPairCount),A
 642  83ED              WriteAccelRegisterTableLoop:
 643  83ED 7E                   LD      A,(HL)
 644  83EE 23                   INC     HL
 645  83EF 5E                   LD      E,(HL)
 646  83F0 23                   INC     HL
 647  83F1 E5                   PUSH    HL
 648  83F2 CD 01 84             CALL    WriteAccelRegister
 649  83F5 E1                   POP     HL
 650  83F6 3A 9B 89             LD      A,(AccelPairCount)
 651  83F9 D6 02                SUB     2
 652  83FB 32 9B 89             LD      (AccelPairCount),A
 653  83FE 20 ED                JR      NZ,WriteAccelRegisterTableLoop
 654  8400 C9                   RET
 655  8401
 656  8401              ; A = accelerator register index, E = value.
 657  8401              WriteAccelRegister:
 658  8401 01 E2 03             LD      BC,$03E2
 659  8404 ED 79                OUT     (C),A
 660  8406 7B                   LD      A,E
 661  8407 0C                   INC     C
 662  8408 ED 79                OUT     (C),A
 663  840A C9                   RET
 664  840B
 665  840B              ; Returns A=0 when status register reports DONE (1), otherwise A=1.
 666  840B              CheckAccelDone:
 667  840B 01 E2 03             LD      BC,$03E2
 668  840E 3E 01                LD      A,1
 669  8410 ED 79                OUT     (C),A
 670  8412 0C                   INC     C
 671  8413 ED 78                IN      A,(C)
 672  8415 FE 01                CP      1
 673  8417 20 02                JR      NZ,CheckAccelFailed
 674  8419 AF                   XOR     A
 675  841A C9                   RET
 676  841B              CheckAccelFailed:
 677  841B 3E 01                LD      A,1
 678  841D C9                   RET
 679  841E
 680  841E              ; Register tables: index,value pairs. All addresses are byte offsets in VRAM.
 681  841E              AccelFillRegs:
 682  841E 02 00                DB $02,$00                 ; ROP COPY
 683  8420 08 00 09 00          DB $08,$00,$09,$00,$0A,$00,$0B,$00 ; destination base = 0
 683  8424 0A 00 0B 00
 684  8428 0E 40 0F 01          DB $0E,$40,$0F,$01         ; destination pitch = 320
 685  842C 14 14 15 00          DB $14,20,$15,0,$16,20,$17,0
 685  8430 16 14 17 00
 686  8434 18 64 19 00          DB $18,100,$19,0,$1A,60,$1B,0
 686  8438 1A 3C 1B 00
 687  843C 1C E3 1D 00          DB $1C,$E3,$1D,0,$1E,0,$1F,0
 687  8440 1E 00 1F 00
 688  8444              AccelFillRegsEnd:
 689  8444
 690  8444              AccelBlitRegs:
 691  8444 02 00                DB $02,$00
 692  8446 0C 40 0D 01          DB $0C,$40,$0D,$01         ; source pitch = 320
 693  844A 0E 40 0F 01          DB $0E,$40,$0F,$01         ; destination pitch = 320
 694  844E 10 14 11 00          DB $10,20,$11,0,$12,20,$13,0
 694  8452 12 14 13 00
 695  8456 14 8C 15 00          DB $14,140,$15,0,$16,20,$17,0
 695  845A 16 14 17 00
 696  845E 18 64 19 00          DB $18,100,$19,0,$1A,60,$1B,0
 696  8462 1A 3C 1B 00
 697  8466              AccelBlitRegsEnd:
 698  8466
 699  8466              AccelLineRegs:
 700  8466 02 00                DB $02,$00
 701  8468 0E 40 0F 01          DB $0E,$40,$0F,$01         ; destination pitch = 320
 702  846C 14 00 15 00          DB $14,0,$15,0,$16,0,$17,0
 702  8470 16 00 17 00
 703  8474 1C FF 1D 00          DB $1C,$FF,$1D,0,$1E,0,$1F,0
 703  8478 1E 00 1F 00
 704  847C 20 3F 21 01          DB $20,63,$21,1,$22,199,$23,0 ; endpoint (319,199)
 704  8480 22 C7 23 00
 705  8484              AccelLineRegsEnd:
 706  8484
 707  8484              AccelTestFailed:
 708  8484 21 68 8F             LD      HL,Msg2DFail
 709  8487 CD 92 89             CALL    DebugPrint
 710  848A              AccelTestFailedIdle:
 711  848A 76                   HALT
 712  848B 18 FD                JR      AccelTestFailedIdle
 713  848D
 714  848D              ; Re-apply the currently selected packed-pixel 8-bpp resolution.
 715  848D              ConfigureCurrentMode:
 716  848D 3A AB 89             LD      A,(ModeXLo)
 717  8490 5F                   LD      E,A
 718  8491 3E 00                LD      A,0
 719  8493 CD A7 80             CALL    WriteVgaRegister
 720  8496 3A AC 89             LD      A,(ModeXHi)
 721  8499 5F                   LD      E,A
 722  849A 3E 01                LD      A,1
 723  849C CD A7 80             CALL    WriteVgaRegister
 724  849F 3A AD 89             LD      A,(ModeYLo)
 725  84A2 5F                   LD      E,A
 726  84A3 3E 02                LD      A,2
 727  84A5 CD A7 80             CALL    WriteVgaRegister
 728  84A8 3A AE 89             LD      A,(ModeYHi)
 729  84AB 5F                   LD      E,A
 730  84AC 3E 03                LD      A,3
 731  84AE CD A7 80             CALL    WriteVgaRegister
 732  84B1 3E 08                LD      A,8
 733  84B3 5F                   LD      E,A
 734  84B4 3E 04                LD      A,4
 735  84B6 CD A7 80             CALL    WriteVgaRegister
 736  84B9 3E 01                LD      A,1
 737  84BB 5F                   LD      E,A
 738  84BC 3E 05                LD      A,5
 739  84BE CD A7 80             CALL    WriteVgaRegister
 740  84C1 C9                   RET
 741  84C2
 742  84C2              ; Palette table entry: count (word), index mask (byte), DAC source stride
 743  84C2              ; beyond RGB (word). The RGB332 source table contains 256 evenly ordered
 744  84C2              ; entries, so each smaller palette samples the full colour range.
 745  84C2              SelectPaletteParameters:
 746  84C2 21 27 8A             LD      HL,PaletteConfigTable
 747  84C5 3A B3 89             LD      A,(PaletteLevel)
 748  84C8 B7                   OR      A
 749  84C9 28 07                JR      Z,PaletteConfigFound
 750  84CB 47                   LD      B,A
 751  84CC              PaletteConfigSkip:
 752  84CC 11 05 00             LD      DE,5
 753  84CF 19                   ADD     HL,DE
 754  84D0 10 FA                DJNZ    PaletteConfigSkip
 755  84D2              PaletteConfigFound:
 756  84D2 7E                   LD      A,(HL)
 757  84D3 23                   INC     HL
 758  84D4 32 B5 89             LD      (PaletteRemaining),A
 759  84D7 32 B7 89             LD      (PaletteCount),A
 760  84DA 7E                   LD      A,(HL)
 761  84DB 23                   INC     HL
 762  84DC 32 B6 89             LD      (PaletteRemaining+1),A
 763  84DF 32 B8 89             LD      (PaletteCount+1),A
 764  84E2 7E                   LD      A,(HL)
 765  84E3 23                   INC     HL
 766  84E4 32 B4 89             LD      (PaletteMask),A
 767  84E7 7E                   LD      A,(HL)
 768  84E8 23                   INC     HL
 769  84E9 32 B9 89             LD      (PaletteStride),A
 770  84EC 7E                   LD      A,(HL)
 771  84ED 32 BA 89             LD      (PaletteStride+1),A
 772  84F0 C9                   RET
 773  84F1
 774  84F1              ; Program the selected number of DAC entries sampled from the 256-step HSV hue ramp.
 775  84F1              ProgramDacPalette:
 776  84F1 21 3C 96             LD      HL,DacHuePalette
 777  84F4 ED 5B B9 89          LD      DE,(PaletteStride)
 778  84F8 AF                   XOR     A
 779  84F9 32 A1 89             LD      (DacIndex),A
 780  84FC              ProgramDacPaletteLoop:
 781  84FC 3A A1 89             LD      A,(DacIndex)
 782  84FF 01 C8 03             LD      BC,$03C8
 783  8502 ED 79                OUT     (C),A
 784  8504 01 C9 03             LD      BC,$03C9
 785  8507 7E                   LD      A,(HL)
 786  8508 23                   INC     HL
 787  8509 ED 79                OUT     (C),A
 788  850B 7E                   LD      A,(HL)
 789  850C 23                   INC     HL
 790  850D ED 79                OUT     (C),A
 791  850F 7E                   LD      A,(HL)
 792  8510 23                   INC     HL
 793  8511 ED 79                OUT     (C),A
 794  8513 19                   ADD     HL,DE
 795  8514 3A A1 89             LD      A,(DacIndex)
 796  8517 3C                   INC     A
 797  8518 32 A1 89             LD      (DacIndex),A
 798  851B E5                   PUSH    HL
 799  851C CD 23 85             CALL    DecPaletteRemaining
 800  851F E1                   POP     HL
 801  8520 20 DA                JR      NZ,ProgramDacPaletteLoop
 802  8522 C9                   RET
 803  8523
 804  8523              DecPaletteRemaining:
 805  8523 2A B5 89             LD      HL,(PaletteRemaining)
 806  8526 2B                   DEC     HL
 807  8527 22 B5 89             LD      (PaletteRemaining),HL
 808  852A 7C                   LD      A,H
 809  852B B5                   OR      L
 810  852C C9                   RET
 811  852D
 812  852D              ; Fill the framebuffer with a full-width horizontal hue gradient.
 813  852D              ; Palette entries are sampled evenly from the first to last hue.
 814  852D              ; A 16-bit accumulator spreads palette transitions uniformly across each row.
 815  852D              FillModeVRAM:
 816  852D AF                   XOR     A
 817  852E 32 9A 89             LD      (CurrentBank),A
 818  8531 32 A1 89             LD      (DacIndex),A
 819  8534 21 00 00             LD      HL,0
 820  8537 22 BB 89             LD      (GradientAccumulator),HL
 821  853A 22 BD 89             LD      (ModeXCounter),HL
 822  853D              ModeFillBank:
 823  853D 3A 9A 89             LD      A,(CurrentBank)
 824  8540 01 DF 03             LD      BC,$03DF
 825  8543 ED 79                OUT     (C),A
 826  8545 21 00 C0             LD      HL,$C000
 827  8548 3A 9A 89             LD      A,(CurrentBank)
 828  854B 47                   LD      B,A
 829  854C 3A B0 89             LD      A,(ModeBankCount)
 830  854F 3D                   DEC     A
 831  8550 B8                   CP      B
 832  8551 20 06                JR      NZ,ModeFillFullBank
 833  8553 ED 4B B1 89          LD      BC,(ModeLastBankBytes)
 834  8557 18 03                JR      ModeFillCountReady
 835  8559              ModeFillFullBank:
 836  8559 01 00 40             LD      BC,$4000
 837  855C              ModeFillCountReady:
 838  855C              ModeFillByte:
 839  855C 3A A1 89             LD      A,(DacIndex)
 840  855F 77                   LD      (HL),A
 841  8560 23                   INC     HL
 842  8561 E5                   PUSH    HL
 843  8562
 844  8562                      ; Advance the X coordinate and detect the end of the scanline.
 845  8562 2A BD 89             LD      HL,(ModeXCounter)
 846  8565 23                   INC     HL
 847  8566 22 BD 89             LD      (ModeXCounter),HL
 848  8569 E5                   PUSH    HL
 849  856A 3A AB 89             LD      A,(ModeXLo)
 850  856D 5F                   LD      E,A
 851  856E 3A AC 89             LD      A,(ModeXHi)
 852  8571 57                   LD      D,A
 853  8572 B7                   OR      A
 854  8573 ED 52                SBC     HL,DE
 855  8575 E1                   POP     HL
 856  8576 20 0F                JR      NZ,ModeGradientAdvance
 857  8578
 858  8578                      ; Restart the gradient at the beginning of every scanline.
 859  8578 21 00 00             LD      HL,0
 860  857B 22 BD 89             LD      (ModeXCounter),HL
 861  857E 22 BB 89             LD      (GradientAccumulator),HL
 862  8581 AF                   XOR     A
 863  8582 32 A1 89             LD      (DacIndex),A
 864  8585 18 21                JR      ModePatternAdvanceDone
 865  8587
 866  8587              ModeGradientAdvance:
 867  8587                      ; Bresenham-style distribution: add palette count per pixel and
 868  8587                      ; advance the DAC index whenever the accumulator reaches width.
 869  8587 2A BB 89             LD      HL,(GradientAccumulator)
 870  858A ED 5B B7 89          LD      DE,(PaletteCount)
 871  858E 19                   ADD     HL,DE
 872  858F ED 5B AB 89          LD      DE,(ModeXLo)
 873  8593 B7                   OR      A
 874  8594 ED 52                SBC     HL,DE
 875  8596 38 0C                JR      C,ModeGradientHold
 876  8598 22 BB 89             LD      (GradientAccumulator),HL
 877  859B 3A A1 89             LD      A,(DacIndex)
 878  859E 3C                   INC     A
 879  859F 32 A1 89             LD      (DacIndex),A
 880  85A2 18 04                JR      ModePatternAdvanceDone
 881  85A4              ModeGradientHold:
 882  85A4 19                   ADD     HL,DE
 883  85A5 22 BB 89             LD      (GradientAccumulator),HL
 884  85A8
 885  85A8              ModePatternAdvanceDone:
 886  85A8 E1                   POP     HL
 887  85A9 0B                   DEC     BC
 888  85AA 78                   LD      A,B
 889  85AB B1                   OR      C
 890  85AC C2 5C 85             JP      NZ,ModeFillByte
 891  85AF 3A 9A 89             LD      A,(CurrentBank)
 892  85B2 3C                   INC     A
 893  85B3 32 9A 89             LD      (CurrentBank),A
 894  85B6 47                   LD      B,A
 895  85B7 3A B0 89             LD      A,(ModeBankCount)
 896  85BA B8                   CP      B
 897  85BB C2 3D 85             JP      NZ,ModeFillBank
 898  85BE C9                   RET
 899  85BF
 900  85BF              ; Read back every programmed DAC entry, including all RGB components.
 901  85BF              ; Return A=0 on success, A=1 on mismatch.
 902  85BF              VerifyDacPalette:
 903  85BF 21 3C 96             LD      HL,DacHuePalette
 904  85C2 ED 5B B9 89          LD      DE,(PaletteStride)
 905  85C6 AF                   XOR     A
 906  85C7 32 A1 89             LD      (DacIndex),A
 907  85CA              VerifyDacPaletteLoop:
 908  85CA 3A A1 89             LD      A,(DacIndex)
 909  85CD 01 C7 03             LD      BC,$03C7
 910  85D0 ED 79                OUT     (C),A
 911  85D2 01 C9 03             LD      BC,$03C9
 912  85D5 ED 78                IN      A,(C)
 913  85D7 BE                   CP      (HL)
 914  85D8 20 1E                JR      NZ,VerifyDacPaletteFailed
 915  85DA 23                   INC     HL
 916  85DB ED 78                IN      A,(C)
 917  85DD BE                   CP      (HL)
 918  85DE 20 18                JR      NZ,VerifyDacPaletteFailed
 919  85E0 23                   INC     HL
 920  85E1 ED 78                IN      A,(C)
 921  85E3 BE                   CP      (HL)
 922  85E4 20 12                JR      NZ,VerifyDacPaletteFailed
 923  85E6 23                   INC     HL
 924  85E7 19                   ADD     HL,DE
 925  85E8 3A A1 89             LD      A,(DacIndex)
 926  85EB 3C                   INC     A
 927  85EC 32 A1 89             LD      (DacIndex),A
 928  85EF E5                   PUSH    HL
 929  85F0 CD 23 85             CALL    DecPaletteRemaining
 930  85F3 E1                   POP     HL
 931  85F4 20 D4                JR      NZ,VerifyDacPaletteLoop
 932  85F6 AF                   XOR     A
 933  85F7 C9                   RET
 934  85F8              VerifyDacPaletteFailed:
 935  85F8 3E 01                LD      A,1
 936  85FA C9                   RET
 937  85FB
 938  85FB              RunDac256Test:
 939  85FB 21 CB 91             LD      HL,MsgDacStart
 940  85FE CD 92 89             CALL    DebugPrint
 941  8601 CD 97 87             CALL    SpectrumShowDacStart
 942  8604 3E 00                LD      A,0
 943  8606 1E 40                LD      E,64
 944  8608 CD A7 80             CALL    WriteVgaRegister
 945  860B 3E 01                LD      A,1
 946  860D 1E 01                LD      E,1
 947  860F CD A7 80             CALL    WriteVgaRegister
 948  8612 3E 02                LD      A,2
 949  8614 1E C8                LD      E,200
 950  8616 CD A7 80             CALL    WriteVgaRegister
 951  8619 3E 03                LD      A,3
 952  861B 1E 00                LD      E,0
 953  861D CD A7 80             CALL    WriteVgaRegister
 954  8620 3E 04                LD      A,4
 955  8622 1E 08                LD      E,8
 956  8624 CD A7 80             CALL    WriteVgaRegister
 957  8627 3E 05                LD      A,5
 958  8629 1E 01                LD      E,1
 959  862B CD A7 80             CALL    WriteVgaRegister
 960  862E CD 7E 86             CALL    ProgramDac332
 961  8631
 962  8631                      ; DAC writes use ports 3C8h/3C9h. In the Project131 adapter model,
 963  8631                      ; writes to legacy VGA ports clear vbe_enabled. Re-apply the packed
 964  8631                      ; 320x200x8 mode AFTER programming the DAC, before touching VRAM.
 965  8631 3E 00                LD      A,0
 966  8633 1E 40                LD      E,64
 967  8635 CD A7 80             CALL    WriteVgaRegister
 968  8638 3E 01                LD      A,1
 969  863A 1E 01                LD      E,1
 970  863C CD A7 80             CALL    WriteVgaRegister
 971  863F 3E 02                LD      A,2
 972  8641 1E C8                LD      E,200
 973  8643 CD A7 80             CALL    WriteVgaRegister
 974  8646 3E 03                LD      A,3
 975  8648 1E 00                LD      E,0
 976  864A CD A7 80             CALL    WriteVgaRegister
 977  864D 3E 04                LD      A,4
 978  864F 1E 08                LD      E,8
 979  8651 CD A7 80             CALL    WriteVgaRegister
 980  8654 3E 05                LD      A,5
 981  8656 1E 01                LD      E,1
 982  8658 CD A7 80             CALL    WriteVgaRegister
 983  865B
 984  865B CD A6 86             CALL    FillDacFramebuffer
 985  865E CD E1 86             CALL    VerifyDac332
 986  8661 B7                   OR      A
 987  8662 20 0D                JR      NZ,DacTestFailed
