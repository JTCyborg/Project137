 699  8472 7E                   LD      A,(HL)
 700  8473 ED 79                OUT     (C),A
 701  8475 23                   INC     HL
 702  8476 0D                   DEC     C
 703  8477 15                   DEC     D
 704  8478 20 F3                JR      NZ,TextCrtcWrite
