 958  8619              ; HL points to register/value pairs; A is the byte count.
 959  8619              WriteAccelRegisterTable:
 960  8619 32 0D 8C             LD      (AccelPairCount),A
 961  861C              WriteAccelRegisterTableLoop:
 962  861C 7E                   LD      A,(HL)
 963  861D 23                   INC     HL
 964  861E 5E                   LD      E,(HL)
 965  861F 23                   INC     HL
 966  8620 E5                   PUSH    HL
