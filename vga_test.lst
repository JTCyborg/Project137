 968  864A              ; Restore the standard 16-colour VGA/EGA DAC palette (6-bit RGB).
 969  864A              ; This keeps the text-mode colour test independent of the preceding
 970  864A              ; programmable 256-entry gradient test.
 971  864A              ProgramStandardEgaPalette:
 972  864A 01 C8 03             LD      BC,$03C8
 973  864D AF                   XOR     A
 974  864E ED 79                OUT     (C),A
 975  8650 01 C9 03             LD      BC,$03C9
