 986  8660              StandardEgaPalette:
 987  8660                      ; RGB triples, DAC range 00h..3Fh.
 988  8660 00 00 00 00          DB $00,$00,$00, $00,$00,$2A, $00,$2A,$00, $00,$2A,$2A
 988  8664 00 2A 00 2A
