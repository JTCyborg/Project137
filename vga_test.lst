152   80BE 20 08                JR      NZ,PatternPointerReady
153   80C0 7B                   LD      A,E
154   80C1 FE 1A                CP      LOW ColorPatternEnd
155   80C3 20 03                JR      NZ,PatternPointerReady
156   80C5 11 9A 83             LD      DE,ColorPattern
