104   808F              ; -------------------------------------------------------------------------
105   808F              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
106   808F              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
107   808F              ; -------------------------------------------------------------------------
108   808F              OpenATMShadowPorts:
109   808F 01 9F 80             LD      BC,ShadowPortsOpened
110   8092 C5                   PUSH    BC
111   8093 01 53 2A             LD      BC,$2A53
112   8096 C5                   PUSH    BC
