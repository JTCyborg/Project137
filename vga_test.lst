 538  8348              ; -------------------------------------------------------------------------
 539  8348              ; Project131-compatible 2D accelerator smoke test.
 540  8348              ; Uses 320x200x8bpp so the complete 64,000-byte framebuffer is in banks 0..3.
 541  8348              ; Tests solid fill, VRAM-to-VRAM BitBLT, Bresenham line and status/readback.
 542  8348              ; Returns A=0 on success, A=1 on failure.
 543  8348              ; -------------------------------------------------------------------------
 544  8348              Run2DAcceleratorTest:
 545  8348 21 47 91             LD      HL,Msg2DStart
 546  834B CD BE 8B             CALL    DebugPrint
 547  834E CD FD 88             CALL    SpectrumShow2DStart
 548  8351
 549  8351                      ; The adapter powers up with a zeroed DAC. Program visible colours
 550  8351                      ; before the first 8-bpp test, then restore VBE mode (DAC writes
 551  8351                      ; switch the adapter to legacy software mode).
 552  8351 CD E3 81             CALL    Program2DTestPalette
 553  8354
 554  8354                      ; Select 320x200x8bpp.
 555  8354 3E 40                LD      A,320&255
 556  8356 32 D8 8B             LD      (ModeXLo),A
 557  8359 3E 01                LD      A,320>>8
 558  835B 32 D9 8B             LD      (ModeXHi),A
 559  835E 3E C8                LD      A,200&255
 560  8360 32 DA 8B             LD      (ModeYLo),A
 561  8363 AF                   XOR     A
 562  8364 32 DB 8B             LD      (ModeYHi),A
 563  8367 CD 77 86             CALL    ConfigureCurrentMode
 564  836A
 565  836A                      ; SOLID FILL: destination (20,20), 100x60, colour E3h.
 566  836A 21 08 86             LD      HL,AccelFillRegs
 567  836D 3E 26                LD      A,AccelFillRegsEnd-AccelFillRegs
 568  836F CD D4 85             CALL    WriteAccelRegisterTable
 569  8372 3E 00                LD      A,0
 570  8374 1E 01                LD      E,1
 571  8376 CD EB 85             CALL    WriteAccelRegister
 572  8379 CD F5 85             CALL    CheckAccelDone
 573  837C B7                   OR      A
 574  837D C0                   RET     NZ
 575  837E
 576  837E                      ; BITBLT: copy the filled rectangle to (140,20).
 577  837E 21 2E 86             LD      HL,AccelBlitRegs
 578  8381 3E 22                LD      A,AccelBlitRegsEnd-AccelBlitRegs
 579  8383 CD D4 85             CALL    WriteAccelRegisterTable
 580  8386 3E 00                LD      A,0
 581  8388 1E 02                LD      E,2
 582  838A CD EB 85             CALL    WriteAccelRegister
 583  838D CD F5 85             CALL    CheckAccelDone
 584  8390 B7                   OR      A
 585  8391 C0                   RET     NZ
 586  8392
 587  8392                      ; LINE: draw from (0,0) to (319,199), colour FFh.
 588  8392 21 50 86             LD      HL,AccelLineRegs
 589  8395 3E 1E                LD      A,AccelLineRegsEnd-AccelLineRegs
 590  8397 CD D4 85             CALL    WriteAccelRegisterTable
 591  839A 3E 00                LD      A,0
 592  839C 1E 03                LD      E,3
 593  839E CD EB 85             CALL    WriteAccelRegister
 594  83A1 CD F5 85             CALL    CheckAccelDone
 595  83A4 B7                   OR      A
 596  83A5 C0                   RET     NZ
 597  83A6
 598  83A6                      ; Read back the source and copied destination pixels in bank 0.
 599  83A6 AF                   XOR     A
 600  83A7 01 DF 03             LD      BC,$03DF
 601  83AA ED 79                OUT     (C),A
 602  83AC 21 14 D9             LD      HL,$D914             ; 20*320 + 20 + C000h
 603  83AF 7E                   LD      A,(HL)
 604  83B0 FE E3                CP      $E3
 605  83B2 C2 C5 85             JP      NZ,AccelReadbackFail
 606  83B5 21 8C D9             LD      HL,$D98C             ; 20*320 + 140 + C000h
 607  83B8 7E                   LD      A,(HL)
 608  83B9 FE E3                CP      $E3
 609  83BB C2 C5 85             JP      NZ,AccelReadbackFail
 610  83BE
 611  83BE                      ; The final line pixel is linear offset 63999 = bank 3:3A00?
 612  83BE                      ; Bank 3 aperture address = C000h + (63999 - 49152) = F9FFh.
 613  83BE 3E 03                LD      A,3
 614  83C0 01 DF 03             LD      BC,$03DF
 615  83C3 ED 79                OUT     (C),A
 616  83C5 21 FF F9             LD      HL,$F9FF
 617  83C8 7E                   LD      A,(HL)
 618  83C9 FE FF                CP      $FF
 619  83CB C2 C5 85             JP      NZ,AccelReadbackFail
 620  83CE
 621  83CE 21 69 91             LD      HL,Msg2DPass
 622  83D1 CD BE 8B             CALL    DebugPrint
 623  83D4 CD 97 89             CALL    SpectrumShow2DPass
 624  83D7 CD 94 8B             CALL    WaitSpace
