# file opened: vga_test.asm
  1   0000              ; =========================================================================
  2   0000              ; PROJECT137 — ATM TURBO 2+ EXTERNAL VGA ADAPTER TEST
  3   0000              ; Based on the proven ATM startup/ROM trampoline from Project112.
  4   0000              ; Target adapter: Project131 ISA VGA/SVGA software interface.
  5   0000              ;
  6   0000              ; Test:
  7   0000              ;   - unlock ATM shadow ports through TR-DOS ROM
  8   0000              ;   - enable VGA software mode + 16 KiB aperture
  9   0000              ;   - program 640x480 RGB565 through 3E0h/3E1h
 10   0000              ;   - fill 614400 bytes of linear VRAM through 38 aperture banks
 11   0000              ;   - read back bytes from bank 0 and the last framebuffer bank
 12   0000              ;   - report results on port EF (spectrum_out.txt)
 13   0000              ;
 14   0000              ; Expected image: eight-colour RGB565 vertical bars.
 15   0000              ; =========================================================================
 16   0000
 17   0000                      DEVICE ZXSPECTRUM128
 18   0000                      EMPTYTRD "vga_test.TRD"
 19   0000
 20   0000                      ORG     $8000
 21   8000
 22   8000              VgaTestEntry:
 23   8000 F3                   DI
 24   8001 31 FF BF             LD      SP,$BFFF
 25   8004
 26   8004 21 2C 83             LD      HL,MsgBuild
 27   8007 CD 4A 82             CALL    DebugPrint
 28   800A 21 43 83             LD      HL,MsgStart
 29   800D CD 4A 82             CALL    DebugPrint
 30   8010
 31   8010 CD 7A 80             CALL    OpenATMShadowPorts
 32   8013
 33   8013 21 69 83             LD      HL,MsgAdapterInit
 34   8016 CD 4A 82             CALL    DebugPrint
 35   8019
 36   8019                      ; 3DEh: software mode = 1, aperture enable = 1, bank 0.
 37   8019 01 DE 03             LD      BC,$03DE
 38   801C 3E 03                LD      A,$03
 39   801E ED 79                OUT     (C),A
 40   8020
 41   8020                      ; Configure packed-pixel 640x480 RGB565:
 42   8020                      ; XRES = 0280h, YRES = 01E0h, BPP = 16, ENABLE = 1.
 43   8020 3E 00                LD      A,0
 44   8022 1E 80                LD      E,$80
 45   8024 CD 8B 80             CALL    WriteVgaRegister
 46   8027 3E 01                LD      A,1
 47   8029 1E 02                LD      E,$02
 48   802B CD 8B 80             CALL    WriteVgaRegister
 49   802E 3E 02                LD      A,2
 50   8030 1E E0                LD      E,$E0
 51   8032 CD 8B 80             CALL    WriteVgaRegister
 52   8035 3E 03                LD      A,3
 53   8037 1E 01                LD      E,$01
 54   8039 CD 8B 80             CALL    WriteVgaRegister
 55   803C 3E 04                LD      A,4
 56   803E 1E 10                LD      E,16
 57   8040 CD 8B 80             CALL    WriteVgaRegister
 58   8043 3E 05                LD      A,5
 59   8045 1E 01                LD      E,1
 60   8047 CD 8B 80             CALL    WriteVgaRegister
