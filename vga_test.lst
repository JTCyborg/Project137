# file opened: vga_test.asm
   1  0000              ; =========================================================================
   2  0000              ; PROJECT137 — ATM TURBO 2+ EXTERNAL VGA ADAPTER STANDARD MODE TEST
   3  0000              ; Based on the proven ATM startup/ROM trampoline from Project112.
   4  0000              ; Target adapter: Project131 ISA VGA/SVGA software interface.
   5  0000              ;
   6  0000              ; Test:
   7  0000              ;   - unlock ATM shadow ports through TR-DOS ROM
   8  0000              ;   - enable VGA software mode + 16 KiB aperture
   9  0000              ;   - program 640x480 RGB565 through 3E0h/3E1h
  10  0000              ;   - fill 614400 bytes of linear VRAM through 38 aperture banks
  11  0000              ;   - read back bytes from bank 0 and the last framebuffer bank
  12  0000              ;   - report results on port EF (spectrum_out.txt)
  13  0000              ;
  14  0000              ; Expected image: eight-colour RGB565 vertical bars.
  15  0000              ; =========================================================================
  16  0000
  17  0000                      DEVICE ZXSPECTRUM128
  18  0000                      EMPTYTRD "vga_test.TRD"
  19  0000
  20  0000                      ORG     $8000
  21  8000
  22  8000              VgaTestEntry:
  23  8000 F3                   DI
  24  8001 31 FF BF             LD      SP,$BFFF
  25  8004
  26  8004 21 23 8C             LD      HL,MsgBuild
  27  8007 CD E6 87             CALL    DebugPrint
  28  800A 21 3A 8C             LD      HL,MsgStart
  29  800D CD E6 87             CALL    DebugPrint
  30  8010
  31  8010 CD 96 80             CALL    OpenATMShadowPorts
  32  8013
  33  8013                      ; Select standard Spectrum screen page 5 before drawing status text.
  34  8013 AF                   XOR     A
  35  8014 01 FD 7F             LD      BC,$7FFD
  36  8017 ED 79                OUT     (C),A
  37  8019 CD 09 87             CALL    SpectrumShowStartup
  38  801C 21 DF 8E             LD      HL,ScreenShadowReady
  39  801F CD 19 87             CALL    SpectrumShowStatus
  40  8022
  41  8022 21 60 8C             LD      HL,MsgAdapterInit
  42  8025 CD E6 87             CALL    DebugPrint
  43  8028
  44  8028 CD 28 87             CALL    SpectrumShowInitialMode
  45  802B
  46  802B                      ; 3DEh: software mode = 1, aperture enable = 1, bank 0.
  47  802B 01 DE 03             LD      BC,$03DE
  48  802E 3E 03                LD      A,$03
  49  8030 ED 79                OUT     (C),A
  50  8032
  51  8032                      ; Configure packed-pixel 640x480 RGB565:
  52  8032                      ; XRES = 0280h, YRES = 01E0h, BPP = 16, ENABLE = 1.
  53  8032 3E 00                LD      A,0
  54  8034 1E 80                LD      E,$80
  55  8036 CD A7 80             CALL    WriteVgaRegister
  56  8039 3E 01                LD      A,1
  57  803B 1E 02                LD      E,$02
  58  803D CD A7 80             CALL    WriteVgaRegister
  59  8040 3E 02                LD      A,2
  60  8042 1E E0                LD      E,$E0
  61  8044 CD A7 80             CALL    WriteVgaRegister
  62  8047 3E 03                LD      A,3
  63  8049 1E 01                LD      E,$01
  64  804B CD A7 80             CALL    WriteVgaRegister
  65  804E 3E 04                LD      A,4
  66  8050 1E 10                LD      E,16
  67  8052 CD A7 80             CALL    WriteVgaRegister
  68  8055 3E 05                LD      A,5
  69  8057 1E 01                LD      E,1
  70  8059 CD A7 80             CALL    WriteVgaRegister
  71  805C
  72  805C 21 77 8C             LD      HL,MsgModeSet
  73  805F CD E6 87             CALL    DebugPrint
  74  8062
  75  8062 CD B1 80             CALL    Fill640x480x16
  76  8065
  77  8065 21 91 8C             LD      HL,MsgFrameWritten
  78  8068 CD E6 87             CALL    DebugPrint
  79  806B CD 44 87             CALL    SpectrumShowInitialWriteComplete
  80  806E
  81  806E CD F6 80             CALL    VerifyFramebuffer
  82  8071 B7                   OR      A
  83  8072 20 19                JR      NZ,VgaTestFailed
  84  8074
  85  8074 21 AD 8C             LD      HL,MsgReadbackPass
  86  8077 CD E6 87             CALL    DebugPrint
  87  807A
  88  807A CD 29 81             CALL    RunPackedModeSweep
  89  807D
  90  807D CD E3 81             CALL    Run2DAcceleratorTest
  91  8080 B7                   OR      A
  92  8081 C2 1A 83             JP      NZ,AccelTestFailed
  93  8084
  94  8084 21 D7 8C             LD      HL,MsgReady
  95  8087 CD E6 87             CALL    DebugPrint
  96  808A
  97  808A              VgaTestIdle:
  98  808A 76                   HALT
  99  808B 18 FD                JR      VgaTestIdle
 100  808D
 101  808D              VgaTestFailed:
 102  808D 21 C2 8C             LD      HL,MsgReadbackFail
 103  8090 CD E6 87             CALL    DebugPrint
 104  8093              VgaTestFailedIdle:
 105  8093 76                   HALT
 106  8094 18 FD                JR      VgaTestFailedIdle
 107  8096
 108  8096              ; -------------------------------------------------------------------------
 109  8096              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
 110  8096              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
 111  8096              ; -------------------------------------------------------------------------
 112  8096              OpenATMShadowPorts:
 113  8096 01 A6 80             LD      BC,ShadowPortsOpened
 114  8099 C5                   PUSH    BC
 115  809A 01 53 2A             LD      BC,$2A53
 116  809D C5                   PUSH    BC
 117  809E 01 77 01             LD      BC,$0177
 118  80A1 3E C3                LD      A,$C3
 119  80A3 C3 2F 3D             JP      $3D2F
 120  80A6              ShadowPortsOpened:
 121  80A6 C9                   RET
 122  80A7
 123  80A7              ; A = indexed VGA register, E = value.
 124  80A7              WriteVgaRegister:
 125  80A7 01 E0 03             LD      BC,$03E0
 126  80AA ED 79                OUT     (C),A
 127  80AC 7B                   LD      A,E
 128  80AD 0C                   INC     C
 129  80AE ED 79                OUT     (C),A
 130  80B0 C9                   RET
 131  80B1
 132  80B1              ; -------------------------------------------------------------------------
 133  80B1              ; Fill the 640x480x16 framebuffer.
 134  80B1              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
 135  80B1              ; The aperture C000h-FFFFh is switched with port 3DFh.
 136  80B1              ; -------------------------------------------------------------------------
 137  80B1              Fill640x480x16:
 138  80B1 AF                   XOR     A
 139  80B2 32 EE 87             LD      (CurrentBank),A
 140  80B5
 141  80B5              FillBankLoop:
 142  80B5 3A EE 87             LD      A,(CurrentBank)
 143  80B8 01 DF 03             LD      BC,$03DF
 144  80BB ED 79                OUT     (C),A
 145  80BD
 146  80BD 21 00 C0             LD      HL,$C000
 147  80C0 11 A3 8B             LD      DE,ColorPattern
 148  80C3 3A EE 87             LD      A,(CurrentBank)
 149  80C6 FE 25                CP      37
 150  80C8 28 05                JR      Z,FillLastHalfBank
 151  80CA 01 00 40             LD      BC,$4000
 152  80CD 18 03                JR      FillBankBytes
 153  80CF
 154  80CF              FillLastHalfBank:
 155  80CF 01 00 20             LD      BC,$2000
 156  80D2
 157  80D2              FillBankBytes:
 158  80D2 1A                   LD      A,(DE)
 159  80D3 13                   INC     DE
 160  80D4 77                   LD      (HL),A
 161  80D5 23                   INC     HL
 162  80D6
 163  80D6                      ; Repeat the 128-byte RGB565 colour-bar sequence.
 164  80D6 F5                   PUSH    AF
 165  80D7 7A                   LD      A,D
 166  80D8 FE 8C                CP      HIGH ColorPatternEnd
 167  80DA 20 08                JR      NZ,PatternPointerReady
 168  80DC 7B                   LD      A,E
 169  80DD FE 23                CP      LOW ColorPatternEnd
 170  80DF 20 03                JR      NZ,PatternPointerReady
 171  80E1 11 A3 8B             LD      DE,ColorPattern
 172  80E4              PatternPointerReady:
 173  80E4 F1                   POP     AF
 174  80E5
 175  80E5 0B                   DEC     BC
 176  80E6 78                   LD      A,B
 177  80E7 B1                   OR      C
 178  80E8 20 E8                JR      NZ,FillBankBytes
 179  80EA
 180  80EA 3A EE 87             LD      A,(CurrentBank)
 181  80ED 3C                   INC     A
 182  80EE 32 EE 87             LD      (CurrentBank),A
 183  80F1 FE 26                CP      38
 184  80F3 20 C0                JR      NZ,FillBankLoop
 185  80F5 C9                   RET
 186  80F6
 187  80F6              ; -------------------------------------------------------------------------
 188  80F6              ; Readback checks:
 189  80F6              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
 190  80F6              ; bank 37 starts at linear offset 37*4000h = 5E000h.
 191  80F6              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
 192  80F6              ; Return A=0 on success, A=1 on mismatch.
 193  80F6              ; -------------------------------------------------------------------------
 194  80F6              VerifyFramebuffer:
 195  80F6 AF                   XOR     A
 196  80F7 01 DF 03             LD      BC,$03DF
 197  80FA ED 79                OUT     (C),A
 198  80FC
 199  80FC 21 00 C0             LD      HL,$C000
 200  80FF                      ; First eight pixels are black: bytes 0..15 must be zero.
 201  80FF 7E                   LD      A,(HL)
 202  8100 B7                   OR      A
 203  8101 20 23                JR      NZ,VerifyFailed
 204  8103 23                   INC     HL
 205  8104 7E                   LD      A,(HL)
 206  8105 B7                   OR      A
 207  8106 20 1E                JR      NZ,VerifyFailed
 208  8108
 209  8108                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
 210  8108 21 10 C0             LD      HL,$C010
 211  810B 7E                   LD      A,(HL)
 212  810C FE 1F                CP      $1F
 213  810E 20 16                JR      NZ,VerifyFailed
 214  8110 23                   INC     HL
 215  8111 7E                   LD      A,(HL)
 216  8112 B7                   OR      A
 217  8113 20 11                JR      NZ,VerifyFailed
 218  8115
 219  8115 3E 25                LD      A,37
 220  8117 01 DF 03             LD      BC,$03DF
 221  811A ED 79                OUT     (C),A
 222  811C 21 FF DF             LD      HL,$DFFF
 223  811F 7E                   LD      A,(HL)
 224  8120 FE FF                CP      $FF
 225  8122 20 02                JR      NZ,VerifyFailed
 226  8124
 227  8124 AF                   XOR     A
 228  8125 C9                   RET
 229  8126
 230  8126              VerifyFailed:
 231  8126 3E 01                LD      A,1
 232  8128 C9                   RET
 233  8129
 234  8129
 235  8129              ; -------------------------------------------------------------------------
 236  8129              ; Sweep the nine requested standard PC display resolutions.
 237  8129              ; Each mode uses 8-bpp indexed pixels and writes exactly its visible
 238  8129              ; framebuffer size. Use only the adapter's initialized EGA palette
 239  8129              ; entries 0..7, matching the proven Project132 test pattern.
 240  8129              ; SPACE advances to the next resolution.
 241  8129              ; -------------------------------------------------------------------------
 242  8129              RunPackedModeSweep:
 243  8129 21 FE 8C             LD      HL,MsgSweepStart
 244  812C CD E6 87             CALL    DebugPrint
 245  812F 21 30 88             LD      HL,PackedModeTable
 246  8132 22 F9 87             LD      (ModeTablePtr),HL
 247  8135 21 8C 88             LD      HL,ModeLabelTable
 248  8138 22 F0 87             LD      (ModeLabelPtr),HL
 249  813B 3E 09                LD      A,9
 250  813D 32 FB 87             LD      (ModeCount),A
 251  8140
 252  8140              ; Outer loop: increase resolution only after all four palette sizes pass.
 253  8140              PackedModeNext:
 254  8140 2A F9 87             LD      HL,(ModeTablePtr)
 255  8143 7E                   LD      A,(HL)
 256  8144 23                   INC     HL
 257  8145 32 FC 87             LD      (ModeXLo),A
 258  8148 7E                   LD      A,(HL)
 259  8149 23                   INC     HL
 260  814A 32 FD 87             LD      (ModeXHi),A
 261  814D 7E                   LD      A,(HL)
 262  814E 23                   INC     HL
 263  814F 32 FE 87             LD      (ModeYLo),A
 264  8152 7E                   LD      A,(HL)
 265  8153 23                   INC     HL
 266  8154 32 FF 87             LD      (ModeYHi),A
 267  8157 7E                   LD      A,(HL)
 268  8158 23                   INC     HL
 269  8159 32 00 88             LD      (ModeBpp),A
 270  815C 7E                   LD      A,(HL)
 271  815D 23                   INC     HL
 272  815E 32 01 88             LD      (ModeBankCount),A
 273  8161 7E                   LD      A,(HL)
 274  8162 23                   INC     HL
 275  8163 32 02 88             LD      (ModeLastBankBytes),A
 276  8166 7E                   LD      A,(HL)
 277  8167 23                   INC     HL
 278  8168 32 03 88             LD      (ModeLastBankBytes+1),A
 279  816B 22 F9 87             LD      (ModeTablePtr),HL
 280  816E
 281  816E CD 23 83             CALL    ConfigureCurrentMode
 282  8171 CD 60 87             CALL    SpectrumShowMode
 283  8174
 284  8174 AF                   XOR     A
 285  8175 32 04 88             LD      (PaletteLevel),A
 286  8178
 287  8178              ; Inner loop: 2, 4, 16 and 256 DAC entries at this resolution.
 288  8178              PackedPaletteNext:
 289  8178 CD 58 83             CALL    SelectPaletteParameters
 290  817B CD 87 83             CALL    ProgramDacPalette
 291  817E
 292  817E                      ; Legacy DAC writes disable VBE in the adapter model.
 293  817E                      ; Re-apply this resolution's indexed 8-bpp mode before VRAM access.
 294  817E CD 23 83             CALL    ConfigureCurrentMode
 295  8181
 296  8181 21 F3 8D             LD      HL,MsgPaletteLevel
 297  8184 CD E6 87             CALL    DebugPrint
 298  8187 3A 04 88             LD      A,(PaletteLevel)
 299  818A CD CC 87             CALL    DebugHexByte
 300  818D 21 02 8E             LD      HL,MsgPaletteSuffix
 301  8190 CD E6 87             CALL    DebugPrint
 302  8193
 303  8193                      ; Verify the DAC before touching the framebuffer. This keeps all
 304  8193                      ; DAC read-index/component activity out of the post-render phase.
 305  8193 CD 58 83             CALL    SelectPaletteParameters
 306  8196 CD 55 84             CALL    VerifyDacPalette
 307  8199 B7                   OR      A
 308  819A 20 3A                JR      NZ,PackedPaletteFailed
 309  819C
 310  819C CD C3 83             CALL    FillModeVRAM
 311  819F
 312  819F 21 21 8E             LD      HL,MsgPalettePass
 313  81A2 CD E6 87             CALL    DebugPrint
 314  81A5 CD 8C 87             CALL    SpectrumShowWriteComplete
 315  81A8 CD BC 87             CALL    WaitSpace
 316  81AB
 317  81AB 3A 04 88             LD      A,(PaletteLevel)
 318  81AE 3C                   INC     A
 319  81AF 32 04 88             LD      (PaletteLevel),A
 320  81B2 FE 04                CP      4
 321  81B4 20 C2                JR      NZ,PackedPaletteNext
 322  81B6
 323  81B6 3A FB 87             LD      A,(ModeCount)
 324  81B9 3D                   DEC     A
 325  81BA 32 FB 87             LD      (ModeCount),A
 326  81BD C2 40 81             JP      NZ,PackedModeNext
 327  81C0
 328  81C0 21 47 8D             LD      HL,MsgSweepDone
 329  81C3 CD E6 87             CALL    DebugPrint
 330  81C6 CD E7 86             CALL    SpectrumClear
 331  81C9 21 A8 8E             LD      HL,ScreenTitle
 332  81CC CD 33 86             CALL    SpectrumPrint
 333  81CF 21 E7 8F             LD      HL,ScreenAllDone
 334  81D2 CD 33 86             CALL    SpectrumPrint
 335  81D5 C9                   RET
 336  81D6
 337  81D6              PackedPaletteFailed:
 338  81D6 21 35 8E             LD      HL,MsgPaletteFail
 339  81D9 CD E6 87             CALL    DebugPrint
 340  81DC CD 1D 86             CALL    SpectrumShowDacFail
 341  81DF CD BC 87             CALL    WaitSpace
 342  81E2 C9                   RET
 343  81E3
 344  81E3              ; -------------------------------------------------------------------------
 345  81E3              ; Project131-compatible 2D accelerator smoke test.
 346  81E3              ; Uses 320x200x8bpp so the complete 64,000-byte framebuffer is in banks 0..3.
 347  81E3              ; Tests solid fill, VRAM-to-VRAM BitBLT, Bresenham line and status/readback.
 348  81E3              ; Returns A=0 on success, A=1 on failure.
 349  81E3              ; -------------------------------------------------------------------------
 350  81E3              Run2DAcceleratorTest:
 351  81E3 21 6B 8D             LD      HL,Msg2DStart
 352  81E6 CD E6 87             CALL    DebugPrint
 353  81E9 CD A9 85             CALL    SpectrumShow2DStart
 354  81EC
 355  81EC                      ; Select 320x200x8bpp.
 356  81EC 3E 40                LD      A,320&255
 357  81EE 32 FC 87             LD      (ModeXLo),A
 358  81F1 3E 01                LD      A,320>>8
 359  81F3 32 FD 87             LD      (ModeXHi),A
 360  81F6 3E C8                LD      A,200&255
 361  81F8 32 FE 87             LD      (ModeYLo),A
 362  81FB AF                   XOR     A
 363  81FC 32 FF 87             LD      (ModeYHi),A
 364  81FF CD 23 83             CALL    ConfigureCurrentMode
 365  8202
 366  8202                      ; SOLID FILL: destination (20,20), 100x60, colour E3h.
 367  8202 21 B4 82             LD      HL,AccelFillRegs
 368  8205 3E 26                LD      A,AccelFillRegsEnd-AccelFillRegs
 369  8207 CD 80 82             CALL    WriteAccelRegisterTable
 370  820A 3E 00                LD      A,0
 371  820C 1E 01                LD      E,1
 372  820E CD 97 82             CALL    WriteAccelRegister
 373  8211 CD A1 82             CALL    CheckAccelDone
 374  8214 B7                   OR      A
 375  8215 C0                   RET     NZ
 376  8216
 377  8216                      ; BITBLT: copy the filled rectangle to (140,20).
 378  8216 21 DA 82             LD      HL,AccelBlitRegs
 379  8219 3E 22                LD      A,AccelBlitRegsEnd-AccelBlitRegs
 380  821B CD 80 82             CALL    WriteAccelRegisterTable
 381  821E 3E 00                LD      A,0
 382  8220 1E 02                LD      E,2
 383  8222 CD 97 82             CALL    WriteAccelRegister
 384  8225 CD A1 82             CALL    CheckAccelDone
 385  8228 B7                   OR      A
 386  8229 C0                   RET     NZ
 387  822A
 388  822A                      ; LINE: draw from (0,0) to (319,199), colour FFh.
 389  822A 21 FC 82             LD      HL,AccelLineRegs
 390  822D 3E 1E                LD      A,AccelLineRegsEnd-AccelLineRegs
 391  822F CD 80 82             CALL    WriteAccelRegisterTable
 392  8232 3E 00                LD      A,0
 393  8234 1E 03                LD      E,3
 394  8236 CD 97 82             CALL    WriteAccelRegister
 395  8239 CD A1 82             CALL    CheckAccelDone
 396  823C B7                   OR      A
 397  823D C0                   RET     NZ
 398  823E
 399  823E                      ; Read back the source and copied destination pixels in bank 0.
 400  823E AF                   XOR     A
 401  823F 01 DF 03             LD      BC,$03DF
 402  8242 ED 79                OUT     (C),A
 403  8244 21 14 D9             LD      HL,$D914             ; 20*320 + 20 + C000h
 404  8247 7E                   LD      A,(HL)
 405  8248 FE E3                CP      $E3
 406  824A 20 25                JR      NZ,AccelReadbackFail
 407  824C 21 8C D9             LD      HL,$D98C             ; 20*320 + 140 + C000h
 408  824F 7E                   LD      A,(HL)
 409  8250 FE E3                CP      $E3
 410  8252 20 1D                JR      NZ,AccelReadbackFail
 411  8254
 412  8254                      ; The final line pixel is linear offset 63999 = bank 3:3A00?
 413  8254                      ; Bank 3 aperture address = C000h + (63999 - 49152) = F9FFh.
 414  8254 3E 03                LD      A,3
 415  8256 01 DF 03             LD      BC,$03DF
 416  8259 ED 79                OUT     (C),A
 417  825B 21 FF F9             LD      HL,$F9FF
 418  825E 7E                   LD      A,(HL)
 419  825F FE FF                CP      $FF
 420  8261 20 0E                JR      NZ,AccelReadbackFail
 421  8263
 422  8263 21 8D 8D             LD      HL,Msg2DPass
 423  8266 CD E6 87             CALL    DebugPrint
 424  8269 CD BF 85             CALL    SpectrumShow2DPass
 425  826C CD BC 87             CALL    WaitSpace
 426  826F AF                   XOR     A
 427  8270 C9                   RET
 428  8271
 429  8271              AccelReadbackFail:
 430  8271 21 D4 8D             LD      HL,Msg2DReadbackFail
 431  8274 CD E6 87             CALL    DebugPrint
 432  8277 CD D5 85             CALL    SpectrumShow2DFail
 433  827A CD BC 87             CALL    WaitSpace
 434  827D 3E 01                LD      A,1
 435  827F C9                   RET
 436  8280
 437  8280              ; HL points to register/value pairs; A is the byte count.
 438  8280              WriteAccelRegisterTable:
 439  8280 32 EF 87             LD      (AccelPairCount),A
 440  8283              WriteAccelRegisterTableLoop:
 441  8283 7E                   LD      A,(HL)
 442  8284 23                   INC     HL
 443  8285 5E                   LD      E,(HL)
 444  8286 23                   INC     HL
 445  8287 E5                   PUSH    HL
 446  8288 CD 97 82             CALL    WriteAccelRegister
 447  828B E1                   POP     HL
 448  828C 3A EF 87             LD      A,(AccelPairCount)
 449  828F D6 02                SUB     2
 450  8291 32 EF 87             LD      (AccelPairCount),A
 451  8294 20 ED                JR      NZ,WriteAccelRegisterTableLoop
 452  8296 C9                   RET
 453  8297
 454  8297              ; A = accelerator register index, E = value.
 455  8297              WriteAccelRegister:
 456  8297 01 E2 03             LD      BC,$03E2
 457  829A ED 79                OUT     (C),A
 458  829C 7B                   LD      A,E
 459  829D 0C                   INC     C
 460  829E ED 79                OUT     (C),A
 461  82A0 C9                   RET
 462  82A1
 463  82A1              ; Returns A=0 when status register reports DONE (1), otherwise A=1.
 464  82A1              CheckAccelDone:
 465  82A1 01 E2 03             LD      BC,$03E2
 466  82A4 3E 01                LD      A,1
 467  82A6 ED 79                OUT     (C),A
 468  82A8 0C                   INC     C
 469  82A9 ED 78                IN      A,(C)
 470  82AB FE 01                CP      1
 471  82AD 20 02                JR      NZ,CheckAccelFailed
 472  82AF AF                   XOR     A
 473  82B0 C9                   RET
 474  82B1              CheckAccelFailed:
 475  82B1 3E 01                LD      A,1
 476  82B3 C9                   RET
 477  82B4
 478  82B4              ; Register tables: index,value pairs. All addresses are byte offsets in VRAM.
 479  82B4              AccelFillRegs:
 480  82B4 02 00                DB $02,$00                 ; ROP COPY
 481  82B6 08 00 09 00          DB $08,$00,$09,$00,$0A,$00,$0B,$00 ; destination base = 0
 481  82BA 0A 00 0B 00
 482  82BE 0E 40 0F 01          DB $0E,$40,$0F,$01         ; destination pitch = 320
 483  82C2 14 14 15 00          DB $14,20,$15,0,$16,20,$17,0
 483  82C6 16 14 17 00
 484  82CA 18 64 19 00          DB $18,100,$19,0,$1A,60,$1B,0
 484  82CE 1A 3C 1B 00
 485  82D2 1C E3 1D 00          DB $1C,$E3,$1D,0,$1E,0,$1F,0
 485  82D6 1E 00 1F 00
 486  82DA              AccelFillRegsEnd:
 487  82DA
 488  82DA              AccelBlitRegs:
 489  82DA 02 00                DB $02,$00
 490  82DC 0C 40 0D 01          DB $0C,$40,$0D,$01         ; source pitch = 320
 491  82E0 0E 40 0F 01          DB $0E,$40,$0F,$01         ; destination pitch = 320
 492  82E4 10 14 11 00          DB $10,20,$11,0,$12,20,$13,0
 492  82E8 12 14 13 00
 493  82EC 14 8C 15 00          DB $14,140,$15,0,$16,20,$17,0
 493  82F0 16 14 17 00
 494  82F4 18 64 19 00          DB $18,100,$19,0,$1A,60,$1B,0
 494  82F8 1A 3C 1B 00
 495  82FC              AccelBlitRegsEnd:
 496  82FC
 497  82FC              AccelLineRegs:
 498  82FC 02 00                DB $02,$00
 499  82FE 0E 40 0F 01          DB $0E,$40,$0F,$01         ; destination pitch = 320
 500  8302 14 00 15 00          DB $14,0,$15,0,$16,0,$17,0
 500  8306 16 00 17 00
 501  830A 1C FF 1D 00          DB $1C,$FF,$1D,0,$1E,0,$1F,0
 501  830E 1E 00 1F 00
 502  8312 20 3F 21 01          DB $20,63,$21,1,$22,199,$23,0 ; endpoint (319,199)
 502  8316 22 C7 23 00
 503  831A              AccelLineRegsEnd:
 504  831A
 505  831A              AccelTestFailed:
 506  831A 21 B9 8D             LD      HL,Msg2DFail
 507  831D CD E6 87             CALL    DebugPrint
 508  8320              AccelTestFailedIdle:
 509  8320 76                   HALT
 510  8321 18 FD                JR      AccelTestFailedIdle
