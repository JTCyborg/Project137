# file opened: vga_test.asm
   1  0000              ; =========================================================================
   2  0000              ; PROJECT137 — ATM TURBO 2+ EXTERNAL VGA ADAPTER STANDARD MODE TEST
   3  0000              ; Based on the proven ATM startup/ROM trampoline from Project112.
   4  0000              ; Target adapter: Project131 ISA VGA/SVGA software interface.
   5  0000              ;
   6  0000              ; Test:
   7  0000              ;   - unlock ATM shadow ports through TR-DOS ROM
   8  0000              ;   - enable VGA software mode + 16 KiB aperture
   9  0000              ;   - program 640x480 RGB565 through 3E0h/3E1h
  10  0000              ;   - fill 614400 bytes of linear VRAM through 38 aperture banks
  11  0000              ;   - read back bytes from bank 0 and the last framebuffer bank
  12  0000              ;   - report results on port EF (spectrum_out.txt)
  13  0000              ;
  14  0000              ; Expected image: eight-colour RGB565 vertical bars.
  15  0000              ; =========================================================================
  16  0000
  17  0000                      DEVICE ZXSPECTRUM128
  18  0000                      EMPTYTRD "vga_test.TRD"
  19  0000
  20  0000                      ORG     $8000
  21  8000
  22  8000              VgaTestEntry:
  23  8000 F3                   DI
  24  8001 31 FF BF             LD      SP,$BFFF
  25  8004
  26  8004 21 8C 8D             LD      HL,MsgBuild
  27  8007 CD 4C 89             CALL    DebugPrint
  28  800A 21 A3 8D             LD      HL,MsgStart
  29  800D CD 4C 89             CALL    DebugPrint
  30  8010
  31  8010 CD 96 80             CALL    OpenATMShadowPorts
  32  8013
  33  8013                      ; Select standard Spectrum screen page 5 before drawing status text.
  34  8013 AF                   XOR     A
  35  8014 01 FD 7F             LD      BC,$7FFD
  36  8017 ED 79                OUT     (C),A
  37  8019 CD 6F 88             CALL    SpectrumShowStartup
  38  801C 21 C2 90             LD      HL,ScreenShadowReady
  39  801F CD 7F 88             CALL    SpectrumShowStatus
  40  8022
  41  8022 21 C9 8D             LD      HL,MsgAdapterInit
  42  8025 CD 4C 89             CALL    DebugPrint
  43  8028
  44  8028                      ; Enable the adapter before running any engine tests.
  45  8028                      ; 3DEh: software mode = 1, aperture enable = 1, bank 0.
  46  8028 01 DE 03             LD      BC,$03DE
  47  802B 3E 03                LD      A,$03
  48  802D ED 79                OUT     (C),A
  49  802F
  50  802F                      ; Run 2D engine tests first, before framebuffer and palette sweeps.
  51  802F CD 02 83             CALL    Run2DAcceleratorTest
  52  8032 B7                   OR      A
  53  8033 C2 3E 84             JP      NZ,AccelTestFailed
  54  8036
  55  8036 CD 8E 88             CALL    SpectrumShowInitialMode
  56  8039
  57  8039                      ; Configure packed-pixel 640x480 RGB565:
  58  8039                      ; XRES = 0280h, YRES = 01E0h, BPP = 16, ENABLE = 1.
  59  8039 3E 00                LD      A,0
  60  803B 1E 80                LD      E,$80
  61  803D CD A7 80             CALL    WriteVgaRegister
  62  8040 3E 01                LD      A,1
  63  8042 1E 02                LD      E,$02
  64  8044 CD A7 80             CALL    WriteVgaRegister
  65  8047 3E 02                LD      A,2
  66  8049 1E E0                LD      E,$E0
  67  804B CD A7 80             CALL    WriteVgaRegister
  68  804E 3E 03                LD      A,3
  69  8050 1E 01                LD      E,$01
  70  8052 CD A7 80             CALL    WriteVgaRegister
  71  8055 3E 04                LD      A,4
  72  8057 1E 10                LD      E,16
  73  8059 CD A7 80             CALL    WriteVgaRegister
  74  805C 3E 05                LD      A,5
  75  805E 1E 01                LD      E,1
  76  8060 CD A7 80             CALL    WriteVgaRegister
  77  8063
  78  8063 21 E0 8D             LD      HL,MsgModeSet
  79  8066 CD 4C 89             CALL    DebugPrint
  80  8069
  81  8069 CD B1 80             CALL    Fill640x480x16
  82  806C
  83  806C 21 FA 8D             LD      HL,MsgFrameWritten
  84  806F CD 4C 89             CALL    DebugPrint
  85  8072 CD AA 88             CALL    SpectrumShowInitialWriteComplete
  86  8075
  87  8075 CD F6 80             CALL    VerifyFramebuffer
  88  8078 B7                   OR      A
  89  8079 20 12                JR      NZ,VgaTestFailed
  90  807B
  91  807B 21 16 8E             LD      HL,MsgReadbackPass
  92  807E CD 4C 89             CALL    DebugPrint
  93  8081
  94  8081                      ; Palette/resolution matrix is deliberately the final test group.
  95  8081 CD 29 81             CALL    RunPackedModeSweep
  96  8084
  97  8084 21 40 8E             LD      HL,MsgReady
  98  8087 CD 4C 89             CALL    DebugPrint
  99  808A
 100  808A              VgaTestIdle:
 101  808A 76                   HALT
 102  808B 18 FD                JR      VgaTestIdle
 103  808D
 104  808D              VgaTestFailed:
 105  808D 21 2B 8E             LD      HL,MsgReadbackFail
 106  8090 CD 4C 89             CALL    DebugPrint
 107  8093              VgaTestFailedIdle:
 108  8093 76                   HALT
 109  8094 18 FD                JR      VgaTestFailedIdle
 110  8096
 111  8096              ; -------------------------------------------------------------------------
 112  8096              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
 113  8096              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
 114  8096              ; -------------------------------------------------------------------------
 115  8096              OpenATMShadowPorts:
 116  8096 01 A6 80             LD      BC,ShadowPortsOpened
 117  8099 C5                   PUSH    BC
 118  809A 01 53 2A             LD      BC,$2A53
 119  809D C5                   PUSH    BC
 120  809E 01 77 01             LD      BC,$0177
 121  80A1 3E C3                LD      A,$C3
 122  80A3 C3 2F 3D             JP      $3D2F
 123  80A6              ShadowPortsOpened:
 124  80A6 C9                   RET
 125  80A7
 126  80A7              ; A = indexed VGA register, E = value.
 127  80A7              WriteVgaRegister:
 128  80A7 01 E0 03             LD      BC,$03E0
 129  80AA ED 79                OUT     (C),A
 130  80AC 7B                   LD      A,E
 131  80AD 0C                   INC     C
 132  80AE ED 79                OUT     (C),A
 133  80B0 C9                   RET
 134  80B1
 135  80B1              ; -------------------------------------------------------------------------
 136  80B1              ; Fill the 640x480x16 framebuffer.
 137  80B1              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
 138  80B1              ; The aperture C000h-FFFFh is switched with port 3DFh.
 139  80B1              ; -------------------------------------------------------------------------
 140  80B1              Fill640x480x16:
 141  80B1 AF                   XOR     A
 142  80B2 32 54 89             LD      (CurrentBank),A
 143  80B5
 144  80B5              FillBankLoop:
 145  80B5 3A 54 89             LD      A,(CurrentBank)
 146  80B8 01 DF 03             LD      BC,$03DF
 147  80BB ED 79                OUT     (C),A
 148  80BD
 149  80BD 21 00 C0             LD      HL,$C000
 150  80C0 11 0C 8D             LD      DE,ColorPattern
 151  80C3 3A 54 89             LD      A,(CurrentBank)
 152  80C6 FE 25                CP      37
 153  80C8 28 05                JR      Z,FillLastHalfBank
 154  80CA 01 00 40             LD      BC,$4000
 155  80CD 18 03                JR      FillBankBytes
 156  80CF
 157  80CF              FillLastHalfBank:
 158  80CF 01 00 20             LD      BC,$2000
 159  80D2
 160  80D2              FillBankBytes:
 161  80D2 1A                   LD      A,(DE)
 162  80D3 13                   INC     DE
 163  80D4 77                   LD      (HL),A
 164  80D5 23                   INC     HL
 165  80D6
 166  80D6                      ; Repeat the 128-byte RGB565 colour-bar sequence.
 167  80D6 F5                   PUSH    AF
 168  80D7 7A                   LD      A,D
 169  80D8 FE 8D                CP      HIGH ColorPatternEnd
 170  80DA 20 08                JR      NZ,PatternPointerReady
 171  80DC 7B                   LD      A,E
 172  80DD FE 8C                CP      LOW ColorPatternEnd
 173  80DF 20 03                JR      NZ,PatternPointerReady
 174  80E1 11 0C 8D             LD      DE,ColorPattern
 175  80E4              PatternPointerReady:
 176  80E4 F1                   POP     AF
 177  80E5
 178  80E5 0B                   DEC     BC
 179  80E6 78                   LD      A,B
 180  80E7 B1                   OR      C
 181  80E8 20 E8                JR      NZ,FillBankBytes
 182  80EA
 183  80EA 3A 54 89             LD      A,(CurrentBank)
 184  80ED 3C                   INC     A
 185  80EE 32 54 89             LD      (CurrentBank),A
 186  80F1 FE 26                CP      38
 187  80F3 20 C0                JR      NZ,FillBankLoop
 188  80F5 C9                   RET
 189  80F6
 190  80F6              ; -------------------------------------------------------------------------
 191  80F6              ; Readback checks:
 192  80F6              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
 193  80F6              ; bank 37 starts at linear offset 37*4000h = 5E000h.
 194  80F6              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
 195  80F6              ; Return A=0 on success, A=1 on mismatch.
 196  80F6              ; -------------------------------------------------------------------------
 197  80F6              VerifyFramebuffer:
 198  80F6 AF                   XOR     A
 199  80F7 01 DF 03             LD      BC,$03DF
 200  80FA ED 79                OUT     (C),A
 201  80FC
 202  80FC 21 00 C0             LD      HL,$C000
 203  80FF                      ; First eight pixels are black: bytes 0..15 must be zero.
 204  80FF 7E                   LD      A,(HL)
 205  8100 B7                   OR      A
 206  8101 20 23                JR      NZ,VerifyFailed
 207  8103 23                   INC     HL
 208  8104 7E                   LD      A,(HL)
 209  8105 B7                   OR      A
 210  8106 20 1E                JR      NZ,VerifyFailed
 211  8108
 212  8108                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
 213  8108 21 10 C0             LD      HL,$C010
 214  810B 7E                   LD      A,(HL)
 215  810C FE 1F                CP      $1F
 216  810E 20 16                JR      NZ,VerifyFailed
 217  8110 23                   INC     HL
 218  8111 7E                   LD      A,(HL)
 219  8112 B7                   OR      A
 220  8113 20 11                JR      NZ,VerifyFailed
 221  8115
 222  8115 3E 25                LD      A,37
 223  8117 01 DF 03             LD      BC,$03DF
 224  811A ED 79                OUT     (C),A
 225  811C 21 FF DF             LD      HL,$DFFF
 226  811F 7E                   LD      A,(HL)
 227  8120 FE FF                CP      $FF
 228  8122 20 02                JR      NZ,VerifyFailed
 229  8124
 230  8124 AF                   XOR     A
 231  8125 C9                   RET
 232  8126
 233  8126              VerifyFailed:
 234  8126 3E 01                LD      A,1
 235  8128 C9                   RET
 236  8129
 237  8129
 238  8129              ; -------------------------------------------------------------------------
 239  8129              ; Sweep the nine requested standard PC display resolutions.
 240  8129              ; Each mode uses 8-bpp indexed pixels and writes exactly its visible
 241  8129              ; framebuffer size. Use only the adapter's initialized EGA palette
 242  8129              ; entries 0..7, matching the proven Project132 test pattern.
 243  8129              ; SPACE advances to the next resolution.
 244  8129              ; -------------------------------------------------------------------------
 245  8129              RunPackedModeSweep:
 246  8129 21 67 8E             LD      HL,MsgSweepStart
 247  812C CD 4C 89             CALL    DebugPrint
 248  812F 21 99 89             LD      HL,PackedModeTable
 249  8132 22 62 89             LD      (ModeTablePtr),HL
 250  8135 21 F5 89             LD      HL,ModeLabelTable
 251  8138 22 59 89             LD      (ModeLabelPtr),HL
 252  813B 3E 09                LD      A,9
 253  813D 32 64 89             LD      (ModeCount),A
 254  8140
 255  8140              ; Outer loop: increase resolution only after all four palette sizes pass.
 256  8140              PackedModeNext:
 257  8140 2A 62 89             LD      HL,(ModeTablePtr)
 258  8143 7E                   LD      A,(HL)
 259  8144 23                   INC     HL
 260  8145 32 65 89             LD      (ModeXLo),A
 261  8148 7E                   LD      A,(HL)
 262  8149 23                   INC     HL
 263  814A 32 66 89             LD      (ModeXHi),A
 264  814D 7E                   LD      A,(HL)
 265  814E 23                   INC     HL
 266  814F 32 67 89             LD      (ModeYLo),A
 267  8152 7E                   LD      A,(HL)
 268  8153 23                   INC     HL
 269  8154 32 68 89             LD      (ModeYHi),A
 270  8157 7E                   LD      A,(HL)
 271  8158 23                   INC     HL
 272  8159 32 69 89             LD      (ModeBpp),A
 273  815C 7E                   LD      A,(HL)
 274  815D 23                   INC     HL
 275  815E 32 6A 89             LD      (ModeBankCount),A
 276  8161 7E                   LD      A,(HL)
 277  8162 23                   INC     HL
 278  8163 32 6B 89             LD      (ModeLastBankBytes),A
 279  8166 7E                   LD      A,(HL)
 280  8167 23                   INC     HL
 281  8168 32 6C 89             LD      (ModeLastBankBytes+1),A
 282  816B 22 62 89             LD      (ModeTablePtr),HL
 283  816E
 284  816E CD 47 84             CALL    ConfigureCurrentMode
 285  8171 CD C6 88             CALL    SpectrumShowMode
 286  8174
 287  8174 AF                   XOR     A
 288  8175 32 6D 89             LD      (PaletteLevel),A
 289  8178
 290  8178              ; Inner loop: 2, 4, 16 and 256 DAC entries at this resolution.
 291  8178              PackedPaletteNext:
 292  8178 CD 7C 84             CALL    SelectPaletteParameters
 293  817B CD AB 84             CALL    ProgramDacPalette
 294  817E
 295  817E                      ; Legacy DAC writes disable VBE in the adapter model.
 296  817E                      ; Re-apply this resolution's indexed 8-bpp mode before VRAM access.
 297  817E CD 47 84             CALL    ConfigureCurrentMode
 298  8181
 299  8181 21 D6 8F             LD      HL,MsgPaletteLevel
 300  8184 CD 4C 89             CALL    DebugPrint
 301  8187 3A 6D 89             LD      A,(PaletteLevel)
 302  818A CD 32 89             CALL    DebugHexByte
 303  818D 21 E5 8F             LD      HL,MsgPaletteSuffix
 304  8190 CD 4C 89             CALL    DebugPrint
 305  8193
 306  8193                      ; Verify the DAC before touching the framebuffer. This keeps all
 307  8193                      ; DAC read-index/component activity out of the post-render phase.
 308  8193 CD 7C 84             CALL    SelectPaletteParameters
 309  8196 CD 79 85             CALL    VerifyDacPalette
 310  8199 B7                   OR      A
 311  819A 20 3A                JR      NZ,PackedPaletteFailed
 312  819C
 313  819C CD E7 84             CALL    FillModeVRAM
 314  819F
 315  819F 21 04 90             LD      HL,MsgPalettePass
 316  81A2 CD 4C 89             CALL    DebugPrint
 317  81A5 CD F2 88             CALL    SpectrumShowWriteComplete
 318  81A8 CD 22 89             CALL    WaitSpace
 319  81AB
 320  81AB 3A 6D 89             LD      A,(PaletteLevel)
 321  81AE 3C                   INC     A
 322  81AF 32 6D 89             LD      (PaletteLevel),A
 323  81B2 FE 04                CP      4
 324  81B4 20 C2                JR      NZ,PackedPaletteNext
 325  81B6
 326  81B6 3A 64 89             LD      A,(ModeCount)
 327  81B9 3D                   DEC     A
 328  81BA 32 64 89             LD      (ModeCount),A
 329  81BD C2 40 81             JP      NZ,PackedModeNext
 330  81C0
 331  81C0 21 B0 8E             LD      HL,MsgSweepDone
 332  81C3 CD 4C 89             CALL    DebugPrint
 333  81C6 CD 4D 88             CALL    SpectrumClear
 334  81C9 21 8B 90             LD      HL,ScreenTitle
 335  81CC CD 99 87             CALL    SpectrumPrint
 336  81CF 21 CA 91             LD      HL,ScreenAllDone
 337  81D2 CD 99 87             CALL    SpectrumPrint
 338  81D5 C9                   RET
 339  81D6
 340  81D6              PackedPaletteFailed:
 341  81D6 21 18 90             LD      HL,MsgPaletteFail
 342  81D9 CD 4C 89             CALL    DebugPrint
 343  81DC CD 83 87             CALL    SpectrumShowDacFail
 344  81DF CD 22 89             CALL    WaitSpace
 345  81E2 C9                   RET
 346  81E3
 347  81E3              ; Initialize only the entries used by the 2D smoke test.
 348  81E3              ; DAC components are six-bit values. Index 01 = blue, E3 = orange, FF = white.
 349  81E3              Program2DTestPalette:
 350  81E3 01 C8 03             LD      BC,$03C8
 351  81E6 AF                   XOR     A
 352  81E7 ED 79                OUT     (C),A
 353  81E9 01 C9 03             LD      BC,$03C9
 354  81EC AF                   XOR     A
 355  81ED ED 79                OUT     (C),A
 356  81EF ED 79                OUT     (C),A
 357  81F1 ED 79                OUT     (C),A
 358  81F3
 359  81F3 01 C8 03             LD      BC,$03C8
 360  81F6 3E 01                LD      A,1
 361  81F8 ED 79                OUT     (C),A
 362  81FA 01 C9 03             LD      BC,$03C9
 363  81FD 3E 00                LD      A,$00
 364  81FF ED 79                OUT     (C),A
 365  8201 3E 00                LD      A,$00
 366  8203 ED 79                OUT     (C),A
 367  8205 3E 3F                LD      A,$3F
 368  8207 ED 79                OUT     (C),A
 369  8209
 370  8209 01 C8 03             LD      BC,$03C8
 371  820C 3E E3                LD      A,$E3
 372  820E ED 79                OUT     (C),A
 373  8210 01 C9 03             LD      BC,$03C9
 374  8213 3E 3F                LD      A,$3F
 375  8215 ED 79                OUT     (C),A
 376  8217 3E 20                LD      A,$20
 377  8219 ED 79                OUT     (C),A
 378  821B AF                   XOR     A
 379  821C ED 79                OUT     (C),A
 380  821E
 381  821E 01 C8 03             LD      BC,$03C8
 382  8221 3E FF                LD      A,$FF
 383  8223 ED 79                OUT     (C),A
 384  8225 01 C9 03             LD      BC,$03C9
 385  8228 3E 3F                LD      A,$3F
 386  822A ED 79                OUT     (C),A
 387  822C ED 79                OUT     (C),A
 388  822E ED 79                OUT     (C),A
 389  8230 C9                   RET
 390  8231
 391  8231              ; -------------------------------------------------------------------------
 392  8231              ; 2D gradient test.
 393  8231              ; Programs all 256 DAC entries, then uses 256 accelerator SOLID FILL
 394  8231              ; commands to paint a full 320x200 horizontal hue gradient. The first
 395  8231              ; 64 palette bands are 2 pixels wide and the remaining 192 are 1 pixel,
 396  8231              ; giving exactly 320 pixels. No CPU framebuffer writes are used.
 397  8231              ; Returns A=0 on success, A=1 on accelerator/readback failure.
 398  8231              ; -------------------------------------------------------------------------
 399  8231              Run2DGradientTest:
 400  8231 21 5C 8F             LD      HL,Msg2DGradientStart
 401  8234 CD 4C 89             CALL    DebugPrint
 402  8237 CD E3 86             CALL    SpectrumShow2DGradientStart
 403  823A
 404  823A 3E 03                LD      A,3
 405  823C 32 6D 89             LD      (PaletteLevel),A
 406  823F CD 7C 84             CALL    SelectPaletteParameters
 407  8242 CD AB 84             CALL    ProgramDacPalette
 408  8245 CD 47 84             CALL    ConfigureCurrentMode
 409  8248
 410  8248                      ; Common parameters: base 0, pitch 320, y=0, height=200.
 411  8248 21 E4 82             LD      HL,AccelGradientRegs
 412  824B 3E 1E                LD      A,AccelGradientRegsEnd-AccelGradientRegs
 413  824D CD A4 83             CALL    WriteAccelRegisterTable
 414  8250
 415  8250 AF                   XOR     A
 416  8251 32 56 89             LD      (GradientIndex),A
 417  8254 21 00 00             LD      HL,0
 418  8257 22 57 89             LD      (GradientX),HL
 419  825A
 420  825A              Run2DGradientColumn:
 421  825A                      ; X position is accumulated because the first 64 bands are 2 px.
 422  825A 2A 57 89             LD      HL,(GradientX)
 423  825D 7D                   LD      A,L
 424  825E 5F                   LD      E,A
 425  825F 3E 14                LD      A,$14
 426  8261 CD BB 83             CALL    WriteAccelRegister
 427  8264 2A 57 89             LD      HL,(GradientX)
 428  8267 7C                   LD      A,H
 429  8268 5F                   LD      E,A
 430  8269 3E 15                LD      A,$15
 431  826B CD BB 83             CALL    WriteAccelRegister
 432  826E
 433  826E                      ; Palette index is also the 8-bpp fill colour.
 434  826E 3A 56 89             LD      A,(GradientIndex)
 435  8271 5F                   LD      E,A
 436  8272 3E 1C                LD      A,$1C
 437  8274 CD BB 83             CALL    WriteAccelRegister
 438  8277
 439  8277                      ; Width=2 for indices 0..63, then width=1 for 64..255.
 440  8277 3A 56 89             LD      A,(GradientIndex)
 441  827A FE 40                CP      64
 442  827C 1E 01                LD      E,1
 443  827E 30 02                JR      NC,Run2DGradientWidthReady
 444  8280 1E 02                LD      E,2
 445  8282              Run2DGradientWidthReady:
 446  8282 3E 18                LD      A,$18
 447  8284 CD BB 83             CALL    WriteAccelRegister
 448  8287
 449  8287 3E 00                LD      A,0
 450  8289 1E 01                LD      E,1
 451  828B CD BB 83             CALL    WriteAccelRegister
 452  828E CD C5 83             CALL    CheckAccelDone
 453  8291 B7                   OR      A
 454  8292 C2 D5 82             JP      NZ,Run2DGradientFailed
 455  8295
 456  8295                      ; Advance X by the just-painted band width.
 457  8295 3A 56 89             LD      A,(GradientIndex)
 458  8298 FE 40                CP      64
 459  829A 11 01 00             LD      DE,1
 460  829D 30 03                JR      NC,Run2DGradientAdvance
 461  829F 11 02 00             LD      DE,2
 462  82A2              Run2DGradientAdvance:
 463  82A2 2A 57 89             LD      HL,(GradientX)
 464  82A5 19                   ADD     HL,DE
 465  82A6 22 57 89             LD      (GradientX),HL
 466  82A9
 467  82A9 3A 56 89             LD      A,(GradientIndex)
 468  82AC 3C                   INC     A
 469  82AD 32 56 89             LD      (GradientIndex),A
 470  82B0 20 A8                JR      NZ,Run2DGradientColumn
 471  82B2
 472  82B2                      ; Confirm both ends of the 320-pixel gradient in VRAM.
 473  82B2 AF                   XOR     A
 474  82B3 01 DF 03             LD      BC,$03DF
 475  82B6 ED 79                OUT     (C),A
 476  82B8 21 00 C0             LD      HL,$C000
 477  82BB 7E                   LD      A,(HL)
 478  82BC B7                   OR      A
 479  82BD 20 16                JR      NZ,Run2DGradientReadbackFailed
 480  82BF 21 3F C1             LD      HL,$C13F
 481  82C2 7E                   LD      A,(HL)
 482  82C3 FE FF                CP      $FF
 483  82C5 20 0E                JR      NZ,Run2DGradientReadbackFailed
 484  82C7
 485  82C7 21 82 8F             LD      HL,Msg2DGradientPass
 486  82CA CD 4C 89             CALL    DebugPrint
 487  82CD CD F9 86             CALL    SpectrumShow2DGradientPass
 488  82D0 CD 22 89             CALL    WaitSpace
 489  82D3 AF                   XOR     A
 490  82D4 C9                   RET
 491  82D5
 492  82D5              Run2DGradientReadbackFailed:
 493  82D5              Run2DGradientFailed:
 494  82D5 21 B2 8F             LD      HL,Msg2DGradientFail
 495  82D8 CD 4C 89             CALL    DebugPrint
 496  82DB CD 0F 87             CALL    SpectrumShow2DGradientFail
 497  82DE CD 22 89             CALL    WaitSpace
 498  82E1 3E 01                LD      A,1
 499  82E3 C9                   RET
 500  82E4
 501  82E4              AccelGradientRegs:
 502  82E4 02 00                DB $02,$00
 503  82E6 08 00 09 00          DB $08,$00,$09,$00,$0A,$00,$0B,$00 ; destination base = 0
 503  82EA 0A 00 0B 00
 504  82EE 0E 40 0F 01          DB $0E,$40,$0F,$01                 ; destination pitch = 320
 505  82F2 16 00 17 00          DB $16,$00,$17,$00                 ; y = 0
 506  82F6 19 00                DB $19,$00                         ; width high = 0
 507  82F8 1A C8 1B 00          DB $1A,$C8,$1B,$00                 ; height = 200
 508  82FC 1D 00 1E 00          DB $1D,$00,$1E,$00,$1F,$00         ; colour upper bytes = 0
 508  8300 1F 00
 509  8302              AccelGradientRegsEnd:
 510  8302
 511  8302              ; -------------------------------------------------------------------------
 512  8302              ; Project131-compatible 2D accelerator smoke test.
 513  8302              ; Uses 320x200x8bpp so the complete 64,000-byte framebuffer is in banks 0..3.
 514  8302              ; Tests solid fill, VRAM-to-VRAM BitBLT, Bresenham line and status/readback.
 515  8302              ; Returns A=0 on success, A=1 on failure.
 516  8302              ; -------------------------------------------------------------------------
 517  8302              Run2DAcceleratorTest:
 518  8302 21 D4 8E             LD      HL,Msg2DStart
 519  8305 CD 4C 89             CALL    DebugPrint
 520  8308 CD CD 86             CALL    SpectrumShow2DStart
 521  830B
 522  830B                      ; The adapter powers up with a zeroed DAC. Program visible colours
 523  830B                      ; before the first 8-bpp test, then restore VBE mode (DAC writes
 524  830B                      ; switch the adapter to legacy software mode).
 525  830B CD E3 81             CALL    Program2DTestPalette
 526  830E
