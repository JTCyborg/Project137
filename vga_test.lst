 613  83B5              ; HL points to register/value pairs; A is the byte count.
 614  83B5              WriteAccelRegisterTable:
 615  83B5 32 66 89             LD      (AccelPairCount),A
 616  83B8              WriteAccelRegisterTableLoop:
 617  83B8 7E                   LD      A,(HL)
 618  83B9 23                   INC     HL
 619  83BA 5E                   LD      E,(HL)
 620  83BB 23                   INC     HL
 621  83BC E5                   PUSH    HL
 622  83BD CD CC 83             CALL    WriteAccelRegister
 623  83C0 E1                   POP     HL
 624  83C1 3A 66 89             LD      A,(AccelPairCount)
 625  83C4 D6 02                SUB     2
 626  83C6 32 66 89             LD      (AccelPairCount),A
 627  83C9 20 ED                JR      NZ,WriteAccelRegisterTableLoop
 628  83CB C9                   RET
 629  83CC
 630  83CC              ; A = accelerator register index, E = value.
 631  83CC              WriteAccelRegister:
 632  83CC 01 E2 03             LD      BC,$03E2
 633  83CF ED 79                OUT     (C),A
 634  83D1 7B                   LD      A,E
 635  83D2 0C                   INC     C
 636  83D3 ED 79                OUT     (C),A
 637  83D5 C9                   RET
 638  83D6
 639  83D6              ; Returns A=0 when status register reports DONE (1), otherwise A=1.
 640  83D6              CheckAccelDone:
 641  83D6 01 E2 03             LD      BC,$03E2
 642  83D9 3E 01                LD      A,1
 643  83DB ED 79                OUT     (C),A
 644  83DD 0C                   INC     C
 645  83DE ED 78                IN      A,(C)
 646  83E0 FE 01                CP      1
 647  83E2 20 02                JR      NZ,CheckAccelFailed
 648  83E4 AF                   XOR     A
 649  83E5 C9                   RET
 650  83E6              CheckAccelFailed:
 651  83E6 3E 01                LD      A,1
 652  83E8 C9                   RET
 653  83E9
 654  83E9              ; Register tables: index,value pairs. All addresses are byte offsets in VRAM.
 655  83E9              AccelFillRegs:
 656  83E9 02 00                DB $02,$00                 ; ROP COPY
 657  83EB 08 00 09 00          DB $08,$00,$09,$00,$0A,$00,$0B,$00 ; destination base = 0
 657  83EF 0A 00 0B 00
 658  83F3 0E 40 0F 01          DB $0E,$40,$0F,$01         ; destination pitch = 320
 659  83F7 14 14 15 00          DB $14,20,$15,0,$16,20,$17,0
 659  83FB 16 14 17 00
 660  83FF 18 64 19 00          DB $18,100,$19,0,$1A,60,$1B,0
 660  8403 1A 3C 1B 00
 661  8407 1C E3 1D 00          DB $1C,$E3,$1D,0,$1E,0,$1F,0
 661  840B 1E 00 1F 00
 662  840F              AccelFillRegsEnd:
 663  840F
 664  840F              AccelBlitRegs:
 665  840F 02 00                DB $02,$00
 666  8411 0C 40 0D 01          DB $0C,$40,$0D,$01         ; source pitch = 320
 667  8415 0E 40 0F 01          DB $0E,$40,$0F,$01         ; destination pitch = 320
 668  8419 10 14 11 00          DB $10,20,$11,0,$12,20,$13,0
 668  841D 12 14 13 00
 669  8421 14 8C 15 00          DB $14,140,$15,0,$16,20,$17,0
 669  8425 16 14 17 00
 670  8429 18 64 19 00          DB $18,100,$19,0,$1A,60,$1B,0
 670  842D 1A 3C 1B 00
 671  8431              AccelBlitRegsEnd:
 672  8431
 673  8431              AccelLineRegs:
 674  8431 02 00                DB $02,$00
 675  8433 0E 40 0F 01          DB $0E,$40,$0F,$01         ; destination pitch = 320
 676  8437 14 00 15 00          DB $14,0,$15,0,$16,0,$17,0
 676  843B 16 00 17 00
 677  843F 1C FF 1D 00          DB $1C,$FF,$1D,0,$1E,0,$1F,0
 677  8443 1E 00 1F 00
 678  8447 20 3F 21 01          DB $20,63,$21,1,$22,199,$23,0 ; endpoint (319,199)
 678  844B 22 C7 23 00
 679  844F              AccelLineRegsEnd:
 680  844F
 681  844F              AccelTestFailed:
 682  844F 21 33 8F             LD      HL,Msg2DFail
 683  8452 CD 5D 89             CALL    DebugPrint
