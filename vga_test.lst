 104  808F              ; -------------------------------------------------------------------------
 105  808F              ; ATM Turbo 2+ shadow-port unlock, copied from the working Project112 flow.
 106  808F              ; TR-DOS ROM entry #3D2F calls OUT (C),A at #2A53.
 107  808F              ; -------------------------------------------------------------------------
 108  808F              OpenATMShadowPorts:
 109  808F 01 9F 80             LD      BC,ShadowPortsOpened
 110  8092 C5                   PUSH    BC
 111  8093 01 53 2A             LD      BC,$2A53
 112  8096 C5                   PUSH    BC
 113  8097 01 77 01             LD      BC,$0177
 114  809A 3E C3                LD      A,$C3
 115  809C C3 2F 3D             JP      $3D2F
 116  809F              ShadowPortsOpened:
 117  809F C9                   RET
 118  80A0
 119  80A0              ; A = indexed VGA register, E = value.
 120  80A0              WriteVgaRegister:
 121  80A0 01 E0 03             LD      BC,$03E0
 122  80A3 ED 79                OUT     (C),A
 123  80A5 7B                   LD      A,E
 124  80A6 0C                   INC     C
 125  80A7 ED 79                OUT     (C),A
 126  80A9 C9                   RET
 127  80AA
 128  80AA              ; -------------------------------------------------------------------------
 129  80AA              ; Fill the 640x480x16 framebuffer.
 130  80AA              ; Size = 614400 bytes = 37 full 16 KiB banks + 8192 bytes in bank 37.
 131  80AA              ; The aperture C000h-FFFFh is switched with port 3DFh.
 132  80AA              ; -------------------------------------------------------------------------
 133  80AA              Fill640x480x16:
 134  80AA AF                   XOR     A
 135  80AB 32 6B 86             LD      (CurrentBank),A
 136  80AE
 137  80AE              FillBankLoop:
 138  80AE 3A 6B 86             LD      A,(CurrentBank)
 139  80B1 01 DF 03             LD      BC,$03DF
 140  80B4 ED 79                OUT     (C),A
 141  80B6
 142  80B6 21 00 C0             LD      HL,$C000
 143  80B9 11 1C 8A             LD      DE,ColorPattern
 144  80BC 3A 6B 86             LD      A,(CurrentBank)
 145  80BF FE 25                CP      37
 146  80C1 28 05                JR      Z,FillLastHalfBank
 147  80C3 01 00 40             LD      BC,$4000
 148  80C6 18 03                JR      FillBankBytes
 149  80C8
 150  80C8              FillLastHalfBank:
 151  80C8 01 00 20             LD      BC,$2000
 152  80CB
 153  80CB              FillBankBytes:
 154  80CB 1A                   LD      A,(DE)
 155  80CC 13                   INC     DE
 156  80CD 77                   LD      (HL),A
 157  80CE 23                   INC     HL
 158  80CF
 159  80CF                      ; Repeat the 128-byte RGB565 colour-bar sequence.
 160  80CF F5                   PUSH    AF
 161  80D0 7A                   LD      A,D
 162  80D1 FE 8A                CP      HIGH ColorPatternEnd
 163  80D3 20 08                JR      NZ,PatternPointerReady
 164  80D5 7B                   LD      A,E
 165  80D6 FE 9C                CP      LOW ColorPatternEnd
 166  80D8 20 03                JR      NZ,PatternPointerReady
 167  80DA 11 1C 8A             LD      DE,ColorPattern
 168  80DD              PatternPointerReady:
 169  80DD F1                   POP     AF
 170  80DE
 171  80DE 0B                   DEC     BC
 172  80DF 78                   LD      A,B
 173  80E0 B1                   OR      C
 174  80E1 20 E8                JR      NZ,FillBankBytes
 175  80E3
 176  80E3 3A 6B 86             LD      A,(CurrentBank)
 177  80E6 3C                   INC     A
 178  80E7 32 6B 86             LD      (CurrentBank),A
 179  80EA FE 26                CP      38
 180  80EC 20 C0                JR      NZ,FillBankLoop
 181  80EE C9                   RET
 182  80EF
 183  80EF              ; -------------------------------------------------------------------------
 184  80EF              ; Readback checks:
 185  80EF              ; bank 0 starts with 00 00 1F 00 E0 07 FF 07.
 186  80EF              ; bank 37 starts at linear offset 37*4000h = 5E000h.
 187  80EF              ; The final byte of the 640x480 framebuffer is bank 37 offset 1FFFh = FF.
 188  80EF              ; Return A=0 on success, A=1 on mismatch.
 189  80EF              ; -------------------------------------------------------------------------
 190  80EF              VerifyFramebuffer:
 191  80EF AF                   XOR     A
 192  80F0 01 DF 03             LD      BC,$03DF
 193  80F3 ED 79                OUT     (C),A
 194  80F5
 195  80F5 21 00 C0             LD      HL,$C000
 196  80F8                      ; First eight pixels are black: bytes 0..15 must be zero.
 197  80F8 7E                   LD      A,(HL)
 198  80F9 B7                   OR      A
 199  80FA 20 23                JR      NZ,VerifyFailed
 200  80FC 23                   INC     HL
 201  80FD 7E                   LD      A,(HL)
 202  80FE B7                   OR      A
 203  80FF 20 1E                JR      NZ,VerifyFailed
 204  8101
 205  8101                      ; Pixel 8 begins the blue RGB565 bar: 1F 00.
 206  8101 21 10 C0             LD      HL,$C010
 207  8104 7E                   LD      A,(HL)
 208  8105 FE 1F                CP      $1F
 209  8107 20 16                JR      NZ,VerifyFailed
 210  8109 23                   INC     HL
 211  810A 7E                   LD      A,(HL)
 212  810B B7                   OR      A
 213  810C 20 11                JR      NZ,VerifyFailed
 214  810E
 215  810E 3E 25                LD      A,37
 216  8110 01 DF 03             LD      BC,$03DF
 217  8113 ED 79                OUT     (C),A
 218  8115 21 FF DF             LD      HL,$DFFF
 219  8118 7E                   LD      A,(HL)
 220  8119 FE FF                CP      $FF
 221  811B 20 02                JR      NZ,VerifyFailed
 222  811D
 223  811D AF                   XOR     A
 224  811E C9                   RET
 225  811F
 226  811F              VerifyFailed:
 227  811F 3E 01                LD      A,1
 228  8121 C9                   RET
 229  8122
 230  8122
 231  8122              ; -------------------------------------------------------------------------
 232  8122              ; Sweep the nine requested standard PC display resolutions.
 233  8122              ; Each mode uses 8-bpp indexed pixels and writes exactly its visible
 234  8122              ; framebuffer size. Use only the adapter's initialized EGA palette
 235  8122              ; entries 0..7, matching the proven Project132 test pattern.
 236  8122              ; SPACE advances to the next resolution.
 237  8122              ; -------------------------------------------------------------------------
 238  8122              RunPackedModeSweep:
 239  8122 21 77 8B             LD      HL,MsgSweepStart
 240  8125 CD 63 86             CALL    DebugPrint
 241  8128 21 A9 86             LD      HL,PackedModeTable
 242  812B 22 75 86             LD      (ModeTablePtr),HL
 243  812E 21 05 87             LD      HL,ModeLabelTable
 244  8131 22 6C 86             LD      (ModeLabelPtr),HL
 245  8134 3E 09                LD      A,9
 246  8136 32 77 86             LD      (ModeCount),A
 247  8139
 248  8139              ; Outer loop: increase resolution only after all four palette sizes pass.
 249  8139              PackedModeNext:
 250  8139 2A 75 86             LD      HL,(ModeTablePtr)
 251  813C 7E                   LD      A,(HL)
 252  813D 23                   INC     HL
 253  813E 32 78 86             LD      (ModeXLo),A
 254  8141 7E                   LD      A,(HL)
 255  8142 23                   INC     HL
 256  8143 32 79 86             LD      (ModeXHi),A
 257  8146 7E                   LD      A,(HL)
 258  8147 23                   INC     HL
 259  8148 32 7A 86             LD      (ModeYLo),A
 260  814B 7E                   LD      A,(HL)
 261  814C 23                   INC     HL
 262  814D 32 7B 86             LD      (ModeYHi),A
 263  8150 7E                   LD      A,(HL)
 264  8151 23                   INC     HL
 265  8152 32 7C 86             LD      (ModeBpp),A
 266  8155 7E                   LD      A,(HL)
 267  8156 23                   INC     HL
 268  8157 32 7D 86             LD      (ModeBankCount),A
 269  815A 7E                   LD      A,(HL)
 270  815B 23                   INC     HL
 271  815C 32 7E 86             LD      (ModeLastBankBytes),A
 272  815F 7E                   LD      A,(HL)
 273  8160 23                   INC     HL
 274  8161 32 7F 86             LD      (ModeLastBankBytes+1),A
 275  8164 22 75 86             LD      (ModeTablePtr),HL
 276  8167
 277  8167 CD DC 81             CALL    ConfigureCurrentMode
 278  816A CD DD 85             CALL    SpectrumShowMode
 279  816D
 280  816D AF                   XOR     A
 281  816E 32 80 86             LD      (PaletteLevel),A
 282  8171
 283  8171              ; Inner loop: 2, 4, 16 and 256 DAC entries at this resolution.
 284  8171              PackedPaletteNext:
 285  8171 CD 11 82             CALL    SelectPaletteParameters
 286  8174 CD 3A 82             CALL    ProgramDacPalette
 287  8177
 288  8177                      ; Legacy DAC writes disable VBE in the adapter model.
 289  8177                      ; Re-apply this resolution's indexed 8-bpp mode before VRAM access.
 290  8177 CD DC 81             CALL    ConfigureCurrentMode
 291  817A
 292  817A 21 E4 8B             LD      HL,MsgPaletteLevel
 293  817D CD 63 86             CALL    DebugPrint
 294  8180 3A 80 86             LD      A,(PaletteLevel)
 295  8183 CD 49 86             CALL    DebugHexByte
 296  8186 21 F3 8B             LD      HL,MsgPaletteSuffix
 297  8189 CD 63 86             CALL    DebugPrint
 298  818C
 299  818C                      ; Verify the DAC before touching the framebuffer. This keeps all
 300  818C                      ; DAC read-index/component activity out of the post-render phase.
 301  818C CD 11 82             CALL    SelectPaletteParameters
 302  818F CD 14 83             CALL    VerifyDacPalette
 303  8192 B7                   OR      A
 304  8193 20 3A                JR      NZ,PackedPaletteFailed
 305  8195
 306  8195 CD 76 82             CALL    FillModeVRAM
 307  8198
 308  8198 21 15 8C             LD      HL,MsgPalettePass
 309  819B CD 63 86             CALL    DebugPrint
 310  819E CD 09 86             CALL    SpectrumShowWriteComplete
 311  81A1 CD 39 86             CALL    WaitSpace
 312  81A4
 313  81A4 3A 80 86             LD      A,(PaletteLevel)
 314  81A7 3C                   INC     A
 315  81A8 32 80 86             LD      (PaletteLevel),A
 316  81AB FE 04                CP      4
 317  81AD 20 C2                JR      NZ,PackedPaletteNext
 318  81AF
 319  81AF 3A 77 86             LD      A,(ModeCount)
 320  81B2 3D                   DEC     A
 321  81B3 32 77 86             LD      (ModeCount),A
 322  81B6 C2 39 81             JP      NZ,PackedModeNext
 323  81B9
 324  81B9 21 C0 8B             LD      HL,MsgSweepDone
 325  81BC CD 63 86             CALL    DebugPrint
 326  81BF CD 64 85             CALL    SpectrumClear
 327  81C2 21 9C 8C             LD      HL,ScreenTitle
 328  81C5 CD B0 84             CALL    SpectrumPrint
 329  81C8 21 DB 8D             LD      HL,ScreenAllDone
 330  81CB CD B0 84             CALL    SpectrumPrint
 331  81CE C9                   RET
 332  81CF
 333  81CF              PackedPaletteFailed:
 334  81CF 21 29 8C             LD      HL,MsgPaletteFail
 335  81D2 CD 63 86             CALL    DebugPrint
 336  81D5 CD 9A 84             CALL    SpectrumShowDacFail
 337  81D8 CD 39 86             CALL    WaitSpace
 338  81DB C9                   RET
