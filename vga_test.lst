 688  8458              ; Re-apply the currently selected packed-pixel 8-bpp resolution.
 689  8458              ConfigureCurrentMode:
 690  8458 3A 76 89             LD      A,(ModeXLo)
 691  845B 5F                   LD      E,A
 692  845C 3E 00                LD      A,0
 693  845E CD A7 80             CALL    WriteVgaRegister
 694  8461 3A 77 89             LD      A,(ModeXHi)
 695  8464 5F                   LD      E,A
 696  8465 3E 01                LD      A,1
 697  8467 CD A7 80             CALL    WriteVgaRegister
 698  846A 3A 78 89             LD      A,(ModeYLo)
 699  846D 5F                   LD      E,A
 700  846E 3E 02                LD      A,2
 701  8470 CD A7 80             CALL    WriteVgaRegister
 702  8473 3A 79 89             LD      A,(ModeYHi)
 703  8476 5F                   LD      E,A
 704  8477 3E 03                LD      A,3
 705  8479 CD A7 80             CALL    WriteVgaRegister
 706  847C 3E 08                LD      A,8
 707  847E 5F                   LD      E,A
 708  847F 3E 04                LD      A,4
 709  8481 CD A7 80             CALL    WriteVgaRegister
 710  8484 3E 01                LD      A,1
 711  8486 5F                   LD      E,A
 712  8487 3E 05                LD      A,5
 713  8489 CD A7 80             CALL    WriteVgaRegister
 714  848C C9                   RET
 715  848D
 716  848D              ; Palette table entry: count (word), index mask (byte), DAC source stride
 717  848D              ; beyond RGB (word). The RGB332 source table contains 256 evenly ordered
 718  848D              ; entries, so each smaller palette samples the full colour range.
 719  848D              SelectPaletteParameters:
 720  848D 21 F2 89             LD      HL,PaletteConfigTable
 721  8490 3A 7E 89             LD      A,(PaletteLevel)
 722  8493 B7                   OR      A
 723  8494 28 07                JR      Z,PaletteConfigFound
 724  8496 47                   LD      B,A
 725  8497              PaletteConfigSkip:
 726  8497 11 05 00             LD      DE,5
 727  849A 19                   ADD     HL,DE
 728  849B 10 FA                DJNZ    PaletteConfigSkip
 729  849D              PaletteConfigFound:
 730  849D 7E                   LD      A,(HL)
 731  849E 23                   INC     HL
 732  849F 32 80 89             LD      (PaletteRemaining),A
 733  84A2 32 82 89             LD      (PaletteCount),A
 734  84A5 7E                   LD      A,(HL)
 735  84A6 23                   INC     HL
 736  84A7 32 81 89             LD      (PaletteRemaining+1),A
 737  84AA 32 83 89             LD      (PaletteCount+1),A
 738  84AD 7E                   LD      A,(HL)
 739  84AE 23                   INC     HL
 740  84AF 32 7F 89             LD      (PaletteMask),A
 741  84B2 7E                   LD      A,(HL)
 742  84B3 23                   INC     HL
 743  84B4 32 84 89             LD      (PaletteStride),A
 744  84B7 7E                   LD      A,(HL)
 745  84B8 32 85 89             LD      (PaletteStride+1),A
 746  84BB C9                   RET
 747  84BC
 748  84BC              ; Program the selected number of DAC entries sampled from the 256-step HSV hue ramp.
 749  84BC              ProgramDacPalette:
 750  84BC 21 82 95             LD      HL,DacHuePalette
 751  84BF ED 5B 84 89          LD      DE,(PaletteStride)
 752  84C3 AF                   XOR     A
 753  84C4 32 6C 89             LD      (DacIndex),A
 754  84C7              ProgramDacPaletteLoop:
 755  84C7 3A 6C 89             LD      A,(DacIndex)
 756  84CA 01 C8 03             LD      BC,$03C8
 757  84CD ED 79                OUT     (C),A
 758  84CF 01 C9 03             LD      BC,$03C9
 759  84D2 7E                   LD      A,(HL)
 760  84D3 23                   INC     HL
 761  84D4 ED 79                OUT     (C),A
 762  84D6 7E                   LD      A,(HL)
 763  84D7 23                   INC     HL
 764  84D8 ED 79                OUT     (C),A
 765  84DA 7E                   LD      A,(HL)
 766  84DB 23                   INC     HL
 767  84DC ED 79                OUT     (C),A
 768  84DE 19                   ADD     HL,DE
 769  84DF 3A 6C 89             LD      A,(DacIndex)
 770  84E2 3C                   INC     A
 771  84E3 32 6C 89             LD      (DacIndex),A
 772  84E6 E5                   PUSH    HL
 773  84E7 CD EE 84             CALL    DecPaletteRemaining
 774  84EA E1                   POP     HL
 775  84EB 20 DA                JR      NZ,ProgramDacPaletteLoop
 776  84ED C9                   RET
 777  84EE
 778  84EE              DecPaletteRemaining:
 779  84EE 2A 80 89             LD      HL,(PaletteRemaining)
 780  84F1 2B                   DEC     HL
 781  84F2 22 80 89             LD      (PaletteRemaining),HL
 782  84F5 7C                   LD      A,H
 783  84F6 B5                   OR      L
 784  84F7 C9                   RET
 785  84F8
 786  84F8              ; Fill the framebuffer with a full-width horizontal hue gradient.
 787  84F8              ; Palette entries are sampled evenly from the first to last hue.
 788  84F8              ; A 16-bit accumulator spreads palette transitions uniformly across each row.
 789  84F8              FillModeVRAM:
 790  84F8 AF                   XOR     A
 791  84F9 32 65 89             LD      (CurrentBank),A
 792  84FC 32 6C 89             LD      (DacIndex),A
 793  84FF 21 00 00             LD      HL,0
 794  8502 22 86 89             LD      (GradientAccumulator),HL
 795  8505 22 88 89             LD      (ModeXCounter),HL
 796  8508              ModeFillBank:
 797  8508 3A 65 89             LD      A,(CurrentBank)
 798  850B 01 DF 03             LD      BC,$03DF
 799  850E ED 79                OUT     (C),A
 800  8510 21 00 C0             LD      HL,$C000
 801  8513 3A 65 89             LD      A,(CurrentBank)
 802  8516 47                   LD      B,A
 803  8517 3A 7B 89             LD      A,(ModeBankCount)
 804  851A 3D                   DEC     A
 805  851B B8                   CP      B
 806  851C 20 06                JR      NZ,ModeFillFullBank
 807  851E ED 4B 7C 89          LD      BC,(ModeLastBankBytes)
 808  8522 18 03                JR      ModeFillCountReady
 809  8524              ModeFillFullBank:
 810  8524 01 00 40             LD      BC,$4000
 811  8527              ModeFillCountReady:
 812  8527              ModeFillByte:
 813  8527 3A 6C 89             LD      A,(DacIndex)
 814  852A 77                   LD      (HL),A
 815  852B 23                   INC     HL
 816  852C E5                   PUSH    HL
 817  852D
 818  852D                      ; Advance the X coordinate and detect the end of the scanline.
 819  852D 2A 88 89             LD      HL,(ModeXCounter)
 820  8530 23                   INC     HL
 821  8531 22 88 89             LD      (ModeXCounter),HL
 822  8534 E5                   PUSH    HL
 823  8535 3A 76 89             LD      A,(ModeXLo)
 824  8538 5F                   LD      E,A
 825  8539 3A 77 89             LD      A,(ModeXHi)
 826  853C 57                   LD      D,A
 827  853D B7                   OR      A
 828  853E ED 52                SBC     HL,DE
 829  8540 E1                   POP     HL
 830  8541 20 0F                JR      NZ,ModeGradientAdvance
 831  8543
 832  8543                      ; Restart the gradient at the beginning of every scanline.
 833  8543 21 00 00             LD      HL,0
 834  8546 22 88 89             LD      (ModeXCounter),HL
 835  8549 22 86 89             LD      (GradientAccumulator),HL
 836  854C AF                   XOR     A
 837  854D 32 6C 89             LD      (DacIndex),A
 838  8550 18 21                JR      ModePatternAdvanceDone
 839  8552
 840  8552              ModeGradientAdvance:
 841  8552                      ; Bresenham-style distribution: add palette count per pixel and
 842  8552                      ; advance the DAC index whenever the accumulator reaches width.
 843  8552 2A 86 89             LD      HL,(GradientAccumulator)
 844  8555 ED 5B 82 89          LD      DE,(PaletteCount)
 845  8559 19                   ADD     HL,DE
 846  855A ED 5B 76 89          LD      DE,(ModeXLo)
 847  855E B7                   OR      A
 848  855F ED 52                SBC     HL,DE
 849  8561 38 0C                JR      C,ModeGradientHold
 850  8563 22 86 89             LD      (GradientAccumulator),HL
 851  8566 3A 6C 89             LD      A,(DacIndex)
 852  8569 3C                   INC     A
 853  856A 32 6C 89             LD      (DacIndex),A
 854  856D 18 04                JR      ModePatternAdvanceDone
 855  856F              ModeGradientHold:
 856  856F 19                   ADD     HL,DE
 857  8570 22 86 89             LD      (GradientAccumulator),HL
 858  8573
 859  8573              ModePatternAdvanceDone:
 860  8573 E1                   POP     HL
 861  8574 0B                   DEC     BC
 862  8575 78                   LD      A,B
 863  8576 B1                   OR      C
 864  8577 C2 27 85             JP      NZ,ModeFillByte
 865  857A 3A 65 89             LD      A,(CurrentBank)
 866  857D 3C                   INC     A
 867  857E 32 65 89             LD      (CurrentBank),A
 868  8581 47                   LD      B,A
 869  8582 3A 7B 89             LD      A,(ModeBankCount)
 870  8585 B8                   CP      B
 871  8586 C2 08 85             JP      NZ,ModeFillBank
 872  8589 C9                   RET
 873  858A
 874  858A              ; Read back every programmed DAC entry, including all RGB components.
 875  858A              ; Return A=0 on success, A=1 on mismatch.
 876  858A              VerifyDacPalette:
 877  858A 21 82 95             LD      HL,DacHuePalette
 878  858D ED 5B 84 89          LD      DE,(PaletteStride)
 879  8591 AF                   XOR     A
 880  8592 32 6C 89             LD      (DacIndex),A
 881  8595              VerifyDacPaletteLoop:
 882  8595 3A 6C 89             LD      A,(DacIndex)
 883  8598 01 C7 03             LD      BC,$03C7
